/************************************************************
 * API: LOAD STATIONS
 *
 * Uses:
 * taco_treceability_master
 *
 * Table:
 * taco_treceability.master_station
 ************************************************************/

app.get(
    "/api/stations",
    async (req, res) => {

        try {

            const result =
                await dbConn
                    .request()
                    .query(`
                        SELECT
                            Station_ID,
                            Station_Name
                        FROM
                            taco_treceability.master_station
                        ORDER BY
                            Station_Name
                    `);


            res.json(
                result.recordset
            );


        } catch (err) {

            console.error(
                "Station fetch error:",
                err
            );


            res.status(500).json({

                error:
                    "Failed to load stations"

            });

        }

    }
);


/************************************************************
 * API: VERIFY PASSWORD
 *
 * Uses:
 * taco_treceability
 *
 * Table:
 * station_status_ok_universal_password
 *
 * Password and username are now dynamic.
 ************************************************************/

app.post(
    "/api/verify-password",
    async (req, res) => {

        try {

            const {
                password
            } = req.body;


            /************************************************
             * CHECK PASSWORD RECEIVED
             ************************************************/

            if (!password) {

                return res.status(400).json({

                    success: false,

                    message:
                        "Password required"

                });

            }


            /************************************************
             * CHECK DB CONNECTION
             ************************************************/

            if (!dbConn2.connected) {

                console.error(
                    "Password verification failed: " +
                    "taco_treceability DB not connected"
                );


                return res.status(500).json({

                    success: false,

                    message:
                        "Database connection unavailable"

                });

            }


            /************************************************
             * CHECK PASSWORD IN DATABASE
             ************************************************/

            const result =
                await dbConn2
                    .request()

                    .input(
                        "pass_key",
                        sql.VarChar(sql.MAX),
                        String(password)
                    )

                    .query(`
                        SELECT TOP 1
                            sr_no,
                            username,
                            pass_key,
                            today_date
                        FROM
                            taco_treceability.station_status_ok_universal_password
                        WHERE
                            pass_key = @pass_key
                        ORDER BY
                            sr_no DESC
                    `);


            /************************************************
             * INVALID PASSWORD
             ************************************************/

            if (
                result.recordset.length === 0
            ) {

                console.log(
                    "Invalid password entered"
                );


                return res.status(401).json({

                    success: false,

                    message:
                        "Invalid Password"

                });

            }


            /************************************************
             * GET USERNAME FROM DATABASE
             ************************************************/

            const username =
                result.recordset[0].username;


            console.log(
                "Password verified successfully"
            );


            console.log(
                "Authenticated Username:",
                username
            );


            /************************************************
             * RETURN USERNAME
             ************************************************/

            return res.json({

                success: true,

                username: username

            });


        } catch (err) {

            console.error(
                "Password verification error:",
                err
            );


            return res.status(500).json({

                success: false,

                message:
                    "Password verification failed"

            });

        }

    }
);


/************************************************************
 * API: BARCODE SCAN
 ************************************************************/

app.post(
    "/api/scan",
    async (req, res) => {

        try {

            const {
                stationId,
                line,
                barcode,
                username
            } = req.body;


            /************************************************
             * VALIDATE REQUEST
             ************************************************/

            if (
                !stationId ||
                !barcode ||
                !username
            ) {

                return res.status(400).json({

                    message:
                        "Station, barcode & username required"

                });

            }


            /************************************************
             * LOG SCAN RECEIVED
             ************************************************/

            console.log(
                "\n=========== SCAN RECEIVED ==========="
            );


            console.log(
                "Station ID:",
                stationId
            );


            console.log(
                "Line:",
                line
            );


            console.log(
                "Barcode:",
                barcode
            );


            console.log(
                "Username:",
                username
            );


            console.log(
                "====================================="
            );


            /********************************************************
             * GET STATION NAME
             *
             * IMPORTANT:
             *
             * master_station is in:
             * taco_treceability_master
             *
             * Therefore dbConn is used.
             ********************************************************/

            let stationName;


            try {

                const stationResult =
                    await dbConn
                        .request()

                        .input(
                            "station_id",
                            sql.Int,
                            parseInt(stationId)
                        )

                        .query(`
                            SELECT TOP 1
                                Station_ID,
                                Station_Name,
                                category
                            FROM
                                taco_treceability.master_station
                            WHERE
                                Station_ID = @station_id
                        `);


                /************************************************
                 * CHECK STATION EXISTS
                 ************************************************/

                if (
                    stationResult.recordset.length === 0
                ) {

                    console.error(
                        "Station not found in master_station"
                    );


                    console.error(
                        "Station ID:",
                        stationId
                    );


                    return res.status(400).json({

                        message:
                            "Station not found in master_station"

                    });

                }


                /************************************************
                 * GET STATION NAME
                 ************************************************/

                stationName =
                    stationResult
                        .recordset[0]
                        .Station_Name;


                console.log(
                    "Station Name:",
                    stationName
                );


            } catch (stationErr) {

                console.error(
                    "Station lookup error:",
                    stationErr
                );


                return res.status(500).json({

                    message:
                        "Failed to fetch Station Name"

                });

            }


            /********************************************************
             * INSERT INTO station_status_ok_universal
             *
             * Database:
             * taco_treceability
             *
             * IMPORTANT:
             *
             * The column name remains:
             *
             * station_id
             *
             * But the VALUE inserted is:
             *
             * Station_Name
             ********************************************************/

            try {

                await dbConn2
                    .request()

                    .input(
                        "station_name",
                        sql.VarChar(sql.MAX),
                        String(stationName)
                    )

                    .input(
                        "barcode_string",
                        sql.VarChar(sql.MAX),
                        String(barcode)
                    )

                    .input(
                        "username",
                        sql.VarChar(sql.MAX),
                        String(username)
                    )

                    .query(`
                        INSERT INTO
                            taco_treceability.station_status_ok_universal
                        (
                            station_id,
                            barcode_string,
                            username
                        )
                        VALUES
                        (
                            @station_name,
                            @barcode_string,
                            @username
                        )
                    `);


                console.log(
                    "Log inserted successfully into taco_treceability"
                );


                console.log(
                    "Inserted Station Name:",
                    stationName
                );


                console.log(
                    "Inserted Barcode:",
                    barcode
                );


                console.log(
                    "Inserted Username:",
                    username
                );


            } catch (logErr) {

                console.error(
                    "Log Insert Error:",
                    logErr
                );


                return res.status(500).json({

                    message:
                        "Log insert failed"

                });

            }


            /********************************************************
             * CALL EXTERNAL API
             *
             * EXISTING LOGIC REMAINS SAME
             *
             * IMPORTANT:
             *
             * External API still receives stationId,
             * NOT stationName.
             ********************************************************/

            const apiPayload = {

                station_id:
                    stationId,

                line_id:
                    line,

                customer_qrcode:
                    barcode,

                station_status:
                    "OK",

                checklist_name:
                    "NA",

                substation_id:
                    "NA"

            };


            try {

                console.log(
                    "\nSending Payload To External API:"
                );


                console.log(
                    apiPayload
                );


                const apiResponse =
                    await axios.post(

                        "https://mismainapp.tataautocomp.com:3241/station_status/filter",

                        apiPayload,

                        {

                            httpsAgent:
                                new https.Agent({

                                    rejectUnauthorized:
                                        false

                                }),

                            timeout:
                                10000

                        }

                    );


                console.log(
                    "\n=========== EXTERNAL API RESPONSE ==========="
                );


                console.log(
                    "Status Code:",
                    apiResponse.status
                );


                console.log(
                    "Status Text:",
                    apiResponse.statusText
                );


                console.log(
                    "Headers:",
                    apiResponse.headers
                );


                console.log(
                    "Response Data:",
                    apiResponse.data
                );


                console.log(
                    "=============================================\n"
                );


                return res.json({

                    message:
                        "Barcode processed successfully",

                    externalApiStatus:
                        apiResponse.status,

                    externalApiResponse:
                        apiResponse.data

                });


            } catch (apiErr) {

                console.log(
                    "\n=========== EXTERNAL API ERROR ==========="
                );


                if (apiErr.response) {

                    console.log(
                        "Error Status:",
                        apiErr.response.status
                    );


                    console.log(
                        "Error Headers:",
                        apiErr.response.headers
                    );


                    console.log(
                        "Error Data:",
                        apiErr.response.data
                    );


                } else {

                    console.log(
                        "Error Message:",
                        apiErr.message
                    );

                }


                console.log(
                    "==========================================\n"
                );


                return res.status(500).json({

                    message:
                        "External API failed",

                    error:
                        apiErr.response?.data ||
                        apiErr.message

                });

            }


        } catch (err) {

            console.error(
                "Scan error:",
                err
            );


            res.status(500).json({

                message:
                    "Scan failed"

            });

        }

    }
);


