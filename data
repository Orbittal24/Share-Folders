const net = require("net");

const SERVER_IP = "10.9.4.28";
const SERVER_PORT = 5391;

console.log("================================================");
console.log("TCP TEST CLIENT");
console.log("================================================");
console.log("Server IP   :", SERVER_IP);
console.log("Server Port :", SERVER_PORT);
console.log("================================================");

function connectToServer() {

    console.log("");
    console.log(`[TCP] Connecting to ${SERVER_IP}:${SERVER_PORT}...`);

    const client = new net.Socket();

    client.setTimeout(5000);

    // ========================================================
    // TCP CONNECT
    // ========================================================

    client.connect(SERVER_PORT, SERVER_IP, () => {

        console.log("");
        console.log("================================================");
        console.log("✅ TCP CONNECTION SUCCESSFUL");
        console.log("================================================");
        console.log(`Connected to : ${SERVER_IP}:${SERVER_PORT}`);
        console.log("================================================");
        console.log("");
        console.log("Type a line number and press ENTER.");
        console.log("Example: 3");
        console.log("Type 'exit' to close.");
        console.log("");
    });

    // ========================================================
    // RECEIVE DATA FROM MAIN SERVER
    // ========================================================

    client.on("data", (data) => {

        console.log("");
        console.log("------------------------------------------------");
        console.log("📥 DATA RECEIVED FROM MAIN SERVER");
        console.log("------------------------------------------------");
        console.log(data.toString());
        console.log("------------------------------------------------");
    });

    // ========================================================
    // CONNECTION CLOSED
    // ========================================================

    client.on("close", () => {

        console.log("");
        console.log("❌ TCP CONNECTION CLOSED");
        console.log("");

        setTimeout(() => {
            connectToServer();
        }, 3000);
    });

    // ========================================================
    // CONNECTION ERROR
    // ========================================================

    client.on("error", (error) => {

        console.log("");
        console.log("❌ TCP ERROR");
        console.log("Error :", error.message);
        console.log("");

    });

    // ========================================================
    // CONNECTION TIMEOUT
    // ========================================================

    client.on("timeout", () => {

        console.log("");
        console.log("❌ TCP CONNECTION TIMEOUT");
        console.log("");

        client.destroy();
    });

    // ========================================================
    // SEND LINE NUMBER
    // ========================================================

    process.stdin.removeAllListeners("data");

    process.stdin.on("data", (input) => {

        const message = input.toString().trim();

        if (!message) {
            return;
        }

        if (message.toLowerCase() === "exit") {

            console.log("");
            console.log("[TCP] Closing connection...");

            client.end();

            process.exit(0);
        }

        if (!client.destroyed) {

            client.write(message);

            console.log("");
            console.log("📤 SENT TO MAIN SERVER :", message);
        }
    });
}

connectToServer();
