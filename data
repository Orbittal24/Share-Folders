# ============================================================
# CONNECT FUNCTION
# ============================================================

def connect_db(config):

    conn = pyodbc.connect(
        f"DRIVER={{ODBC Driver 17 for SQL Server}};"
        f"SERVER={config['server']};"
        f"DATABASE={config['database']};"
        f"UID={config['user']};"
        f"PWD={config['password']};"
        f"TrustServerCertificate=yes;"
        f"Connection Timeout=5;"
    )

    conn.autocommit = False

    return conn


# ============================================================
# SQL CONNECTION ERROR DETECTION
# ============================================================

def is_sql_connection_error(error):

    error_text = str(error).upper()

    connection_errors = [
        "08S01",
        "08001",
        "08003",
        "08004",
        "08007",
        "08S02",
        "08S03",
        "COMMUNICATION LINK FAILURE",
        "CONNECTION IS BROKEN",
        "CONNECTION RESET",
        "CONNECTION WAS CLOSED",
        "TCP PROVIDER",
        "SQL SERVER DOES NOT EXIST",
        "GENERAL NETWORK ERROR",
        "SERVER IS NOT FOUND",
        "TRANSPORT-LEVEL ERROR",
        "BROKEN PIPE",
        "CONNECTION FAILED"
    ]

    return any(
        error_code in error_text
        for error_code in connection_errors
    )


# ============================================================
# CLOSE CONNECTION SAFELY
# ============================================================

def close_connection(conn, name="DB"):

    if conn is None:
        return

    try:

        conn.close()

        print(
            f"[{name}] CONNECTION CLOSED."
        )

    except Exception as e:

        print(
            f"[{name}] CONNECTION CLOSE FAILED :",
            e
        )


