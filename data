            console.log(`  NOT FOUND in the last ${RETENTION_DAYS} days.`);
            console.log(`  (Either never read from the PLC, or older than the retention period.)\n`);
        } else {
            console.log(`\n  ${qr} -- ${rows.length} record(s)\n`);
            for (const r of rows) {
                let state;
                if (r.sent_at) state = "SENT at " + r.sent_at;
                else if (r.queue_id) state = `WAITING TO SEND (attempts: ${r.attempts})`;
                else state = "NOT SENT and NOT QUEUED -- investigate";

                console.log(`  history id=${r.id}  node=${r.src_node}`);
                console.log(`    first read : ${r.first_read_at}`);
                console.log(`    last read  : ${r.read_at}`);
                console.log(`    reported   : ${r.read_count} time(s), values changed ${r.change_count} time(s)`);
                console.log(`    status     : ${state}`);
                console.log(`    voltage    : ${r.voltage_val}   ir: ${r.ir_val}   material: ${r.material}`);
                if (r.last_error) console.log(`    last err   : ${r.last_error}`);
                console.log("");
            }
        }
        return true;
    }

    if (cmd === "--stats") {
        const hist = Number(stmtHistoryCount.get().n);
        const sent = Number(stmtHistorySentCount.get().n);
        const queued = Number(stmtQueueCount.get().n);
        const distinct = Number(db.prepare(`SELECT COUNT(DISTINCT cell_qrcode) AS n FROM cells_history`).get().n);
        const reReads = Number(db.prepare(`SELECT COALESCE(SUM(read_count - 1), 0) AS n FROM cells_history`).get().n);
        const changed = Number(db.prepare(`SELECT COUNT(*) AS n FROM cells_history WHERE change_count > 0`).get().n);
        const ng = Number(db.prepare(`SELECT COUNT(*) AS n FROM cells_history WHERE cell_qrcode IN ('', 'NG')`).get().n);
        const oldest = db.prepare(`SELECT MIN(first_read_at) AS t FROM cells_history`).get().t;
        const newest = db.prepare(`SELECT MAX(read_at) AS t FROM cells_history`).get().t;
        const stuck = db.prepare(`SELECT COUNT(*) AS n FROM cells_queue WHERE attempts > 3`).get().n;
        const orphan = db.prepare(`
            SELECT COUNT(*) AS n FROM cells_history h
            WHERE h.sent_at IS NULL
              AND NOT EXISTS (SELECT 1 FROM cells_queue q WHERE q.history_id = h.id)
        `).get().n;
        const lastPurge = db.prepare(
            `SELECT ts, detail FROM events WHERE kind = 'PURGE' ORDER BY id DESC LIMIT 1`
        ).get();

        let sizeMb = "-";
        try { sizeMb = (fs.statSync(DB_FILE).size / 1048576).toFixed(1) + " MB"; } catch (_) {}

        console.log(`
  DATABASE  : ${DB_FILE}
  File size : ${sizeMb}

  HISTORY (one row per cell QR, kept ${RETENTION_DAYS} days)
    Cells        : ${hist}
    Distinct QR  : ${distinct}   (should equal Cells, apart from NG/blank)
    Sent         : ${sent}
    NG / blank   : ${ng}
    Re-reads     : ${reReads}   (repeat reports ignored -- no duplicate rows)
    Values changed: ${changed} cell(s) updated after first read
    Oldest       : ${oldest || "-"}
    Newest       : ${newest || "-"}

  QUEUE (cleared on ack)
    Waiting : ${queued}
    Stuck   : ${stuck}   (more than 3 failed attempts)

  Orphaned  : ${orphan}   (unsent, not in queue -- should be 0)

  Last purge: ${lastPurge ? lastPurge.ts + " -- " + lastPurge.detail : "never"}
`);
        return true;
    }

    if (cmd === "--pending") {
        const rows = db.prepare(`
            SELECT id, cell_qrcode, queued_at, attempts, last_error
            FROM cells_queue ORDER BY id LIMIT 50
        `).all();
        if (rows.length === 0) {
            console.log("\n  Queue is empty -- everything has been acknowledged.\n");
        } else {
            console.log(`\n  ${rows.length} oldest queued record(s):\n`);
            for (const r of rows) {
                console.log(`  id=${r.id}  ${r.cell_qrcode}  queued ${r.queued_at}` +
                            (r.attempts ? `  attempts=${r.attempts} (${r.last_error})` : ""));
            }
            console.log("");
        }
        return true;
    }

    if (cmd === "--purge") {
        if (RETENTION_DAYS <= 0) {
            console.log("\n  RETENTION_DAYS is 0 -- history is kept forever, nothing purged.\n");
            return true;
        }
        console.log(`\n  Purging history older than ${RETENTION_DAYS} days...`);
        purgeOldHistory((removed) => {
            console.log(`  Removed ${removed} record(s).`);
            console.log(`  Run --vacuum (service stopped) to shrink the file itself.\n`);
            db.close();
            process.exit(0);
        });
        return "async";
    }

    if (cmd === "--vacuum") {
        console.log("\n  VACUUM rewrites the whole database and holds an exclusive lock.");
        console.log("  Make sure the service is STOPPED before running this.\n");
        const before = fs.statSync(DB_FILE).size;
        const t0 = Date.now();
        db.exec("VACUUM");
        const after = fs.statSync(DB_FILE).size;
        console.log(`  Done in ${((Date.now() - t0) / 1000).toFixed(1)}s`);
        console.log(`  ${(before / 1048576).toFixed(1)} MB -> ${(after / 1048576).toFixed(1)} MB\n`);
        logEvent("VACUUM", `${before} -> ${after} bytes`);
        return true;
    }

    return false;
}

