import redis
import time

r = redis.StrictRedis(
    host="localhost",
    port=6379,
    password="Gotion@123Strong!",
    db=31,
    decode_responses=True
)

BATCH_SIZE = 5000
TOTAL_TO_DELETE = 100000

cursor = 0
deleted = 0

while deleted < TOTAL_TO_DELETE:

    cursor, keys = r.scan(
        cursor=cursor,
        match="cell:*",
        count=BATCH_SIZE
    )

    if keys:
        remaining = TOTAL_TO_DELETE - deleted
        keys = keys[:remaining]

        r.unlink(*keys)

        deleted += len(keys)

        print(
            f"Deleted: {deleted}/{TOTAL_TO_DELETE}"
        )

    if cursor == 0:
        break

    time.sleep(0.05)

print("\nCompleted.")
print("Total deleted:", deleted)
