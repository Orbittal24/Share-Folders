    while not stop_event.is_set():

        try:

            # ------------------------------------------------------
            # Make sure SQL connection is alive
            # ------------------------------------------------------

            if not is_sql_connection_alive(conn):

                print(
                    f"[SQL] Broken SQL connection detected "
                    f"for controller {ip}."
                )

                close_sql_connection(conn)

                conn = None

                while (
                    not stop_event.is_set()
                    and conn is None
                ):

                    conn = create_sql_connection()

                    if conn is None:

                        print(
                            f"[SQL] Reconnect failed for "
                            f"{ip}. Retrying in 5 seconds..."
                        )

                        time.sleep(5)

                if stop_event.is_set():
                    break

                print(
                    f"[SQL] SQL connection restored for {ip}"
                )

            # ------------------------------------------------------
            # ENIP CONNECTION
            # ------------------------------------------------------

            with proxy_simple(
                ip,
                timeout=3
            ) as via:

                print(
                    f"[CONNECTED] {ip}"
                )

                while not stop_event.is_set():

                    # ------------------------------------------------
                    # Read ENIP data
                    # ------------------------------------------------

                    real, uint = via.read([
                        ('@4/100/3', 'REAL'),
                        ('@4/100/3', 'UINT'),
                    ])

                    real_vals = (
                        extract_selected_values(
                            real,
                            REAL_INDICES
                        )
                    )

                    uint_vals = (
                        extract_selected_values(
                            uint,
                            UINT_INDICES
                        )
                    )

                    timestamp = (
                        get_formatted_timestamp()
                    )

                    # ------------------------------------------------
                    # Store pending values
                    # ------------------------------------------------

                    for i in range(
                        min(
                            len(real_vals),
                            len(uint_vals)
                        )
                    ):

                        pending[
                            f"{ip}_{i+1}"
                        ] = (
                            real_vals[i],
                            uint_vals[i]
                        )

                    # ------------------------------------------------
                    # Process pending values
                    # ------------------------------------------------

                    for key, (
                        t,
                        a
                    ) in list(
                        pending.items()
                    ):

                        try:

                            if update_sql_redis_api(
                                conn,
                                redis_client,
                                ip,
                                int(
                                    key.split('_')[1]
                                ),
                                t,
                                a,
                                timestamp,
                                last_sql_values
                            ):

                                del pending[key]

                        except pyodbc.Error as sql_error:

                            # ----------------------------------------
                            # SQL connection is broken.
                            # ----------------------------------------

                            print(
                                f"[SQL RECONNECT] "
                                f"{ip} SQL error: "
                                f"{sql_error}"
                            )

                            close_sql_connection(
                                conn
                            )

                            conn = None

                            # ----------------------------------------
                            # Do NOT remove pending record.
                            # It will be retried after SQL reconnect.
                            # ----------------------------------------

                            break

                    # ------------------------------------------------
                    # If SQL connection broke, leave ENIP loop and
                    # recreate SQL connection.
                    # ------------------------------------------------

                    if conn is None:

                        print(
                            f"[SQL] Waiting for SQL reconnect "
                            f"for controller {ip}..."
                        )

                        break

                    time.sleep(0.5)

        except pyodbc.Error as sql_error:

            print(
                f"[SQL RECONNECT] {ip}: "
                f"{sql_error}"
            )

            close_sql_connection(
                conn
            )

            conn = None

            print(
                f"[SQL] Retrying SQL connection "
                f"for {ip} in 3 seconds..."
            )

            time.sleep(3)

        except Exception as e:

            # ------------------------------------------------------
            # Existing ENIP reconnect behavior
            # ------------------------------------------------------

            print(
                "[RECONNECT]",
                ip,
                e
            )

            time.sleep(3)

    # --------------------------------------------------------------
    # STOP
    # --------------------------------------------------------------

    close_sql_connection(
        conn
    )

    print(
        f"[STOPPED] {ip}"
    )


# ------------------------------------------------------------------
# MAIN
# ------------------------------------------------------------------

def main():

    processes = {}

    stop_event = Event()

    print(
        "[INFO] Monitoring controllers..."
    )

    # --------------------------------------------------------------
    # Keep the last successfully fetched IP list.
    # If SQL temporarily fails, do not terminate existing processes.
    # --------------------------------------------------------------

    last_known_ips = set()

    try:

        while True:

            # ------------------------------------------------------
            # Fetch controller IPs
            # ------------------------------------------------------

            fetched_ips = fetch_ip_list()

            if fetched_ips is None:

                print(
                    "[IP MONITOR] SQL unavailable. "
                    "Keeping existing controller processes."
                )

                ips = last_known_ips

            else:

                ips = set(
                    fetched_ips
                )

                last_known_ips = ips

            # ------------------------------------------------------
            # Start newly discovered controllers
            # ------------------------------------------------------

            for ip in (
                ips - processes.keys()
            ):

                print(
                    f"[PROCESS START] Starting controller {ip}"
                )

                p = Process(
                    target=enip_reader,
                    args=(
                        ip,
                        stop_event
                    )
                )

                p.start()

                processes[ip] = p

            # ------------------------------------------------------
            # Remove controllers which are no longer configured
            # or whose process has stopped
            # ------------------------------------------------------

            for ip in list(processes):

                if (
                    ip not in ips
                    or
                    not processes[ip].is_alive()
                ):

                    print(
                        f"[PROCESS REMOVE] "
                        f"Removing controller {ip}"
                    )

                    try:

                        processes[ip].terminate()

                    except Exception:
                        pass

                    try:

                        processes[ip].join(
                            timeout=2
                        )

                    except Exception:
                        pass

                    del processes[ip]

            # ------------------------------------------------------
            # IMPORTANT:
            #
            # Original code checked every 1 second.
            # Keep the controller monitoring responsive, but the
            # SQL function itself has retry protection.
            # ------------------------------------------------------

            time.sleep(5)

    except KeyboardInterrupt:

        print(
            "\n[INFO] Stopping all controller processes..."
        )

        stop_event.set()

        for ip, p in processes.items():

            try:

                p.join(
                    timeout=5
                )

            except Exception:
                pass

        print(
            "[INFO] All controller processes stopped."
        )


# ------------------------------------------------------------------
# MAIN ENTRY
# ------------------------------------------------------------------

if __name__ == "__main__":

    main()
