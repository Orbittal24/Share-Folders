def process_record(src_conn, dst_conn):

    src_cursor = src_conn.cursor()
    dst_cursor = dst_conn.cursor()

    row = None

    # -----------------------------------
    # STATUS FLAGS
    # -----------------------------------

    sql_success = False
    redis_success = False

    try:

        # -----------------------------------
        # GET SOURCE RECORD
        # -----------------------------------

        src_cursor.execute("""
        SELECT TOP 1 *
        FROM taco_treceability.ocv_machine_data_mirror
        WHERE machine_location='line5_line6'
        ORDER BY sr_no ASC
        """)

        row = src_cursor.fetchone()

        if not row:

            print("No records...")

            return

        qr = safe(row.cell_qrcode)

        print("\n========= NEW RECORD =========")
        print("QR :", qr)


        # -----------------------------------
        # QR VALIDATION
        # -----------------------------------

        if len(qr) < 16:

            raise Exception("QR too short")


        # -----------------------------------
        # DATE CODE
        # -----------------------------------

        code12_13 = qr[12:14]

        dateCode = (
            qr[8:11]
            if code12_13 == "BV"
            else qr[14:17]
        )


        # -----------------------------------
        # DATE MAPPING
        # -----------------------------------

        yearValue = yearMap.get(dateCode[0])

        monthValue = monthMap.get(dateCode[1])

        dayValue = dayMap.get(dateCode[2])


        if not yearValue or not monthValue or not dayValue:

            raise Exception(
                "Date mapping failed"
            )


        year = 2000 + yearValue

        month = f"{monthValue:02d}"

        day = f"{dayValue:02d}"


        tableName = (
            f"ocvcell_inventory_data_{year}_{month}_{day}"
        )


        print(
            "TABLE :",
            tableName
        )


        # -----------------------------------
        # ENSURE TABLE
        # -----------------------------------

        ensure_table(
            dst_cursor,
            tableName
        )


        capacity_val = extract_capacity(
            row.cell_capacity
        )


        # =================================================
        # SQL PROCESS
        # =================================================

        try:

            dst_cursor.execute(
                f"""
                SELECT cellqr
                FROM {tableName}
                WHERE cellqr=?
                """,
                qr
            )

            exists = dst_cursor.fetchone()


            # -----------------------------------
            # UPDATE EXISTING SQL RECORD
            # -----------------------------------

            if exists:

                dst_cursor.execute(
                    f"""
                    UPDATE {tableName}
                    SET
                        voltage=?,
                        ir=?,
                        class_grade=?,
                        capacity=?,
                        k_value=?,
                        ocv_mc_no=?,
                        first_para_time=?,
                        last_para_time=?,
                        batch=?,
                        plant_code=?
                    WHERE cellqr=?
                    """,
                    (
                        safe(row.voltage),
                        safe(row.ir),
                        safe(row.cell_class),
                        capacity_val,
                        safe(row.kvalue),
                        safe(row.machine_location),
                        row.today_date,
                        row.today_date,
                        dateCode,
                        code12_13,
                        qr
                    )
                )

                print(
                    "UPDATED :",
                    qr
                )


            # -----------------------------------
            # INSERT NEW SQL RECORD
            # -----------------------------------

            else:

                dst_cursor.execute(
                    f"""
                    INSERT INTO {tableName}
                    (
                        cellqr,
                        voltage,
                        ir,
                        class_grade,
                        capacity,
                        thickness,
                        k_value,
                        negative_voltage,
                        cell_status,
                        ocv_mc_no,
                        first_para_time,
                        last_para_time,
                        laser_status,
                        batch,
                        plant_code
                    )
                    VALUES
                    (
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        NULL,
                        ?,
                        NULL,
                        'OK',
                        ?,
                        ?,
                        ?,
                        NULL,
                        ?,
                        ?
                    )
                    """,
                    (
                        qr,
                        safe(row.voltage),
                        safe(row.ir),
                        safe(row.cell_class),
                        capacity_val,
                        safe(row.kvalue),
                        safe(row.machine_location),
                        row.today_date,
                        row.today_date,
                        dateCode,
                        code12_13
                    )
                )

                print(
                    "INSERTED :",
                    qr
                )


            # -----------------------------------
            # SQL COMMIT
            # -----------------------------------

            dst_conn.commit()

            sql_success = True

            print(
                "SQL SUCCESS :",
                qr
            )


        except Exception as sql_error:

            # -----------------------------------
            # SQL FAILED
            # -----------------------------------

            print(
                "SQL FAILED :",
                sql_error
            )

            try:

                dst_conn.rollback()

            except Exception as rollback_error:

                print(
                    "SQL ROLLBACK FAILED :",
                    rollback_error
                )

            # IMPORTANT:
            #
            # DO NOT RETURN HERE.
            #
            # Redis MUST be attempted even
            # when SQL has failed.

            sql_success = False


        # =================================================
        # REDIS PROCESS
        # =================================================

        try:

            redis_payload = {
                "cellqr": qr,
                "voltage": safe(row.voltage),
                "ir": safe(row.ir),
                "class_grade": safe(row.cell_class),
                "capacity": capacity_val,
                "k_value": safe(row.kvalue),
                "ocv_mc_no": safe(row.machine_location),
                "first_para_time": str(row.today_date),
                "last_para_time": str(row.today_date),
                "batch": dateCode,
                "plant_code": code12_13
            }


            # -----------------------------------
            # REDIS INSERT
            # -----------------------------------

            r.setex(
                f"cell:{qr}",
                DUPLICATE_TTL_SECONDS,
                json.dumps(redis_payload)
            )


            redis_success = True

            print(
                "REDIS SUCCESS :",
                redis_payload
            )


        except Exception as redis_error:

            # -----------------------------------
            # REDIS FAILED
            # -----------------------------------

            print(
                "REDIS FAILED :",
                redis_error
            )

            redis_success = False


        # =================================================
        # FINAL RESULT
        # =================================================

        # -----------------------------------
        # CASE 1
        # SQL SUCCESS + REDIS SUCCESS
        # -----------------------------------

        if sql_success and redis_success:

            print(
                "SQL + REDIS SUCCESS :",
                qr
            )

            try:

                src_cursor.execute("""
                DELETE FROM taco_treceability.ocv_machine_data_mirror
                WHERE cell_qrcode=?
                """, qr)

                src_conn.commit()

                print(
                    "SOURCE DELETED :",
                    qr
                )

            except Exception as delete_error:

                print(
                    "DELETE FAILED :",
                    delete_error
                )

                try:
                    src_conn.rollback()
                except Exception as rollback_error:
                    print(
                        "DELETE ROLLBACK FAILED :",
                        rollback_error
                    )

            return


        # -----------------------------------
        # CASE 2
        # SQL FAILED + REDIS SUCCESS
        # -----------------------------------

        if not sql_success and redis_success:

            print(
                "SQL FAILED + REDIS SUCCESS :",
                qr
            )

            print(
                "INSERTING FAILED SQL DATA INTO REJECTION :",
                qr
            )

            rejection_result = handle_failure(
                src_conn,
                row
            )

            if rejection_result:

                print(
                    "SQL FAILED DATA MOVED TO REJECTION :",
                    qr
                )

            else:

                print(
                    "SQL FAILED DATA KEPT IN MIRROR :",
                    qr
                )

            return


        # -----------------------------------
        # CASE 3
        # SQL SUCCESS + REDIS FAILED
        # -----------------------------------

        if sql_success and not redis_success:

            print(
                "SQL SUCCESS + REDIS FAILED :",
                qr
            )

            print(
                "INSERTING REDIS FAILED DATA INTO REJECTION :",
                qr
            )

            rejection_result = handle_failure(
                src_conn,
                row
            )

            if rejection_result:

                print(
                    "REDIS FAILED DATA MOVED TO REJECTION :",
                    qr
                )

            else:

                print(
                    "REDIS FAILED DATA KEPT IN MIRROR :",
                    qr
                )

            return


        # -----------------------------------
        # CASE 4
        # SQL FAILED + REDIS FAILED
        # -----------------------------------

        if not sql_success and not redis_success:

            print(
                "SQL FAILED + REDIS FAILED :",
                qr
            )

            print(
                "BOTH FAILED - INSERTING INTO REJECTION :",
                qr
            )

            rejection_result = handle_failure(
                src_conn,
                row
            )

            if rejection_result:

                print(
                    "BOTH FAILED - DATA MOVED TO REJECTION :",
                    qr
                )

            else:

                print(
                    "BOTH FAILED - SOURCE KEPT IN MIRROR :",
                    qr
                )

            return


    # =================================================
    # OUTER PROCESS ERROR
    # =================================================

    except Exception as e:

        print(
            "PROCESS ERROR :",
            e
        )

        # -----------------------------------
        # IMPORTANT
        # -----------------------------------
        #
        # If an unexpected error occurs after
        # obtaining the source row, attempt to
        # move it to rejection.
        #
        # Mirror is deleted ONLY if rejection
        # insertion + acknowledgement succeeds.

        if row:

            try:

                handle_failure(
                    src_conn,
                    row
                )

            except Exception as failure_error:

                print(
                    "FAILURE HANDLER ERROR :",
                    failure_error
                )

        return


# -----------------------------------
# MAIN LOOP
# -----------------------------------

def start():

    src_conn = connect_db(
        sqlConfig1
    )

    dst_conn = connect_db(
        sqlConfig2
    )

    print(
        "SYSTEM STARTED"
    )


    while True:

        try:

            process_record(
                src_conn,
                dst_conn
            )


        except Exception as main_error:

            print(
                "MAIN LOOP ERROR :",
                main_error
            )

            # -----------------------------------
            # RECONNECT DATABASES
            # -----------------------------------

            try:

                src_conn = connect_db(
                    sqlConfig1
                )

                dst_conn = connect_db(
                    sqlConfig2
                )

                print(
                    "DB RECONNECTED"
                )

            except Exception as reconnect_error:

                print(
                    "RECONNECT FAILED :",
                    reconnect_error
                )


        time.sleep(0.1)


# -----------------------------------
# START
# -----------------------------------

start()
