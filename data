import asyncio

# ============================================================
# TCP SERVER CONFIGURATION
# ============================================================

HOST = "0.0.0.0"
PORT = 5391


# ============================================================
# HANDLE TCP CLIENT
# ============================================================

async def handle_client(reader, writer):

    client_address = writer.get_extra_info("peername")

    print("")
    print("================================================")
    print("✅ TCP CLIENT CONNECTED")
    print("================================================")
    print(f"Client : {client_address}")
    print("================================================")

    try:

        while True:

            data = await reader.read(1024)

            if not data:
                print(
                    f"❌ Client disconnected : {client_address}"
                )
                break

            message = data.decode("utf-8").strip()

            print("")
            print("📥 DATA RECEIVED")
            print("----------------")
            print(f"Message : {message}")

            # Send response to Node.js client
            response = f"SERVER RECEIVED: {message}\n"

            writer.write(response.encode("utf-8"))

            await writer.drain()

            print(
                f"📤 RESPONSE SENT : {response.strip()}"
            )

    except Exception as e:

        print("")
        print("❌ CLIENT ERROR")
        print(f"Error : {e}")

    finally:

        writer.close()

        await writer.wait_closed()

        print("")
        print("================================================")
        print("🔌 TCP CLIENT CONNECTION CLOSED")
        print("================================================")


# ============================================================
# START TCP SERVER
# ============================================================

async def main():

    print("")
    print("================================================")
    print("🚀 TCP SERVER STARTING")
    print("================================================")
    print(f"Host : {HOST}")
    print(f"Port : {PORT}")
    print("================================================")

    server = await asyncio.start_server(
        handle_client,
        HOST,
        PORT
    )

    print("")
    print("================================================")
    print("✅ TCP SERVER CREATED SUCCESSFULLY")
    print("================================================")
    print(f"Listening : {HOST}:{PORT}")
    print("Waiting for clients...")
    print("================================================")
    print("")

    async with server:

        await server.serve_forever()


# ============================================================
# RUN SERVER
# ============================================================

if __name__ == "__main__":

    try:
        asyncio.run(main())

    except KeyboardInterrupt:

        print("")
        print("🛑 TCP SERVER STOPPED")
