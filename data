SELECT TOP 100
    CaptureTimestamp,
    DatabaseName,
    LastExecutionTime,
    TotalCPUMs,
    TotalElapsedMs,
    ExecutionCount,
    LogicalReads,
    PhysicalReads,
    LogicalWrites,
    QueryText
FROM SQLMonitoringDB.dbo.SQLQueryExecutionLogs
ORDER BY LogID DESC;
