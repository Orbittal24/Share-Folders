
"use strict";

const sql = require("mssql");

// ======================================================
// SQL SERVER CONFIGURATION
// ======================================================

const sqlConfig = {
    user: "user_mis",
    password: "admin@123", // Use your approved SQL password
    server: "10.9.4.29",
    database: "SQLMonitoringDB",

    options: {
        instanceName: "PROD_SQL_2026",
        encrypt: false,
        trustServerCertificate: true
    },

    pool: {
        max: 3,
        min: 0,
        idleTimeoutMillis: 30000
    },

    connectionTimeout: 15000,
    requestTimeout: 60000
};

const INTERVAL_MS = 60 * 1000;

let pool = null;
let isRunning = false;
let isStopping = false;
let timer = null;

// ======================================================
// CAPTURE TOP 10 QUERIES BY CUMULATIVE CPU
// ======================================================

const captureSQL = `
;WITH RecentQueries AS
(
    SELECT
        qs.sql_handle,
        qs.plan_handle,
        qs.statement_start_offset,
        qs.statement_end_offset,
        qs.execution_count,
        qs.total_worker_time / 1000 AS total_cpu_ms,
        qs.total_elapsed_time / 1000 AS total_elapsed_ms,
        qs.total_logical_reads AS logical_reads,
        qs.total_physical_reads AS physical_reads,
        qs.total_logical_writes AS logical_writes,
        qs.last_execution_time,
        st.dbid,
        st.text AS query_text,
        pa.database_id AS plan_database_id

    FROM sys.dm_exec_query_stats AS qs

    CROSS APPLY sys.dm_exec_sql_text(qs.sql_handle) AS st

    OUTER APPLY
    (
        SELECT TOP (1)
            TRY_CONVERT(INT, p.value) AS database_id
        FROM sys.dm_exec_plan_attributes(qs.plan_handle) AS p
        WHERE p.attribute = 'dbid'
    ) AS pa

    WHERE qs.last_execution_time >=
          DATEADD(MINUTE, -1, GETDATE())
)
INSERT INTO SQLMonitoringDB.dbo.SQLQueryExecutionLogs
(
    CaptureTimestamp,
    DatabaseName,
    QueryText,
    LastExecutionTime,
    ExecutionCount,
    TotalCPUMs,
    TotalElapsedMs,
    LogicalReads,
    PhysicalReads,
    LogicalWrites
)
SELECT TOP (10)
    SYSDATETIME(),

    COALESCE(
        DB_NAME(q.dbid),
        DB_NAME(q.plan_database_id)
    ),

    CASE
        WHEN q.query_text IS NULL THEN NULL

        WHEN q.statement_start_offset < 0
            THEN q.query_text

        ELSE SUBSTRING
        (
            q.query_text,
            (q.statement_start_offset / 2) + 1,

            (
                CASE
                    WHEN q.statement_end_offset = -1
                        THEN DATALENGTH(q.query_text)
                    ELSE q.statement_end_offset
                END
                - q.statement_start_offset
            ) / 2
        )
    END,

    q.last_execution_time,
    q.execution_count,
    q.total_cpu_ms,
    q.total_elapsed_ms,
    q.logical_reads,
    q.physical_reads,
    q.logical_writes

FROM RecentQueries AS q

ORDER BY q.total_cpu_ms DESC;
`;

// ======================================================
// GET OR CREATE CONNECTION
// ======================================================

async function getConnection() {
    if (pool && pool.connected) {
        return pool;
    }

    if (pool) {
        await pool.close().catch(() => {});
        pool = null;
    }

    console.log(
        new Date().toISOString(),
        "| Connecting to SQL Server..."
    );

    const newPool = new sql.ConnectionPool(sqlConfig);

    newPool.on("error", (err) => {
        console.error(
            new Date().toISOString(),
            "| Connection pool error:",
            err.message
        );
    });

    pool = await newPool.connect();

    console.log("SQL Server connection successful.");

    return pool;
}

// ======================================================
// CAPTURE LOGS
// ======================================================

async function captureQueryLogs() {
    if (isRunning || isStopping) {
        return;
    }

    isRunning = true;

    try {
        console.log(
            new Date().toISOString(),
            "| Capturing Top 10 query statistics..."
        );

        const connection = await getConnection();

        const result = await connection.request().query(captureSQL);

        const inserted = (result.rowsAffected || [])
            .reduce((sum, count) => sum + count, 0);

        console.log(
            new Date().toISOString(),
            "| Capture successful | Rows inserted:",
            inserted
        );

    } catch (err) {
        console.error(
            new Date().toISOString(),
            "| Capture failed:",
            err.message
        );

        if (pool) {
            await pool.close().catch(() => {});
            pool = null;
        }

    } finally {
        isRunning = false;
    }
}

// ======================================================
// START LOGGER
// ======================================================

async function startLogger() {
    console.log("==============================================");
    console.log("SQL QUERY CONSUMPTION LOGGER STARTED");
    console.log("Server        : 10.9.4.29");
    console.log("Instance      : PROD_SQL_2026");
    console.log("Logging DB    : SQLMonitoringDB");
    console.log("Capture limit : Top 10");
    console.log("Interval      : 60 seconds");
    console.log("==============================================");

    // Run first capture immediately.
    await captureQueryLogs();

    if (!isStopping) {
        timer = setInterval(() => {
            captureQueryLogs().catch((err) => {
                console.error(
                    "Unexpected capture error:",
                    err.message
                );
            });
        }, INTERVAL_MS);

        console.log("Logger is running. Press Ctrl+C to stop.");
    }
}

// ======================================================
// GRACEFUL SHUTDOWN
// ======================================================

async function shutdown() {
    if (isStopping) {
        return;
    }

    isStopping = true;

    console.log("\nStopping SQL query logger...");

    if (timer) {
        clearInterval(timer);
        timer = null;
    }

    while (isRunning) {
        await new Promise((resolve) => setTimeout(resolve, 200));
    }

    if (pool) {
        await pool.close().catch(() => {});
        pool = null;
    }

    console.log("SQL query logger stopped.");
}

process.once("SIGINT", shutdown);
process.once("SIGTERM", shutdown);

// ======================================================
// EXECUTE LOGGER
// ======================================================

startLogger().catch((err) => {
    console.error("Logger startup failed:", err.message);
    process.exitCode = 1;
});
