// ===========================================================================
// HEALTH / STATUS FILE
// ===========================================================================
const health = {
    startedAt: new Date(),
    opcuaConnected: false,
    cellsSent: 0,
    lastCellAt: null,
    lastAckAt: null,
    lastError: null,
};

function noteError(msg) { health.lastError = { at: Date.now(), msg: msg }; }

function fmtTime(d) {
    if (!d) return "-";
    const p = (n) => String(n).padStart(2, "0");
    return `${p(d.getDate())}-${p(d.getMonth() + 1)}-${d.getFullYear()} ` +
           `${p(d.getHours())}:${p(d.getMinutes())}:${p(d.getSeconds())}`;
}

function fmtAgo(d) {
    if (!d) return "never";
    const s = Math.floor((Date.now() - d.getTime()) / 1000);
    if (s < 60) return `${s} seconds ago`;
    if (s < 3600) return `${Math.floor(s / 60)} minutes ago`;
    return `${Math.floor(s / 3600)}h ${Math.floor((s % 3600) / 60)}m ago`;
}

function overallStatus(queued) {
    if (!health.opcuaConnected) return ["FAULT", "Not connected to the machine"];
    if (dbWriteError) return ["FAULT", "Cannot save data to database"];
    if (queued < 0) return ["FAULT", "Cannot read the database"];
    if (queued > BACKLOG_FAULT) return ["FAULT", "Data is not reaching MES, backlog is large"];
    if (queued > BACKLOG_WARN) return ["WARNING", "Backlog is building up"];
    if (health.lastError && Date.now() - health.lastError.at < 120000)
        return ["WARNING", health.lastError.msg];
    return ["OK", "Normal"];
}

function writeStatus() {
    const queued = queueDepth();
    const [state, detail] = overallStatus(queued);
    const upSec = Math.floor((Date.now() - health.startedAt.getTime()) / 1000);
    const uptime = `${Math.floor(upSec / 3600)}h ${Math.floor((upSec % 3600) / 60)}m`;

    const text =
`==================================================
     MES CELL DATA SERVICE - ${LINE_NAME}
==================================================

  OVERALL           : ${state}
  Detail            : ${detail}

  Checked at        : ${fmtTime(new Date())}
  Service running   : ${uptime}  (since ${fmtTime(health.startedAt)})

  Machine (OPC UA)  : ${health.opcuaConnected ? "CONNECTED" : "NOT CONNECTED"}
  Last cell read    : ${fmtAgo(health.lastCellAt)}
  Last sent to MES  : ${fmtAgo(health.lastAckAt)}

  New cells         : ${counts.inserted}      (this session)
  Updated cells     : ${counts.updated}      (same cell, new values)
  Repeat reads      : ${counts.repeats}      (unchanged - ignored)
  Cells sent        : ${health.cellsSent}      (this session)
  Waiting to send   : ${queued}

  History kept      : ${RETENTION_DAYS > 0 ? RETENTION_DAYS + " days" : "forever"}
  Last cleanup      : ${lastPurgeAt ? fmtAgo(lastPurgeAt) + " (" + lastPurgeCount + " removed)" : "not yet run"}
${DRY_RUN ? "\n  *** TEST MODE - nothing is being sent to MES ***\n" : ""}
  Last error        : ${health.lastError ? health.lastError.msg : "(none)"}

--------------------------------------------------
  CALL ORBITTAL SUPPORT IF:
    - OVERALL is not OK, OR
    - this file's "Date modified" in Windows
      Explorer is more than 2 minutes old
==================================================
`;
    try {
        fs.mkdirSync(path.dirname(STATUS_FILE), { recursive: true });
        const tmp = STATUS_FILE + ".tmp";
        fs.writeFileSync(tmp, text, "utf8");
        fs.renameSync(tmp, STATUS_FILE);
    } catch (err) {
        console.error("[status] write failed:", err.message);
    }
}

setInterval(writeStatus, HEARTBEAT_MS);
writeStatus();

if (RETENTION_DAYS > 0) {
    setTimeout(() => purgeOldHistory(), PURGE_START_DELAY_MS);
    setInterval(() => purgeOldHistory(), PURGE_INTERVAL_HOURS * 3600000);
}

// ===========================================================================
// UPLINK
// ===========================================================================
let sendInFlight = false;

function sendOne(row) {
    if (sendInFlight) return;
    sendInFlight = true;

    const payload = {
        cell_qrcode: row.cell_qrcode,
        voltage_val: row.voltage_val,
        ir_val: row.ir_val,
        material: row.material,
    };

    let settled = false;
    const ws = new W3CWebSocket(WS_URL, "echo-protocol");

    const done = (failReason) => {
        if (settled) return;
        settled = true;
        sendInFlight = false;
        if (failReason) {
            try { stmtBumpAttempt.run(failReason, row.id); } catch (_) {}
        }
        try { ws.close(); } catch (e) {}
    };

    const timeout = setTimeout(() => {
        console.error("send timeout, will retry");
        noteError("MES did not respond");
        done("timeout");
    }, SEND_TIMEOUT_MS);

    ws.onopen = () => {
        try {
            ws.send(JSON.stringify(payload));
        } catch (err) {
            console.error("send failed:", err.message);
            noteError("MES connection problem");
            clearTimeout(timeout);
            done("send failed: " + err.message);
        }
    };

    ws.onmessage = (e) => {
        if (confirmSent(row.id, row.history_id)) {
            dbWriteError = null;
            health.cellsSent++;
            health.lastAckAt = new Date();
            console.log(`acked ${row.cell_qrcode} | queue: ${queueDepth()}`);
        }
        clearTimeout(timeout);
        done(null);
    };

    ws.onerror = (err) => {
        console.error("Socket error:", err && err.message);
        noteError("MES connection problem");
        clearTimeout(timeout);
        done("socket error");
    };

    ws.onclose = () => { clearTimeout(timeout); done("closed before ack"); };
}

setInterval(() => {
    let row;
    try { row = stmtNextQueued.get(); }
    catch (err) { dbWriteError = err.message; return; }
    if (!row) return;

    if (DRY_RUN) {
        if (confirmSent(row.id, row.history_id)) {
            health.cellsSent++;
            health.lastAckAt = new Date();
        }
        return;
    }
    sendOne(row);
}, SEND_INTERVAL_MS);

// ===========================================================================
// OPC UA INGEST
// ===========================================================================
async function main() {
    logEvent("START", `${LINE_NAME} pid=${process.pid} dryRun=${DRY_RUN} queued=${queueDepth()} retentionDays=${RETENTION_DAYS}`);

    try {
        const client = OPCUAClient.create({
            endpointMustExist: false,
            connectionStrategy: {
                maxRetry: Infinity,
                initialDelay: 2000,
                maxDelay: 30 * 1000,
            },
        });
        client.on("backoff", () => console.log("retrying connection"));

        await client.connect(ENDPOINT_URL);
        health.opcuaConnected = true;
        logEvent("OPCUA_CONNECTED", ENDPOINT_URL);

        client.on("connection_lost", () => {
            health.opcuaConnected = false;
            noteError("Lost connection to machine");
            logEvent("OPCUA_LOST", null);
            console.error("OPC UA connection lost");
        });
        client.on("connection_reestablished", () => {
            health.opcuaConnected = true;
            logEvent("OPCUA_RECONNECTED", null);
            console.log("OPC UA connection re-established");
        });

        const session = await client.createSession();

        const browseResult = await session.browse("RootFolder");
        console.log(browseResult.references.map((r) => r.browseName.toString()).join("\n"));

        const subscription = await session.createSubscription2({
            requestedPublishingInterval: 1000,
            requestedLifetimeCount: 100,
            requestedMaxKeepAliveCount: 10,
            maxNotificationsPerPublish: 10,
            publishingEnabled: true,
            priority: 10,
        });

        subscription
            .on("started", () => console.log("subscription started - subscriptionId=", subscription.subscriptionId))
            .on("keepalive", () => console.log("keepalive"))
            .on("terminated", () => {
                noteError("Machine data subscription stopped");
                logEvent("SUBSCRIPTION_TERMINATED", null);
                console.error("subscription terminated");
            });

        const parameters = {
            samplingInterval: 100,
            discardOldest: true,
            queueSize: 100,
        };

        const monitoredItems = [];
        for (let i = 0; i < NODES.length; i++) {
            const itemToMonitor = {
                nodeId: `ns=4;s=${NODES[i]}`,
                attributeId: AttributeIds.Value,
            };
            console.log("Node" + (i + 1), itemToMonitor);
            monitoredItems.push(await subscription.monitor(itemToMonitor, parameters, TimestampsToReturn.Both));
        }

        monitoredItems.forEach((req, index) => {
            req.on("changed", (dataValue) => {
                const raw = dataValue.value.value;
                if (!Array.isArray(raw)) {
                    console.error(NODES[index], "unexpected payload:", typeof raw);
                    return;
                }

                const batch = raw.slice(0, 4)
                    .filter((c) => c && typeof c === "object")
                    .map((c) => ({
                        cell_qrcode: c["QR_code"],
                        voltage_val: c["pnVoltage"],
                        ir_val: c["pnResistance"],
                        material: c["haveINT"],
                    }));

                if (batch.length === 0) return;

                const before = counts.inserted + counts.updated;
                if (upsertBatch(batch, NODES[index])) {
                    dbWriteError = null;
                    health.lastCellAt = new Date();
                    const changedNow = (counts.inserted + counts.updated) - before;
                    // Only log when something actually changed, otherwise the
                    // console fills with noise from unchanged republishes.
                    if (changedNow > 0) {
                        console.log(`${NODES[index]}  new/updated: ${changedNow}  queue: ${queueDepth()}`);
                    }
                }
            });
        });

        let running = true;
        const shutdown = async (why) => {
            if (!running) return;
            running = false;
            console.log("shutting down client");
            logEvent("STOP", `${why} | new=${counts.inserted} updated=${counts.updated} repeats=${counts.repeats}`);
            try {
                await subscription.terminate();
                await session.close();
                await client.disconnect();
            } catch (err) {
                console.error("shutdown error:", err.message);
            }
            health.opcuaConnected = false;
            noteError("Service was stopped");
            writeStatus();
            try { db.close(); } catch (_) {}
            console.log("Done");
            process.exit(0);
        };

        process.on("SIGINT", () => shutdown("SIGINT"));
        process.on("SIGTERM", () => shutdown("SIGTERM"));
    } catch (err) {
        console.log("Error !!!", err);
        health.opcuaConnected = false;
        noteError("Service failed to start");
        logEvent("START_FAILED", err.message);
        writeStatus();
        try { db.close(); } catch (_) {}
        process.exit(1);
    }
}

process.on("uncaughtException", (err) => {
    console.error("FATAL:", err);
    noteError("Service crashed: " + err.message);
    try { logEvent("CRASH", err.stack || err.message); writeStatus(); db.close(); } catch (_) {}
    process.exit(1);
});
process.on("unhandledRejection", (err) => {
    console.error("FATAL (promise):", err);
    noteError("Service crashed");
    try { logEvent("CRASH", String(err)); writeStatus(); db.close(); } catch (_) {}
    process.exit(1);
});

main();

