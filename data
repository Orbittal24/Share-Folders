// ============================================================
// IR SCREWING SERVICE RESTART
// HTTPS + SOCKET.IO BACKEND
// ============================================================


// ============================================================
// IMPORT MODULES
// ============================================================

const express = require("express");

const https = require("https");

const fs = require("fs");

const path = require("path");

const { exec } = require("child_process");

const socketio = require("socket.io");


// ============================================================
// EXPRESS APP
// ============================================================

const app = express();


// ============================================================
// PORT
// ============================================================

const PORT = 3998;


// ============================================================
// SSL CERTIFICATE
// ============================================================

const sslOptions = {

    key: fs.readFileSync(
        path.join(
            __dirname,
            "certs",
            "server.key"
        )
    ),

    cert: fs.readFileSync(
        path.join(
            __dirname,
            "certs",
            "server.pem"
        )
    )

};


// ============================================================
// CREATE HTTPS SERVER
// ============================================================

const httpsServer = https.createServer(
    sslOptions,
    app
);


// ============================================================
// SOCKET.IO
// SOCKET.IO WILL RUN ON HTTPS SERVER
// ============================================================

const io = socketio(
    httpsServer,
    {
        cors: {

            origin: "*",

            methods: [
                "GET",
                "POST"
            ]

        }
    }
);


// ============================================================
// SERVE STATIC FILES
// ============================================================

app.use(
    express.static(__dirname)
);


// ============================================================
// OCV PAGE
// ============================================================

app.get(
    "/ocv",
    function (req, res) {

        res.sendFile(
            path.join(
                __dirname,
                "ocv.html"
            )
        );

    }
);


// ============================================================
// ROOT PAGE
// REDIRECT TO OCV
// ============================================================

app.get(
    "/",
    function (req, res) {

        res.redirect("/ocv");

    }
);


// ============================================================
// SOCKET.IO CONNECTION
// ============================================================

io.on(
    "connection",
    function (socket) {


        console.log(
            "========================================"
        );

        console.log(
            "HTTPS CLIENT CONNECTED"
        );

        console.log(
            "Socket ID:",
            socket.id
        );

        console.log(
            "========================================"
        );


        // ====================================================
        // EXECUTE COMMAND
        // ====================================================

        socket.on(
            "executeBat",
            function (command, callback) {


                console.log(
                    "========================================"
                );

                console.log(
                    "COMMAND RECEIVED"
                );

                console.log(
                    "========================================"
                );

                console.log(
                    command
                );

                console.log(
                    "========================================"
                );


                // =================================================
                // VALIDATE COMMAND
                // =================================================

                if (
                    typeof command !== "string" ||
                    command.trim() === ""
                ) {

                    console.error(
                        "Invalid command received."
                    );


                    if (callback) {

                        callback({

                            success: false,

                            error:
                                "Invalid command."

                        });

                    }

                    return;

                }


                // =================================================
                // EXECUTE COMMAND
                // =================================================

                exec(
                    command,
                    function (
                        error,
                        stdout,
                        stderr
                    ) {


                        // =========================================
                        // COMMAND FAILED
                        // =========================================

                        if (error) {


                            console.error(
                                "========================================"
                            );

                            console.error(
                                "COMMAND EXECUTION FAILED"
                            );

                            console.error(
                                "========================================"
                            );


                            console.error(
                                "Error:"
                            );

                            console.error(
                                error.message
                            );


                            console.error(
                                "STDERR:"
                            );

                            console.error(
                                stderr
                            );


                            console.error(
                                "STDOUT:"
                            );

                            console.error(
                                stdout
                            );


                            // -------------------------------------
                            // SEND ERROR TO CLIENT
                            // -------------------------------------

                            if (callback) {

                                callback({

                                    success: false,

                                    error:
                                        stderr ||
                                        error.message,

                                    stdout:
                                        stdout || "",

                                    stderr:
                                        stderr || ""

                                });

                            }


                            return;

                        }


                        // =========================================
                        // COMMAND SUCCESS
                        // =========================================

                        console.log(
                            "========================================"
                        );

                        console.log(
                            "COMMAND EXECUTED SUCCESSFULLY"
                        );

                        console.log(
                            "========================================"
                        );


                        console.log(
                            "STDOUT:"
                        );

                        console.log(
                            stdout
                        );


                        if (stderr) {

                            console.log(
                                "STDERR:"
                            );

                            console.log(
                                stderr
                            );

                        }


                        // -------------------------------------
                        // SEND SUCCESS TO CLIENT
                        // -------------------------------------

                        if (callback) {

                            callback({

                                success: true,

                                stdout:
                                    stdout || "",

                                stderr:
                                    stderr || ""

                            });

                        }

                    }
                );

            }
        );


        // ====================================================
        // CLIENT DISCONNECTED
        // ====================================================

        socket.on(
            "disconnect",
            function () {


                console.log(
                    "========================================"
                );

                console.log(
                    "HTTPS CLIENT DISCONNECTED"
                );

                console.log(
                    "Socket ID:",
                    socket.id
                );

                console.log(
                    "========================================"
                );

            }
        );

    }
);


// ============================================================
// HTTPS SERVER ERROR
// ============================================================

httpsServer.on(
    "error",
    function (error) {


        console.error(
            "========================================"
        );

        console.error(
            "HTTPS SERVER ERROR"
        );

        console.error(
            "========================================"
        );


        console.error(
            error
        );


        // ---------------------------------------------
        // PORT ALREADY IN USE
        // ---------------------------------------------

        if (
            error.code === "EADDRINUSE"
        ) {

            console.error(
                `Port ${PORT} is already in use.`
            );

            console.error(
                "Stop the existing Node.js process and try again."
            );

        }

    }
);


// ============================================================
// START HTTPS SERVER
// ============================================================

httpsServer.listen(
    PORT,
    "0.0.0.0",
    function () {


        console.log(
            "========================================"
        );

        console.log(
            "IR SCREWING SERVICE RESTART SERVER"
        );

        console.log(
            "========================================"
        );

        console.log(
            "HTTPS SERVER STARTED"
        );

        console.log(
            `Port: ${PORT}`
        );

        console.log(
            `Local URL: https://localhost:${PORT}/ocv`
        );

        console.log(
            `Network URL: https://<SERVER-IP>:${PORT}/ocv`
        );

        console.log(
            "========================================"
        );

        console.log(
            "Socket.IO running over HTTPS"
        );

        console.log(
            "========================================"
        );

    }
);
