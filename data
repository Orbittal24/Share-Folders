USE taco_treceability;
GO

SET NOCOUNT ON;

BEGIN TRY

    SET IDENTITY_INSERT dbo.ocv_machine_data_mirror ON;

    INSERT INTO dbo.ocv_machine_data_mirror
    (
        sr_no,
        cell_qrcode,
        voltage,
        ir,
        today_date,
        updated_time,
        machine_location,
        shift,
        used_on_line,
        kvalue,
        grade,
        cell_capacity,
        cell_class
    )
    SELECT
        sr_no,
        cell_qrcode,
        voltage,
        ir,
        today_date,
        updated_time,
        machine_location,
        shift,
        used_on_line,
        kvalue,
        grade,
        cell_capacity,
        cell_class
    FROM dbo.ocv_machine_data
    WHERE machine_location = 'line7_line8'
      AND today_date >= '2026-11-14'
      AND today_date < '2026-11-15';

    SET IDENTITY_INSERT dbo.ocv_machine_data_mirror OFF;

    PRINT 'Data copied successfully';

END TRY
BEGIN CATCH

    SET IDENTITY_INSERT dbo.ocv_machine_data_mirror OFF;

    PRINT 'ERROR: ' + ERROR_MESSAGE();

END CATCH;
GO
