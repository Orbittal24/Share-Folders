<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Pack Module Barcode Checker</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
            background: #f4f6f9;
            color: #222;
        }

        .container {
            width: 95%;
            max-width: 1200px;
            margin: 30px auto;
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 3px 15px rgba(0, 0, 0, 0.1);
        }

        h1 {
            margin-top: 0;
            text-align: center;
            color: #1f4e78;
        }

        .form-row {
            display: flex;
            gap: 20px;
            align-items: flex-start;
            margin-top: 25px;
        }

        .form-group {
            flex: 1;
            position: relative;
        }

        label {
            display: block;
            font-weight: bold;
            margin-bottom: 8px;
        }

        input,
        select,
        button {
            width: 100%;
            height: 42px;
            padding: 8px 12px;
            font-size: 15px;
            border-radius: 5px;
            border: 1px solid #bbb;
        }

        input:focus,
        select:focus {
            outline: none;
            border-color: #1f4e78;
        }

        .error {
            color: #d60000;
            font-size: 13px;
            margin-top: 5px;
            min-height: 18px;
        }

        .button-container {
            width: 120px;
            margin-top: 25px;
        }

        button {
            border: none;
            background: #1f4e78;
            color: white;
            font-weight: bold;
            cursor: pointer;
        }

        button:hover {
            background: #163b5c;
        }

        button:disabled {
            background: #999;
            cursor: not-allowed;
        }

        .message {
            margin-top: 20px;
            padding: 12px;
            border-radius: 5px;
            display: none;
        }

        .success {
            background: #dff5e1;
            color: #146c2e;
            border: 1px solid #9ad5a5;
        }

        .failure {
            background: #ffe0e0;
            color: #a00000;
            border: 1px solid #e0a0a0;
        }

        .info {
            background: #e5f1ff;
            color: #13558a;
            border: 1px solid #9cc7ee;
        }

        .results {
            margin-top: 30px;
        }

        .results-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
        }

        .results-header h2 {
            margin: 0;
            color: #1f4e78;
        }

        .table-container {
            overflow-x: auto;
            border: 1px solid #ddd;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 900px;
        }

        th,
        td {
            padding: 10px;
            border: 1px solid #ddd;
            text-align: left;
        }

        th {
            background: #1f4e78;
            color: white;
        }

        tr:nth-child(even) {
            background: #f7f7f7;
        }

        .changed {
            color: #008000;
            font-weight: bold;
        }

        .no-data {
            text-align: center;
            padding: 20px;
            color: #777;
        }

        .loading {
            display: none;
            text-align: center;
            margin-top: 15px;
            font-weight: bold;
            color: #1f4e78;
        }

        .pack-info {
            display: flex;
            gap: 20px;
            margin-top: 20px;
            padding: 15px;
            background: #f1f5f9;
            border-radius: 6px;
        }

        .pack-info div {
            flex: 1;
        }

        .pack-info span {
            font-weight: bold;
            color: #1f4e78;
        }

        @media (max-width: 700px) {
            .form-row {
                flex-direction: column;
            }

            .button-container {
                width: 100%;
                margin-top: 0;
            }

            .pack-info {
                flex-direction: column;
                gap: 8px;
            }
        }
    </style>
</head>

<body>

<div class="container">

    <h1>Pack Module Barcode Checker</h1>

    <div class="form-row">

        <!-- PACK NO -->
        <div class="form-group">

            <label for="packNo">
                Pack No <span style="color:red">*</span>
            </label>

            <input
                type="text"
                id="packNo"
                maxlength="6"
                inputmode="numeric"
                placeholder="Enter 6 digit Pack No"
                autocomplete="off"
            >

            <div id="packNoError" class="error"></div>

        </div>


        <!-- PACK NAME -->
        <div class="form-group">

            <label for="packName">
                Pack Name <span style="color:red">*</span>
            </label>

            <select id="packName">
                <option value="">Loading Pack Names...</option>
            </select>

            <div id="packNameError" class="error"></div>

        </div>


        <!-- OK BUTTON -->
        <div class="button-container">

            <button id="okButton" onclick="processPack()">
                OK
            </button>

        </div>

    </div>


    <div id="loading" class="loading">
        Processing... Please wait.
    </div>


    <div id="message" class="message"></div>


    <!-- PACK INFORMATION -->

    <div id="packInfo" class="pack-info" style="display:none;">

        <div>
            Pack ID:
            <span id="displayPackId"></span>
        </div>

        <div>
            Line ID:
            <span id="displayLineId"></span>
        </div>

        <div>
            Line No:
            <span id="displayLineNo"></span>
        </div>

        <div>
            Pack Creation Date:
            <span id="displayCreationDate"></span>
        </div>

    </div>


    <!-- RESULTS -->

    <div class="results">

        <div class="results-header">
            <h2>Module Barcode Results</h2>
        </div>

        <div class="table-container">

            <table>

                <thead>
                    <tr>
                        <th>#</th>
                        <th>History Table</th>
                        <th>Module Barcode</th>
                        <th>Modified Barcode</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody id="resultsBody">

                    <tr>
                        <td colspan="5" class="no-data">
                            No data available
                        </td>
                    </tr>

                </tbody>

            </table>

        </div>

    </div>

</div>


<script>

    const API_BASE = "";


    // ============================================================
    // LOAD PACK NAMES
    // ============================================================

    async function loadPackNames() {

        const select = document.getElementById("packName");

        try {

            const response = await fetch(
                `${API_BASE}/api/pack-names`
            );

            const result = await response.json();

            if (!response.ok) {
                throw new Error(result.message || "Failed to load Pack Names");
            }

            select.innerHTML =
                `<option value="">Select Pack Name</option>`;

            result.data.forEach(pack => {

                const option = document.createElement("option");

                option.value = pack.Pack_ID;

                option.textContent = pack.Pack_Name;

                option.dataset.totalModules =
                    pack.Total_Module_Count;

                select.appendChild(option);

            });

        } catch (error) {

            console.error(error);

            select.innerHTML =
                `<option value="">Failed to load Pack Names</option>`;

            showMessage(
                "Failed to load Pack Names. Please check backend/database connection.",
                "failure"
            );
        }
    }


    // ============================================================
    // PACK NUMBER VALIDATION
    // ============================================================

    document
        .getElementById("packNo")
        .addEventListener("input", function () {

            // Only numbers
            this.value = this.value.replace(/\D/g, "");

            const error =
                document.getElementById("packNoError");

            if (this.value.length === 0) {

                error.textContent = "";

            } else if (this.value.length < 6) {

                error.textContent =
                    "Pack No must contain exactly 6 digits.";

            } else {

                error.textContent = "";
            }

        });


    // ============================================================
    // PACK NAME CHANGE
    // ============================================================

    document
        .getElementById("packName")
        .addEventListener("change", function () {

            document.getElementById("packNameError").textContent = "";

        });


    // ============================================================
    // PROCESS PACK
    // ============================================================

    async function processPack() {

        const packNo =
            document.getElementById("packNo").value.trim();

        const packSelect =
            document.getElementById("packName");

        const packId =
            packSelect.value;

        const packName =
            packSelect.options[packSelect.selectedIndex]?.text || "";


        // --------------------------------------------------------
        // VALIDATION
        // --------------------------------------------------------

        let valid = true;


        if (!/^\d{6}$/.test(packNo)) {

            document.getElementById("packNoError").textContent =
                "Pack No must contain exactly 6 digits.";

            valid = false;

        } else {

            document.getElementById("packNoError").textContent = "";
        }


        if (!packId) {

            document.getElementById("packNameError").textContent =
                "Please select a Pack Name.";

            valid = false;

        } else {

            document.getElementById("packNameError").textContent = "";
        }


        if (!valid) {
            return;
        }


        // --------------------------------------------------------
        // UI
        // --------------------------------------------------------

        const button =
            document.getElementById("okButton");

        const loading =
            document.getElementById("loading");

        button.disabled = true;

        loading.style.display = "block";

        hideMessage();

        document.getElementById("packInfo").style.display = "none";

        document.getElementById("resultsBody").innerHTML =
            `<tr>
                <td colspan="5" class="no-data">
                    Processing...
                </td>
            </tr>`;


        try {

            const response = await fetch(
                `${API_BASE}/api/process-pack`,
                {
                    method: "POST",

                    headers: {
                        "Content-Type": "application/json"
                    },

                    body: JSON.stringify({

                        packNo: packNo,

                        packId: packId,

                        packName: packName

                    })
                }
            );


            const result = await response.json();


            if (!response.ok) {

                throw new Error(
                    result.message || "Processing failed."
                );
            }


            // ----------------------------------------------------
            // SHOW PACK INFORMATION
            // ----------------------------------------------------

            document.getElementById("displayPackId").textContent =
                result.packId || "";

            document.getElementById("displayLineId").textContent =
                result.lineId || "";

            document.getElementById("displayLineNo").textContent =
                result.lineNo || "";

            document.getElementById("displayCreationDate").textContent =
                result.packCreationDate || "";

            document.getElementById("packInfo").style.display =
                "flex";


            // ----------------------------------------------------
            // SHOW RESULTS
            // ----------------------------------------------------

            displayResults(result.records || []);


            showMessage(
                result.message || "Processing completed successfully.",
                "success"
            );


        } catch (error) {

            console.error(error);

            document.getElementById("resultsBody").innerHTML =
                `<tr>
                    <td colspan="5" class="no-data">
                        No data available
                    </td>
                </tr>`;


            showMessage(
                error.message || "Something went wrong.",
                "failure"
            );

        } finally {

            button.disabled = false;

            loading.style.display = "none";
        }
    }


    // ============================================================
    // DISPLAY RESULTS
    // ============================================================

    function displayResults(records) {

        const tbody =
            document.getElementById("resultsBody");


        if (!records || records.length === 0) {

            tbody.innerHTML =
                `<tr>
                    <td colspan="5" class="no-data">
                        No module barcode records found.
                    </td>
                </tr>`;

            return;
        }


        tbody.innerHTML = "";


        records.forEach((record, index) => {

            const row =
                document.createElement("tr");


            const changed =
                record.moduleBarcode !==
                record.modifiedBarcode;


            row.innerHTML = `

                <td>${index + 1}</td>

                <td>${escapeHtml(record.tableName || "")}</td>

                <td>${escapeHtml(record.moduleBarcode || "")}</td>

                <td class="${changed ? "changed" : ""}">
                    ${escapeHtml(record.modifiedBarcode || "")}
                </td>

                <td>
                    ${
                        changed
                        ? "None replaced"
                        : "No None found"
                    }
                </td>

            `;


            tbody.appendChild(row);

        });

    }


    // ============================================================
    // MESSAGE
    // ============================================================

    function showMessage(message, type) {

        const element =
            document.getElementById("message");

        element.textContent = message;

        element.className =
            `message ${type}`;

        element.style.display = "block";
    }


    function hideMessage() {

        const element =
            document.getElementById("message");

        element.style.display = "none";
    }


    // ============================================================
    // HTML ESCAPE
    // ============================================================

    function escapeHtml(value) {

        return String(value)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }


    // ============================================================
    // INITIAL LOAD
    // ============================================================

    loadPackNames();

</script>

</body>
</html>
