# ============================================================
# RECONNECT DATABASE
# ============================================================

def reconnect_db(old_conn, config, name="DB"):

    print(
        f"[{name}] RECONNECT STARTED..."
    )

    close_connection(
        old_conn,
        name
    )

    while True:

        try:

            print(
                f"[{name}] TRYING NEW CONNECTION..."
            )

            new_conn = connect_db(
                config
            )

            if test_connection(new_conn):

                print(
                    f"[{name}] RECONNECTED SUCCESSFULLY."
                )

                return new_conn

            else:

                print(
                    f"[{name}] CONNECTION TEST FAILED."
                )

                close_connection(
                    new_conn,
                    name
                )

        except Exception as e:

            print(
                f"[{name}] RECONNECT FAILED :",
                e
            )

        print(
            f"[{name}] RETRYING IN "
            f"{DB_RECONNECT_DELAY} SECOND(S)..."
        )

        time.sleep(
            DB_RECONNECT_DELAY
        )


