/************************************************************
 * API: UPDATE PASSWORD
 *
 * Database:
 * taco_treceability
 *
 * Table:
 * station_status_ok_universal_password
 *
 * Update:
 *
 * pass_key   = new password
 * today_date = current date/time
 *
 * Existing password is never returned.
 ************************************************************/

app.post("/api/update-password", async (req, res) => {

    try {

        const {
            username,
            newPassword
        } = req.body;


        /****************************************************
         * VALIDATE REQUEST
         ****************************************************/

        if (!username || !newPassword) {

            return res.status(400).json({
                success: false,
                message: "Username and new password are required"
            });

        }


        /****************************************************
         * TRIM USERNAME
         ****************************************************/

        const cleanUsername = String(username).trim();


        /****************************************************
         * PASSWORD AS STRING
         *
         * Do not trim password because spaces can technically
         * be part of a password.
         ****************************************************/

        const passwordValue = String(newPassword);


        /****************************************************
         * CHECK EMPTY PASSWORD
         ****************************************************/

        if (passwordValue.length === 0) {

            return res.status(400).json({
                success: false,
                message: "New password cannot be empty"
            });

        }


        /****************************************************
         * CHECK DATABASE CONNECTION
         ****************************************************/

        if (!dbConn2.connected) {

            console.error(
                "Password update failed: taco_treceability DB not connected"
            );

            return res.status(500).json({
                success: false,
                message: "Database connection unavailable"
            });

        }


        /****************************************************
         * CHECK USERNAME EXISTS
         ****************************************************/

        const userResult = await dbConn2
            .request()
            .input(
                "username",
                sql.VarChar(sql.MAX),
                cleanUsername
            )
            .query(`
                SELECT TOP 1
                    sr_no,
                    username,
                    pass_key,
                    today_date
                FROM taco_treceability.station_status_ok_universal_password
                WHERE username = @username
                ORDER BY sr_no DESC
            `);


        /****************************************************
         * USERNAME NOT FOUND
         ****************************************************/

        if (userResult.recordset.length === 0) {

            console.log(
                "Password update failed. Username not found:",
                cleanUsername
            );

            return res.status(404).json({
                success: false,
                message: "Username not found"
            });

        }


        /****************************************************
         * UPDATE PASSWORD
         ****************************************************/

        const updateResult = await dbConn2
            .request()
            .input(
                "username",
                sql.VarChar(sql.MAX),
                cleanUsername
            )
            .input(
                "pass_key",
                sql.VarChar(sql.MAX),
                passwordValue
            )
            .query(`
                UPDATE taco_treceability.station_status_ok_universal_password
                SET
                    pass_key = @pass_key,
                    today_date = GETDATE()
                WHERE username = @username
            `);


        /****************************************************
         * CHECK UPDATE RESULT
         ****************************************************/

        if (
            !updateResult.rowsAffected ||
            updateResult.rowsAffected[0] === 0
        ) {

            console.error(
                "Password update affected 0 rows:",
                cleanUsername
            );

            return res.status(500).json({
                success: false,
                message: "Password update failed"
            });

        }


        /****************************************************
         * GET UPDATED DATE
         *
         * Password itself is NOT returned.
         ****************************************************/

        const updatedResult = await dbConn2
            .request()
            .input(
                "username",
                sql.VarChar(sql.MAX),
                cleanUsername
            )
            .query(`
                SELECT TOP 1
                    sr_no,
                    username,
                    today_date
                FROM taco_treceability.station_status_ok_universal_password
                WHERE username = @username
                ORDER BY sr_no DESC
            `);


        const updatedRecord =
            updatedResult.recordset.length > 0
                ? updatedResult.recordset[0]
                : null;


        /****************************************************
         * LOG SUCCESS
         ****************************************************/

        console.log(
            "Password updated successfully"
        );

        console.log(
            "Username:",
            cleanUsername
        );

        console.log(
            "Updated Date:",
            updatedRecord?.today_date
        );


        /****************************************************
         * RETURN SUCCESS
         *
         * IMPORTANT:
         * Password is NOT returned.
         ****************************************************/

        return res.json({

            success: true,

            message:
                "Password updated successfully",

            username:
                cleanUsername,

            today_date:
                updatedRecord?.today_date || null

        });


    } catch (err) {

        console.error(
            "Password update error:",
            err
        );

        return res.status(500).json({
            success: false,
            message: "Password update failed"
        });

    }

});


/************************************************************
 * API: VERIFY PASSWORD
 *
 * Password is checked against:
 *
 * taco_treceability.station_status_ok_universal_password
 *
 * Columns:
 * sr_no
 * username
 * pass_key
 * today_date
 ************************************************************/

app.post("/api/verify-password", async (req, res) => {

    try {

        const { password } = req.body;


        /****************************************************
         * CHECK PASSWORD RECEIVED
         ****************************************************/

        if (!password) {

            return res.status(400).json({
                success: false,
                message: "Password required"
            });

        }


        /****************************************************
         * CHECK DATABASE CONNECTION
         ****************************************************/

        if (!dbConn2.connected) {

            console.error(
                "Password verification failed: taco_treceability DB not connected"
            );

            return res.status(500).json({
                success: false,
                message: "Database connection unavailable"
            });

        }


        /****************************************************
         * CHECK PASSWORD IN DATABASE
         ****************************************************/

        const result = await dbConn2
            .request()
            .input(
                "pass_key",
                sql.VarChar(sql.MAX),
                String(password)
            )
            .query(`
                SELECT TOP 1
                    sr_no,
                    username,
                    pass_key,
                    today_date
                FROM taco_treceability.station_status_ok_universal_password
                WHERE pass_key = @pass_key
                ORDER BY sr_no DESC
            `);


        /****************************************************
         * INVALID PASSWORD
         ****************************************************/

        if (result.recordset.length === 0) {

            console.log(
                "Invalid password entered"
            );

            return res.status(401).json({
                success: false,
                message: "Invalid Password"
            });

        }


        /****************************************************
         * GET USERNAME FROM DATABASE
         ****************************************************/

        const username = result.recordset[0].username;


        console.log(
            "Password verified successfully"
        );

        console.log(
            "Authenticated Username:",
            username
        );


        /****************************************************
         * RETURN USERNAME TO FRONTEND
         ****************************************************/

        return res.json({
            success: true,
            username: username
        });


    } catch (err) {

        console.error(
            "Password verification error:",
            err
        );

        return res.status(500).json({
            success: false,
            message: "Password verification failed"
        });

    }

});


/************************************************************
 * API: BARCODE SCAN
 ************************************************************/

app.post("/api/scan", async (req, res) => {

    try {

        const {
            stationId,
            line,
            barcode,
            username
        } = req.body;


        /****************************************************
         * VALIDATE REQUEST
         ****************************************************/

        if (!stationId || !barcode || !username) {

            return res.status(400).json({
                message:
                    "Station, barcode & username required"
            });

        }


        /****************************************************
         * LOG SCAN RECEIVED
         ****************************************************/

        console.log(
            "\n=========== SCAN RECEIVED ==========="
        );

        console.log(
            "Station ID:",
            stationId
        );

        console.log(
            "Line:",
            line
        );

        console.log(
            "Barcode:",
            barcode
        );

        console.log(
            "Username:",
            username
        );

        console.log(
            "====================================="
        );


        /********************************************************
         * GET STATION NAME FROM MASTER DATABASE
         *
         * MASTER DB:
         * taco_treceability_master
         ********************************************************/

        let stationName = null;

        try {

            const stationResult = await dbConn
                .request()
                .input(
                    "station_id",
                    sql.Int,
                    parseInt(stationId)
                )
                .query(`
                    SELECT TOP 1
                        Station_ID,
                        Station_Name,
                        category
                    FROM taco_treceability.master_station
                    WHERE Station_ID = @station_id
                `);


            if (
                !stationResult.recordset ||
                stationResult.recordset.length === 0
            ) {

                console.error(
                    "Station not found in master_station:",
                    stationId
                );

                return res.status(400).json({
                    message:
                        "Station not found in master_station"
                });

            }


            stationName =
                stationResult.recordset[0].Station_Name;


            console.log(
                "Station Name:",
                stationName
            );


        } catch (stationErr) {

            console.error(
                "Station lookup error:",
                stationErr
            );

            return res.status(500).json({
                message:
                    "Station lookup failed"
            });

        }


        /********************************************************
         * INSERT LOG INTO SECOND DATABASE
         *
         * DATABASE:
         * taco_treceability
         *
         * IMPORTANT:
         * station_id column receives Station_Name
         * as requested.
         ********************************************************/

        try {

            await dbConn2
                .request()

                .input(
                    "station_name",
                    sql.VarChar(sql.MAX),
                    String(stationName)
                )

                .input(
                    "barcode_string",
                    sql.VarChar(sql.MAX),
                    String(barcode)
                )

                .input(
                    "username",
                    sql.VarChar(sql.MAX),
                    String(username)
                )

                .query(`
                    INSERT INTO taco_treceability.station_status_ok_universal
                    (
                        station_id,
                        barcode_string,
                        username
                    )
                    VALUES
                    (
                        @station_name,
                        @barcode_string,
                        @username
                    )
                `);


            console.log(
                "Log inserted successfully into taco_treceability"
            );


        } catch (logErr) {

            console.error(
                "Log Insert Error:",
                logErr
            );

            return res.status(500).json({
                message: "Log insert failed"
            });

        }


        /********************************************************
         * CALL EXTERNAL API
         ********************************************************/

        const apiPayload = {

            station_id: stationId,

            line_id: line,

            customer_qrcode: barcode,

            station_status: "OK",

            checklist_name: "NA",

            substation_id: "NA"

        };


        try {

            console.log(
                "\nSending Payload To External API:"
            );

            console.log(
                apiPayload
            );


            const apiResponse = await axios.post(

                "https://mismainapp.tataautocomp.com:3241/station_status/filter",

                apiPayload,

                {
                    httpsAgent:
                        new https.Agent({
                            rejectUnauthorized: false
                        }),

                    timeout: 10000
                }

            );


            console.log(
                "\n=========== EXTERNAL API RESPONSE ==========="
            );

            console.log(
                "Status Code:",
                apiResponse.status
            );

            console.log(
                "Status Text:",
                apiResponse.statusText
            );

            console.log(
                "Headers:",
                apiResponse.headers
            );

            console.log(
                "Response Data:",
                apiResponse.data
            );

            console.log(
                "=============================================\n"
            );


            return res.json({

                message:
                    "Barcode processed successfully",

                externalApiStatus:
                    apiResponse.status,

                externalApiResponse:
                    apiResponse.data

            });


        } catch (apiErr) {

            console.log(
                "\n=========== EXTERNAL API ERROR ==========="
            );


            if (apiErr.response) {

                console.log(
                    "Error Status:",
                    apiErr.response.status
                );

                console.log(
                    "Error Headers:",
                    apiErr.response.headers
                );

                console.log(
                    "Error Data:",
                    apiErr.response.data
                );

            } else {

                console.log(
                    "Error Message:",
                    apiErr.message
                );

            }


            console.log(
                "==========================================\n"
            );


            return res.status(500).json({

                message:
                    "External API failed",

                error:
                    apiErr.response?.data ||
                    apiErr.message

            });

        }


    } catch (err) {

        console.error(
            "Scan error:",
            err
        );

        res.status(500).json({
            message: "Scan failed"
        });

    }

});


