const WebSocket = require("ws");

const HOST = "0.0.0.0";
const PORT = 9094;

const clients = new Set();
let clientCounter = 0;

// ======================================================
// HELPER FUNCTIONS
// ======================================================

function getTimestamp() {
    return new Date().toLocaleString("en-IN", {
        timeZone: "Asia/Kolkata",
        hour12: false
    });
}

function log(message) {
    console.log(`[${getTimestamp()}] ${message}`);
}

function separator() {
    console.log("------------------------------------------------------------");
}

// ======================================================
// WEBSOCKET SERVER
// ======================================================

const wss = new WebSocket.Server({
    host: HOST,
    port: PORT
});

// ======================================================
// CLIENT CONNECTED
// ======================================================

wss.on("connection", (socket, request) => {

    clientCounter++;

    const clientId = clientCounter;

    const clientIP =
        request.socket.remoteAddress || "UNKNOWN";

    socket.clientId = clientId;
    socket.clientIP = clientIP;

    clients.add(socket);

    separator();

    log("CLIENT CONNECTED");

    console.log(`  Client ID    : ${clientId}`);
    console.log(`  IP Address   : ${clientIP}`);
    console.log(`  Total Clients: ${clients.size}`);

    separator();

    // ==================================================
    // RECEIVE MESSAGE
    // ==================================================

    socket.on("message", (data, isBinary) => {

        let message;

        if (isBinary) {
            message = data.toString();
        } else {
            message = data.toString();
        }

        separator();

        log("DATA RECEIVED");

        console.log(`  Client ID    : ${clientId}`);
        console.log(`  Client IP    : ${clientIP}`);
        console.log(`  Data Length  : ${data.length} bytes`);

        console.log("");
        console.log("  Message:");
        console.log(message);

        separator();

        // ==================================================
        // BROADCAST
        // ==================================================

        let broadcastCount = 0;

        for (const client of clients) {

            if (
                client !== socket &&
                client.readyState === WebSocket.OPEN
            ) {
                client.send(message);
                broadcastCount++;
            }
        }

        log(`MESSAGE BROADCASTED TO ${broadcastCount} CLIENT(S)`);

        separator();
    });

    // ==================================================
    // CLIENT DISCONNECTED
    // ==================================================

    socket.on("close", () => {

        clients.delete(socket);

        separator();

        log("CLIENT DISCONNECTED");

        console.log(`  Client ID    : ${clientId}`);
        console.log(`  Client IP    : ${clientIP}`);
        console.log(`  Total Clients: ${clients.size}`);

        separator();
    });

    // ==================================================
    // CLIENT ERROR
    // ==================================================

    socket.on("error", (err) => {

        console.error("");

        console.error(
            "============================================================"
        );

        log("CLIENT ERROR");

        console.error(`  Client ID : ${clientId}`);
        console.error(`  Client IP : ${clientIP}`);
        console.error(`  Error     : ${err.message}`);

        console.error(
            "============================================================"
        );

        console.error("");

        clients.delete(socket);
    });

    // ==================================================
    // SEND CONNECTION ACK
    // ==================================================

    socket.send(
        JSON.stringify({
            type: "CONNECTION_ACK",
            status: "CONNECTED",
            client_id: clientId,
            message: "Connected to WebSocket server"
        })
    );
});

// ======================================================
// SERVER ERROR
// ======================================================

wss.on("error", (err) => {

    console.error("");

    console.error(
        "============================================================"
    );

    log("WEBSOCKET SERVER ERROR");

    console.error(`  Error : ${err.message}`);

    console.error(
        "============================================================"
    );

    console.error("");
});

// ======================================================
// SERVER START
// ======================================================

wss.on("listening", () => {

    console.log("");

    console.log(
        "============================================================"
    );

    console.log(
        "              WEBSOCKET SERVER STARTED"
    );

    console.log(
        "============================================================"
    );

    console.log(`  Start Time     : ${getTimestamp()}`);
    console.log(`  Host           : ${HOST}`);
    console.log(`  Port           : ${PORT}`);
    console.log(`  Protocol       : WebSocket`);
    console.log(`  Status         : RUNNING`);
    console.log(`  Active Clients : ${clients.size}`);

    console.log(
        "============================================================"
    );

    console.log("  Waiting for WebSocket clients...");
    console.log(
        "============================================================"
    );

    console.log("");
});
