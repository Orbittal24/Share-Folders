// =====================================================
// VALIDATE TABLE SELECTION
// =====================================================

function getTables(lineTable) {
    const match = /^running_production_count_line([1-9]|1[0-9]|20)$/
        .exec(String(lineTable || ""));

    if (!match) {
        throw new Error(
            "Please select a valid production count table (Line 1-20)."
        );
    }

    const line = Number(match[1]);

    return {
        source: `[running_production_count_line${line}]`,
        target: `[running_production_count_line${line}_backup]`,
        label: `Line ${line}`
    };
}

// =====================================================
// SQL CONNECTION POOL
// =====================================================

async function connectDatabase() {
    if (pool && pool.connected) {
        return pool;
    }

    if (poolPromise) {
        return poolPromise;
    }

    pool = new sql.ConnectionPool(sqlConfig);

    pool.on("error", error => {
        console.error(
            "SQL connection pool error:",
            error.message
        );
    });

    poolPromise = pool.connect()
        .then(connection => {
            console.log("SQL Server connected successfully.");
            console.log(
                "Connected database:",
                sqlConfig.database
            );
            return connection;
        })
        .catch(error => {
            pool = null;
            poolPromise = null;
            throw error;
        });

    return poolPromise;
}

// =====================================================
// INPUT VALIDATION
// =====================================================

function validateFilters(data) {
    const date = String(data?.date || "").trim();
    const mode = data?.mode;
    const tables = getTables(data?.tableName);

    if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) {
        throw new Error("Please select a valid date.");
    }

    const parsedDate = new Date(date + "T00:00:00.000Z");

    if (
        Number.isNaN(parsedDate.getTime()) ||
        parsedDate.toISOString().slice(0, 10) !== date
    ) {
        throw new Error("The selected date is invalid.");
    }

    if (mode !== "date" && mode !== "status") {
        throw new Error("Invalid backup mode.");
    }

    let status = null;

    if (mode === "status") {
        status = String(data?.status || "")
            .trim()
            .toLowerCase();

        if (!["running", "stopped"].includes(status)) {
            throw new Error(
                "Status must be Running or Stopped."
            );
        }
    }

    return {
        date,
        mode,
        status,
        ...tables,
        tableName: data.tableName
    };
}

// =====================================================
// DATE AND STATUS FILTER
//
// Condition 1:
// Filter by current_dateTime.
//
// Condition 2:
// Filter by current_dateTime and pack_status.
//
// The date filter includes the entire selected day,
// including records whose current_dateTime has a time.
// =====================================================

function filterSql(filters) {
    const statusCondition =
        filters.mode === "status"
            ? `
                AND LOWER(
                    LTRIM(
                        RTRIM(
                            CONVERT(VARCHAR(30), [pack_status])
                        )
                    )
                ) = @status
            `
            : "";

    return `
        WHERE [current_dateTime] >= @startDate
          AND [current_dateTime] < DATEADD(
                DAY,
                1,
                @startDate
          )
          ${statusCondition}
    `;
}

function applyFilters(request, filters) {
    request.input(
        "startDate",
        sql.Date,
        filters.date
    );

    if (filters.mode === "status") {
        request.input(
            "status",
            sql.VarChar(30),
            filters.status
        );
    }

    return request;
}

// =====================================================
// SCAN RECORDS
//
// Scan only counts records.
// It does not insert or delete anything.
// =====================================================

async function scanRecords(filters) {
    const db = await connectDatabase();

    const query = `
        SELECT COUNT_BIG(*) AS total
        FROM ${filters.source}
        ${filterSql(filters)};
    `;

    const request = applyFilters(
        db.request(),
        filters
    );

    const result = await request.query(query);

    return result.recordset[0].total.toString();
}

// =====================================================
// SHIFT ONE RECORD
//
// 1. Begin transaction.
// 2. Insert into the matching backup table.
// 3. Verify exactly one inserted row.
// 4. Delete the source row.
// 5. Verify exactly one deleted row.
// 6. Commit.
//
// If any operation fails, roll back the transaction.
// =====================================================

async function shiftOneRecord(db, filters, srNo) {
    const transaction = new sql.Transaction(db);

    await transaction.begin(
        sql.ISOLATION_LEVEL.READ_COMMITTED
    );

    try {
        // ---------------------------------------------
        // STEP 1: INSERT INTO BACKUP TABLE
        // ---------------------------------------------

        const insertRequest = new sql.Request(transaction);

        insertRequest.input(
            "srNo",
            sql.Int,
            srNo
        );

        const insertQuery = `
            INSERT INTO ${filters.target} (
                ${COLUMN_LIST}
            )
            SELECT
                ${COLUMN_LIST}
            FROM ${filters.source}
                WITH (UPDLOCK, ROWLOCK)
            WHERE [sr_no] = @srNo;
        `;

        const insertResult = await insertRequest.query(
            insertQuery
        );

        const insertedRows =
            insertResult.rowsAffected.reduce(
                (sum, count) => sum + count,
                0
            );

        if (insertedRows !== 1) {
            throw new Error(
                `Expected exactly one inserted backup row ` +
                `for sr_no ${srNo}, but got ${insertedRows}.`
            );
        }

        // ---------------------------------------------
        // STEP 2: DELETE FROM SOURCE TABLE
        // Only after the insert has succeeded.
        // ---------------------------------------------

        const deleteRequest = new sql.Request(transaction);

        deleteRequest.input(
            "srNo",
            sql.Int,
            srNo
        );

        const deleteResult = await deleteRequest.query(`
            DELETE FROM ${filters.source}
            WHERE [sr_no] = @srNo;
        `);

        const deletedRows =
            deleteResult.rowsAffected.reduce(
                (sum, count) => sum + count,
                0
            );

        if (deletedRows !== 1) {
            throw new Error(
                `Expected exactly one deleted source row ` +
                `for sr_no ${srNo}, but got ${deletedRows}.`
            );
        }

        // ---------------------------------------------
        // STEP 3: COMMIT BOTH OPERATIONS
        // ---------------------------------------------

        await transaction.commit();

        return true;

    } catch (error) {
        try {
            await transaction.rollback();
        } catch (rollbackError) {
            console.error(
                `Rollback error for sr_no ${srNo}:`,
                rollbackError.message
            );
        }

        throw error;
    }
}

// =====================================================
// SHIFT ALL MATCHING RECORDS
//
// Processes rows sequentially.
// Stops at the first failed record.
// Does not skip the failed record.
// =====================================================

async function shiftRecords(filters, socket) {
    if (backupRunning) {
        throw new Error(
            "Another shift operation is running. Please wait."
        );
    }

    backupRunning = true;

    let total = 0;
    let shifted = 0;
    let failed = 0;
    let failedSrNo = null;
    let lastError = null;

    try {
        const db = await connectDatabase();

        // Select matching source record IDs.
        const selectRequest = applyFilters(
            db.request(),
            filters
        );

        const selected = await selectRequest.query(`
            SELECT [sr_no]
            FROM ${filters.source}
            ${filterSql(filters)}
            ORDER BY [sr_no] ASC;
        `);

        const ids = selected.recordset.map(
            row => row.sr_no
        );

        total = ids.length;

        socket.emit("backup-started", {
            total,
            source: filters.source,
            target: filters.target,
            message: "Shift started."
        });

        // ---------------------------------------------
        // PROCESS RECORDS ONE BY ONE
        // ---------------------------------------------

        for (const srNo of ids) {
            try {
                await shiftOneRecord(
                    db,
                    filters,
                    srNo
                );

                shifted++;

            } catch (error) {
                failed++;
                failedSrNo = srNo;
                lastError = error.message;

                console.error(
                    `Shift failed for sr_no ${srNo}:`,
                    error.message
                );

                socket.emit("backup-progress", {
                    total,
                    shifted,
                    failed,
                    currentSrNo: srNo,
                    error: lastError
                });

                // Stop immediately at the failed record.
                break;
            }

            socket.emit("backup-progress", {
                total,
                shifted,
                failed,
                currentSrNo: srNo,
                error: null
            });
        }

        const response = {
            total,
            shifted,
            failed,
            failedSrNo,
            lastError,
            source: filters.source,
            target: filters.target,

            message: failed
                ? "Shift stopped at the failed record. " +
                  "That record remains in the source table."
                : "Shift completed successfully."
        };

        socket.emit("backup-complete", response);

        return response;

    } finally {
        backupRunning = false;
    }
}

// =====================================================
// HTTP SERVER
// =====================================================

const server = http.createServer((req, res) => {
    let requestPath;

    try {
        requestPath = new URL(
            req.url,
            "http://localhost"
        ).pathname;

    } catch {
        res.writeHead(400);
        return res.end("Invalid request");
    }

    if (
        requestPath !== "/" &&
        requestPath !== "/production_count_ui_newMIS.html"
    ) {
        res.writeHead(404);
        return res.end("Not found");
    }

    fs.readFile(HTML_FILE, (error, content) => {
        if (error) {
            console.error(
                "HTML file error:",
                error.message
            );

            res.writeHead(500);

            return res.end(
                "Unable to load production_count_ui_newMIS.html"
            );
        }

        res.writeHead(200, {
            "Content-Type": "text/html; charset=utf-8",
            "Cache-Control": "no-store"
        });

        res.end(content);
    });
});

// =====================================================
// SOCKET.IO
// =====================================================

const io = new Server(server, {
    maxHttpBufferSize: 1e6
});

io.on("connection", socket => {
    console.log(
        "Frontend connected:",
        socket.id
    );

    socket.emit("connection-status", {
        connected: true,
        message: "Connected to backup server."
    });

    // ---------------------------------------------
    // SCAN BUTTON
    // ---------------------------------------------

    socket.on(
        "scan-records",
        async (data, acknowledge) => {
            try {
                const filters = validateFilters(data);

                const total = await scanRecords(filters);

                const response = {
                    success: true,
                    total,
                    source: filters.source,
                    target: filters.target,
                    message: "Scan completed."
                };

                socket.emit(
                    "scan-result",
                    response
                );

                if (typeof acknowledge === "function") {
                    acknowledge(response);
                }

            } catch (error) {
                console.error(
                    "Scan error:",
                    error.message
                );

                const response = {
                    success: false,
                    message: error.message
                };

                socket.emit(
                    "operation-error",
                    response
                );

                if (typeof acknowledge === "function") {
                    acknowledge(response);
                }
            }
        }
    );

    // ---------------------------------------------
    // SHIFT TO BACKUP BUTTON
    // ---------------------------------------------

    socket.on(
        "shift-backup",
        async (data, acknowledge) => {
            try {
                const filters = validateFilters(data);

                const result = await shiftRecords(
                    filters,
                    socket
                );

                if (typeof acknowledge === "function") {
                    acknowledge({
                        success: true,
                        ...result
                    });
                }

            } catch (error) {
                console.error(
                    "Shift error:",
                    error.message
                );

                const response = {
                    success: false,
                    message: error.message
                };

                socket.emit(
                    "operation-error",
                    response
                );

                if (typeof acknowledge === "function") {
                    acknowledge(response);
                }
            }
        }
    );

    socket.on("disconnect", reason => {
        console.log(
            "Frontend disconnected:",
            socket.id,
            reason
        );
    });
});

