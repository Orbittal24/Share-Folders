import csv
import json
import time
from datetime import datetime
import redis


# ============================================================
# REDIS CONNECTION
# ============================================================

r = redis.StrictRedis(
    host="localhost",
    port=6379,
    password="Gotion@123Strong!",
    db=31,
    decode_responses=True
)


# ============================================================
# SETTINGS
# ============================================================

TARGET_PREFIX = "2026-09-20"

# Examples:
# "2026-09"       -> entire September 2026
# "2026-09-20"    -> only 20-Sep-2026

SCAN_COUNT = 5000

DRY_RUN = False

PRINT_EACH = True

DELETE_BATCH_SIZE = 1000


# ============================================================
# REDIS VERSION
# ============================================================

print("Redis version:", r.info("server")["redis_version"])


mode = "dryrun" if DRY_RUN else "deleted"

csv_file = (
    f"cells_{TARGET_PREFIX}_{mode}_"
    f"{datetime.now():%Y%m%d_%H%M%S}.csv"
)


# ============================================================
# VARIABLES
# ============================================================

cursor = 0

scanned = 0
matched = 0
skipped = 0
csv_rows = 0

all_records = []


# ============================================================
# STEP 1
# SCAN REDIS
# ============================================================

print()
print("==============================================")
print("Scanning Redis...")
print("==============================================")
print()


while True:

    cursor, keys = r.scan(
        cursor=cursor,
        match="cell:*",
        count=SCAN_COUNT
    )

    if keys:

        values = r.mget(keys)

        for key, raw in zip(keys, values):

            scanned += 1

            # ------------------------------------------------
            # Key expired between SCAN and MGET
            # ------------------------------------------------

            if raw is None:
                continue

            # ------------------------------------------------
            # Convert Redis JSON string to Python dictionary
            # ------------------------------------------------

            try:
                data = json.loads(raw)

            except (json.JSONDecodeError, TypeError):

                skipped += 1

                print(
                    f"[SKIPPED - INVALID JSON] {key}"
                )

                continue

            # ------------------------------------------------
            # Make sure JSON is an object
            # ------------------------------------------------

            if not isinstance(data, dict):

                skipped += 1

                print(
                    f"[SKIPPED - NOT JSON OBJECT] {key}"
                )

                continue

            # ------------------------------------------------
            # Check first_para_time
            # ------------------------------------------------

            first_para_time = str(
                data.get("first_para_time") or ""
            ).strip()

            if not first_para_time.startswith(TARGET_PREFIX):
                continue


            # =================================================
            # MATCH FOUND
            # =================================================

            cellqr = data.get("cellqr", "")


            # ------------------------------------------------
            # IMPORTANT:
            #
            # Save the COMPLETE original Redis JSON.
            #
            # Nothing from Redis is discarded.
            # ------------------------------------------------

            record = {
                "redis_key": key,
                "redis_json": raw,
                **data
            }


            all_records.append(record)


            if PRINT_EACH:

                print(
                    f"[{'DRY RUN' if DRY_RUN else 'FOUND'}] "
                    f"cellqr={cellqr} "
                    f"first_para_time={first_para_time}"
                )


    if cursor == 0:
        break

    time.sleep(0.05)


# ============================================================
# NO RECORDS FOUND
# ============================================================

if not all_records:

    print()
    print("==============================================")
    print("No matching records found.")
    print("==============================================")
    print()

    print("Total Redis keys scanned :", scanned)
    print("Invalid JSON skipped     :", skipped)

    raise SystemExit


# ============================================================
# STEP 2
# CREATE COMPLETE CSV HEADER
# ============================================================

print()
print("==============================================")
print("Preparing CSV...")
print("==============================================")
print()


csv_fields = [
    "redis_key",
    "redis_json"
]


# ------------------------------------------------------------
# Collect ALL JSON fields from ALL Redis records
# ------------------------------------------------------------

for record in all_records:

    for field in record.keys():

        if field not in csv_fields:

            csv_fields.append(field)


print(
    f"Total matching Redis records : {len(all_records)}"
)

print(
    f"Total CSV columns             : {len(csv_fields)}"
)


# ============================================================
# STEP 3
# WRITE CSV
# ============================================================

print()
print("Writing complete Redis data to CSV...")
print()


with open(
    csv_file,
    "w",
    newline="",
    encoding="utf-8-sig"
) as f:

    writer = csv.DictWriter(
        f,
        fieldnames=csv_fields,
        extrasaction="ignore"
    )

    # --------------------------------------------------------
    # CSV HEADER
    # --------------------------------------------------------

    writer.writeheader()


    # --------------------------------------------------------
    # WRITE EVERY REDIS RECORD
    # --------------------------------------------------------

    for record in all_records:

        csv_record = {}

        for field in csv_fields:

            value = record.get(field, "")


            # ------------------------------------------------
            # If Redis JSON contains nested object/list,
            # preserve it as JSON text.
            # ------------------------------------------------

            if isinstance(value, (dict, list)):

                value = json.dumps(
                    value,
                    ensure_ascii=False
                )


            elif value is None:

                value = ""


            csv_record[field] = value


        writer.writerow(csv_record)

        csv_rows += 1


    # --------------------------------------------------------
    # Force everything to disk
    # --------------------------------------------------------

    f.flush()


# ============================================================
# IMPORTANT
#
# CSV IS COMPLETELY WRITTEN BEFORE REDIS DELETE.
# ============================================================

print()
print("==============================================")
print("CSV successfully created.")
print("==============================================")
print()

print("CSV file        :", csv_file)
print("CSV rows        :", csv_rows)
print("CSV columns     :", len(csv_fields))


# ============================================================
# STEP 4
# DELETE REDIS DATA
# ============================================================

if DRY_RUN:

    matched = len(all_records)

    print()
    print("DRY RUN enabled.")
    print("Redis data will NOT be deleted.")

else:

    print()
    print("==============================================")
    print("Deleting Redis records...")
    print("==============================================")
    print()


    delete_keys = [
        record["redis_key"]
        for record in all_records
    ]


    for i in range(
        0,
        len(delete_keys),
        DELETE_BATCH_SIZE
    ):

        batch = delete_keys[
            i:i + DELETE_BATCH_SIZE
        ]


        deleted_now = r.delete(*batch)

        matched += deleted_now


        print(
            f"Deleted {deleted_now} Redis keys "
            f"({min(i + DELETE_BATCH_SIZE, len(delete_keys))}"
            f"/{len(delete_keys)})"
        )


# ============================================================
# FINAL SUMMARY
# ============================================================

print()
print("================================================")
print("                    COMPLETED")
print("================================================")

print(
    "Mode                    :",
    "DRY RUN" if DRY_RUN else "DELETED"
)

print(
    "Target                  :",
    f"first_para_time starts with {TARGET_PREFIX}"
)

print(
    "Total Redis keys scanned:",
    scanned
)

print(
    "Total matching records  :",
    len(all_records)
)

print(
    "Total CSV rows saved    :",
    csv_rows
)

print(
    "Total Redis deleted     :",
    matched
)

print(
    "Invalid JSON skipped    :",
    skipped
)

print(
    "Total CSV columns       :",
    len(csv_fields)
)

print(
    "CSV file                :",
    csv_file
)

print("================================================")
