# ============================================================
# PROCESS SQL OPERATION
# ============================================================

def process_sql_operation(
    dst_conn,
    tableName,
    qr,
    row,
    exists,
    dateCode,
    code12_13
):

    sql_success = False
    sql_error = None
    connection_error = False

    for attempt in range(
        1,
        SQL_CONNECTION_RETRY_COUNT + 1
    ):

        dst_cursor = None

        try:

            print(
                f"[SQL] ATTEMPT {attempt}/"
                f"{SQL_CONNECTION_RETRY_COUNT} :",
                qr
            )

            # =================================================
            # CREATE FRESH CURSOR
            # =================================================

            dst_cursor = dst_conn.cursor()

            # =================================================
            # IMPORTANT:
            #
            # Re-check table existence on every retry.
            #
            # This also handles 08S01 occurring while creating
            # the date-wise table.
            # =================================================

            dst_cursor.execute(
                f"""
                IF NOT EXISTS
                (
                    SELECT 1
                    FROM INFORMATION_SCHEMA.TABLES
                    WHERE TABLE_NAME = '{tableName}'
                )
                BEGIN

                    CREATE TABLE {tableName}
                    (
                        sr_no INT IDENTITY(1,1) PRIMARY KEY,

                        cellqr NVARCHAR(50),
                        voltage NVARCHAR(50),
                        ir NVARCHAR(50),
                        class_grade NVARCHAR(30),
                        capacity NVARCHAR(50),
                        thickness NVARCHAR(50),
                        k_value NVARCHAR(50),
                        negative_voltage NVARCHAR(50),
                        cell_status NVARCHAR(20),
                        ocv_mc_no NVARCHAR(40),
                        first_para_time DATETIME,
                        last_para_time DATETIME,
                        laser_status VARCHAR(50),
                        batch VARCHAR(100),
                        plant_code VARCHAR(50)
                    );

                END
                """
            )

            dst_conn.commit()

            # =================================================
            # CHECK EXISTING RECORD AGAIN
            # =================================================

            dst_cursor.execute(
                f"""
                SELECT *
                FROM {tableName}
                WHERE cellqr = ?
                """,
                qr
            )

            current_exists = dst_cursor.fetchone()

            # =================================================
            # SQL INSERT
            # =================================================

            if not current_exists:

                print(
                    "TRYING SQL INSERT :",
                    qr
                )

                dst_cursor.execute(
                    f"""
                    INSERT INTO {tableName}
                    (
                        cellqr,
                        voltage,
                        ir,
                        class_grade,
                        capacity,
                        thickness,
                        k_value,
                        negative_voltage,
                        cell_status,
                        ocv_mc_no,
                        first_para_time,
                        last_para_time,
                        laser_status,
                        batch,
                        plant_code
                    )
                    VALUES
                    (
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        'OK',
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        ?
                    )
                    """,
                    (
                        qr,
                        row.voltage,
                        row.ir,
                        row.cell_class,
                        row.cell_capacity,
                        row.cell_thikness,
                        row.kvalue,
                        row.cell_nigative_voltage,
                        row.used_on_line,
                        row.today_date,
                        row.updated_time,
                        row.laser_status,
                        dateCode,
                        code12_13
                    )
                )

                print(
                    "SQL INSERT EXECUTED :",
                    qr
                )

            # =================================================
            # SQL UPDATE
            # =================================================

            else:

                print(
                    "Already exists :",
                    qr
                )

                print(
                    "TRYING SQL UPDATE :",
                    qr
                )

                dst_cursor.execute(
                    f"""
                    UPDATE {tableName}
                    SET
                        voltage = ?,
                        ir = ?,
                        class_grade = ?,
                        capacity = ?,
                        thickness = ?,
                        k_value = ?,
                        negative_voltage = ?,
                        ocv_mc_no = ?,
                        last_para_time = ?,
                        laser_status = ?,
                        batch = ?,
                        plant_code = ?
                    WHERE cellqr = ?
                    """,
                    (
                        row.voltage,
                        row.ir,
                        row.cell_class,
                        row.cell_capacity,
                        row.cell_thikness,
                        row.kvalue,
                        row.cell_nigative_voltage,
                        row.used_on_line,
                        row.updated_time,
                        row.laser_status,
                        dateCode,
                        code12_13,
                        qr
                    )
                )

                print(
                    "SQL UPDATE EXECUTED :",
                    qr
                )

            # =================================================
            # COMMIT
            # =================================================

            dst_conn.commit()

            sql_success = True
            sql_error = None

            print(
                "SQL SUCCESS :",
                qr
            )

            return {
                "success": True,
                "connection_error": False,
                "error": None,
                "conn": dst_conn
            }

        except Exception as e:

            sql_success = False
            sql_error = str(e)

            print(
                "[SQL] FAILED :",
                qr
            )

            print(
                "[SQL] ERROR :",
                e
            )

            try:

                dst_conn.rollback()

            except Exception:
                pass

            # =================================================
            # CONNECTION FAILURE
            # =================================================

            if is_sql_connection_error(e):

                connection_error = True

                print(
                    "[SQL] COMMUNICATION / "
                    "CONNECTION FAILURE DETECTED."
                )

                # ---------------------------------------------
                # RECONNECT
                # ---------------------------------------------

                dst_conn = reconnect_db(
                    dst_conn,
                    sqlConfig2,
                    "DESTINATION SQL"
                )

                # ---------------------------------------------
                # RETRY SAME RECORD
                # ---------------------------------------------

                if attempt < SQL_CONNECTION_RETRY_COUNT:

                    print(
                        "[SQL] RETRYING SAME RECORD "
                        "AFTER RECONNECT :",
                        qr
                    )

                    time.sleep(
                        SQL_CONNECTION_RETRY_DELAY
                    )

                    continue

                print(
                    "[SQL] ALL RETRIES EXHAUSTED :",
                    qr
                )

                return {
                    "success": False,
                    "connection_error": True,
                    "error": sql_error,
                    "conn": dst_conn
                }

            # =================================================
            # NORMAL SQL ERROR
            # =================================================

            return {
                "success": False,
                "connection_error": False,
                "error": sql_error,
                "conn": dst_conn
            }

        finally:

            try:

                if dst_cursor:
                    dst_cursor.close()

            except Exception:
                pass

    return {
        "success": sql_success,
        "connection_error": connection_error,
        "error": sql_error,
        "conn": dst_conn
    }


# ============================================================
