@echo off
setlocal

set NSSM=C:\Software_Tools\new_OCV\nssm.exe
set NODE=C:\Software_Tools\new_OCV\node-v24.21.0-win-x64\node.exe
set APPDIR=C:\Software_Tools\new_OCV\MESCellDataV2
set SERVICE=TataData

if not exist "%APPDIR%\logs" mkdir "%APPDIR%\logs"

echo.
echo ==========================================
echo Installing %SERVICE%
echo ==========================================
echo.

REM Check files
if not exist "%NSSM%" (
    echo ERROR: NSSM not found:
    echo %NSSM%
    pause
    exit /b 1
)

if not exist "%NODE%" (
    echo ERROR: Node.js not found:
    echo %NODE%
    pause
    exit /b 1
)

if not exist "%APPDIR%\mesCellDataService.js" (
    echo ERROR: JavaScript file not found:
    echo %APPDIR%\mesCellDataService.js
    pause
    exit /b 1
)

REM Remove existing service if present
"%NSSM%" stop %SERVICE% >nul 2>&1
"%NSSM%" remove %SERVICE% confirm >nul 2>&1

REM Install service
"%NSSM%" install %SERVICE% "%NODE%"

REM Configure service
"%NSSM%" set %SERVICE% Application "%NODE%"
"%NSSM%" set %SERVICE% AppDirectory "%APPDIR%"
"%NSSM%" set %SERVICE% AppParameters "mesCellDataService.js"

"%NSSM%" set %SERVICE% DisplayName "Tata Data"
"%NSSM%" set %SERVICE% Description "Reads cell data from OPC UA and forwards it to the MES"

REM Automatic startup
"%NSSM%" set %SERVICE% Start SERVICE_AUTO_START

REM Logs
"%NSSM%" set %SERVICE% AppStdout "%APPDIR%\logs\service.log"
"%NSSM%" set %SERVICE% AppStderr "%APPDIR%\logs\service-error.log"

REM Log rotation
"%NSSM%" set %SERVICE% AppRotateFiles 1
"%NSSM%" set %SERVICE% AppRotateBytes 10485760

REM Stop method
"%NSSM%" set %SERVICE% AppStopMethodConsole 15000

REM Restart if Node.js exits
"%NSSM%" set %SERVICE% AppExit Default Restart
"%NSSM%" set %SERVICE% AppRestartDelay 5000

echo.
echo ==========================================
echo TataData installed successfully
echo ==========================================
echo.

"%NSSM%" status %SERVICE%

echo.
echo Service:
echo   TataData
echo.
echo Application:
echo   %NODE%
echo.
echo Script:
echo   %APPDIR%\mesCellDataService.js
echo.
echo Logs:
echo   %APPDIR%\logs\service.log
echo   %APPDIR%\logs\service-error.log
echo.

echo Starting TataData...
echo.

"%NSSM%" start %SERVICE%

timeout /t 5 /nobreak >nul

echo.
echo ==========================================
echo TataData Status
echo ==========================================
echo.

"%NSSM%" status %SERVICE%

echo.
pause


