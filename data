SELECT 
    module_barcode,
    final_qr_code,
    battery_id,
    battery_pack_name,
    module_name,
    module_id,
    date_time_start,
    date_time_end,
    today_date
FROM taco_treceability.production_count_archive_compress
WHERE module_barcode IN (
    SELECT module_barcode
    FROM taco_treceability.production_count_archive_compress
    WHERE module_barcode IS NOT NULL
      AND module_barcode <> ''
    GROUP BY module_barcode
    HAVING COUNT(*) > 1
)
ORDER BY module_barcode, date_time_start;

If you only want the duplicate module_barcode and their final_qr_code
SELECT 
    module_barcode,
    STRING_AGG(final_qr_code, ', ') AS final_qr_codes,
    COUNT(*) AS duplicate_count
FROM taco_treceability.production_count_archive_compress
WHERE module_barcode IS NOT NULL
  AND module_barcode <> ''
GROUP BY module_barcode
HAVING COUNT(*) > 1
ORDER BY duplicate_count DESC;
