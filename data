// =====================================================
// HTTP SERVER
// Serves index.html. Socket.IO handles its own client
// script and all database-operation events.
// =====================================================

const server = http.createServer((req, res) => {
    let requestPath;

    try {
        requestPath = new URL(
            req.url,
            "http://localhost"
        ).pathname;
    } catch {
        res.writeHead(400);
        return res.end("Invalid request");
    }

    if (requestPath !== "/" && requestPath !== "/index.html") {
        res.writeHead(404);
        return res.end("Not found");
    }

    fs.readFile(HTML_FILE, (error, content) => {
        if (error) {
            console.error("HTML file error:", error.message);
            res.writeHead(500);
            return res.end("Unable to load index.html");
        }

        res.writeHead(200, {
            "Content-Type": "text/html; charset=utf-8",
            "Cache-Control": "no-store"
        });

        res.end(content);
    });
});

const io = new Server(server, {
    maxHttpBufferSize: 1e6
});

// =====================================================
// SQL CONNECTION POOL
// =====================================================

async function connectDatabase() {
    if (pool && pool.connected) {
        return pool;
    }

    if (poolPromise) {
        return poolPromise;
    }

    pool = new sql.ConnectionPool(sqlConfig);

    pool.on("error", error => {
        console.error("SQL connection pool error:", error.message);
    });

    poolPromise = pool.connect()
        .then(connection => {
            console.log("SQL Server connected successfully.");
            return connection;
        })
        .catch(error => {
            pool = null;
            poolPromise = null;
            throw error;
        });

    return poolPromise;
}

// =====================================================
// INPUT VALIDATION
// =====================================================

function validateFilters(data) {
    const date = String(data?.date || "").trim();
    const mode = data?.mode;

    if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) {
        throw new Error("Please select a valid date.");
    }

    const parsedDate = new Date(date + "T00:00:00.000Z");

    if (
        Number.isNaN(parsedDate.getTime()) ||
        parsedDate.toISOString().slice(0, 10) !== date
    ) {
        throw new Error("The selected date is invalid.");
    }

    if (mode !== "date" && mode !== "status") {
        throw new Error("Invalid backup mode.");
    }

    let status = null;

    if (mode === "status") {
        status = String(data?.status || "")
            .trim()
            .toLowerCase();

        if (!["running", "pause"].includes(status)) {
            throw new Error(
                "Status must be running or pause."
            );
        }
    }

    return { date, mode, status };
}

// =====================================================
// SHARED DATE/STATUS FILTER
// today_date may contain either DATE or DATETIME values.
// =====================================================

function filterSql(mode) {
    const statusCondition = mode === "status"
        ? `
            AND LOWER(LTRIM(RTRIM([battery_status]))) = @status
        `
        : "";

    return `
        WHERE [today_date] >= @startDate
          AND [today_date] < DATEADD(day, 1, @startDate)
          ${statusCondition}
    `;
}

function applyFilters(request, filters) {
    request.input("startDate", sql.Date, filters.date);

    if (filters.mode === "status") {
        request.input(
            "status",
            sql.VarChar(20),
            filters.status
        );
    }

    return request;
}

// =====================================================
// SCAN
// Returns the number of matching source records.
// No rows are inserted or deleted during scanning.
// =====================================================

async function scanRecords(filters) {
    const db = await connectDatabase();

    const query = `
        SELECT COUNT_BIG(*) AS total
        FROM ${SOURCE_TABLE}
        ${filterSql(filters.mode)};
    `;

    const request = applyFilters(db.request(), filters);
    const result = await request.query(query);

    // BigInt-safe serialization for Socket.IO.
    return result.recordset[0].total.toString();
}

// =====================================================
// SHIFT EXACTLY ONE RECORD
//
// Transaction:
// 1. Insert one record into the destination.
// 2. Verify the insert affected exactly one row.
// 3. Delete that source record.
// 4. Verify the delete affected exactly one row.
// 5. Commit both operations.
//
// Any error triggers rollback.
// =====================================================

async function shiftOneRecord(db, srNo) {
    const transaction = new sql.Transaction(db);

    await transaction.begin(
        sql.ISOLATION_LEVEL.READ_COMMITTED
    );

    try {
        const insertQuery = `
            INSERT INTO ${TARGET_TABLE} (${COLUMN_LIST})
            SELECT ${COLUMN_LIST}
            FROM ${SOURCE_TABLE} WITH (UPDLOCK, ROWLOCK)
            WHERE [sr_no] = @srNo;
        `;

        const insertRequest = new sql.Request(transaction);

        insertRequest.input("srNo", sql.Int, srNo);

        const insertResult = await insertRequest.query(
            insertQuery
        );

        if (insertResult.rowsAffected[0] !== 1) {
            throw new Error(
                `Expected one inserted row for sr_no ${srNo}, ` +
                `but got ${insertResult.rowsAffected[0]}.`
            );
        }

        // Delete the source record only after the insert succeeds.
        const deleteRequest = new sql.Request(transaction);

        deleteRequest.input("srNo", sql.Int, srNo);

        const deleteResult = await deleteRequest.query(`
            DELETE FROM ${SOURCE_TABLE}
            WHERE [sr_no] = @srNo;
        `);

        if (deleteResult.rowsAffected[0] !== 1) {
            throw new Error(
                `Expected one deleted source row for sr_no ${srNo}, ` +
                `but got ${deleteResult.rowsAffected[0]}.`
            );
        }

        await transaction.commit();

        return true;
    } catch (error) {
        try {
            await transaction.rollback();
        } catch (rollbackError) {
            console.error(
                `Rollback error for sr_no ${srNo}:`,
                rollbackError.message
            );
        }

        throw error;
    }
}

// =====================================================
// BACKUP
// Select matching IDs once, then process sequentially.
// Stops at the first failure so the failed row can be
// investigated and retried after a fresh scan.
// =====================================================

async function shiftRecords(filters, socket) {
    if (backupRunning) {
        throw new Error(
            "Another backup is running. Please wait."
        );
    }

    backupRunning = true;

    let total = 0;
    let shifted = 0;
    let failed = 0;
    let lastError = null;
    let failedSrNo = null;

    try {
        const db = await connectDatabase();

        const selectRequest = applyFilters(
            db.request(),
            filters
        );

        const selected = await selectRequest.query(`
            SELECT [sr_no]
            FROM ${SOURCE_TABLE}
            ${filterSql(filters.mode)}
            ORDER BY [sr_no] ASC;
        `);

        const ids = selected.recordset.map(row => row.sr_no);
        total = ids.length;

        socket.emit("backup-started", {
            total,
            message: "Backup started."
        });

        for (const srNo of ids) {
            try {
                await shiftOneRecord(db, srNo);
                shifted++;
            } catch (error) {
                failed++;
                failedSrNo = srNo;
                lastError = error.message;

                console.error(
                    `Backup failed for sr_no ${srNo}:`,
                    error.message
                );

                socket.emit("backup-progress", {
                    total,
                    shifted,
                    failed,
                    currentSrNo: srNo,
                    error: lastError
                });

                // Do not skip the failed record.
                break;
            }

            socket.emit("backup-progress", {
                total,
                shifted,
                failed,
                currentSrNo: srNo,
                error: null
            });
        }

        const response = {
            total,
            shifted,
            failed,
            failedSrNo,
            lastError,
            message: failed
                ? "Backup stopped at the failed record. The failed source record was retained."
                : "Backup completed successfully."
        };

        socket.emit("backup-complete", response);

        return response;
    } finally {
        backupRunning = false;
    }
}

// =====================================================
// SOCKET.IO EVENTS
// =====================================================

io.on("connection", socket => {
    console.log("Frontend connected:", socket.id);

    socket.emit("connection-status", {
        connected: true,
        message: "Connected to backup server."
    });

    // SCAN BUTTON
    socket.on("scan-records", async (data, acknowledge) => {
        try {
            const filters = validateFilters(data);
            const total = await scanRecords(filters);

            const response = {
                success: true,
                total,
                message: "Scan completed."
            };

            socket.emit("scan-result", response);

            if (typeof acknowledge === "function") {
                acknowledge(response);
            }
        } catch (error) {
            console.error("Scan error:", error.message);

            const response = {
                success: false,
                message: error.message
            };

            socket.emit("operation-error", response);

            if (typeof acknowledge === "function") {
                acknowledge(response);
            }
        }
    });

    // SHIFT TO BACKUP BUTTON
    socket.on("shift-backup", async (data, acknowledge) => {
        try {
            const filters = validateFilters(data);
            const result = await shiftRecords(filters, socket);

            if (typeof acknowledge === "function") {
                acknowledge({
                    success: true,
                    ...result
                });
            }
        } catch (error) {
            console.error("Backup error:", error.message);

            const response = {
                success: false,
                message: error.message
            };

            socket.emit("operation-error", response);

            if (typeof acknowledge === "function") {
                acknowledge(response);
            }
        }
    });

    socket.on("disconnect", reason => {
        console.log(
            "Frontend disconnected:",
            socket.id,
            reason
        );
    });
});

