def process_record(src_conn, dst_conn):

    src_cursor = None

    row = None

    try:

        # ====================================================
        # SOURCE CONNECTION CHECK
        # ====================================================

        if not test_connection(src_conn):

            print(
                "[SOURCE SQL] CONNECTION NOT HEALTHY."
            )

            src_conn = reconnect_db(
                src_conn,
                sqlConfig1,
                "SOURCE SQL"
            )

        # ====================================================
        # DESTINATION CONNECTION CHECK
        # ====================================================

        if not test_connection(dst_conn):

            print(
                "[DESTINATION SQL] CONNECTION NOT HEALTHY."
            )

            dst_conn = reconnect_db(
                dst_conn,
                sqlConfig2,
                "DESTINATION SQL"
            )

        # ====================================================
        # FETCH TOP 1 FROM NEW TABLE
        # ====================================================

        src_cursor = src_conn.cursor()

        src_cursor.execute(
            """
            SELECT TOP 1 *
            FROM taco_treceability.ocv_machine_data_xng_mirrior
            ORDER BY sr_no DESC
            """
        )

        row = src_cursor.fetchone()

        if not row:

            print(
                "No new records..."
            )

            return src_conn, dst_conn

        qr = row.cell_qrcode

        print(
            "\n================ NEW RECORD ================"
        )

        print(
            "QR CODE:",
            qr
        )

        # ====================================================
        # QR VALIDATION
        # ====================================================

        if not qr or len(qr) < 16:

            print(
                "ERROR: QR too short, skipping"
            )

            return src_conn, dst_conn

        # ====================================================
        # EXTRACT PLANT CODE & BATCH CODE
        # ====================================================

        code12_13 = qr[12:14]

        # Dynamic logic for dateCode
        if code12_13 == "BV":

            dateCode = qr[8:11]

        else:

            dateCode = qr[14:17]

        print(
            "Plant code:",
            code12_13
        )

        print(
            "Batch code:",
            dateCode
        )

        # ====================================================
        # DATE MAPPING
        # ====================================================

        yearValue = yearMap.get(
            dateCode[0]
        )

        monthValue = monthMap.get(
            dateCode[1]
        )

        dayValue = dayMap.get(
            dateCode[2]
        )

        if (
            not yearValue
            or not monthValue
            or not dayValue
        ):

            print(
                "ERROR: Mapping failed! Skipping QR:",
                qr
            )

            return src_conn, dst_conn

        year = 2000 + yearValue

        month = f"{monthValue:02d}"

        day = f"{dayValue:02d}"

        tableName = (
            f"ocvcell_inventory_data_"
            f"{year}_{month}_{day}"
        )

        print(
            "Target Table:",
            tableName
        )

        # ====================================================
        # CHECK IF EXISTS
        # ====================================================
        #
        # We keep the original logic of determining whether
        # the record exists.
        #
        # But if communication fails here, we reconnect and
        # continue. The actual SQL operation performs another
        # existence check safely.
        # ====================================================

        exists = None

        try:

            dst_cursor = dst_conn.cursor()

            # Create table if required
            dst_cursor.execute(
                f"""
                IF NOT EXISTS
                (
                    SELECT 1
                    FROM INFORMATION_SCHEMA.TABLES
                    WHERE TABLE_NAME = '{tableName}'
                )
                BEGIN

                    CREATE TABLE {tableName}
                    (
                        sr_no INT IDENTITY(1,1) PRIMARY KEY,

                        cellqr NVARCHAR(50),
                        voltage NVARCHAR(50),
                        ir NVARCHAR(50),
                        class_grade NVARCHAR(30),
                        capacity NVARCHAR(50),
                        thickness NVARCHAR(50),
                        k_value NVARCHAR(50),
                        negative_voltage NVARCHAR(50),
                        cell_status NVARCHAR(20),
                        ocv_mc_no NVARCHAR(40),
                        first_para_time DATETIME,
                        last_para_time DATETIME,
                        laser_status VARCHAR(50),
                        batch VARCHAR(100),
                        plant_code VARCHAR(50)
                    );

                END
                """
            )

            dst_conn.commit()

            dst_cursor.execute(
                f"""
                SELECT *
                FROM {tableName}
                WHERE cellqr = ?
                """,
                qr
            )

            exists = dst_cursor.fetchone()

        except Exception as e:

            print(
                "SQL EXISTENCE CHECK FAILED :",
                e
            )

            try:

                dst_conn.rollback()

            except Exception:
                pass

            if is_sql_connection_error(e):

                print(
                    "[SQL] COMMUNICATION FAILURE "
                    "DURING EXISTENCE CHECK."
                )

                dst_conn = reconnect_db(
                    dst_conn,
                    sqlConfig2,
                    "DESTINATION SQL"
                )

                # Do not stop.
                #
                # process_sql_operation will perform the
                # table check and record operation again.

                exists = None

            else:

                exists = None

        finally:

            try:

                if 'dst_cursor' in locals() and dst_cursor:
                    dst_cursor.close()

            except Exception:
                pass

        # ====================================================
        # PREPARE ROW DICT FOR REDIS
        # ====================================================

        row_dict = {

            "cellqr": safe(qr),

            "voltage": safe(row.voltage),

            "ir": safe(row.ir),

            "class_grade": safe(row.cell_class),

            "capacity": safe(row.cell_capacity),

            "thickness": safe(row.cell_thikness),

            "k_value": safe(row.kvalue),

            "negative_voltage": safe(
                row.cell_nigative_voltage
            ),

            "cell_status": "OK",

            "ocv_mc_no": safe(
                row.used_on_line
            ),

            "first_para_time": safe(
                row.today_date
            ),

            "last_para_time": safe(
                row.updated_time
            ),

            "laser_status": safe(
                row.laser_status
            ),

            "batch": safe(
                dateCode
            ),

            "plant_code": safe(
                code12_13
            )

        }

        # ====================================================
        # STATUS VARIABLES
        # ====================================================

        sql_success = False
        redis_success = False

        sql_error = None
        redis_error = None

        sql_connection_error = False

        # ====================================================
        # SQL OPERATION
        # ====================================================

        sql_result = process_sql_operation(
            dst_conn,
            tableName,
            qr,
            row,
            exists,
            dateCode,
            code12_13
        )

        # Important:
        # process_sql_operation can reconnect and replace
        # dst_conn.

        dst_conn = sql_result["conn"]

        sql_success = sql_result["success"]

        sql_connection_error = sql_result[
            "connection_error"
        ]

        sql_error = sql_result[
            "error"
        ]

        # ====================================================
        # REDIS OPERATION
        # ====================================================
        #
        # IMPORTANT:
        #
        # Redis is ALWAYS attempted.
        #
        # SQL success or SQL failure does NOT decide
        # whether Redis is attempted.
        #
        # ====================================================

        try:

            print(
                "TRYING REDIS :",
                qr
            )

            r.set(
                f"cell:{qr}",
                json.dumps(row_dict)
            )

            redis_success = True

            print(
                "REDIS SUCCESS :",
                qr
            )

        except Exception as e:

            redis_success = False

            redis_error = str(e)

            print(
                "REDIS FAILED :",
                qr
            )

            print(
                "REDIS ERROR :",
                e
            )

        # ====================================================
        # FINAL RESULT
        # ====================================================

        print(
            "\n--------------- FINAL RESULT ---------------"
        )

        print(
            "QR CODE       :",
            qr
        )

        print(
            "SQL SUCCESS   :",
            sql_success
        )

        print(
            "REDIS SUCCESS :",
            redis_success
        )

        # ====================================================
        # CASE 1
        #
        # SQL SUCCESS + REDIS SUCCESS
        # ====================================================

        if sql_success and redis_success:

            print(
                "\nCASE 1 : "
                "SQL SUCCESS + REDIS SUCCESS"
            )

            print(
                "SQL and Redis both successful."
            )

            # ------------------------------------------------
            # DELETE SOURCE
            # ------------------------------------------------

            delete_success, src_conn = delete_source_record(
                src_conn,
                qr
            )

            if not delete_success:

                print(
                    "SOURCE DELETE FAILED - "
                    "MIRROR RECORD REMAINS :",
                    qr
                )

            return src_conn, dst_conn

        # ====================================================
        # CASE 2
        #
        # SQL FAILED + REDIS SUCCESS
        #
        # IMPORTANT:
        #
        # This includes 08S01.
        #
        # Redis has succeeded.
        #
        # Therefore:
        #
        # SQL FAILED
        #      +
        # REDIS SUCCESS
        #      ↓
        # REJECTION TABLE
        #      ↓
        # ACKNOWLEDGEMENT
        #      ↓
        # DELETE MIRROR
        #
        # ====================================================

        elif not sql_success and redis_success:

            print(
                "\nCASE 2 : "
                "SQL FAILED + REDIS SUCCESS"
            )

            print(
                "SQL failed."
            )

            print(
                "Redis succeeded."
            )

            print(
                "SQL ERROR :",
                sql_error
            )

            if sql_connection_error:

                print(
                    "SQL COMMUNICATION FAILURE "
                    "WAS DETECTED."
                )

            # ------------------------------------------------
            # INSERT INTO REJECTION TABLE
            # ------------------------------------------------

            rejection_success, dst_conn = insert_rejection_record(
                dst_conn,
                row,
                qr,
                dateCode,
                code12_13,
                tableName,
                sql_success,
                redis_success,
                sql_error,
                redis_error
            )

            # ------------------------------------------------
            # DELETE SOURCE AFTER REJECTION ACKNOWLEDGEMENT
            # ------------------------------------------------

            if rejection_success:

                print(
                    "REJECTION ACKNOWLEDGED."
                )

                delete_success, src_conn = delete_source_record(
                    src_conn,
                    qr
                )

                if not delete_success:

                    print(
                        "SOURCE NOT DELETED BECAUSE "
                        "SOURCE DELETE FAILED :",
                        qr
                    )

            else:

                print(
                    "SOURCE NOT DELETED BECAUSE "
                    "REJECTION INSERT FAILED :",
                    qr
                )

            return src_conn, dst_conn

        # ====================================================
        # CASE 3
        #
        # SQL SUCCESS + REDIS FAILED
        # ====================================================

        elif sql_success and not redis_success:

            print(
                "\nCASE 3 : "
                "SQL SUCCESS + REDIS FAILED"
            )

            print(
                "SQL succeeded."
            )

            print(
                "Redis failed."
            )

            print(
                "REDIS ERROR :",
                redis_error
            )

            # ------------------------------------------------
            # INSERT INTO REJECTION TABLE
            # ------------------------------------------------

            rejection_success, dst_conn = insert_rejection_record(
                dst_conn,
                row,
                qr,
                dateCode,
                code12_13,
                tableName,
                sql_success,
                redis_success,
                sql_error,
                redis_error
            )

            # ------------------------------------------------
            # DELETE SOURCE AFTER REJECTION ACKNOWLEDGEMENT
            # ------------------------------------------------

            if rejection_success:

                print(
                    "REJECTION ACKNOWLEDGED."
                )

                delete_success, src_conn = delete_source_record(
                    src_conn,
                    qr
                )

                if not delete_success:

                    print(
                        "SOURCE NOT DELETED BECAUSE "
                        "SOURCE DELETE FAILED :",
                        qr
                    )

            else:

                print(
                    "SOURCE NOT DELETED BECAUSE "
                    "REJECTION INSERT FAILED :",
                    qr
                )

            return src_conn, dst_conn

        # ====================================================
        # CASE 4
        #
        # SQL FAILED + REDIS FAILED
        # ====================================================

        elif not sql_success and not redis_success:

            print(
                "\nCASE 4 : "
                "SQL FAILED + REDIS FAILED"
            )

            print(
                "SQL failed."
            )

            print(
                "Redis failed."
            )

            print(
                "SQL ERROR :",
                sql_error
            )

            print(
                "REDIS ERROR :",
                redis_error
            )

            # ------------------------------------------------
            # BOTH FAILED
            #
            # INSERT INTO REJECTION TABLE
            # ------------------------------------------------

            rejection_success, dst_conn = insert_rejection_record(
                dst_conn,
                row,
                qr,
                dateCode,
                code12_13,
                tableName,
                sql_success,
                redis_success,
                sql_error,
                redis_error
            )

            # ------------------------------------------------
            # DELETE SOURCE AFTER REJECTION ACKNOWLEDGEMENT
            # ------------------------------------------------

            if rejection_success:

                print(
                    "REJECTION INSERT SUCCESSFUL."
                )

                print(
                    "REJECTION ACKNOWLEDGEMENT SUCCESSFUL."
                )

                delete_success, src_conn = delete_source_record(
                    src_conn,
                    qr
                )

                if not delete_success:

                    print(
                        "SOURCE DELETE FAILED :",
                        qr
                    )

            else:

                print(
                    "REJECTION INSERT FAILED."
                )

                print(
                    "SOURCE NOT DELETED :",
                    qr
                )

            return src_conn, dst_conn

        return src_conn, dst_conn

    # ========================================================
    # UNEXPECTED PROCESS ERROR
    # ========================================================

    except Exception as e:

        print(
            "PROCESS ERROR :",
            e
        )

        # ----------------------------------------------------
        # SOURCE CONNECTION FAILURE
        # ----------------------------------------------------

        if is_sql_connection_error(e):

            print(
                "[PROCESS] SQL COMMUNICATION FAILURE."
            )

            # Reconnect source so service remains alive.
            src_conn = reconnect_db(
                src_conn,
                sqlConfig1,
                "SOURCE SQL"
            )

        return src_conn, dst_conn

    finally:

        try:

            if src_cursor:
                src_cursor.close()

        except Exception:
            pass


# ============================================================
# CONTINUOUS LOOP
# ============================================================

def start():

    src_conn = None
    dst_conn = None

    # ========================================================
    # INITIAL SOURCE CONNECTION
    # ========================================================

    while True:

        try:

            print(
                "[SOURCE SQL] CONNECTING..."
            )

            src_conn = connect_db(
                sqlConfig1
            )

            print(
                "[SOURCE SQL] CONNECTED SUCCESSFULLY."
            )

            break

        except Exception as e:

            print(
                "[SOURCE SQL] CONNECTION FAILED :",
                e
            )

            time.sleep(
                DB_RECONNECT_DELAY
            )

    # ========================================================
    # INITIAL DESTINATION CONNECTION
    # ========================================================

    while True:

        try:

            print(
                "[DESTINATION SQL] CONNECTING..."
            )

            dst_conn = connect_db(
                sqlConfig2
            )

            print(
                "[DESTINATION SQL] CONNECTED SUCCESSFULLY."
            )

            break

        except Exception as e:

            print(
                "[DESTINATION SQL] CONNECTION FAILED :",
                e
            )

            time.sleep(
                DB_RECONNECT_DELAY
            )

    # ========================================================
    # SERVICE START
    # ========================================================

    print(
        "=============================================="
    )

    print(
        "OCV CELL DATA MIRROR SERVICE STARTED"
    )

    print(
        "=============================================="
    )

    # ========================================================
    # CONTINUOUS LOOP
    # ========================================================

    while True:

        try:

            # =================================================
            # SOURCE CONNECTION HEALTH CHECK
            # =================================================

            if not test_connection(src_conn):

                print(
                    "[SOURCE SQL] CONNECTION NOT HEALTHY."
                )

                src_conn = reconnect_db(
                    src_conn,
                    sqlConfig1,
                    "SOURCE SQL"
                )

            # =================================================
            # DESTINATION CONNECTION HEALTH CHECK
            # =================================================

            if not test_connection(dst_conn):

                print(
                    "[DESTINATION SQL] CONNECTION NOT HEALTHY."
                )

                dst_conn = reconnect_db(
                    dst_conn,
                    sqlConfig2,
                    "DESTINATION SQL"
                )

            # =================================================
            # PROCESS RECORD
            # =================================================

            src_conn, dst_conn = process_record(
                src_conn,
                dst_conn
            )

        except Exception as e:

            print(
                "ERROR:",
                e
            )

            # =================================================
            # SOURCE RECOVERY
            # =================================================

            try:

                if not test_connection(src_conn):

                    print(
                        "[MAIN] SOURCE CONNECTION LOST."
                    )

                    src_conn = reconnect_db(
                        src_conn,
                        sqlConfig1,
                        "SOURCE SQL"
                    )

            except Exception as source_error:

                print(
                    "[MAIN] SOURCE RECONNECT ERROR :",
                    source_error
                )

            # =================================================
            # DESTINATION RECOVERY
            # =================================================

            try:

                if not test_connection(dst_conn):

                    print(
                        "[MAIN] DESTINATION CONNECTION LOST."
                    )

                    dst_conn = reconnect_db(
                        dst_conn,
                        sqlConfig2,
                        "DESTINATION SQL"
                    )

            except Exception as destination_error:

                print(
                    "[MAIN] DESTINATION RECONNECT ERROR :",
                    destination_error
                )

            time.sleep(1)

        # =====================================================
        # SMALL LOOP DELAY
        # =====================================================

        time.sleep(
            0.1
        )


# ============================================================
# START SERVICE
# ============================================================

if __name__ == "__main__":

    start()
