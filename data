            SELECT h.*, q.id AS queue_id, q.attempts, q.last_error
            FROM cells_history h
            LEFT JOIN cells_queue q ON q.history_id = h.id
            WHERE h.cell_qrcode = ?
            ORDER BY h.id
        `).all(qr);

        if (rows.length === 0) {
