# ============================================================
# SQL PROCESS WITH RECONNECT + RETRY
# ============================================================

def process_sql_record(
    dst_conn,
    tableName,
    qr,
    row,
    capacity_val,
    dateCode,
    code12_13
):

    sql_success = False
    connection_error = False

    for sql_attempt in range(
        1,
        SQL_CONNECTION_RETRY_COUNT + 1
    ):

        dst_cursor = None

        try:

            print(
                f"[SQL] ATTEMPT "
                f"{sql_attempt}/"
                f"{SQL_CONNECTION_RETRY_COUNT} :",
                qr
            )

            # =================================================
            # NEW CURSOR
            # =================================================

            dst_cursor = dst_conn.cursor()

            # =================================================
            # ENSURE TABLE
            # =================================================

            ensure_table(
                dst_cursor,
                tableName
            )

            # =================================================
            # CHECK EXISTING RECORD
            # =================================================

            dst_cursor.execute(
                f"""
                SELECT cellqr
                FROM {tableName}
                WHERE cellqr=?
                """,
                qr
            )

            exists = dst_cursor.fetchone()

            # =================================================
            # UPDATE EXISTING SQL RECORD
            # =================================================

            if exists:

                dst_cursor.execute(
                    f"""
                    UPDATE {tableName}
                    SET
                        voltage=?,
                        ir=?,
                        class_grade=?,
                        capacity=?,
                        k_value=?,
                        ocv_mc_no=?,
                        first_para_time=?,
                        last_para_time=?,
                        batch=?,
                        plant_code=?
                    WHERE cellqr=?
                    """,
                    (
                        safe(row.voltage),
                        safe(row.ir),
                        safe(row.cell_class),
                        capacity_val,
                        safe(row.kvalue),
                        safe(row.machine_location),
                        row.today_date,
                        row.today_date,
                        dateCode,
                        code12_13,
                        qr
                    )
                )

                print(
                    "UPDATED :",
                    qr
                )

            # =================================================
            # INSERT NEW SQL RECORD
            # =================================================

            else:

                dst_cursor.execute(
                    f"""
                    INSERT INTO {tableName}
                    (
                        cellqr,
                        voltage,
                        ir,
                        class_grade,
                        capacity,
                        thickness,
                        k_value,
                        negative_voltage,
                        cell_status,
                        ocv_mc_no,
                        first_para_time,
                        last_para_time,
                        laser_status,
                        batch,
                        plant_code
                    )
                    VALUES
                    (
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        NULL,
                        ?,
                        NULL,
                        'OK',
                        ?,
                        ?,
                        ?,
                        NULL,
                        ?,
                        ?
                    )
                    """,
                    (
                        qr,
                        safe(row.voltage),
                        safe(row.ir),
                        safe(row.cell_class),
                        capacity_val,
                        safe(row.kvalue),
                        safe(row.machine_location),
                        row.today_date,
                        row.today_date,
                        dateCode,
                        code12_13
                    )
                )

                print(
                    "INSERTED :",
                    qr
                )

            # =================================================
            # SQL COMMIT
            # =================================================

            dst_conn.commit()

            sql_success = True

            print(
                "SQL SUCCESS :",
                qr
            )

            return {
                "success": True,
                "connection_error": False,
                "conn": dst_conn
            }

        except Exception as sql_error:

            print(
                f"[SQL] FAILED ATTEMPT "
                f"{sql_attempt}/"
                f"{SQL_CONNECTION_RETRY_COUNT} :",
                sql_error
            )

            try:

                dst_conn.rollback()

            except Exception as rollback_error:

                print(
                    "[SQL] ROLLBACK FAILED :",
                    rollback_error
                )

            # =================================================
            # SQL COMMUNICATION FAILURE
            # =================================================

            if is_sql_connection_error(
                sql_error
            ):

                connection_error = True

                print(
                    "[SQL] COMMUNICATION FAILURE DETECTED."
                )

                # ---------------------------------------------
                # RECONNECT DESTINATION SQL
                # ---------------------------------------------

                dst_conn = reconnect_db(
                    dst_conn,
                    sqlConfig2,
                    "DESTINATION SQL"
                )

                # ---------------------------------------------
                # RETRY SAME RECORD
                # ---------------------------------------------

                if sql_attempt < SQL_CONNECTION_RETRY_COUNT:

                    print(
                        "[SQL] RETRYING SAME RECORD AFTER "
                        "RECONNECT :",
                        qr
                    )

                    time.sleep(
                        SQL_CONNECTION_RETRY_DELAY
                    )

                    continue

                else:

                    print(
                        "[SQL] ALL SQL CONNECTION RETRIES "
                        "EXHAUSTED :",
                        qr
                    )

                    # IMPORTANT:
                    #
                    # We DO NOT stop here.
                    #
                    # The caller will continue to Redis.
                    #

                    return {
                        "success": False,
                        "connection_error": True,
                        "conn": dst_conn
                    }

            # =================================================
            # NORMAL SQL ERROR
            # =================================================

            else:

                print(
                    "[SQL] NON-CONNECTION ERROR."
                )

                return {
                    "success": False,
                    "connection_error": False,
                    "conn": dst_conn
                }

        finally:

            try:

                if dst_cursor:
                    dst_cursor.close()

            except Exception:
                pass

    return {
        "success": sql_success,
        "connection_error": connection_error,
        "conn": dst_conn
    }


# ============================================================
# PROCESS RECORD
# ============================================================

def process_record(src_conn, dst_conn):

    src_cursor = None
    row = None

    # ========================================================
    # STATUS FLAGS
    # ========================================================

    sql_success = False
    redis_success = False
    sql_connection_error = False

    try:

        # ====================================================
        # GET SOURCE RECORD
        # ====================================================

        src_cursor = src_conn.cursor()

        src_cursor.execute("""
        SELECT TOP 1 *
        FROM taco_treceability.ocv_machine_data_mirror
        WHERE machine_location='line5_line6'
        ORDER BY sr_no ASC
        """)

        row = src_cursor.fetchone()

        if not row:

            print(
                "No records..."
            )

            return src_conn, dst_conn

        qr = safe(
            row.cell_qrcode
        )

        print(
            "\n========= NEW RECORD ========="
        )

        print(
            "QR :",
            qr
        )

        # ====================================================
        # QR VALIDATION
        # ====================================================

        if len(qr) < 16:

            raise Exception(
                "QR too short"
            )

        # ====================================================
        # DATE CODE
        # ====================================================

        code12_13 = qr[12:14]

        dateCode = (
            qr[8:11]
            if code12_13 == "BV"
            else qr[14:17]
        )

        # ====================================================
        # DATE MAPPING
        # ====================================================

        yearValue = yearMap.get(
            dateCode[0]
        )

        monthValue = monthMap.get(
            dateCode[1]
        )

        dayValue = dayMap.get(
            dateCode[2]
        )

        if (
            not yearValue
            or not monthValue
            or not dayValue
        ):

            raise Exception(
                "Date mapping failed"
            )

        year = 2000 + yearValue

        month = f"{monthValue:02d}"

        day = f"{dayValue:02d}"

        tableName = (
            f"ocvcell_inventory_data_"
            f"{year}_{month}_{day}"
        )

        print(
            "TABLE :",
            tableName
        )

        # ====================================================
        # CAPACITY
        # ====================================================

        capacity_val = extract_capacity(
            row.cell_capacity
        )

        # ====================================================
        # SQL PROCESS
        # ====================================================

        sql_result = process_sql_record(
            dst_conn,
            tableName,
            qr,
            row,
            capacity_val,
            dateCode,
            code12_13
        )

        # IMPORTANT:
        #
        # process_sql_record may have replaced the
        # broken destination connection.

        dst_conn = sql_result[
            "conn"
        ]

        sql_success = sql_result[
            "success"
        ]

        sql_connection_error = sql_result[
            "connection_error"
        ]

        # ====================================================
        # REDIS PROCESS
        # ====================================================
        #
        # IMPORTANT:
        #
        # Redis is ALWAYS attempted.
        #
        # It does not matter whether SQL succeeded
        # or failed.
        #

        try:

            redis_payload = {
                "cellqr": qr,
                "voltage": safe(row.voltage),
                "ir": safe(row.ir),
                "class_grade": safe(row.cell_class),
                "capacity": capacity_val,
                "k_value": safe(row.kvalue),
                "ocv_mc_no": safe(row.machine_location),
                "first_para_time": str(row.today_date),
                "last_para_time": str(row.today_date),
                "batch": dateCode,
                "plant_code": code12_13
            }

            # =================================================
            # REDIS INSERT
            # =================================================

            r.setex(
                f"cell:{qr}",
                DUPLICATE_TTL_SECONDS,
                json.dumps(redis_payload)
            )

            redis_success = True

            print(
                "REDIS SUCCESS :",
                redis_payload
            )

        except Exception as redis_error:

            print(
                "REDIS FAILED :",
                redis_error
            )

            redis_success = False

        # ====================================================
        # FINAL RESULT
        # ====================================================

        # ====================================================
        # CASE 1
        # SQL SUCCESS + REDIS SUCCESS
        # ====================================================

        if sql_success and redis_success:

            print(
                "SQL + REDIS SUCCESS :",
                qr
            )

            delete_source(
                src_conn,
                qr
            )

            return src_conn, dst_conn

        # ====================================================
        # CASE 2
        # SQL FAILED + REDIS SUCCESS
        # ====================================================
        #
        # This includes:
        #
        #   - 08S01 communication failure
        #   - SQL connection failure
        #   - normal SQL failure
        #
        # Redis succeeded.
        #
        # Therefore:
        #
        #   Redis SUCCESS
        #       ↓
        #   Rejection INSERT
        #       ↓
        #   ACKNOWLEDGEMENT
        #       ↓
        #   DELETE MIRROR
        #

        if not sql_success and redis_success:

            print(
                "SQL FAILED + REDIS SUCCESS :",
                qr
            )

            if sql_connection_error:

                print(
                    "SQL COMMUNICATION FAILURE "
                    "BUT REDIS SUCCESSFUL :",
                    qr
                )

            print(
                "INSERTING FAILED SQL DATA INTO REJECTION :",
                qr
            )

            rejection_result = handle_failure(
                src_conn,
                row
            )

            if rejection_result:

                print(
                    "SQL FAILED DATA MOVED TO REJECTION :",
                    qr
                )

            else:

                print(
                    "REJECTION FAILED - "
                    "SOURCE KEPT IN MIRROR :",
                    qr
                )

            return src_conn, dst_conn

        # ====================================================
        # CASE 3
        # SQL SUCCESS + REDIS FAILED
        # ====================================================

        if sql_success and not redis_success:

            print(
                "SQL SUCCESS + REDIS FAILED :",
                qr
            )

            print(
                "INSERTING REDIS FAILED DATA INTO REJECTION :",
                qr
            )

            rejection_result = handle_failure(
                src_conn,
                row
            )

            if rejection_result:

                print(
                    "REDIS FAILED DATA MOVED TO REJECTION :",
                    qr
                )

            else:

                print(
                    "REJECTION FAILED - "
                    "SOURCE KEPT IN MIRROR :",
                    qr
                )

            return src_conn, dst_conn

        # ====================================================
        # CASE 4
        # SQL FAILED + REDIS FAILED
        # ====================================================
        #
        # Both failed.
        #
        # Existing logic preserved:
        #
        #   Rejection INSERT
        #       ↓
        #   ACK
        #       ↓
        #   Delete Mirror
        #
        # If rejection also fails, mirror remains.
        #

        if not sql_success and not redis_success:

            print(
                "SQL FAILED + REDIS FAILED :",
                qr
            )

            print(
                "BOTH FAILED - "
                "INSERTING INTO REJECTION :",
                qr
            )

            rejection_result = handle_failure(
                src_conn,
                row
            )

            if rejection_result:

                print(
                    "BOTH FAILED - DATA MOVED TO REJECTION :",
                    qr
                )

            else:

                print(
                    "BOTH FAILED - "
                    "SOURCE KEPT IN MIRROR :",
                    qr
                )

            return src_conn, dst_conn

        return src_conn, dst_conn

    # ========================================================
    # OUTER PROCESS ERROR
    # ========================================================

    except Exception as e:

        print(
            "PROCESS ERROR :",
            e
        )

        # ====================================================
        # SOURCE SQL CONNECTION FAILURE
        # ====================================================

        if is_sql_connection_error(e):

            print(
                "SOURCE SQL COMMUNICATION FAILURE DETECTED."
            )

            # Do not try rejection using a broken source
            # connection.
            #
            # Main loop will reconnect source SQL.
            #
            # Mirror record remains safe.

            src_conn = reconnect_db(
                src_conn,
                sqlConfig1,
                "SOURCE SQL"
            )

            return src_conn, dst_conn

        # ====================================================
        # NORMAL UNEXPECTED ERROR
        # ====================================================

        if row:

            try:

                handle_failure(
                    src_conn,
                    row
                )

            except Exception as failure_error:

                print(
                    "FAILURE HANDLER ERROR :",
                    failure_error
                )

        return src_conn, dst_conn

    finally:

        try:

