SELECT
    COLUMN_NAME,
    DATA_TYPE,
    COLUMNPROPERTY(
        OBJECT_ID('taco_treceability.master_line_cell_scanning_status'),
        'Srno',
        'IsIdentity'
    ) AS IsIdentity
FROM INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_NAME = 'master_line_cell_scanning_status'
AND COLUMN_NAME = 'Srno';
