// =====================================================
// GRACEFUL SHUTDOWN
// =====================================================

async function shutdown() {
    console.log("Shutting down server...");

    io.close();

    if (pool) {
        try {
            await pool.close();
        } catch (error) {
            console.error(
                "SQL shutdown error:",
                error.message
            );
        }
    }

    process.exit(0);
}

process.on("SIGINT", shutdown);
process.on("SIGTERM", shutdown);
