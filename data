// ============================================================
// START SERVER
// ============================================================

async function startServer() {

    try {

        // --------------------------------------------------------
        // Test MASTER connection
        // --------------------------------------------------------

        await getMasterPool();


        console.log(
            "Master database connection successful."
        );


        // --------------------------------------------------------
        // START SERVER
        // --------------------------------------------------------

        app.listen(
            PORT,
            "0.0.0.0",
            () => {

                console.log("");
                console.log(
                    "============================================"
                );

                console.log(
                    `Server running on http://localhost:${PORT}`
                );

                console.log(
                    "============================================"
                );

            }
        );


    } catch (error) {

        console.error(
            "Unable to start application:",
            error
        );


        process.exit(1);

    }

}


startServer();


// ============================================================
// GRACEFUL SHUTDOWN
// ============================================================

async function shutdown() {

    console.log(
        "Closing database connections..."
    );


    try {

        if (masterPool) {

            await masterPool.close();

        }


        if (cellScanningPool) {

            await cellScanningPool.close();

        }


        if (completedHistoryPool) {

            await completedHistoryPool.close();

        }


    } catch (error) {

        console.error(
            "Error while closing DB connections:",
            error
        );

    }


    process.exit(0);

}


// ============================================================
// PROCESS SIGNALS
// ============================================================

process.on(
    "SIGINT",
    shutdown
);


process.on(
    "SIGTERM",
    shutdown
);
