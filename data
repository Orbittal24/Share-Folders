const express = require("express");
const cors = require("cors");
const sql = require("mssql");
const net = require("net");

const app = express();
app.use(cors());
app.use(express.json({ limit: "1mb" }));

// ============================================================
// CONFIGURATION
// ============================================================
const API_HOST = process.env.API_HOST || "0.0.0.0";
const API_PORT = Number(process.env.API_PORT || 3000);

const TCP_HOST = process.env.TCP_HOST || "10.9.4.28";
const TCP_PORT = Number(process.env.TCP_PORT || 1826);

// SQL Server configuration.
// The supplied table is in database taco_treceability_master
// under schema taco_treceability.
const sqlConfig = {
  user: process.env.DB_USER || "user_mis",
  password: process.env.DB_PASSWORD || "admin",
  database: process.env.DB_DATABASE || "taco_treceability_master",
  server: process.env.DB_SERVER || "localhost",
  pool: {
    max: 10,
    min: 0,
    idleTimeoutMillis: 30000
  },
  options: {
    encrypt: true,
    trustServerCertificate: true
  }
};

const LINE_STATUS_QUERY = `
SELECT TOP (1)
    Srno,
    line_no,
    status
FROM taco_treceability.master_line_cell_scanning_status
WHERE line_no = @line_no
ORDER BY Srno DESC
`;

// ============================================================
// TCP CLIENT MANAGEMENT
// ============================================================
const tcpClients = new Set();
let sqlPool = null;

function broadcast(payload) {
  const message = JSON.stringify(payload) + "\n";
  let sent = 0;

  for (const socket of tcpClients) {
    if (!socket.destroyed && socket.writable) {
      try {
        socket.write(message);
        sent++;
      } catch (err) {
        console.error("[TCP] Broadcast error:", err.message);
      }
    }
  }

  console.log(`[TCP] Broadcasted to ${sent}/${tcpClients.size} client(s): ${message.trim()}`);
  return sent;
}

const tcpServer = net.createServer((socket) => {
  tcpClients.add(socket);

  const remote = `${socket.remoteAddress}:${socket.remotePort}`;
  console.log(`[TCP] Client connected: ${remote}`);
  console.log(`[TCP] Active clients: ${tcpClients.size}`);

  socket.setKeepAlive(true, 10000);

  socket.on("error", (err) => {
    console.error(`[TCP] Client error ${remote}: ${err.message}`);
  });

  socket.on("close", () => {
    tcpClients.delete(socket);
    console.log(`[TCP] Client disconnected: ${remote}`);
    console.log(`[TCP] Active clients: ${tcpClients.size}`);
  });
});

async function getSqlPool() {
  if (sqlPool && sqlPool.connected) {
    return sqlPool;
  }

  if (sqlPool) {
    try { await sqlPool.close(); } catch (_) {}
    sqlPool = null;
  }

  console.log("[SQL] Connecting to SQL Server...");
  sqlPool = await new sql.ConnectionPool(sqlConfig).connect();
  console.log("[SQL] Connected successfully.");
  return sqlPool;
}

async function getLineStatus(lineNo) {
  const pool = await getSqlPool();

  const result = await pool
    .request()
    .input("line_no", sql.VarChar(50), String(lineNo).trim())
    .query(LINE_STATUS_QUERY);

  return result.recordset[0] || null;
}

// ============================================================
// HEALTH CHECK
// ============================================================
app.get("/health", async (req, res) => {
  let db = "disconnected";

  try {
    const pool = await getSqlPool();
    if (pool.connected) db = "connected";
  } catch (err) {
    console.error("[HEALTH] SQL error:", err.message);
  }

  res.json({
    success: true,
    api: "running",
    database: db,
    tcp: {
      host: TCP_HOST,
      port: TCP_PORT,
      connected_clients: tcpClients.size
    }
  });
});

// ============================================================
// BUZZER STATUS API
// ============================================================
// Frontend sends:
// {
//   "line_no": "1",
//   "cellqr": "CELL-QR-123"
// }
//
// If DB status is OFF:
//   Do not broadcast.
//
// If DB status is ON:
//   Broadcast line_no + cellqr to every connected TCP client.
//
// The frontend can continue using:
// /insert_combined_ModulePack_status/buzzer_status
// so only the request body needs to change.
// ============================================================
app.post("/insert_combined_ModulePack_status/buzzer_status", async (req, res) => {
  const lineNo = req.body?.line_no;
  const cellqr = req.body?.cellqr;

  if (lineNo === undefined || lineNo === null || String(lineNo).trim() === "") {
    return res.status(400).json({
      success: false,
      status: "error",
      message: "line_no is required"
    });
  }

  if (cellqr === undefined || cellqr === null || String(cellqr).trim() === "") {
    return res.status(400).json({
      success: false,
      status: "error",
      message: "cellqr is required"
    });
  }

  const normalizedLine = String(lineNo).trim();
  const normalizedCellQr = String(cellqr).trim();

  try {
    const row = await getLineStatus(normalizedLine);

    if (!row) {
      console.warn(`[BUZZER API] No line status found for line ${normalizedLine}`);

      return res.status(404).json({
        success: false,
        status: "not_found",
        line_no: normalizedLine,
        cellqr: normalizedCellQr,
        broadcasted: false,
        message: `No status found for line ${normalizedLine}`
      });
    }

    const dbStatus = String(row.status || "").trim().toUpperCase();

    console.log(
      `[BUZZER API] line=${normalizedLine}, cellqr=${normalizedCellQr}, DB status=${dbStatus}`
    );

    if (dbStatus !== "ON") {
      return res.json({
        success: true,
        status: "OFF",
        line_no: normalizedLine,
        cellqr: normalizedCellQr,
        broadcasted: false,
        clients: tcpClients.size,
        message: "Line status is OFF. Normal frontend flow continues."
      });
    }

    const payload = {
      event: "INVALID_CELL_BUZZER",
      line_no: normalizedLine,
      cellqr: normalizedCellQr,
      timestamp: new Date().toISOString()
    };

    const clientCount = broadcast(payload);

    return res.json({
      success: true,
      status: "ON",
      line_no: normalizedLine,
      cellqr: normalizedCellQr,
      broadcasted: true,
      clients: clientCount,
      message: "Invalid cell broadcasted to TCP clients."
    });

  } catch (err) {
    console.error("[BUZZER API] Error:", err);

    // Do not crash the API if SQL temporarily fails.
    sqlPool = null;

    return res.status(500).json({
      success: false,
      status: "error",
      broadcasted: false,
      message: "Failed to check line status.",
      error: err.message
    });
  }
});

// ============================================================
// START
// ============================================================
async function start() {
  try {
    // Establish SQL connection during startup.
    await getSqlPool();

    tcpServer.listen(TCP_PORT, TCP_HOST, () => {
      console.log("====================================================");
      console.log(" CELL BUZZER TCP SERVER");
      console.log("====================================================");
      console.log(`TCP Server : ${TCP_HOST}:${TCP_PORT}`);
      console.log(`API Server : ${API_HOST}:${API_PORT}`);
      console.log(`Database   : ${sqlConfig.server}`);
      console.log(`DB Name    : ${sqlConfig.database}`);
      console.log("====================================================");
    });

    app.listen(API_PORT, API_HOST, () => {
      console.log(`[API] Listening on ${API_HOST}:${API_PORT}`);
    });

  } catch (err) {
    console.error("[STARTUP] Failed:", err);
    process.exit(1);
  }
}

// Graceful shutdown.
async function shutdown(signal) {
  console.log(`[SYSTEM] ${signal} received. Shutting down...`);

  for (const socket of tcpClients) {
    try { socket.destroy(); } catch (_) {}
  }

  tcpServer.close();

  if (sqlPool) {
    try { await sqlPool.close(); } catch (_) {}
  }

  process.exit(0);
}

process.on("SIGINT", () => shutdown("SIGINT"));
process.on("SIGTERM", () => shutdown("SIGTERM"));

start();
