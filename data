$port  = 6379          # change to 1433 or 52299 to check SQL connections the same way
New-Item -ItemType Directory -Force C:\temp | Out-Null

$conns = Get-NetTCPConnection -RemotePort $port -State Established | Group-Object OwningProcess
$procs = Get-CimInstance Win32_Process
$svcs  = Get-CimInstance Win32_Service | Where ProcessId -gt 0

$result = foreach ($g in $conns) {
    $procId  = [int]$g.Name
    $p       = $procs | Where ProcessId -eq $procId
    $parent  = $procs | Where ProcessId -eq $p.ParentProcessId
    $gparent = $procs | Where ProcessId -eq $parent.ParentProcessId
    [pscustomobject]@{
        PID         = $procId
        Conns       = $g.Count
        Name        = $p.Name
        Started     = $p.CreationDate
        Service     = ($svcs | Where ProcessId -eq $procId).Name
        CommandLine = $p.CommandLine
        ParentPID   = $p.ParentProcessId
        ParentCmd   = $parent.CommandLine
        GParentCmd  = $gparent.CommandLine
    }
}

$result | Sort Conns -Descending | Format-List
$result | Export-Csv "C:\temp\pids_port_$port.csv" -NoTypeInformation
