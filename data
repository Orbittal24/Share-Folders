dir C:\project\buzzer\buzzer_client_ready\nssm.exe

C:\project\buzzer\buzzer_client_ready\nssm.exe version

sc create TACO_Test_Service binPath= "C:\Windows\System32\cmd.exe"


@echo off
setlocal
title TACO Buzzer Service Installer

set "APP_DIR=C:\project\buzzer\buzzer_client_ready"
set "NSSM=%APP_DIR%\nssm.exe"
set "SCRIPT=%APP_DIR%\buzzer_client_live_2relay.js"
set "SERVICE=TACO_Buzzer_Client_2Relay"
set "LOG_DIR=%APP_DIR%\logs"

echo ==========================================
echo       TACO BUZZER SERVICE INSTALLER
echo ==========================================

:: Check Administrator
fltmc >nul 2>&1
if errorlevel 1 (
    echo Requesting Administrator Access...
    powershell -NoProfile -Command "Start-Process -FilePath '%~f0' -Verb RunAs"
    exit /b
)

echo Administrator permission verified.

:: Check application files
if not exist "%NSSM%" (
    echo ERROR: NSSM executable missing!
    echo Expected: %NSSM%
    pause
    exit /b 1
)

if not exist "%SCRIPT%" (
    echo ERROR: JavaScript file missing!
    pause
    exit /b 1
)

:: Check Node.js
set "NODE="
for /f "delims=" %%A in ('where node 2^>nul') do (
    if not defined NODE set "NODE=%%A"
)

if not defined NODE (
    echo ERROR: Node.js not found!
    pause
    exit /b 1
)

if not exist "%LOG_DIR%" mkdir "%LOG_DIR%"

echo Node: %NODE%
echo NSSM: %NSSM%

:: Test NSSM executable
"%NSSM%" version
if errorlevel 1 (
    echo ERROR: NSSM cannot execute.
    pause
    exit /b 1
)

:: Check existing service
sc query "%SERVICE%" >nul 2>&1

if errorlevel 1 (
    echo Installing new service...

    "%NSSM%" install "%SERVICE%" "%NODE%"

    if errorlevel 1 (
        echo ERROR: Service installation failed.
        pause
        exit /b 1
    )
) else (
    echo Service already exists. Updating configuration...

    "%NSSM%" stop "%SERVICE%" confirm

    "%NSSM%" set "%SERVICE%" Application "%NODE%"
)

:: Configure Node.js script
"%NSSM%" set "%SERVICE%" AppParameters "\"%SCRIPT%\""
if errorlevel 1 goto ERROR

"%NSSM%" set "%SERVICE%" AppDirectory "%APP_DIR%"
if errorlevel 1 goto ERROR

"%NSSM%" set "%SERVICE%" DisplayName "TACO Buzzer Client 2 Relay"
if errorlevel 1 goto ERROR

"%NSSM%" set "%SERVICE%" Start SERVICE_AUTO_START
if errorlevel 1 goto ERROR

:: Restart on crash
"%NSSM%" set "%SERVICE%" AppExit Default Restart
if errorlevel 1 goto ERROR

"%NSSM%" set "%SERVICE%" AppRestartDelay 5000
if errorlevel 1 goto ERROR

:: Configure logs
"%NSSM%" set "%SERVICE%" AppStdout "%LOG_DIR%\buzzer_stdout.log"
if errorlevel 1 goto ERROR

"%NSSM%" set "%SERVICE%" AppStderr "%LOG_DIR%\buzzer_error.log"
if errorlevel 1 goto ERROR

"%NSSM%" set "%SERVICE%" AppStdoutCreationDisposition 4
"%NSSM%" set "%SERVICE%" AppStderrCreationDisposition 4

:: Start service
echo.
echo Starting service...

"%NSSM%" start "%SERVICE%"

if errorlevel 1 goto ERROR

echo.
echo ==========================================
echo SERVICE INSTALLED SUCCESSFULLY
echo ==========================================

sc query "%SERVICE%"

echo.
echo Logs: %LOG_DIR%
pause
exit /b 0

:ERROR
echo.
echo ==========================================
echo ERROR: SERVICE CONFIGURATION FAILED
echo ==========================================
echo Check administrator permission and NSSM.
sc query "%SERVICE%"
pause
exit /b 1
