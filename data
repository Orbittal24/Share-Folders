
@echo off
title TACO Buzzer Windows Service Installer

:: Check Administrator Permission
net session >nul 2>&1
if %errorlevel% neq 0 (
    echo Requesting Administrator Permission...
    powershell -Command "Start-Process '%~f0' -Verb RunAs"
    exit /b
)

:: Configuration
set "APP_DIR=C:\project\buzzer\buzzer_client_ready"
set "SCRIPT_NAME=buzzer_client_live_2relay.js"
set "SERVICE_NAME=TACO_Buzzer_Client_2Relay"
set "SERVICE_DISPLAY=TACO Buzzer Client 2 Relay"
set "NSSM=%APP_DIR%\nssm.exe"
set "LOG_DIR=%APP_DIR%\logs"

echo.
echo ==========================================
echo       TACO BUZZER SERVICE INSTALLER
echo ==========================================

:: Check NSSM
if not exist "%NSSM%" (
    echo ERROR: nssm.exe not found!
    echo Please copy nssm.exe into:
    echo %APP_DIR%
    pause
    exit /b 1
)

:: Check JavaScript File
if not exist "%APP_DIR%\%SCRIPT_NAME%" (
    echo ERROR: JavaScript file not found!
    echo %APP_DIR%\%SCRIPT_NAME%
    pause
    exit /b 1
)

:: Find Node.js
set "NODE_EXE="
for /f "delims=" %%N in ('where node 2^>nul') do (
    if not defined NODE_EXE set "NODE_EXE=%%N"
)

if not defined NODE_EXE (
    echo ERROR: Node.js not found in PATH!
    pause
    exit /b 1
)

:: Create Logs Directory
if not exist "%LOG_DIR%" mkdir "%LOG_DIR%"

echo Node.js: %NODE_EXE%
echo Script: %APP_DIR%\%SCRIPT_NAME%

:: Install Service if it does not exist
"%NSSM%" status "%SERVICE_NAME%" >nul 2>&1

if errorlevel 1 (
    echo Installing Windows Service...
    "%NSSM%" install "%SERVICE_NAME%" "%NODE_EXE%"
) else (
    echo Existing service found. Updating configuration...
    "%NSSM%" stop "%SERVICE_NAME%" confirm
    "%NSSM%" set "%SERVICE_NAME%" Application "%NODE_EXE%"
)

:: Configure Service
"%NSSM%" set "%SERVICE_NAME%" AppParameters "\"%APP_DIR%\%SCRIPT_NAME%\""
"%NSSM%" set "%SERVICE_NAME%" AppDirectory "%APP_DIR%"
"%NSSM%" set "%SERVICE_NAME%" DisplayName "%SERVICE_DISPLAY%"
"%NSSM%" set "%SERVICE_NAME%" Start SERVICE_AUTO_START

:: Automatic Restart on Application Failure
"%NSSM%" set "%SERVICE_NAME%" AppExit Default Restart
"%NSSM%" set "%SERVICE_NAME%" AppRestartDelay 5000

:: Log Files
"%NSSM%" set "%SERVICE_NAME%" AppStdout "%LOG_DIR%\buzzer_stdout.log"
"%NSSM%" set "%SERVICE_NAME%" AppStderr "%LOG_DIR%\buzzer_error.log"

:: Enable Log Append
"%NSSM%" set "%SERVICE_NAME%" AppStdoutCreationDisposition 4
"%NSSM%" set "%SERVICE_NAME%" AppStderrCreationDisposition 4

:: Start Service
echo.
echo Starting Buzzer Windows Service...

sc config "%SERVICE_NAME%" start= auto >nul
"%NSSM%" start "%SERVICE_NAME%"

echo.
echo ==========================================
echo       SERVICE INSTALLATION COMPLETE
echo ==========================================

sc query "%SERVICE_NAME%"

echo.
echo Log Location:
echo %LOG_DIR%
echo.
pause
