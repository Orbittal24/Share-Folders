// ============================================================
// PROCESS PACK
// ============================================================

app.post(
    "/api/process-pack",
    async (req, res) => {

        try {

            const {
                packNo,
                packId
            } = req.body;


            // ====================================================
            // VALIDATE PACK NO
            // ====================================================

            if (!packNo) {

                return res.status(400).json({

                    success: false,

                    message:
                        "Pack No is required."

                });

            }


            if (
                !/^\d{6}$/.test(
                    String(packNo)
                )
            ) {

                return res.status(400).json({

                    success: false,

                    message:
                        "Pack No must contain exactly 6 digits."

                });

            }


            // ====================================================
            // VALIDATE PACK ID
            // ====================================================

            if (!packId) {

                return res.status(400).json({

                    success: false,

                    message:
                        "Pack ID is required."

                });

            }


            console.log("");

            console.log(
                "============================================"
            );

            console.log(
                "PROCESSING PACK"
            );

            console.log(
                "Pack No :",
                packNo
            );

            console.log(
                "Pack ID :",
                packId
            );

            console.log(
                "============================================"
            );


            // ====================================================
            // STEP 1
            // GET LINE ID + PACK CREATION DATE
            // ====================================================

            const cellPool =
                await getCellScanningPool();


            const duplicateResult =
                await cellPool
                    .request()

                    .input(
                        "PackNo",
                        sql.VarChar,
                        String(packNo)
                    )

                    .input(
                        "PackID",
                        sql.VarChar,
                        String(packId)
                    )

                    .query(`

                        SELECT
                            Line_Id,
                            pack_creation_Date

                        FROM Pack_duplicate_checker

                        WHERE Pack_No = @PackNo

                        AND Pack_ID = @PackID

                    `);


            if (
                duplicateResult.recordset.length === 0
            ) {

                return res.status(404).json({

                    success: false,

                    message:
                        "No record found in Pack_duplicate_checker for the given Pack No and Pack ID."

                });

            }


            // ====================================================
            // TAKE FIRST MATCHING RECORD
            // ====================================================

            const duplicateRecord =
                duplicateResult.recordset[0];


            const lineId =
                duplicateRecord.Line_Id;


            // ====================================================
            // STEP 2
            // EXTRACT PACK CREATION DATE
            // ====================================================

            const rawCreationDate =
                duplicateRecord.pack_creation_Date;


            let packCreationDate;


            if (
                rawCreationDate instanceof Date
            ) {

                const year =
                    rawCreationDate
                        .getFullYear();


                const month =
                    String(
                        rawCreationDate.getMonth() + 1
                    ).padStart(
                        2,
                        "0"
                    );


                const day =
                    String(
                        rawCreationDate.getDate()
                    ).padStart(
                        2,
                        "0"
                    );


                packCreationDate =
                    `${year}_${month}_${day}`;

            } else {

                const dateString =
                    String(
                        rawCreationDate
                    );


                const match =
                    dateString.match(
                        /(\d{4})[-_](\d{2})[-_](\d{2})/
                    );


                if (!match) {

                    throw new Error(
                        "Unable to extract pack_creation_Date."
                    );

                }


                packCreationDate =
                    `${match[1]}_${match[2]}_${match[3]}`;

            }


            console.log(
                "Line ID:",
                lineId
            );


            console.log(
                "Pack Creation Date:",
                packCreationDate
            );


            // ====================================================
            // STEP 3
            // GET LINE NO FROM MASTER_LINE
            // ====================================================

            const masterPool =
                await getMasterPool();


            const lineResult =
                await masterPool
                    .request()

                    .input(
                        "LineId",
                        sql.VarChar,
                        String(lineId)
                    )

                    .query(`

                        SELECT
                            line_no

                        FROM taco_treceability.master_line

                        WHERE Srno = @LineId

                    `);


            if (
                lineResult.recordset.length === 0
            ) {

                return res.status(404).json({

                    success: false,

                    message:
                        `No line found for Line_Id ${lineId}.`

                });

            }


            const lineNo =
                lineResult.recordset[0].line_no;


            const finalLineNo =
                lineNo == null
                    ? ""
                    : String(
                        lineNo
                    ).trim();


            if (!finalLineNo) {

                return res.status(404).json({

                    success: false,

                    message:
                        `Line No is empty for Line_Id ${lineId}.`

                });

            }


            console.log(
                "Line No:",
                finalLineNo
            );


            // ====================================================
            // STEP 4
            // FIND PACK HISTORY TABLES
            // ====================================================

            const historyPool =
                await getCompletedHistoryPool();


            const tableResult =
                await historyPool
                    .request()

                    .input(
                        "CreationDate",
                        sql.VarChar,
                        packCreationDate
                    )

                    .query(`

                        SELECT
                            TABLE_NAME

                        FROM INFORMATION_SCHEMA.TABLES

                        WHERE TABLE_TYPE = 'BASE TABLE'

                        AND TABLE_NAME LIKE
                            'pack_history_' +
                            @CreationDate +
                            '_%'

                    `);


            let historyTables =
                tableResult.recordset
                    .map(
                        row =>
                            row.TABLE_NAME
                    );


            // ====================================================
            // VALIDATE HISTORY TABLE NAMES
            // ====================================================

            historyTables =
                historyTables.filter(
                    tableName => {

                        const parts =
                            tableName.split("_");


                        if (
                            parts.length < 8
                        ) {

                            return false;

                        }


                        const dateAtPosition2 =
                            `${parts[2]}_${parts[3]}_${parts[4]}`;


                        return (
                            dateAtPosition2 ===
                            packCreationDate
                        );

                    }
                );


            console.log(
                "History Tables:"
            );


            historyTables.forEach(
                tableName => {

                    console.log(
                        "  ",
                        tableName
                    );

                }
            );


            if (
                historyTables.length === 0
            ) {

                return res.status(404).json({

                    success: false,

                    message:
                        `No pack history table found for ${packCreationDate}.`

                });

            }


            // ====================================================
            // STEP 5
            // PROCESS ALL PACK HISTORY TABLES
            // ====================================================

            const allRecords = [];


            for (
                const tableName of historyTables
            ) {

                // ------------------------------------------------
                // SAFETY CHECK TABLE NAME
                // ------------------------------------------------

                if (
                    !/^pack_history_\d{4}_\d{2}_\d{2}_\d{4}_\d{2}_\d{2}$/
                        .test(tableName)
                ) {

                    console.log(
                        "Skipping invalid table:",
                        tableName
                    );

                    continue;

                }


                console.log("");

                console.log(
                    "============================================"
                );

                console.log(
                    "PROCESSING PACK HISTORY TABLE:",
                    tableName
                );

                console.log(
                    "Line ID:",
                    lineId
                );

                console.log(
                    "Line No:",
                    finalLineNo
                );

                console.log(
                    "Pack No:",
                    packNo
                );

                console.log(
                    "============================================"
                );


                // =================================================
                // UPDATE PACK HISTORY
                // =================================================

                const updateQuery = `

                    UPDATE [${tableName}]

                    SET module_barcode =
                        REPLACE(
                            module_barcode,
                            'None',
                            @LineNo
                        )

                    WHERE pack_no = @PackNo

                    AND module_barcode LIKE '%None%'

                `;


                const updateResult =
                    await historyPool
                        .request()

                        .input(
                            "LineNo",
                            sql.VarChar,
                            finalLineNo
                        )

                        .input(
                            "PackNo",
                            sql.VarChar,
                            String(packNo)
                        )

                        .query(
                            updateQuery
                        );


                console.log(
                    "Pack History Database Rows Updated:",
                    updateResult.rowsAffected
                );


                // =================================================
                // SELECT PACK HISTORY RECORDS
                // =================================================

                const query = `

                    SELECT
                        pack_name,
                        pack_id,
                        line_id,
                        pack_no,
                        module_barcode

                    FROM [${tableName}]

                    WHERE pack_no = @PackNo

                    ORDER BY sr_no

                `;


                const result =
                    await historyPool
                        .request()

                        .input(
                            "PackNo",
                            sql.VarChar,
                            String(packNo)
                        )

                        .query(
                            query
                        );


                console.log(
                    "Pack History Records Found After Update:",
                    result.recordset.length
                );


                // =================================================
                // ADD PACK HISTORY RECORDS
                // =================================================

                for (
                    const row of result.recordset
                ) {

                    const moduleBarcode =
                        row.module_barcode == null
                            ? ""
                            : String(
                                row.module_barcode
                            ).trim();


                    console.log(
                        "Pack History Module Barcode:",
                        moduleBarcode
                    );


                    allRecords.push({

                        tableName,

                        packName:
                            row.pack_name,

                        packId:
                            row.pack_id,

                        lineId:
                            row.line_id,

                        packNo:
                            row.pack_no,

                        moduleBarcode

                    });

                }

            }


            // ====================================================
            // STEP 6
            // MODULE REGISTER TABLE NAME
            //
            // 2026_03_10
            //
            // becomes
            //
            // module_register_10_03_26
            // ====================================================

            const dateParts =
                packCreationDate.split("_");


            if (
                dateParts.length !== 3
            ) {

                throw new Error(
                    `Invalid pack creation date format: ${packCreationDate}`
                );

            }


            const year =
                dateParts[0];

            const month =
                dateParts[1];

            const day =
                dateParts[2];


            const shortYear =
                year.slice(-2);


            const moduleRegisterTable =
                `module_register_${day}_${month}_${shortYear}`;


            // ====================================================
            // SAFETY CHECK
            // ====================================================

            if (
                !/^module_register_\d{2}_\d{2}_\d{2}$/
                    .test(
                        moduleRegisterTable
                    )
            ) {

                throw new Error(
                    `Invalid Module Register table name: ${moduleRegisterTable}`
                );

            }


            console.log("");

            console.log(
                "============================================"
            );

            console.log(
                "PROCESSING MODULE REGISTER"
            );

            console.log(
                "Database:",
                DATABASES.MODULE_REGISTER
            );

            console.log(
                "Schema:",
                "taco_treceability"
            );

            console.log(
                "Table:",
                moduleRegisterTable
            );

            console.log(
                "Line ID:",
                lineId
            );

            console.log(
                "Line No:",
                finalLineNo
            );

            console.log(
                "Pack No:",
                packNo
            );

            console.log(
                "============================================"
            );


            // ====================================================
            // GET MODULE REGISTER CONNECTION
            // ====================================================

            const modulePool =
                await getModuleRegisterPool();


            // ====================================================
            // CHECK MODULE REGISTER TABLE
            // ====================================================

            const moduleTableCheck =
                await modulePool
                    .request()

                    .input(
                        "TableName",
                        sql.VarChar,
                        moduleRegisterTable
                    )

                    .query(`

                        SELECT
                            TABLE_SCHEMA,
                            TABLE_NAME

                        FROM INFORMATION_SCHEMA.TABLES

                        WHERE TABLE_SCHEMA =
                            'taco_treceability'

                        AND TABLE_TYPE =
                            'BASE TABLE'

                        AND TABLE_NAME =
                            @TableName

                    `);


            if (
                moduleTableCheck.recordset.length === 0
            ) {

                throw new Error(
                    `Module Register table taco_treceability.${moduleRegisterTable} does not exist in database ${DATABASES.MODULE_REGISTER}.`
                );

            }


            console.log(
                "Module Register table verified:",
                `taco_treceability.${moduleRegisterTable}`
            );


            // ====================================================
            // UPDATE MODULE REGISTER
            //
            // IMPORTANT:
            // Module Register uses Module_QR.
            // ====================================================

            const moduleRegisterUpdateQuery = `

                UPDATE [taco_treceability].[${moduleRegisterTable}]

                SET Module_QR =
                    REPLACE(
                        Module_QR,
                        'None',
                        @LineNo
                    )

                WHERE Pack_No = @PackNo

                AND Module_QR LIKE '%None%'

            `;


            const moduleRegisterUpdateResult =
                await modulePool
                    .request()

                    .input(
                        "LineNo",
                        sql.VarChar,
                        finalLineNo
                    )

                    .input(
                        "PackNo",
                        sql.VarChar,
                        String(packNo)
                    )

                    .query(
                        moduleRegisterUpdateQuery
                    );


            console.log(
                "Module Register Database Rows Updated:",
                moduleRegisterUpdateResult.rowsAffected
            );


            // ====================================================
            // SELECT MODULE REGISTER RECORDS
            // ====================================================

            const moduleRegisterSelectQuery = `

                SELECT
                    srno,
                    Pack_ID,
                    Module_ID,
                    Module_QR,
                    Line_ID,
                    Pack_creation_Date,
                    Pack_No,
                    Cur_Date

                FROM [taco_treceability].[${moduleRegisterTable}]

                WHERE Pack_No = @PackNo

                ORDER BY srno

            `;


            const moduleRegisterResult =
                await modulePool
                    .request()

                    .input(
                        "PackNo",
                        sql.VarChar,
                        String(packNo)
                    )

                    .query(
                        moduleRegisterSelectQuery
                    );


            console.log(
                "Module Register Records Found After Update:",
                moduleRegisterResult.recordset.length
            );


            // ====================================================
            // PREPARE MODULE REGISTER RESPONSE
            // ====================================================

            const moduleRegisterRecords = [];


            for (
                const row of moduleRegisterResult.recordset
            ) {

                const moduleBarcode =
                    row.Module_QR == null
                        ? ""
                        : String(
                            row.Module_QR
                        ).trim();


                console.log(
                    "Module Register Module QR:",
                    moduleBarcode
                );


                moduleRegisterRecords.push({

                    tableName:
                        moduleRegisterTable,

                    srNo:
                        row.srno,

                    packId:
                        row.Pack_ID,

                    moduleId:
                        row.Module_ID,

                    lineId:
                        row.Line_ID,

                    packNo:
                        row.Pack_No,

                    moduleBarcode,

                    packCreationDate:
                        row.Pack_creation_Date,

                    curDate:
                        row.Cur_Date

                });

            }


            // ====================================================
            // FINAL COUNTS
            // ====================================================

            console.log("");

            console.log(
                "============================================"
            );

            console.log(
                "PROCESS COMPLETED"
            );

            console.log(
                "Pack History Records:",
                allRecords.length
            );

            console.log(
                "Module Register Records:",
                moduleRegisterRecords.length
            );

            console.log(
                "============================================"
            );


            // ====================================================
            // FINAL RESPONSE
            //
            // IMPORTANT:
            // Pack History is returned as packHistoryRecords.
            // ====================================================

            res.json({

                success: true,

                message:
                    "Pack History and Module Register processing completed successfully.",

                packNo,

                packId,

                lineId,

                lineNo:
                    finalLineNo,

                packCreationDate,

                historyTables,

                // PACK HISTORY
                packHistoryRecords:
                    allRecords,

                // MODULE REGISTER
                moduleRegisterTable,

                moduleRegisterRecords

            });


        } catch (error) {

            console.error("");

            console.error(
                "============================================"
            );

            console.error(
                "PROCESS PACK ERROR"
            );

            console.error(
                error
            );

            console.error(
                "============================================"
            );


            res.status(500).json({

                success: false,

                message:
                    "Error while processing pack.",

                error:
                    error.message

            });

        }

    }
);


