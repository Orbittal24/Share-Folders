<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>MES Cell Data - History</title>
<style>
  :root {
    --bg: #f4f6f8;
    --panel: #ffffff;
    --line: #dfe4ea;
    --text: #1f2933;
    --muted: #6b7684;
    --accent: #1e5fa8;
    --ok: #1a7f4b;
    --ok-bg: #e3f5eb;
    --warn: #9a6400;
    --warn-bg: #fdf1dc;
    --bad: #a82020;
    --bad-bg: #fbe6e6;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font: 14px/1.5 "Segoe UI", Arial, sans-serif;
    background: var(--bg);
    color: var(--text);
  }
  header {
    background: var(--accent);
    color: #fff;
    padding: 14px 20px;
  }
  header h1 { margin: 0; font-size: 18px; font-weight: 600; }
  header .sub { font-size: 12px; opacity: .85; margin-top: 2px; }

  .wrap { padding: 16px 20px 40px; max-width: 1500px; margin: 0 auto; }

  .cards { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
  .card {
    background: var(--panel); border: 1px solid var(--line);
    border-radius: 6px; padding: 10px 16px; min-width: 125px;
  }
  .card .label { font-size: 11px; text-transform: uppercase; color: var(--muted); letter-spacing: .04em; }
  .card .value { font-size: 22px; font-weight: 600; margin-top: 2px; }

  .panel {
    background: var(--panel); border: 1px solid var(--line);
    border-radius: 6px; padding: 14px 16px; margin-bottom: 16px;
  }

  .filters { display: flex; gap: 14px; flex-wrap: wrap; align-items: flex-end; }
  .field { display: flex; flex-direction: column; gap: 4px; }
  .field label { font-size: 11px; text-transform: uppercase; color: var(--muted); letter-spacing: .04em; }
  input, select {
    font: inherit; padding: 7px 9px; border: 1px solid var(--line);
    border-radius: 4px; background: #fff; color: var(--text);
  }
  input[type=text] { min-width: 280px; }
  button {
    font: inherit; padding: 8px 16px; border: 1px solid var(--accent);
    border-radius: 4px; background: var(--accent); color: #fff; cursor: pointer;
  }
  button.ghost { background: #fff; color: var(--accent); }
  button:disabled { opacity: .45; cursor: default; }
  .quick { display: flex; gap: 6px; margin-top: 10px; flex-wrap: wrap; }
  .quick button {
    padding: 4px 10px; font-size: 12px; background: #fff;
    color: var(--accent); border-color: var(--line);
  }

  .verdict { padding: 12px 16px; border-radius: 6px; margin-bottom: 14px; font-size: 15px; display: none; }
  .verdict.found { background: var(--ok-bg); border: 1px solid #b9e2cc; color: var(--ok); display: block; }
  .verdict.missing { background: var(--bad-bg); border: 1px solid #f0c2c2; color: var(--bad); display: block; }

  table { width: 100%; border-collapse: collapse; background: var(--panel); }
  th, td { padding: 8px 10px; text-align: left; border-bottom: 1px solid var(--line); white-space: nowrap; }
  th { font-size: 11px; text-transform: uppercase; color: var(--muted); letter-spacing: .04em; background: #fafbfc; }
  td.qr { font-family: Consolas, "Courier New", monospace; font-size: 13px; }
  td.num { text-align: right; font-variant-numeric: tabular-nums; }
  tbody tr:hover { background: #f7f9fb; }

  .badge { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 12px; font-weight: 600; }
  .badge.sent { background: var(--ok-bg); color: var(--ok); }
  .badge.queued { background: var(--warn-bg); color: var(--warn); }
  .badge.lost { background: var(--bad-bg); color: var(--bad); }
  .suspect { color: var(--bad); }
  .changed { color: var(--warn); font-weight: 600; }

  .tablewrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 6px; }
  .pager { display: flex; gap: 10px; align-items: center; margin-top: 12px; }
  .pager .info { color: var(--muted); font-size: 13px; }
  .empty, .loading { padding: 30px; text-align: center; color: var(--muted); }
  .err { padding: 12px 16px; background: var(--bad-bg); color: var(--bad); border-radius: 6px; margin-bottom: 14px; }
  .note { font-size: 12px; color: var(--muted); margin-top: 10px; }
</style>
</head>
<body>

<header>
  <h1>MES Cell Data &mdash; History</h1>
  <div class="sub" id="subtitle">Loading...</div>
</header>

<div class="wrap">

  <div class="cards" id="cards"></div>

  <div class="panel">
    <div class="filters">
      <div class="field">
        <label for="qr">Cell QR code (full or partial)</label>
        <input type="text" id="qr" placeholder="e.g. 03HCB00LG6T5BVG6T0992044" autofocus>
      </div>
      <div class="field">
        <label for="from">From date</label>
        <input type="date" id="from">
      </div>
      <div class="field">
        <label for="to">To date</label>
        <input type="date" id="to">
      </div>
      <div class="field">
        <label for="status">Status</label>
        <select id="status">
          <option value="">All</option>
          <option value="sent">Sent to MES</option>
          <option value="notsent">Not sent</option>
        </select>
      </div>
      <div class="field">
        <label>&nbsp;</label>
        <button id="searchBtn">Search</button>
      </div>
      <div class="field">
        <label>&nbsp;</label>
        <button class="ghost" id="clearBtn">Clear</button>
      </div>
      <div class="field">
        <label>&nbsp;</label>
        <button class="ghost" id="csvBtn">Export CSV</button>
      </div>
    </div>
    <div class="quick">
      <button data-days="0">Today</button>
      <button data-days="1">Yesterday</button>
      <button data-days="7">Last 7 days</button>
      <button data-days="30">Last 30 days</button>
    </div>
    <div class="note">
      One row per cell. Dates filter on when the cell was <strong>first</strong> read.
      Times are shown in this PC's local time.
    </div>
  </div>

  <div id="error" class="err" style="display:none"></div>
  <div id="verdict" class="verdict"></div>

  <div class="tablewrap">
    <table>
      <thead>
        <tr>
          <th>Cell QR code</th>
          <th>Status</th>
          <th>First read</th>
          <th>Last seen</th>
          <th class="num">Reads</th>
          <th class="num">Voltage</th>
          <th class="num">IR</th>
          <th class="num">Material</th>
          <th>Node</th>
        </tr>
      </thead>
      <tbody id="rows">
        <tr><td colspan="9" class="loading">Loading...</td></tr>
      </tbody>
    </table>
  </div>

  <div class="pager">
    <button class="ghost" id="prev">&larr; Previous</button>
    <button class="ghost" id="next">Next &rarr;</button>
    <span class="info" id="pageInfo"></span>
  </div>

</div>

<script>
"use strict";

var state = { page: 1, pageSize: 100, lastRows: [] };

function $(id) { return document.getElementById(id); }

function fmtLocal(iso) {
  if (!iso) return "\u2014";
  var d = new Date(iso);
  if (isNaN(d.getTime())) return iso;
  function p(n) { return String(n).padStart(2, "0"); }
  return p(d.getDate()) + "-" + p(d.getMonth() + 1) + "-" + d.getFullYear() +
         " " + p(d.getHours()) + ":" + p(d.getMinutes()) + ":" + p(d.getSeconds());
}

function fmtNum(v, dp) {
  if (v === null || v === undefined) return "\u2014";
  // The machine writes 1e10 / ~1e13 as "no valid reading" sentinels.
  if (v >= 1e9) return "no reading";
  return Number(v).toFixed(dp);
}

function esc(s) {
  return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
    return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
  });
}

function toDateInput(d) {
  function p(n) { return String(n).padStart(2, "0"); }
  return d.getFullYear() + "-" + p(d.getMonth() + 1) + "-" + p(d.getDate());
}

function loadOverview() {
  fetch("/api/overview").then(function (r) { return r.json(); }).then(function (o) {
    $("subtitle").textContent = o.line + "  \u2022  " +
      (o.oldest ? "cells first read " + fmtLocal(o.oldest) + " to " + fmtLocal(o.newest)
                : "no records yet");

    $("cards").innerHTML =
      card("Cells stored", o.total.toLocaleString()) +
      card("Sent to MES", o.sent.toLocaleString()) +
      card("Not yet sent", o.notSent.toLocaleString()) +
      card("Waiting in queue", o.queued.toLocaleString()) +
      card("Values updated", o.changed.toLocaleString()) +
      card("NG / blank", o.ng.toLocaleString()) +
      card("Database size", o.sizeMb === null ? "\u2014" : o.sizeMb + " MB");
  }).catch(function (e) { showError(e.message); });
}

function card(label, value) {
  return '<div class="card"><div class="label">' + esc(label) +
         '</div><div class="value">' + esc(value) + "</div></div>";
}

function showError(msg) {
  $("error").style.display = "block";
  $("error").textContent = "Error: " + msg;
}

function search(resetPage) {
  if (resetPage) state.page = 1;
  $("error").style.display = "none";
  $("verdict").className = "verdict";
  $("rows").innerHTML = '<tr><td colspan="9" class="loading">Loading...</td></tr>';

  var qs = new URLSearchParams();
  var qr = $("qr").value.trim();
  if (qr) qs.set("qr", qr);
  if ($("from").value) qs.set("from", $("from").value);
  if ($("to").value) qs.set("to", $("to").value);
  if ($("status").value) qs.set("status", $("status").value);
  qs.set("page", state.page);
  qs.set("pageSize", state.pageSize);

  fetch("/api/search?" + qs.toString())
    .then(function (r) { return r.json(); })
    .then(function (d) {
      if (d.error) { showError(d.error); return; }
      render(d, qr);
    })
    .catch(function (e) { showError(e.message); });
}

function render(d, qr) {
  state.lastRows = d.rows;

  // When searching a specific code, answer the operator's question directly.
  if (qr) {
    var v = $("verdict");
    if (d.total === 0) {
      v.className = "verdict missing";
      v.textContent = "NOT FOUND \u2014 no record for \"" + qr +
        "\" in the stored history. Either it was never read by the machine, " +
        "or it is older than the retention period.";
    } else {
      var r0 = d.rows[0];
      var msg = "FOUND \u2014 " + d.total + " cell(s). First read " +
                fmtLocal(r0.firstReadAt) + ". ";
      msg += r0.sentAt ? "Sent to MES on " + fmtLocal(r0.sentAt) + "."
                       : (r0.inQueue ? "Still waiting to be sent."
                                     : "NOT sent and not in the queue.");
      if (r0.changeCount > 0) {
        msg += " Values were updated " + r0.changeCount + " time(s) after the first read.";
      }
      v.className = "verdict found";
      v.textContent = msg;
    }
  }

  var tb = $("rows");
  if (d.rows.length === 0) {
    tb.innerHTML = '<tr><td colspan="9" class="empty">No records match these filters.</td></tr>';
  } else {
    var html = "";
    for (var i = 0; i < d.rows.length; i++) {
      var r = d.rows[i];
      var badge = r.sentAt
        ? '<span class="badge sent">Sent</span>'
        : (r.inQueue
            ? '<span class="badge queued">In queue' + (r.attempts ? " (" + r.attempts + ")" : "") + "</span>"
            : '<span class="badge lost">Not sent</span>');

      var suspect = (r.voltage !== null && r.voltage >= 1e9) ? " suspect" : "";
      var reads = r.readCount > 1
        ? '<span class="' + (r.changeCount > 0 ? "changed" : "") + '">' + r.readCount +
          (r.changeCount > 0 ? " (" + r.changeCount + " changed)" : "") + "</span>"
        : String(r.readCount);

      html += "<tr>" +
        '<td class="qr">' + esc(r.qr || "(empty)") + "</td>" +
        "<td>" + badge + "</td>" +
        "<td>" + fmtLocal(r.firstReadAt) + "</td>" +
        "<td>" + fmtLocal(r.readAt) + "</td>" +
        '<td class="num">' + reads + "</td>" +
        '<td class="num' + suspect + '">' + fmtNum(r.voltage, 4) + "</td>" +
        '<td class="num' + suspect + '">' + fmtNum(r.ir, 3) + "</td>" +
        '<td class="num">' + (r.material === null ? "\u2014" : r.material) + "</td>" +
        "<td>" + esc(r.node || "\u2014") + "</td>" +
        "</tr>";
    }
    tb.innerHTML = html;
  }

  $("pageInfo").textContent =
    d.total.toLocaleString() + " cell(s)  \u2022  page " + d.page + " of " + d.pages +
    "  \u2022  " + d.sent + " sent, " + d.notSent + " not sent";
  $("prev").disabled = d.page <= 1;
  $("next").disabled = d.page >= d.pages;
  state.page = d.page;
}

function exportCsv() {
  if (!state.lastRows.length) { alert("Nothing to export."); return; }
  var lines = ["cell_qrcode,status,first_read_at,last_seen_at,read_count,change_count,voltage,ir,material,node"];
  state.lastRows.forEach(function (r) {
    var status = r.sentAt ? "sent" : (r.inQueue ? "in_queue" : "not_sent");
    lines.push([
      '"' + String(r.qr || "").replace(/"/g, '""') + '"',
      status,
      r.firstReadAt || "",
      r.readAt || "",
      r.readCount,
      r.changeCount,
      r.voltage === null ? "" : r.voltage,
      r.ir === null ? "" : r.ir,
      r.material === null ? "" : r.material,
      r.node || ""
    ].join(","));
  });
  var blob = new Blob([lines.join("\r\n")], { type: "text/csv;charset=utf-8" });
  var a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = "cells_page" + state.page + ".csv";
  a.click();
  URL.revokeObjectURL(a.href);
}

// --- wiring -----------------------------------------------------------------
$("searchBtn").addEventListener("click", function () { search(true); });
$("qr").addEventListener("keydown", function (e) { if (e.key === "Enter") search(true); });
$("from").addEventListener("change", function () { search(true); });
$("to").addEventListener("change", function () { search(true); });
$("status").addEventListener("change", function () { search(true); });
$("csvBtn").addEventListener("click", exportCsv);

$("clearBtn").addEventListener("click", function () {
  $("qr").value = ""; $("from").value = ""; $("to").value = ""; $("status").value = "";
  search(true);
});

$("prev").addEventListener("click", function () { if (state.page > 1) { state.page--; search(false); } });
$("next").addEventListener("click", function () { state.page++; search(false); });

Array.prototype.forEach.call(document.querySelectorAll(".quick button"), function (b) {
  b.addEventListener("click", function () {
    var days = parseInt(b.getAttribute("data-days"), 10);
    var end = new Date();
    var start = new Date();
    if (days === 1) {
      start.setDate(start.getDate() - 1);
      end.setDate(end.getDate() - 1);
    } else if (days > 1) {
      start.setDate(start.getDate() - (days - 1));
    }
    $("from").value = toDateInput(start);
    $("to").value = toDateInput(end);
    search(true);
  });
});

loadOverview();
search(true);
setInterval(loadOverview, 30000);
</script>

</body>
</html>
