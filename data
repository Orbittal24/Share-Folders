// ============================================================
// GET USER FROM PASSWORD
// ============================================================

function getUserFromPassword(password) {

    if (
        typeof password !== "string"
    ) {

        return null;

    }

    password =
        password.trim();

    if (password === "") {

        return null;

    }

    return users[password] || null;

}


// ============================================================
// VALIDATE SERVICE
// ============================================================

function isValidService(serviceName) {

    return (

        typeof serviceName === "string" &&

        allowedServices.includes(
            serviceName
        )

    );

}


// ============================================================
// INSERT STOP LOG
// ============================================================

async function insertStopLog(
    password,
    reason,
    serviceName
) {

    // -----------------------------------------
    // GET USER
    // -----------------------------------------

    const userName =
        getUserFromPassword(
            password
        );


    if (!userName) {

        throw new Error(
            "Invalid passcode."
        );

    }


    // -----------------------------------------
    // VALIDATE SERVICE
    // -----------------------------------------

    if (
        !isValidService(
            serviceName
        )
    ) {

        throw new Error(
            "Invalid service name."
        );

    }


    // -----------------------------------------
    // VALIDATE REASON
    // -----------------------------------------

    if (
        typeof reason !== "string" ||
        reason.trim() === ""
    ) {

        throw new Error(
            "Stop reason is required."
        );

    }


    reason =
        reason.trim();


    // -----------------------------------------
    // CHECK SQL CONNECTION
    // -----------------------------------------

    if (!dbConn.connected) {

        throw new Error(
            "SQL Server is not connected. Stop log was not inserted."
        );

    }


    // -----------------------------------------
    // SQL REQUEST
    // -----------------------------------------

    const request =
        dbConn.request();


    request.input(
        "userName",
        sql.NVarChar(100),
        userName
    );


    request.input(
        "reason",
        sql.NVarChar(sql.MAX),
        reason
    );


    request.input(
        "serviceName",
        sql.NVarChar(200),
        serviceName
    );


    // -----------------------------------------
    // INSERT
    // -----------------------------------------

    const query = `

        INSERT INTO
            taco_treceability.ocv_service_log_stop

        (
            [user],
            reason,
            service_name,
            today_date
        )

        VALUES

        (
            @userName,
            @reason,
            @serviceName,
            GETDATE()
        )

    `;


    await request.query(
        query
    );


    // -----------------------------------------
    // CONSOLE LOG
    // -----------------------------------------

    console.log(
        "========================================"
    );

    console.log(
        "OCV STOP LOG INSERTED"
    );

    console.log(
        "USER:",
        userName
    );

    console.log(
        "REASON:",
        reason
    );

    console.log(
        "SERVICE:",
        serviceName
    );

    console.log(
        "DATE:",
        new Date()
    );

    console.log(
        "========================================"
    );


    return userName;

}


// ============================================================
// SOCKET.IO CONNECTION
// ============================================================

io.on(
    "connection",
    function (socket) {

        console.log(
            "========================================"
        );

        console.log(
            "HTTPS CLIENT CONNECTED"
        );

        console.log(
            "Socket ID:",
            socket.id
        );

        console.log(
            "========================================"
        );


        // ====================================================
        // PASSWORD VALIDATION
        // ====================================================

        socket.on(
            "validatePassword",
            function (
                password,
                callback
            ) {

                const userName =
                    getUserFromPassword(
                        password
                    );


                if (!userName) {

                    if (callback) {

                        callback({

                            success: false,

                            error:
                                "Invalid passcode."

                        });

                    }

                    return;

                }


                if (callback) {

                    callback({

                        success: true,

                        user:
                            userName

                    });

                }

            }
        );


        // ====================================================
        // EXECUTE PM2 COMMAND
        // ====================================================

        socket.on(
            "executeBat",
            function (
                command,
                callback
            ) {

                console.log(
                    "========================================"
                );

                console.log(
                    "COMMAND RECEIVED"
                );

                console.log(
                    "========================================"
                );

                console.log(
                    command
                );

                console.log(
                    "========================================"
                );


                // -----------------------------------------
                // VALIDATE COMMAND
                // -----------------------------------------

                if (
                    typeof command !== "string" ||
                    command.trim() === ""
                ) {

                    console.error(
                        "Invalid command received."
                    );


                    if (callback) {

                        callback({

                            success: false,

                            error:
                                "Invalid command."

                        });

                    }

                    return;

                }


                // -----------------------------------------
                // EXECUTE COMMAND
                // -----------------------------------------

                exec(
                    command,
                    function (
                        error,
                        stdout,
                        stderr
                    ) {


                        // =================================
                        // COMMAND FAILED
                        // =================================

                        if (error) {

                            console.error(
                                "========================================"
                            );

                            console.error(
                                "COMMAND EXECUTION FAILED"
                            );

                            console.error(
                                "========================================"
                            );


                            console.error(
                                "Error:",
                                error.message
                            );


                            console.error(
                                "STDERR:",
                                stderr
                            );


                            console.error(
                                "STDOUT:",
                                stdout
                            );


                            if (callback) {

                                callback({

                                    success: false,

                                    error:
                                        stderr ||
                                        error.message,

                                    stdout:
                                        stdout || "",

                                    stderr:
                                        stderr || ""

                                });

                            }


                            return;

                        }


                        // =================================
                        // COMMAND SUCCESS
                        // =================================

                        console.log(
                            "========================================"
                        );

                        console.log(
                            "COMMAND EXECUTED SUCCESSFULLY"
                        );

                        console.log(
                            "========================================"
                        );


                        console.log(
                            "STDOUT:",
                            stdout
                        );


                        if (stderr) {

                            console.log(
                                "STDERR:",
                                stderr
                            );

                        }


                        if (callback) {

                            callback({

                                success: true,

                                stdout:
                                    stdout || "",

                                stderr:
                                    stderr || ""

                            });

                        }

                    }
                );

            }
        );


        // ====================================================
        // INSERT STOP LOG
        // ====================================================

        socket.on(
            "insertStopLog",
            async function (
                data,
                callback
            ) {

                try {

                    // -------------------------------------
                    // CHECK DATA
                    // -------------------------------------

                    if (
                        !data ||
                        typeof data !== "object"
                    ) {

                        throw new Error(
                            "Invalid stop log data."
                        );

                    }


                    const password =
                        typeof data.password === "string"
                            ? data.password.trim()
                            : "";


                    const reason =
                        typeof data.reason === "string"
                            ? data.reason.trim()
                            : "";


                    const serviceName =
                        typeof data.serviceName === "string"
                            ? data.serviceName.trim()
                            : "";


                    // -------------------------------------
                    // PASSWORD
                    // -------------------------------------

                    const userName =
                        getUserFromPassword(
                            password
                        );


                    if (!userName) {

                        throw new Error(
                            "Invalid passcode."
                        );

                    }


                    // -------------------------------------
                    // SERVICE
                    // -------------------------------------

                    if (
                        !isValidService(
                            serviceName
                        )
                    ) {

                        throw new Error(
                            "Invalid service name."
                        );

                    }


                    // -------------------------------------
                    // REASON
                    // -------------------------------------

                    if (
                        reason === ""
                    ) {

                        throw new Error(
                            "Stop reason is required."
                        );

                    }


                    // -------------------------------------
                    // INSERT
                    // -------------------------------------

                    const loggedUser =
                        await insertStopLog(

                            password,

                            reason,

                            serviceName

                        );


                    // -------------------------------------
                    // RESPONSE
                    // -------------------------------------

                    if (callback) {

                        callback({

                            success: true,

                            user:
                                loggedUser

                        });

                    }

                }

                catch (error) {

                    console.error(
                        "========================================"
                    );

                    console.error(
                        "STOP LOG INSERT FAILED"
                    );

                    console.error(
                        "========================================"
                    );

                    console.error(
                        error
                    );


                    if (callback) {

                        callback({

                            success: false,

                            error:
                                error.message ||
                                "Unable to insert stop log."

                        });

                    }

                }

            }
        );


        // ====================================================
        // DISCONNECT
        // ====================================================

        socket.on(
            "disconnect",
            function () {

                console.log(
                    "========================================"
                );

                console.log(
                    "HTTPS CLIENT DISCONNECTED"
                );

                console.log(
                    "Socket ID:",
                    socket.id
                );

                console.log(
                    "========================================"
                );

            }
        );

    }
);


