# ============================================================
# INSERT REJECTION RECORD
# ============================================================

def insert_rejection_record(
    dst_conn,
    row,
    qr,
    dateCode,
    code12_13,
    tableName,
    sql_success,
    redis_success,
    sql_error,
    redis_error
):

    cursor = None

    try:

        # ====================================================
        # MAKE SURE DESTINATION CONNECTION IS ALIVE
        # ====================================================

        if not test_connection(dst_conn):

            print(
                "[REJECTION] DESTINATION SQL CONNECTION LOST."
            )

            dst_conn = reconnect_db(
                dst_conn,
                sqlConfig2,
                "DESTINATION SQL"
            )

        cursor = dst_conn.cursor()

        # --------------------------------------------------------
        # CREATE REJECTION TABLE IF NOT EXISTS
        # --------------------------------------------------------

        cursor.execute(
            f"""
            IF NOT EXISTS
            (
                SELECT 1
                FROM INFORMATION_SCHEMA.TABLES
                WHERE TABLE_NAME = '{REJECTION_TABLE}'
            )
            BEGIN

                CREATE TABLE {REJECTION_TABLE}
                (
                    sr_no INT IDENTITY(1,1) PRIMARY KEY,

                    cellqr NVARCHAR(50),

                    voltage NVARCHAR(50),
                    ir NVARCHAR(50),
                    class_grade NVARCHAR(50),
                    capacity NVARCHAR(50),
                    thickness NVARCHAR(50),
                    k_value NVARCHAR(50),
                    negative_voltage NVARCHAR(50),

                    cell_status NVARCHAR(20),

                    ocv_mc_no NVARCHAR(50),

                    first_para_time NVARCHAR(100),
                    last_para_time NVARCHAR(100),

                    laser_status NVARCHAR(50),

                    batch NVARCHAR(50),
                    plant_code NVARCHAR(50),

                    target_table NVARCHAR(150),

                    sql_success BIT,
                    redis_success BIT,

                    sql_error NVARCHAR(MAX),
                    redis_error NVARCHAR(MAX),

                    rejection_reason NVARCHAR(100),

                    acknowledgement BIT DEFAULT 0,

                    created_at DATETIME DEFAULT GETDATE()
                );

            END
            """
        )

        dst_conn.commit()

        # --------------------------------------------------------
        # DETERMINE REJECTION REASON
        # --------------------------------------------------------

        if not sql_success and not redis_success:

            rejection_reason = "SQL_FAILED_REDIS_FAILED"

        elif not sql_success and redis_success:

            rejection_reason = "SQL_FAILED_REDIS_SUCCESS"

        elif sql_success and not redis_success:

            rejection_reason = "SQL_SUCCESS_REDIS_FAILED"

        else:

            rejection_reason = "UNKNOWN"

        # --------------------------------------------------------
        # INSERT REJECTION RECORD
        # --------------------------------------------------------

        cursor.execute(
            f"""
            INSERT INTO {REJECTION_TABLE}
            (
                cellqr,
                voltage,
                ir,
                class_grade,
                capacity,
                thickness,
                k_value,
                negative_voltage,
                cell_status,
                ocv_mc_no,
                first_para_time,
                last_para_time,
                laser_status,
                batch,
                plant_code,
                target_table,
                sql_success,
                redis_success,
                sql_error,
                redis_error,
                rejection_reason,
                acknowledgement
            )
            VALUES
            (
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                0
            )
            """,
            (
                safe(qr),
                safe(row.voltage),
                safe(row.ir),
                safe(row.cell_class),
                safe(row.cell_capacity),
                safe(row.cell_thikness),
                safe(row.kvalue),
                safe(row.cell_nigative_voltage),
                "OK",
                safe(row.used_on_line),
                safe(row.today_date),
                safe(row.updated_time),
                safe(row.laser_status),
                safe(dateCode),
                safe(code12_13),
                safe(tableName),
                1 if sql_success else 0,
                1 if redis_success else 0,
                safe(sql_error),
                safe(redis_error),
                rejection_reason
            )
        )

        # --------------------------------------------------------
        # GET THE INSERTED REJECTION ID
        # --------------------------------------------------------

        cursor.execute(
            "SELECT CAST(SCOPE_IDENTITY() AS INT)"
        )

        rejection_id_row = cursor.fetchone()

        if not rejection_id_row:

            raise Exception(
                "Could not get rejection record ID"
            )

        rejection_id = rejection_id_row[0]

        # --------------------------------------------------------
        # COMMIT REJECTION INSERT
        # --------------------------------------------------------

        dst_conn.commit()

        print(
            "REJECTION INSERTED :",
            qr
        )

        print(
            "REJECTION ID       :",
            rejection_id
        )

        print(
            "REJECTION REASON   :",
            rejection_reason
        )

        # --------------------------------------------------------
        # ACKNOWLEDGEMENT
        # --------------------------------------------------------

        cursor.execute(
            f"""
            UPDATE {REJECTION_TABLE}
            SET acknowledgement = 1
            WHERE sr_no = ?
            """,
            rejection_id
        )

        dst_conn.commit()

        print(
            "REJECTION ACKNOWLEDGED :",
            qr
        )

        return True, dst_conn

    except Exception as e:

        print(
            "REJECTION TABLE ERROR :",
            qr
        )

        print(
            "ERROR :",
            e
        )

        try:

            dst_conn.rollback()

        except Exception:
            pass

        # --------------------------------------------------------
        # IF REJECTION ITSELF FAILED BECAUSE CONNECTION BROKE
        # --------------------------------------------------------

        if is_sql_connection_error(e):

            print(
                "[REJECTION] SQL COMMUNICATION FAILURE."
            )

            # Do not delete mirror.
            # Source remains safe.

        return False, dst_conn

    finally:

        try:

            if cursor:
                cursor.close()

        except Exception:
            pass


