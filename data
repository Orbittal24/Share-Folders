@echo off
setlocal EnableDelayedExpansion

set "NSSM=C:\Software_Tools\new_OCV\nssm.exe"
set "NODE=C:\Software_Tools\new_OCV\node-v24.21.0-win-x64\node.exe"
set "APPDIR=C:\Software_Tools\new_OCV\MESCellDataV2"
set "SERVICE=TataDataDashboard"
set "PARENT=TataData"

if not exist "%APPDIR%\logs" mkdir "%APPDIR%\logs"

echo.
echo ==========================================
echo Installing %SERVICE%
echo ==========================================
echo.

REM ==========================================
REM Check NSSM
REM ==========================================

if not exist "%NSSM%" (
    echo ERROR: NSSM not found:
    echo %NSSM%
    pause
    exit /b 1
)

REM ==========================================
REM Check Node.js
REM ==========================================

if not exist "%NODE%" (
    echo ERROR: Node.js not found:
    echo %NODE%
    pause
    exit /b 1
)

REM ==========================================
REM Check TataData service
REM ==========================================

echo Checking TataData service...
echo.

sc query "%PARENT%" >nul 2>&1

if errorlevel 1 (
    echo ERROR: TataData service is not installed.
    echo.
    echo Please run:
    echo TataData_services.bat
    echo first.
    echo.
    pause
    exit /b 1
)

echo TataData service exists.
echo.

REM ==========================================
REM Find dashboard JavaScript file
REM ==========================================

set "DASHBOARD_FILE="

for %%F in ("%APPDIR%\*dashboard*.js") do (
    if exist "%%~fF" (
        set "DASHBOARD_FILE=%%~nxF"
    )
)

if not defined DASHBOARD_FILE (
    echo.
    echo ERROR: Dashboard JavaScript file not found.
    echo.
    echo Searching folder:
    echo %APPDIR%
    echo.
    echo JavaScript files available:
    echo.

    dir /b "%APPDIR%\*.js" 2>nul

    echo.
    echo No JavaScript file containing "dashboard" was found.
    echo.
    pause
    exit /b 1
)

echo Dashboard JavaScript found:
echo   !DASHBOARD_FILE!
echo.

REM ==========================================
REM Remove existing dashboard service
REM ==========================================

echo Removing existing %SERVICE% service if present...

"%NSSM%" stop "%SERVICE%" >nul 2>&1
"%NSSM%" remove "%SERVICE%" confirm >nul 2>&1

REM ==========================================
REM Install dashboard service
REM ==========================================

echo Installing %SERVICE%...

"%NSSM%" install "%SERVICE%" "%NODE%"

REM ==========================================
REM Configure dashboard
REM ==========================================

"%NSSM%" set "%SERVICE%" Application "%NODE%"
"%NSSM%" set "%SERVICE%" AppDirectory "%APPDIR%"

REM Dashboard filename
"%NSSM%" set "%SERVICE%" AppParameters "!DASHBOARD_FILE!"

"%NSSM%" set "%SERVICE%" DisplayName "Tata Data Dashboard"
"%NSSM%" set "%SERVICE%" Description "Tata Data Dashboard Service"

REM ==========================================
REM Automatic startup
REM ==========================================

"%NSSM%" set "%SERVICE%" Start SERVICE_AUTO_START

REM ==========================================
REM TataData dependency
REM ==========================================

"%NSSM%" set "%SERVICE%" DependOnService "%PARENT%"

REM ==========================================
REM Logs
REM ==========================================

"%NSSM%" set "%SERVICE%" AppStdout "%APPDIR%\logs\dashboard.log"
"%NSSM%" set "%SERVICE%" AppStderr "%APPDIR%\logs\dashboard-error.log"

REM ==========================================
REM Log rotation
REM ==========================================

"%NSSM%" set "%SERVICE%" AppRotateFiles 1
"%NSSM%" set "%SERVICE%" AppRotateBytes 10485760

REM ==========================================
REM Restart configuration
REM ==========================================

"%NSSM%" set "%SERVICE%" AppExit Default Restart
"%NSSM%" set "%SERVICE%" AppRestartDelay 5000

echo.
echo ==========================================
echo TataDataDashboard Configuration
echo ==========================================
echo.

"%NSSM%" status "%SERVICE%"

echo.
echo Service:
echo   TataDataDashboard

echo.
echo Node:
echo   %NODE%

echo.
echo Dashboard:
echo   %APPDIR%\!DASHBOARD_FILE!

echo.
echo Dependency:
echo   TataData

echo.
echo Logs:
echo   %APPDIR%\logs\dashboard.log
echo   %APPDIR%\logs\dashboard-error.log

echo.
echo ==========================================
echo Starting TataDataDashboard
echo ==========================================
echo.

"%NSSM%" start "%SERVICE%"

timeout /t 5 /nobreak >nul

echo.
echo ==========================================
echo TataDataDashboard Status
echo ==========================================
echo.

"%NSSM%" status "%SERVICE%"

echo.
pause
