function getDbConfig(databaseName) {

    return {

        ...baseSqlConfig,

        database: databaseName

    };

}


// ============================================================
// GET MASTER DATABASE CONNECTION
// ============================================================

async function getMasterPool() {

    if (
        masterPool &&
        masterPool.connected
    ) {

        return masterPool;

    }


    masterPool =
        await new sql.ConnectionPool(
            getDbConfig(
                DATABASES.MASTER
            )
        ).connect();


    masterPool.on(
        "error",
        err => {

            console.error(
                "Master DB Pool Error:",
                err.message
            );

        }
    );


    console.log(
        "Connected to:",
        DATABASES.MASTER
    );


    return masterPool;

}


