# -----------------------------------
# MOVE SOURCE RECORD TO REJECTION
# -----------------------------------
#
# IMPORTANT:
#
# Rejection INSERT is considered the
# acknowledgement only after commit()
# succeeds.
#
# Mirror is deleted only after this
# function returns True.
#
# -----------------------------------

def move_to_rejection(src_conn, row):

    cursor = src_conn.cursor()

    try:

        print(
            "INSERTING INTO REJECTION :",
            row.cell_qrcode
        )

        cursor.execute("""
            INSERT INTO taco_treceability.ocv_machine_data_xng_mirrior_rejection
            (
                cell_qrcode,
                voltage,
                ir,
                today_date,
                updated_time,
                machine_location,
                shift,
                used_on_line,
                kvalue,
                grade,
                cell_capacity,
                cell_class
            )
            VALUES (?,?,?,?,?,?,?,?,?,?,?,?)
        """,
        (
            row.cell_qrcode,
            row.voltage,
            row.ir,
            row.today_date,
            row.updated_time,
            row.machine_location,
            row.shift,
            row.used_on_line,
            row.kvalue,
            row.grade,
            row.cell_capacity,
            row.cell_class
        ))

        # -----------------------------------
        # ACKNOWLEDGEMENT
        # -----------------------------------

        src_conn.commit()

        print(
            "REJECTION INSERT ACKNOWLEDGED :",
            row.cell_qrcode
        )

        return True

    except Exception as e:

        print(
            "REJECTION INSERT FAILED :",
            e
        )

        try:
            src_conn.rollback()
        except Exception as rollback_error:
            print(
                "REJECTION ROLLBACK FAILED :",
                rollback_error
            )

        return False


# -----------------------------------
# INSERT INTO REJECTION
# THEN DELETE FROM MIRROR
# -----------------------------------

def handle_failure(src_conn, row, failure_reason):

    qr = safe(row.cell_qrcode)

    print(
        "-----------------------------------"
    )

    print(
        "FAILURE REASON :",
        failure_reason
    )

    print(
        "QR :",
        qr
    )

    print(
        "MOVING DATA TO REJECTION..."
    )


    # -----------------------------------
    # STEP 1
    # INSERT REJECTION
    # -----------------------------------

    rejection_success = move_to_rejection(
        src_conn,
        row
    )


    # -----------------------------------
    # STEP 2
    # ONLY AFTER ACKNOWLEDGEMENT
    # DELETE MIRROR
    # -----------------------------------

    if rejection_success:

        try:

            cursor = src_conn.cursor()

            cursor.execute("""
                DELETE FROM taco_treceability.ocv_machine_data_xng_mirrior
                WHERE cell_qrcode = ?
            """, qr)

            src_conn.commit()

            print(
                "REJECTION ACK RECEIVED"
            )

            print(
                "SOURCE DELETED FROM MIRROR :",
                qr
            )

            print(
                "-----------------------------------"
            )

            return True

        except Exception as delete_error:

            print(
                "DELETE FROM MIRROR FAILED :",
                delete_error
            )

            try:
                src_conn.rollback()
            except Exception as rollback_error:
                print(
                    "DELETE ROLLBACK FAILED :",
                    rollback_error
                )

            print(
                "SOURCE KEPT IN MIRROR :",
                qr
            )

            print(
                "-----------------------------------"
            )

            return False

    else:

        print(
            "REJECTION ACKNOWLEDGEMENT FAILED"
        )

        print(
            "SOURCE KEPT IN MIRROR :",
            qr
        )

        print(
            "-----------------------------------"
        )

        return False


