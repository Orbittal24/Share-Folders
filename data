<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Restart OCV Services</title>


    <!-- =====================================================
         ALL CSS IN THIS FILE
         ===================================================== -->

    <style>

        /* ====================================================
           GLOBAL
           ==================================================== */

        * {
            box-sizing: border-box;
        }


        html,
        body {

            width: 100%;

            margin: 0;

            padding: 0;

            font-family:
                Arial,
                Helvetica,
                sans-serif;

            background: #ffffff;

        }


        /* ====================================================
           PAGE TITLE
           ==================================================== */

        .page-title {

            width: calc(100% - 12px);

            margin: 12px 6px 14px 6px;

            height: 30px;

            display: flex;

            align-items: center;

        }


        .page-title h3 {

            margin: 0;

            padding: 0;

            font-size: 20px;

            font-weight: 600;

            color: #111827;

        }


        /* ====================================================
           SERVICE CONTROL ROW

           LABEL    = AUTO
           DROPDOWN = REMAINING LARGE SPACE
           START    = 17%
           STOP     = 17%

           EVERYTHING STAYS IN ONE ROW
           ==================================================== */

        .service-control {

            width: calc(100% - 12px);

            margin: 0 6px;

            padding: 10px 8px;

            min-height: 55px;

            display: grid;

            grid-template-columns:
                auto
                minmax(0, 1fr)
                17%
                17%;

            column-gap: 8px;

            align-items: center;

            background: #f8f9fa;

            border: 1px solid #d9dde2;

            border-radius: 3px;

        }


        /* ====================================================
           LABEL
           ==================================================== */

        .service-label {

            width: auto;

            margin: 0;

            padding: 0 8px;

            display: flex;

            align-items: center;

            justify-content: flex-start;

            font-size: 15px;

            font-weight: 500;

            color: #333333;

            white-space: nowrap;

        }


        /* ====================================================
           DROPDOWN CONTAINER
           ==================================================== */

        .dropdown-container {

            width: 100%;

            min-width: 0;

        }


        /* ====================================================
           SERVICE DROPDOWN
           ==================================================== */

        #dropdown {

            display: block;

            width: 100%;

            height: 42px;

            margin: 0;

            padding: 5px 12px;

            border: 1px solid #80b7ff;

            border-radius: 4px;

            background-color: #ffffff;

            color: #333333;

            font-size: 14px;

            font-weight: 500;

            outline: none;

            cursor: pointer;

        }


        #dropdown:hover {

            border-color: #4d9cff;

        }


        #dropdown:focus {

            border-color: #4d9cff;

            outline: none;

            box-shadow:
                0 0 0 2px
                rgba(0, 123, 255, 0.15);

        }


        /* ====================================================
           DROPDOWN OPTIONS
           ==================================================== */

        #dropdown option {

            font-size: 14px;

            font-weight: 500;

            padding: 6px;

        }


        /* ====================================================
           BUTTON CONTAINER
           ==================================================== */

        .button-container {

            width: 100%;

            min-width: 0;

        }


        /* ====================================================
           START / STOP BUTTONS
           ==================================================== */

        #startButton,
        #stopButton {

            display: flex;

            align-items: center;

            justify-content: center;

            width: 100%;

            height: 42px;

            margin: 0;

            padding: 0 15px;

            border: none;

            border-radius: 4px;

            font-size: 15px;

            font-weight: 600;

            line-height: 1;

            cursor: pointer;

            user-select: none;

            transition:
                background-color 0.15s ease,
                transform 0.05s ease;

        }


        /* ====================================================
           START BUTTON
           ==================================================== */

        #startButton {

            background-color: #28a745;

            color: #ffffff;

        }


        #startButton:hover {

            background-color: #218838;

        }


        #startButton:active {

            background-color: #1e7e34;

            transform: translateY(1px);

        }


        /* ====================================================
           STOP BUTTON
           ==================================================== */

        #stopButton {

            background-color: #dc3545;

            color: #ffffff;

        }


        #stopButton:hover {

            background-color: #c82333;

        }


        #stopButton:active {

            background-color: #bd2130;

            transform: translateY(1px);

        }


        /* ====================================================
           SWEETALERT FONT SIZE
           ==================================================== */

        .swal2-title {

            font-size: 24px !important;

        }


        .swal2-html-container {

            font-size: 16px !important;

        }


        .swal2-input {

            font-size: 16px !important;

            height: 45px !important;

        }


        .swal2-confirm,
        .swal2-cancel {

            font-size: 15px !important;

            padding:
                10px 22px !important;

        }


        /* ====================================================
           LARGE DESKTOP
           ==================================================== */

        @media (min-width: 1200px) {

            .page-title h3 {

                font-size: 21px;

            }


            .service-label {

                font-size: 15px;

            }


            #dropdown {

                height: 44px;

                font-size: 15px;

            }


            #dropdown option {

                font-size: 15px;

            }


            #startButton,
            #stopButton {

                height: 44px;

                font-size: 15px;

            }

        }


        /* ====================================================
           SMALL SCREEN
           
           STILL ONE ROW
           ==================================================== */

        @media (max-width: 700px) {

            .service-control {

                grid-template-columns:
                    auto
                    minmax(0, 1fr)
                    80px
                    80px;

                column-gap: 5px;

                padding: 7px;

            }


            .service-label {

                font-size: 11px;

                padding: 0 3px;

            }


            #dropdown {

                height: 36px;

                font-size: 11px;

            }


            #dropdown option {

                font-size: 11px;

            }


            #startButton,
            #stopButton {

                height: 36px;

                font-size: 12px;

                padding: 0 5px;

            }

        }

    </style>


    <!-- =====================================================
         SWEETALERT
         ===================================================== -->

    <script src="./style/sweetalert.js"></script>

</head>


<body>


    <!-- =====================================================
         PAGE TITLE
         ===================================================== -->

    <div class="page-title">

        <h3>
            IR Screwing Service Restart
        </h3>

    </div>



    <!-- =====================================================
         SERVICE CONTROL
         
         LABEL → DROPDOWN → START → STOP

         NO EMPTY SPACE BETWEEN LABEL AND DROPDOWN
         ===================================================== -->

    <div class="service-control">


        <!-- LABEL -->

        <div class="service-label">

            Choose an option:

        </div>



        <!-- LARGE DROPDOWN -->

        <div class="dropdown-container">

            <select id="dropdown">

                <option value="">
                    Select Service Name
                </option>


                <option value="ocv_cell_data_mirror_ocv_universal_line_1_2">
                    ocv_cell_data_mirror_ocv_universal_line_1_2
                </option>


                <option value="ocv_cell_data_mirror_ocv_universal_line_3_4">
                    ocv_cell_data_mirror_ocv_universal_line_3_4
                </option>


                <option value="ocv_cell_data_mirror_ocv_universal_line_5_6">
                    ocv_cell_data_mirror_ocv_universal_line_5_6
                </option>


                <option value="ocv_cell_data_mirror_ocv_universal_line_7_8">
                    ocv_cell_data_mirror_ocv_universal_line_7_8
                </option>


                <option value="ocv_cell_data_mirror_ocv_universal_line_A">
                    ocv_cell_data_mirror_ocv_universal_line_A
                </option>


                <option value="ocv_cell_data_mirror_ocv_universal_XNG">
                    ocv_cell_data_mirror_ocv_universal_XNG
                </option>


                <option value="ocv_cell_data_mirror_ocv_universal_bajaj_2w">
                    ocv_cell_data_mirror_ocv_universal_bajaj_2w
                </option>

            </select>

        </div>



        <!-- START -->

        <div class="button-container">

            <button
                id="startButton"
                type="button">

                Start

            </button>

        </div>



        <!-- STOP -->

        <div class="button-container">

            <button
                id="stopButton"
                type="button">

                Stop

            </button>

        </div>


    </div>



    <!-- =====================================================
         SOCKET.IO
         ===================================================== -->

    <script src="./style/socket_io.js"></script>



    <!-- =====================================================
         JAVASCRIPT
         ===================================================== -->

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {


                // =================================================
                // ELEMENTS
                // =================================================

                const dropdown =
                    document.getElementById(
                        "dropdown"
                    );


                const startButton =
                    document.getElementById(
                        "startButton"
                    );


                const stopButton =
                    document.getElementById(
                        "stopButton"
                    );


                // =================================================
                // SOCKET.IO
                // =================================================

                const socket = io();


                // =================================================
                // START SERVICE
                // =================================================

                startButton.addEventListener(
                    "click",
                    function () {


                        const selectedValue =
                            dropdown.value;


                        if (selectedValue === "") {

                            Swal.fire({

                                title:
                                    "Select Service",

                                text:
                                    "Please select a service name first.",

                                icon:
                                    "warning"

                            });

                            return;

                        }


                        console.log(
                            "Selected Service:",
                            selectedValue
                        );


                        // -----------------------------------------
                        // PASSCODE
                        // -----------------------------------------

                        Swal.fire({

                            title:
                                "Enter Passcode!",

                            html:
                                '<input ' +
                                'id="password" ' +
                                'type="password" ' +
                                'class="swal2-input" ' +
                                'placeholder="Enter Passcode">',

                            showCancelButton:
                                true,

                            confirmButtonText:
                                "Start",

                            cancelButtonText:
                                "Cancel",

                            allowOutsideClick:
                                false

                        }).then(
                            function (result) {


                                if (!result.isConfirmed) {

                                    return;

                                }


                                const password =
                                    document.getElementById(
                                        "password"
                                    ).value;


                                if (password === "") {

                                    Swal.fire({

                                        title:
                                            "Password Required",

                                        text:
                                            "Please enter the passcode.",

                                        icon:
                                            "warning"

                                    });

                                    return;

                                }


                                if (password !== "service") {

                                    Swal.fire({

                                        title:
                                            "Invalid Passcode",

                                        text:
                                            "Please enter the correct passcode.",

                                        icon:
                                            "error"

                                    });

                                    return;

                                }


                                // -----------------------------------------
                                // PM2 START
                                // -----------------------------------------

                                const cmdname =
                                    `pm2 start ${selectedValue} --interpreter=pythonw`;


                                console.log(
                                    "START COMMAND:",
                                    cmdname
                                );


                                socket.emit(

                                    "executeBat",

                                    cmdname,

                                    function (response) {


                                        console.log(
                                            "Server Response:",
                                            response
                                        );


                                        if (
                                            response &&
                                            response.success
                                        ) {

                                            Swal.fire({

                                                title:
                                                    "PM2 Service Started",

                                                text:
                                                    `${selectedValue} has been started successfully.`,

                                                icon:
                                                    "success"

                                            });

                                        }

                                        else {

                                            Swal.fire({

                                                title:
                                                    "Failed to Start Service",

                                                text:
                                                    response?.error ||
                                                    "Unable to start PM2 service.",

                                                icon:
                                                    "error"

                                            });

                                        }

                                    }

                                );

                            }

                        );

                    }

                );



                // =================================================
                // STOP SERVICE
                // =================================================

                stopButton.addEventListener(

                    "click",

                    function () {


                        const selectedValue =
                            dropdown.value;


                        if (selectedValue === "") {

                            Swal.fire({

                                title:
                                    "Select Service",

                                text:
                                    "Please select a service name first.",

                                icon:
                                    "warning"

                            });

                            return;

                        }


                        console.log(
                            "Selected Service:",
                            selectedValue
                        );


                        // -----------------------------------------
                        // PASSCODE
                        // -----------------------------------------

                        Swal.fire({

                            title:
                                "Enter Passcode!",

                            html:
                                '<input ' +
                                'id="password" ' +
                                'type="password" ' +
                                'class="swal2-input" ' +
                                'placeholder="Enter Passcode">',

                            showCancelButton:
                                true,

                            confirmButtonText:
                                "Stop",

                            cancelButtonText:
                                "Cancel",

                            allowOutsideClick:
                                false

                        }).then(

                            function (result) {


                                if (!result.isConfirmed) {

                                    return;

                                }


                                const password =
                                    document.getElementById(
                                        "password"
                                    ).value;


                                if (password === "") {

                                    Swal.fire({

                                        title:
                                            "Password Required",

                                        text:
                                            "Please enter the passcode.",

                                        icon:
                                            "warning"

                                    });

                                    return;

                                }


                                if (password !== "service") {

                                    Swal.fire({

                                        title:
                                            "Invalid Passcode",

                                        text:
                                            "Please enter the correct passcode.",

                                        icon:
                                            "error"

                                    });

                                    return;

                                }


                                // -----------------------------------------
                                // PM2 STOP
                                // -----------------------------------------

                                const cmdname =
                                    `pm2 stop ${selectedValue}`;


                                console.log(
                                    "STOP COMMAND:",
                                    cmdname
                                );


                                socket.emit(

                                    "executeBat",

                                    cmdname,

                                    function (response) {


                                        console.log(
                                            "Server Response:",
                                            response
                                        );


                                        if (
                                            response &&
                                            response.success
                                        ) {

                                            Swal.fire({

                                                title:
                                                    "PM2 Service Stopped",

                                                text:
                                                    `${selectedValue} has been stopped successfully.`,

                                                icon:
                                                    "success"

                                            });

                                        }

                                        else {

                                            Swal.fire({

                                                title:
                                                    "Failed to Stop Service",

                                                text:
                                                    response?.error ||
                                                    "Unable to stop PM2 service.",

                                                icon:
                                                    "error"

                                            });

                                        }

                                    }

                                );

                            }

                        );

                    }

                );



                // =================================================
                // SOCKET CONNECT
                // =================================================

                socket.on(
                    "connect",
                    function () {

                        console.log(
                            "Connected to server."
                        );

                        console.log(
                            "Socket ID:",
                            socket.id
                        );

                    }
                );



                // =================================================
                // SOCKET DISCONNECT
                // =================================================

                socket.on(
                    "disconnect",
                    function () {

                        console.log(
                            "Disconnected from server."
                        );

                    }
                );


            }

        );

    </script>


</body>

</html>
