const WS_URL = "ws://10.9.4.28:9814";

const DB_FILE = "C:\\ProgramData\\Orbittal\\MESCellData\\cells.db";
const STATUS_FILE = "C:\\Software_Tools\\new_OCV\\MESCellDataV2\\SERVICE_STATUS.txt";

// Shadow-run switch. true  = record and clear the queue locally, nothing
//                            reaches the MES.
//                   false = normal production sending.
const DRY_RUN = true;

const NODES = [
    "MES_CellData1",
    "MES_CellData2",
    "MES_CellData3",
    "MES_CellData4",
    "MES_CellData5",
    "MES_CellData6",
    "MES_CellData7",
    "MES_CellData8",
];

// QR codes that are NOT real cell identities. These are never deduplicated:
// every occurrence is stored as its own row.
const NON_IDENTITY_CODES = ["", "NG", "ng", "NoRead", "NOREAD"];

const SEND_INTERVAL_MS = 250;    // how often we try to push a record upstream
const SEND_TIMEOUT_MS = 5000;    // give up on a socket that never answers
const HEARTBEAT_MS = 5000;       // how often the status file is rewritten

const BACKLOG_WARN = 500;
const BACKLOG_FAULT = 5000;

// ---------------------------------------------------------------------------
// HISTORY RETENTION
// ---------------------------------------------------------------------------
const RETENTION_DAYS = 30;
const PURGE_INTERVAL_HOURS = 24;
const PURGE_START_DELAY_MS = 120000;
const PURGE_BATCH_SIZE = 2000;
const PURGE_BATCH_PAUSE_MS = 100;

// ===========================================================================
// DATABASE
// ===========================================================================
fs.mkdirSync(path.dirname(DB_FILE), { recursive: true });

const db = new DatabaseSync(DB_FILE);

db.exec(`
    PRAGMA journal_mode = WAL;
    PRAGMA synchronous = NORMAL;

    -- ---------------------------------------------------------------
    -- TABLE 1: working queue. One row per cell waiting to be sent.
    -- ---------------------------------------------------------------
    CREATE TABLE IF NOT EXISTS cells_queue (
        id           INTEGER PRIMARY KEY AUTOINCREMENT,
        history_id   INTEGER NOT NULL,
        cell_qrcode  TEXT    NOT NULL,
        voltage_val  REAL,
        ir_val       REAL,
        material     INTEGER,
        src_node     TEXT,
        queued_at    TEXT    NOT NULL,
        attempts     INTEGER NOT NULL DEFAULT 0,
        last_error   TEXT
    );

    -- One queue row per history row, so a re-read updates the pending send
    -- instead of creating a second one.
    CREATE UNIQUE INDEX IF NOT EXISTS idx_queue_hist_unique ON cells_queue(history_id);

    -- ---------------------------------------------------------------
    -- TABLE 2: ONE row per cell QR code.
    -- ---------------------------------------------------------------
    CREATE TABLE IF NOT EXISTS cells_history (
        id            INTEGER PRIMARY KEY AUTOINCREMENT,
        cell_qrcode   TEXT    NOT NULL,
        voltage_val   REAL,
        ir_val        REAL,
        material      INTEGER,
        src_node      TEXT,
        first_read_at TEXT    NOT NULL,   -- when this cell was first seen
        read_at       TEXT    NOT NULL,   -- most recent read
        read_count    INTEGER NOT NULL DEFAULT 1,  -- times the PLC reported it
        change_count  INTEGER NOT NULL DEFAULT 0,  -- times the VALUES changed
        sent_at       TEXT
    );

    -- Enforces one row per real QR code. Partial, so "NG" and blank codes are
    -- exempt -- they are failed reads, not identities.
    CREATE UNIQUE INDEX IF NOT EXISTS idx_hist_qr_unique
        ON cells_history(cell_qrcode)
        WHERE cell_qrcode <> '' AND cell_qrcode <> 'NG'
          AND cell_qrcode <> 'ng' AND cell_qrcode <> 'NoRead'
          AND cell_qrcode <> 'NOREAD';

    CREATE INDEX IF NOT EXISTS idx_hist_qr      ON cells_history(cell_qrcode);
    CREATE INDEX IF NOT EXISTS idx_hist_read_at ON cells_history(read_at);
    CREATE INDEX IF NOT EXISTS idx_hist_unsent  ON cells_history(id) WHERE sent_at IS NULL;

    CREATE TABLE IF NOT EXISTS events (
        id      INTEGER PRIMARY KEY AUTOINCREMENT,
        ts      TEXT NOT NULL,
        kind    TEXT NOT NULL,
        detail  TEXT
    );

    CREATE INDEX IF NOT EXISTS idx_events_ts ON events(ts);
`);

let dbWriteError = null;

// --- statements -------------------------------------------------------------
const stmtFindByQr = db.prepare(`
    SELECT id, voltage_val, ir_val, material, sent_at
    FROM cells_history WHERE cell_qrcode = ? LIMIT 1
`);
const stmtInsertHistory = db.prepare(`
    INSERT INTO cells_history
        (cell_qrcode, voltage_val, ir_val, material, src_node, first_read_at, read_at)
    VALUES (?, ?, ?, ?, ?, ?, ?)
`);
// Same values seen again: note the repeat, change nothing else.
const stmtTouchHistory = db.prepare(`
    UPDATE cells_history
    SET read_at = ?, read_count = read_count + 1
    WHERE id = ?
`);
// Different values: overwrite with the latest and mark unsent so it is
// delivered to the MES again.
const stmtUpdateHistory = db.prepare(`
    UPDATE cells_history
    SET voltage_val = ?, ir_val = ?, material = ?, src_node = ?,
        read_at = ?, read_count = read_count + 1, change_count = change_count + 1,
        sent_at = NULL
    WHERE id = ?
`);

const stmtQueueByHistory = db.prepare(`SELECT id FROM cells_queue WHERE history_id = ?`);
const stmtInsertQueue = db.prepare(`
    INSERT INTO cells_queue
        (history_id, cell_qrcode, voltage_val, ir_val, material, src_node, queued_at)
    VALUES (?, ?, ?, ?, ?, ?, ?)
`);
// A pending send for this cell already exists: refresh it with the new values
// and reset the retry counter, rather than queueing the cell twice.
const stmtUpdateQueue = db.prepare(`
    UPDATE cells_queue
    SET voltage_val = ?, ir_val = ?, material = ?, src_node = ?,
        queued_at = ?, attempts = 0, last_error = NULL
    WHERE history_id = ?
`);

const stmtNextQueued = db.prepare(`
    SELECT id, history_id, cell_qrcode, voltage_val, ir_val, material
    FROM cells_queue ORDER BY id LIMIT 1
`);
const stmtDeleteQueued = db.prepare(`DELETE FROM cells_queue WHERE id = ?`);
const stmtMarkHistorySent = db.prepare(`UPDATE cells_history SET sent_at = ? WHERE id = ?`);
const stmtBumpAttempt = db.prepare(`
    UPDATE cells_queue SET attempts = attempts + 1, last_error = ? WHERE id = ?
`);
const stmtQueueCount = db.prepare(`SELECT COUNT(*) AS n FROM cells_queue`);
const stmtHistoryCount = db.prepare(`SELECT COUNT(*) AS n FROM cells_history`);
const stmtHistorySentCount = db.prepare(`SELECT COUNT(*) AS n FROM cells_history WHERE sent_at IS NOT NULL`);
const stmtEvent = db.prepare(`INSERT INTO events (ts, kind, detail) VALUES (?, ?, ?)`);

const stmtPurgeBatch = db.prepare(`
    DELETE FROM cells_history
    WHERE id IN (
        SELECT h.id FROM cells_history h
        WHERE h.sent_at IS NOT NULL
          AND h.read_at < ?
          AND NOT EXISTS (SELECT 1 FROM cells_queue q WHERE q.history_id = h.id)
        ORDER BY h.id
        LIMIT ?
    )
`);

function logEvent(kind, detail) {
    try {
        stmtEvent.run(new Date().toISOString(), kind, detail == null ? null : String(detail));
    } catch (err) {
        console.error("[db] event log failed:", err.message);
    }
}

function queueDepth() {
    try { return Number(stmtQueueCount.get().n); } catch (err) { return -1; }
}

function isIdentityCode(qr) {
    return NON_IDENTITY_CODES.indexOf(qr) === -1;
}

/** Values are stored exactly as read, so plain comparison is reliable here. */
function sameValues(existing, incoming) {
    return existing.voltage_val === incoming.v
        && existing.ir_val === incoming.ir
        && existing.material === incoming.mat;
}

// Session counters, shown in the status file.
const counts = { inserted: 0, updated: 0, repeats: 0 };

/**
 * Insert or update a batch of cells, all inside one transaction.
 *
 * For each cell:
 *   - new QR              -> INSERT history + INSERT queue
 *   - known QR, same data -> read_count++ only. Nothing is queued.
 *   - known QR, new data  -> UPDATE history, clear sent_at, queue (or refresh
 *                            the existing queue row)
 *   - "NG"/blank QR       -> always INSERT, never matched against anything
 */
function upsertBatch(rows, srcNode) {
    const now = new Date().toISOString();
    db.exec("BEGIN");
    try {
        for (const r of rows) {
            const qr = r.cell_qrcode == null ? "" : String(r.cell_qrcode);
            const v = r.voltage_val == null ? null : Number(r.voltage_val);
            const ir = r.ir_val == null ? null : Number(r.ir_val);
            const mat = r.material == null ? null : Number(r.material);
            const incoming = { v: v, ir: ir, mat: mat };

            const existing = isIdentityCode(qr) ? stmtFindByQr.get(qr) : undefined;

            if (!existing) {
                const res = stmtInsertHistory.run(qr, v, ir, mat, srcNode, now, now);
                const historyId = Number(res.lastInsertRowid);
                stmtInsertQueue.run(historyId, qr, v, ir, mat, srcNode, now);
                counts.inserted++;
                continue;
            }

            if (sameValues(existing, incoming)) {
                // The PLC is republishing an unchanged array. Record that we
                // saw it again and move on -- nothing to send.
                stmtTouchHistory.run(now, existing.id);
                counts.repeats++;
                continue;
            }

            // Values changed: overwrite and send the corrected reading.
            stmtUpdateHistory.run(v, ir, mat, srcNode, now, existing.id);

            if (stmtQueueByHistory.get(existing.id)) {
                stmtUpdateQueue.run(v, ir, mat, srcNode, now, existing.id);
            } else {
                stmtInsertQueue.run(existing.id, qr, v, ir, mat, srcNode, now);
            }
            counts.updated++;
        }
        db.exec("COMMIT");
        return true;
    } catch (err) {
        try { db.exec("ROLLBACK"); } catch (_) {}
        console.error("[db] upsert failed:", err.message);
        logEvent("DB_ERROR", "upsert failed: " + err.message);
        dbWriteError = err.message;
        return false;
    }
}

function confirmSent(queueId, historyId) {
    const now = new Date().toISOString();
    db.exec("BEGIN");
    try {
        stmtMarkHistorySent.run(now, historyId);
        stmtDeleteQueued.run(queueId);
        db.exec("COMMIT");
        return true;
    } catch (err) {
        try { db.exec("ROLLBACK"); } catch (_) {}
        console.error("[db] confirm-sent failed:", err.message);
        logEvent("DB_ERROR", "confirm failed: " + err.message);
        dbWriteError = err.message;
        return false;
    }
}

// ===========================================================================
// AUTOMATIC HISTORY PURGE
// ===========================================================================
let purgeRunning = false;
let lastPurgeAt = null;
let lastPurgeCount = 0;

function purgeOldHistory(onDone) {
    if (RETENTION_DAYS <= 0 || purgeRunning) { if (onDone) onDone(0); return; }

    purgeRunning = true;
    const cutoff = new Date(Date.now() - RETENTION_DAYS * 86400000).toISOString();
    const startedAt = Date.now();
    let removed = 0;

    const step = () => {
        let changes = 0;
        try {
            changes = Number(stmtPurgeBatch.run(cutoff, PURGE_BATCH_SIZE).changes);
            removed += changes;
        } catch (err) {
            console.error("[purge] failed:", err.message);
            logEvent("PURGE_ERROR", err.message);
            purgeRunning = false;
            if (onDone) onDone(removed);
            return;
        }

        if (changes === PURGE_BATCH_SIZE) {
            setTimeout(step, PURGE_BATCH_PAUSE_MS);
            return;
        }

        purgeRunning = false;
        lastPurgeAt = new Date();
        lastPurgeCount = removed;
        const secs = ((Date.now() - startedAt) / 1000).toFixed(1);
        if (removed > 0) {
            console.log(`[purge] removed ${removed} history records older than ${cutoff} in ${secs}s`);
            logEvent("PURGE", `removed ${removed} rows older than ${cutoff} in ${secs}s`);
        }
        if (onDone) onDone(removed);
    };

    step();
}

