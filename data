<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Restart OCV Services</title>


    <!-- =====================================================
         ALL CSS IN THIS FILE
         ===================================================== -->

    <style>

        /* ====================================================
           GLOBAL
           ==================================================== */

        * {
            box-sizing: border-box;
        }


        html,
        body {

            width: 100%;

            margin: 0;

            padding: 0;

            font-family:
                Arial,
                Helvetica,
                sans-serif;

            background: #ffffff;

        }


        /* ====================================================
           PAGE TITLE
           ==================================================== */

        .page-title {

            width: calc(100% - 12px);

            margin: 12px 6px 10px 6px;

            height: 25px;

            display: flex;

            align-items: center;

        }


        .page-title h3 {

            margin: 0;

            padding: 0;

            font-size: 13px;

            font-weight: 500;

            color: #111827;

        }


        /* ====================================================
           SERVICE CONTROL ROW

           LABEL       = ONLY REQUIRED SPACE
           DROPDOWN    = LARGE / REMAINING SPACE
           START       = LARGE
           STOP        = LARGE

           EVERYTHING STAYS IN ONE ROW
           ==================================================== */

        .service-control {

            width: calc(100% - 12px);

            margin: 0 6px;

            padding: 7px 6px;

            min-height: 42px;

            display: grid;

            grid-template-columns:
                auto
                minmax(0, 1fr)
                17%
                17%;

            column-gap: 6px;

            align-items: center;

            background: #f8f9fa;

            border: 1px solid #d9dde2;

            border-radius: 2px;

        }


        /* ====================================================
           LABEL
           
           NO FIXED 4-COLUMN WIDTH
           
           This removes the empty space.
           ==================================================== */

        .service-label {

            width: auto;

            margin: 0;

            padding: 0 5px;

            display: flex;

            align-items: center;

            justify-content: flex-start;

            font-size: 9px;

            font-weight: 500;

            color: #333333;

            white-space: nowrap;

        }


        /* ====================================================
           DROPDOWN CONTAINER
           ==================================================== */

        .dropdown-container {

            width: 100%;

            min-width: 0;

        }


        /* ====================================================
           SERVICE DROPDOWN
           
           TAKES ALL EMPTY SPACE
           ==================================================== */

        #dropdown {

            display: block;

            width: 100%;

            height: 32px;

            margin: 0;

            padding: 4px 8px;

            border: 1px solid #8fbfff;

            border-radius: 3px;

            background-color: #ffffff;

            color: #555555;

            font-size: 10px;

            font-weight: 400;

            outline: none;

            cursor: pointer;

        }


        #dropdown:hover {

            border-color: #5da2ff;

        }


        #dropdown:focus {

            border-color: #5da2ff;

            outline: none;

            box-shadow:
                0 0 0 1px
                rgba(0, 123, 255, 0.15);

        }


        /* ====================================================
           DROPDOWN OPTIONS
           ==================================================== */

        #dropdown option {

            font-size: 10px;

            padding: 4px;

        }


        /* ====================================================
           BUTTON CONTAINER
           ==================================================== */

        .button-container {

            width: 100%;

            min-width: 0;

        }


        /* ====================================================
           BUTTONS
           
           BIG BUTTONS
           ==================================================== */

        #startButton,
        #stopButton {

            display: flex;

            align-items: center;

            justify-content: center;

            width: 100%;

            height: 32px;

            margin: 0;

            padding: 0 10px;

            border: none;

            border-radius: 3px;

            font-size: 11px;

            font-weight: 600;

            line-height: 1;

            cursor: pointer;

            user-select: none;

            transition:
                background-color 0.15s ease,
                transform 0.05s ease;

        }


        /* ====================================================
           START BUTTON
           ==================================================== */

        #startButton {

            background-color: #28a745;

            color: #ffffff;

        }


        #startButton:hover {

            background-color: #218838;

        }


        #startButton:active {

            background-color: #1e7e34;

            transform: translateY(1px);

        }


        /* ====================================================
           STOP BUTTON
           ==================================================== */

        #stopButton {

            background-color: #dc3545;

            color: #ffffff;

        }


        #stopButton:hover {

            background-color: #c82333;

        }


        #stopButton:active {

            background-color: #bd2130;

            transform: translateY(1px);

        }


        /* ====================================================
           DESKTOP LARGE SCREEN
           ==================================================== */

        @media (min-width: 1200px) {

            .service-control {

                grid-template-columns:
                    auto
                    minmax(0, 1fr)
                    16%
                    16%;

            }


            #dropdown {

                height: 34px;

                font-size: 10px;

            }


            #startButton,
            #stopButton {

                height: 34px;

                font-size: 11px;

            }

        }


        /* ====================================================
           SMALL SCREEN
           
           STILL ONE ROW
           ==================================================== */

        @media (max-width: 700px) {

            .service-control {

                grid-template-columns:
                    auto
                    minmax(0, 1fr)
                    75px
                    75px;

                column-gap: 4px;

                padding: 5px;

            }


            .service-label {

                font-size: 8px;

                padding: 0 3px;

            }


            #dropdown {

                height: 30px;

                font-size: 9px;

            }


            #startButton,
            #stopButton {

                height: 30px;

                font-size: 10px;

            }

        }

    </style>


    <!-- =====================================================
         SWEETALERT
         ===================================================== -->

    <script src="./style/sweetalert.js"></script>

</head>


<body>


    <!-- =====================================================
         PAGE TITLE
         ===================================================== -->

    <div class="page-title">

        <h3>
            IR Screwing Service Restart
        </h3>

    </div>



    <!-- =====================================================
         SERVICE CONTROL

         LABEL
         ↓
         DROPDOWN TAKES REMAINING SPACE
         ↓
         START
         ↓
         STOP

         ALL IN ONE ROW
         ===================================================== -->

    <div class="service-control">


        <!-- =================================================
             LABEL
             ================================================= -->

        <div class="service-label">

            Choose an option:

        </div>



        <!-- =================================================
             LARGE DROPDOWN
             ================================================= -->

        <div class="dropdown-container">

            <select id="dropdown">

                <option value="">
                    Select Service Name
                </option>


                <option value="ocv_cell_data_mirror_ocv_universal_line_1_2">
                    ocv_cell_data_mirror_ocv_universal_line_1_2
                </option>


                <option value="ocv_cell_data_mirror_ocv_universal_line_3_4">
                    ocv_cell_data_mirror_ocv_universal_line_3_4
                </option>


                <option value="ocv_cell_data_mirror_ocv_universal_line_5_6">
                    ocv_cell_data_mirror_ocv_universal_line_5_6
                </option>


                <option value="ocv_cell_data_mirror_ocv_universal_line_7_8">
                    ocv_cell_data_mirror_ocv_universal_line_7_8
                </option>


                <option value="ocv_cell_data_mirror_ocv_universal_line_A">
                    ocv_cell_data_mirror_ocv_universal_line_A
                </option>


                <option value="ocv_cell_data_mirror_ocv_universal_XNG">
                    ocv_cell_data_mirror_ocv_universal_XNG
                </option>


                <option value="ocv_cell_data_mirror_ocv_universal_bajaj_2w">
                    ocv_cell_data_mirror_ocv_universal_bajaj_2w
                </option>

            </select>

        </div>



        <!-- =================================================
             START
             ================================================= -->

        <div class="button-container">

            <button
                id="startButton"
                type="button">

                Start

            </button>

        </div>



        <!-- =================================================
             STOP
             ================================================= -->

        <div class="button-container">

            <button
                id="stopButton"
                type="button">

                Stop

            </button>

        </div>


    </div>



    <!-- =====================================================
         SOCKET.IO
         ===================================================== -->

    <script src="./style/socket_io.js"></script>



    <!-- =====================================================
         JAVASCRIPT
         ===================================================== -->

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {


                // =================================================
                // ELEMENTS
                // =================================================

                const dropdown =
                    document.getElementById(
                        "dropdown"
                    );


                const startButton =
                    document.getElementById(
                        "startButton"
                    );


                const stopButton =
                    document.getElementById(
                        "stopButton"
                    );


                // =================================================
                // SOCKET.IO
                // =================================================

                const socket = io();


                // =================================================
                // START SERVICE
                // =================================================

                startButton.addEventListener(
                    "click",
                    function () {


                        const selectedValue =
                            dropdown.value;


                        // -----------------------------------------
                        // SERVICE NOT SELECTED
                        // -----------------------------------------

                        if (selectedValue === "") {

                            Swal.fire({

                                title:
                                    "Select Service",

                                text:
                                    "Please select a service name first.",

                                icon:
                                    "warning"

                            });

                            return;

                        }


                        console.log(
                            "Selected Service:",
                            selectedValue
                        );


                        // -----------------------------------------
                        // PASSCODE
                        // -----------------------------------------

                        Swal.fire({

                            title:
                                "Enter Passcode!",

                            html:
                                '<input ' +
                                'id="password" ' +
                                'type="password" ' +
                                'class="swal2-input" ' +
                                'placeholder="Enter Passcode">',

                            showCancelButton:
                                true,

                            confirmButtonText:
                                "Start",

                            cancelButtonText:
                                "Cancel",

                            allowOutsideClick:
                                false

                        }).then(
                            function (result) {


                                if (!result.isConfirmed) {

                                    return;

                                }


                                const password =
                                    document.getElementById(
                                        "password"
                                    ).value;


                                // ---------------------------------
                                // EMPTY PASSWORD
                                // ---------------------------------

                                if (password === "") {

                                    Swal.fire({

                                        title:
                                            "Password Required",

                                        text:
                                            "Please enter the passcode.",

                                        icon:
                                            "warning"

                                    });

                                    return;

                                }


                                // ---------------------------------
                                // PASSWORD CHECK
                                // ---------------------------------

                                if (password !== "service") {

                                    Swal.fire({

                                        title:
                                            "Invalid Passcode",

                                        text:
                                            "Please enter the correct passcode.",

                                        icon:
                                            "error"

                                    });

                                    return;

                                }


                                // ---------------------------------
                                // PM2 START COMMAND
                                // ---------------------------------

                                const cmdname =
                                    `pm2 start ${selectedValue} --interpreter=pythonw`;


                                console.log(
                                    "START COMMAND:",
                                    cmdname
                                );


                                // ---------------------------------
                                // SEND COMMAND
                                // ---------------------------------

                                socket.emit(

                                    "executeBat",

                                    cmdname,

                                    function (response) {


                                        console.log(
                                            "Server Response:",
                                            response
                                        );


                                        if (
                                            response &&
                                            response.success
                                        ) {

                                            Swal.fire({

                                                title:
                                                    "PM2 Service Started",

                                                text:
                                                    `${selectedValue} has been started successfully.`,

                                                icon:
                                                    "success"

                                            });

                                        }

                                        else {

                                            Swal.fire({

                                                title:
                                                    "Failed to Start Service",

                                                text:
                                                    response?.error ||
                                                    "Unable to start PM2 service.",

                                                icon:
                                                    "error"

                                            });

                                        }

                                    }

                                );

                            }

                        );

                    }

                );



                // =================================================
                // STOP SERVICE
                // =================================================

                stopButton.addEventListener(

                    "click",

                    function () {


                        const selectedValue =
                            dropdown.value;


                        // -----------------------------------------
                        // SERVICE NOT SELECTED
                        // -----------------------------------------

                        if (selectedValue === "") {

                            Swal.fire({

                                title:
                                    "Select Service",

                                text:
                                    "Please select a service name first.",

                                icon:
                                    "warning"

                            });

                            return;

                        }


                        console.log(
                            "Selected Service:",
                            selectedValue
                        );


                        // -----------------------------------------
                        // PASSCODE
                        // -----------------------------------------

                        Swal.fire({

                            title:
                                "Enter Passcode!",

                            html:
                                '<input ' +
                                'id="password" ' +
                                'type="password" ' +
                                'class="swal2-input" ' +
                                'placeholder="Enter Passcode">',

                            showCancelButton:
                                true,

                            confirmButtonText:
                                "Stop",

                            cancelButtonText:
                                "Cancel",

                            allowOutsideClick:
                                false

                        }).then(

                            function (result) {


                                if (!result.isConfirmed) {

                                    return;

                                }


                                const password =
                                    document.getElementById(
                                        "password"
                                    ).value;


                                // ---------------------------------
                                // EMPTY PASSWORD
                                // ---------------------------------

                                if (password === "") {

                                    Swal.fire({

                                        title:
                                            "Password Required",

                                        text:
                                            "Please enter the passcode.",

                                        icon:
                                            "warning"

                                    });

                                    return;

                                }


                                // ---------------------------------
                                // PASSWORD CHECK
                                // ---------------------------------

                                if (password !== "service") {

                                    Swal.fire({

                                        title:
                                            "Invalid Passcode",

                                        text:
                                            "Please enter the correct passcode.",

                                        icon:
                                            "error"

                                    });

                                    return;

                                }


                                // ---------------------------------
                                // PM2 STOP COMMAND
                                // ---------------------------------

                                const cmdname =
                                    `pm2 stop ${selectedValue}`;


                                console.log(
                                    "STOP COMMAND:",
                                    cmdname
                                );


                                // ---------------------------------
                                // SEND COMMAND
                                // ---------------------------------

                                socket.emit(

                                    "executeBat",

                                    cmdname,

                                    function (response) {


                                        console.log(
                                            "Server Response:",
                                            response
                                        );


                                        if (
                                            response &&
                                            response.success
                                        ) {

                                            Swal.fire({

                                                title:
                                                    "PM2 Service Stopped",

                                                text:
                                                    `${selectedValue} has been stopped successfully.`,

                                                icon:
                                                    "success"

                                            });

                                        }

                                        else {

                                            Swal.fire({

                                                title:
                                                    "Failed to Stop Service",

                                                text:
                                                    response?.error ||
                                                    "Unable to stop PM2 service.",

                                                icon:
                                                    "error"

                                            });

                                        }

                                    }

                                );

                            }

                        );

                    }

                );



                // =================================================
                // SOCKET CONNECT
                // =================================================

                socket.on(
                    "connect",
                    function () {

                        console.log(
                            "Connected to server."
                        );

                        console.log(
                            "Socket ID:",
                            socket.id
                        );

                    }
                );



                // =================================================
                // SOCKET DISCONNECT
                // =================================================

                socket.on(
                    "disconnect",
                    function () {

                        console.log(
                            "Disconnected from server."
                        );

                    }
                );


            }

        );

    </script>


</body>

</html>
