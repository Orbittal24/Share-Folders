import json
import time
import redis

r = redis.StrictRedis(
    host="localhost",
    port=6379,
    password="Gotion@123Strong!",
    db=31,
    decode_responses=True
)

SCAN_COUNT = 5000

cursor = 0
scanned = skipped = no_date = 0
oldest_time, oldest_key, oldest_cellqr = None, None, None
newest_time, newest_key, newest_cellqr = None, None, None

while True:
    cursor, keys = r.scan(cursor=cursor, match="cell:*", count=SCAN_COUNT)

    if keys:
        for key, raw in zip(keys, r.mget(keys)):
            scanned += 1
            if not raw:
                continue            # expired between SCAN and MGET
            try:
                data = json.loads(raw)
            except (json.JSONDecodeError, TypeError):
                skipped += 1        # not JSON
                continue

            fpt = str(data.get("first_para_time") or "").strip()
            if not fpt or fpt.lower() == "null":
                no_date += 1
                continue

            if oldest_time is None or fpt < oldest_time:
                oldest_time, oldest_key, oldest_cellqr = fpt, key, data.get("cellqr")
            if newest_time is None or fpt > newest_time:
                newest_time, newest_key, newest_cellqr = fpt, key, data.get("cellqr")

        print(f"scanned={scanned}  oldest so far={oldest_time}  cellqr={oldest_cellqr}")

    if cursor == 0:
        break

    time.sleep(0.05)

print("\nCompleted (read-only, nothing deleted).")
print(f"Total cell keys scanned : {scanned}")
print(f"Oldest first_para_time  : {oldest_time}")
print(f"  cellqr                : {oldest_cellqr}")
print(f"  redis key             : {oldest_key}")
print(f"Newest first_para_time  : {newest_time}")
print(f"  cellqr                : {newest_cellqr}")
print(f"  redis key             : {newest_key}")
print(f"Keys with no date       : {no_date}")
print(f"Non-JSON keys skipped   : {skipped}")
