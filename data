import pyodbc
import time


# ================================================================
# SQL CONNECTION CONFIGURATION
# ================================================================

SQL_CONN_STR = (
    'DRIVER={ODBC Driver 17 for SQL Server};'
    'SERVER=10.9.4.29\\PROD_SQL_2026;'
    'DATABASE=taco_treceability_master;'
    'UID=user_mis;'
    'PWD=admin@123;'
    'Connection Timeout=10;'
    'ConnectRetryCount=3;'
    'ConnectRetryInterval=5;'
)


# ================================================================
# FETCH IP LIST
# ================================================================

def fetch_ip_list():

    conn = None
    cursor = None

    max_retries = 3

    for attempt in range(1, max_retries + 1):

        try:

            print(
                f"[SQL IP LIST] Connecting to SQL Server "
                f"(attempt {attempt}/{max_retries})..."
            )

            conn = pyodbc.connect(SQL_CONN_STR)
            cursor = conn.cursor()

            cursor.execute("""
                SELECT ip
                FROM taco_treceability.MIS_ip_master
                WHERE name = 'IR_Controller'
                  AND status = '1'
            """)

            ips = [row[0] for row in cursor.fetchall()]

            print(
                f"[SQL IP LIST] Successfully fetched "
                f"{len(ips)} controller IP(s)."
            )

            return ips

        except pyodbc.Error as e:

            print(
                f"[SQL IP LIST ERROR] "
                f"Attempt {attempt}/{max_retries}: {e}"
            )

            if attempt < max_retries:

                print(
                    "[SQL IP LIST] SQL connection failed. "
                    "Retrying in 3 seconds..."
                )

                time.sleep(3)

            else:

                print(
                    "[SQL IP LIST] All SQL connection attempts failed."
                )

        except Exception as e:

            print(
                f"[SQL IP LIST ERROR] Unexpected error: {e}"
            )

            if attempt < max_retries:
                time.sleep(3)

        finally:

            try:
                if cursor:
                    cursor.close()
            except Exception:
                pass

            try:
                if conn:
                    conn.close()
            except Exception:
                pass

            cursor = None
            conn = None

    # ------------------------------------------------------------
    # IMPORTANT:
    # Return None instead of terminating the complete application.
    # reader_process.py will keep existing controller processes
    # running and retry fetching the IP list later.
    # ------------------------------------------------------------

    return None


# ================================================================
# MONITOR IPS
# ================================================================

def monitor_ips(interval=10):

    last_ip_set = set()

    print("Monitoring for new IPs... Press Ctrl+C to stop.")

    try:

        while True:

            current_ips = fetch_ip_list()

            # ----------------------------------------------------
            # SQL temporarily unavailable
            # ----------------------------------------------------
            if current_ips is None:

                print(
                    "[IP MONITOR] Unable to fetch IP list. "
                    "Keeping previous IP list."
                )

                time.sleep(interval)
                continue

            current_ips = set(current_ips)

            new_ips = current_ips - last_ip_set
            removed_ips = last_ip_set - current_ips

            if new_ips:
                print(
                    "[IP MONITOR] New IPs added:",
                    list(new_ips)
                )

            if removed_ips:
                print(
                    "[IP MONITOR] IPs removed:",
                    list(removed_ips)
                )

            if new_ips or removed_ips:
                print(
                    "[IP MONITOR] Current IPs:",
                    list(current_ips)
                )

            last_ip_set = current_ips

            time.sleep(interval)

    except KeyboardInterrupt:

        print("\nMonitoring stopped.")


# ================================================================
# MAIN
# ================================================================

if __name__ == "__main__":
    monitor_ips()
