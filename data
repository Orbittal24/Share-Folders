const net = require("net");
const { SerialPort } = require("serialport");
const XLSX = require("xlsx");
const fs = require("fs");
const path = require("path");
const os = require("os");


// ============================================================
// MAIN SERVER TCP CONFIGURATION
// ============================================================

// FastAPI backend server IP
const SERVER_IP = "10.9.4.28";

// TCP server port
const SERVER_PORT = 5000;


// ============================================================
// TEST MODE
// ============================================================
//
// true  = Test TCP + Excel comparison without COM port
// false = Use real COM port and physical buzzer
//
const TEST_MODE = true;


// ============================================================
// SERIAL RELAY CONFIGURATION
// ============================================================

const SERIAL_PORT = "COM4";

const BAUD_RATE = 9600;

const DATA_BITS = 8;

const STOP_BITS = 1;

const PARITY = "none";


// ============================================================
// EXCEL CONFIGURATION
// ============================================================
//
// Excel file:
//
// C:\Users\useradmin\Desktop\buzzer_line.xlsx
//
// Expected format:
//
// Sheet Name: Sheet1
//
// Cell A1 contains the line number.
//
// Example:
//
// A1 = 1
//

const EXCEL_FILE_NAME = "buzzer_line.xlsx";

const EXCEL_FILE_PATH = path.join(
    os.homedir(),
    "Desktop",
    EXCEL_FILE_NAME
);

const SHEET_NAME = "Sheet1";

const LINE_CELL = "A1";


// ============================================================
// BUZZER CONFIGURATION
// ============================================================

// Buzzer duration = 10 seconds
const BUZZER_DURATION = 10000;


// ============================================================
// RECONNECT CONFIGURATION
// ============================================================

const TCP_RECONNECT_DELAY = 3000;

const SERIAL_RECONNECT_DELAY = 3000;


// ============================================================
// RELAY COMMANDS
// ============================================================

// RELAY ON
// A0 01 01 A2
const RELAY_ON_COMMAND = Buffer.from([
    0xA0,
    0x01,
    0x01,
    0xA2
]);


// RELAY OFF
// A0 01 00 A1
const RELAY_OFF_COMMAND = Buffer.from([
    0xA0,
    0x01,
    0x00,
    0xA1
]);


// ============================================================
// APPLICATION STATE
// ============================================================

let serialPort = null;

let isSerialConnecting = false;

let isBuzzerRunning = false;

let buzzerTimer = null;

let tcpClient = null;

let tcpReconnectTimer = null;

let receivedBuffer = "";


// ============================================================
// READ LINE NUMBER FROM LOCAL EXCEL
// ============================================================
//
// Reads:
//
// Sheet1!A1
//

function readLocalExcelLine() {

    console.log(
        `[EXCEL] Reading file: ${EXCEL_FILE_PATH}`
    );


    // Check Excel file exists
    if (!fs.existsSync(EXCEL_FILE_PATH)) {

        throw new Error(
            `Excel file not found: ${EXCEL_FILE_PATH}`
        );
    }


    // Read Excel workbook
    const workbook = XLSX.readFile(
        EXCEL_FILE_PATH
    );


    // Check Sheet1 exists
    if (!workbook.SheetNames.includes(SHEET_NAME)) {

        throw new Error(
            `Excel sheet "${SHEET_NAME}" not found`
        );
    }


    // Get worksheet
    const worksheet =
        workbook.Sheets[SHEET_NAME];


    // Get A1
    const cell =
        worksheet[LINE_CELL];


    // Validate A1
    if (
        !cell ||
        cell.v === undefined ||
        cell.v === null ||
        String(cell.v).trim() === ""
    ) {

        throw new Error(
            `Excel cell ${LINE_CELL} is empty`
        );
    }


    // Convert to string
    const lineNo =
        String(cell.v).trim();


    console.log(
        `[EXCEL] Sheet: ${SHEET_NAME}`
    );

    console.log(
        `[EXCEL] Cell ${LINE_CELL}: ${lineNo}`
    );


    return lineNo;
}


// ============================================================
// CONNECT SERIAL RELAY
// ============================================================

async function connectSerialRelay() {

    // TEST MODE:
    // Completely skip COM port connection
    if (TEST_MODE) {

        console.log(
            "[TEST MODE] COM port connection skipped."
        );

        return false;
    }


    // Already connected
    if (
        serialPort &&
        serialPort.isOpen
    ) {

        return true;
    }


    // Connection already in progress
    if (isSerialConnecting) {

        return false;
    }


    isSerialConnecting = true;


    console.log(
        `[SERIAL] Connecting to ${SERIAL_PORT}...`
    );


    return new Promise((resolve) => {

        serialPort = new SerialPort({
            path: SERIAL_PORT,
            baudRate: BAUD_RATE,
            dataBits: DATA_BITS,
            stopBits: STOP_BITS,
            parity: PARITY,
            autoOpen: false,
        });


        // Serial data received
        serialPort.on(
            "data",
            (data) => {

                console.log(
                    `[SERIAL RESPONSE] ${data
                        .toString("hex")
                        .toUpperCase()}`
                );

            }
        );


        // Serial error
        serialPort.on(
            "error",
            (error) => {

                console.error(
                    `[SERIAL ERROR] ${error.message}`
                );

            }
        );


        // Serial closed
        serialPort.on(
            "close",
            () => {

                console.log(
                    "[SERIAL] Relay COM port closed"
                );

                isSerialConnecting = false;

            }
        );


        // Open COM port
        serialPort.open(
            (error) => {

                isSerialConnecting = false;


                if (error) {

                    console.error(
                        `[SERIAL ERROR] ${error.message}`
                    );

                    resolve(false);

                    return;
                }


                console.log(
                    `[SERIAL] Connected successfully to ${SERIAL_PORT}`
                );

                resolve(true);

            }
        );

    });
}


// ============================================================
// ENSURE SERIAL RELAY IS CONNECTED
// ============================================================

async function ensureSerialConnected() {

    if (TEST_MODE) {

        return false;
    }


    if (
        serialPort &&
        serialPort.isOpen
    ) {

        return true;
    }


    return await connectSerialRelay();
}


// ============================================================
// SEND RELAY COMMAND
// ============================================================

async function sendRelayCommand(
    command,
    commandName
) {

    if (TEST_MODE) {

        console.log(
            `[TEST MODE] Command skipped: ${commandName}`
        );

        return;
    }


    const connected =
        await ensureSerialConnected();


    if (!connected) {

        throw new Error(
            `Relay not connected on ${SERIAL_PORT}`
        );
    }


    return new Promise(
        (resolve, reject) => {

            console.log(
                `[SERIAL] Sending ${commandName}`
            );


            console.log(
                `[SERIAL] Command: ${command
                    .toString("hex")
                    .toUpperCase()}`
            );


            serialPort.write(
                command,
                (writeError) => {

                    if (writeError) {

                        reject(writeError);

                        return;
                    }


                    serialPort.drain(
                        (drainError) => {

                            if (drainError) {

                                reject(drainError);

                                return;
                            }


                            console.log(
                                `[SERIAL] ${commandName} command sent successfully`
                            );

                            resolve();

                        }
                    );

                }
            );

        }
    );
}


// ============================================================
// START BUZZER
// ============================================================

async function startBuzzer(lineNo) {

    // Do not restart if already running
    if (isBuzzerRunning) {

        console.log(
            `[BUZZER] Already running. ` +
            `New trigger for Line ${lineNo} ignored.`
        );

        return;
    }


    isBuzzerRunning = true;


    console.log("");
    console.log("================================================");
    console.log(
        `[BUZZER] STARTING FOR LINE: ${lineNo}`
    );
    console.log("================================================");


    // ========================================================
    // TEST MODE
    // ========================================================

    if (TEST_MODE) {

        console.log("");
        console.log("################################################");
        console.log("🧪 TEST MODE - SIMULATED BUZZER");
        console.log("################################################");

        console.log(
            `[TEST BUZZER] LINE ${lineNo} MATCHED`
        );

        console.log(
            `[TEST BUZZER] BUZZER STARTED`
        );

        console.log(
            `[TEST BUZZER] RUNNING FOR ` +
            `${BUZZER_DURATION / 1000} SECONDS`
        );

        console.log("################################################");
        console.log("");


        if (buzzerTimer) {

            clearTimeout(
                buzzerTimer
            );

            buzzerTimer = null;
        }


        buzzerTimer = setTimeout(
            async () => {

                await stopBuzzer();

            },
            BUZZER_DURATION
        );

        return;
    }


    // ========================================================
    // REAL MODE
    // ========================================================

    try {

        // Send ON command
        await sendRelayCommand(
            RELAY_ON_COMMAND,
            "RELAY ON"
        );


        console.log(
            `[BUZZER] ON for ` +
            `${BUZZER_DURATION / 1000} seconds`
        );


        if (buzzerTimer) {

            clearTimeout(
                buzzerTimer
            );

            buzzerTimer = null;
        }


        buzzerTimer = setTimeout(
            async () => {

                await stopBuzzer();

            },
            BUZZER_DURATION
        );

    } catch (error) {

        console.error(
            `[BUZZER ON ERROR] ${error.message}`
        );

        isBuzzerRunning = false;
    }
}


// ============================================================
// STOP BUZZER
// ============================================================

async function stopBuzzer() {

    if (buzzerTimer) {

        clearTimeout(
            buzzerTimer
        );

        buzzerTimer = null;
    }


    console.log("");
    console.log("================================================");
    console.log(
        `[BUZZER] ${BUZZER_DURATION / 1000} SECONDS COMPLETED`
    );
    console.log(
        "[BUZZER] TURNING OFF..."
    );
    console.log("================================================");


    // TEST MODE
    if (TEST_MODE) {

        console.log(
            "[TEST BUZZER] BUZZER STOPPED SUCCESSFULLY"
        );

        isBuzzerRunning = false;

        return;
    }


    // REAL MODE
    try {

        await sendRelayCommand(
            RELAY_OFF_COMMAND,
            "RELAY OFF"
        );


        console.log(
            "[BUZZER] OFF SUCCESSFULLY"
        );

    } catch (error) {

        console.error(
            `[BUZZER OFF ERROR] ${error.message}`
        );

    } finally {

        isBuzzerRunning = false;
    }
}


// ============================================================
// PROCESS RECEIVED BROADCAST LINE NUMBER
// ============================================================

async function processBroadcast(
    receivedLineNo
) {

    console.log("");
    console.log("################################################");
    console.log(
        `[TCP] RECEIVED BROADCAST LINE NO: ${receivedLineNo}`
    );
    console.log("################################################");


    try {

        // Read Excel line number
        const excelLine =
            readLocalExcelLine();


        // Convert both values to strings
        const serverLine =
            String(
                receivedLineNo
            ).trim();

        const localLine =
            String(
                excelLine
            ).trim();


        console.log("");
        console.log("================================================");
        console.log("LINE COMPARISON");
        console.log("================================================");

        console.log(
            `Broadcasted Line : ${serverLine}`
        );

        console.log(
            `Excel A1 Line    : ${localLine}`
        );

        console.log("================================================");


        // ====================================================
        // LINE DOES NOT MATCH
        // ====================================================

        if (serverLine !== localLine) {

            console.log("");
            console.log("❌ [CLIENT] LINE NOT MATCHED");

            console.log(
                "[CLIENT] BUZZER WILL REMAIN OFF"
            );

            console.log("");

            return;
        }


        // ====================================================
        // LINE MATCHED
        // ====================================================

        console.log("");
        console.log("✅ [CLIENT] LINE MATCHED SUCCESSFULLY");

        console.log(
            "[CLIENT] STARTING BUZZER..."
        );

        console.log("");


        // Start test buzzer or real buzzer
        await startBuzzer(
            receivedLineNo
        );

    } catch (error) {

        console.error("");

        console.error(
            `[CLIENT ERROR] ${error.message}`
        );

        console.error(
            "[CLIENT] BUZZER WILL NOT START"
        );

        console.error("");
    }
}


// ============================================================
// PROCESS TCP MESSAGE
// ============================================================
//
// Expected:
//
// {"line_no": 1}\n
//

async function processTcpMessage(
    message
) {

    const trimmedMessage =
        message.trim();


    // Ignore empty message
    if (!trimmedMessage) {

        return;
    }


    try {

        console.log(
            `[TCP] RAW MESSAGE: ${trimmedMessage}`
        );


        // Parse JSON
        const parsed =
            JSON.parse(
                trimmedMessage
            );


        // Get broadcasted line_no
        const lineNo =
            parsed.line_no;


        // Validate line_no
        if (
            lineNo === undefined ||
            lineNo === null ||
            String(lineNo).trim() === ""
        ) {

            console.error(
                "[TCP ERROR] line_no missing from server message"
            );

            return;
        }


        // Process line
        await processBroadcast(
            lineNo
        );

    } catch (error) {

        console.error(
            `[TCP MESSAGE ERROR] ${error.message}`
        );

        console.error(
            `[TCP MESSAGE] Invalid message: ${trimmedMessage}`
        );
    }
}


// ============================================================
// CONNECT TO MAIN TCP SERVER
// ============================================================

function connectToMainServer() {

    // Prevent duplicate connection
    if (
        tcpClient &&
        !tcpClient.destroyed
    ) {

        return;
    }


    console.log("");
    console.log("================================================");
    console.log(
        "[TCP] CONNECTING TO MAIN SERVER"
    );
    console.log(
        `[TCP] Server: ${SERVER_IP}:${SERVER_PORT}`
    );
    console.log("================================================");


    tcpClient =
        new net.Socket();


    // Connect
    tcpClient.connect(
        SERVER_PORT,
        SERVER_IP,
        () => {

            console.log("");
            console.log("================================================");
            console.log(
                "✅ [TCP] CONNECTED TO MAIN SERVER"
            );
            console.log(
                `[TCP] Connected: ${SERVER_IP}:${SERVER_PORT}`
            );
            console.log("================================================");
            console.log("");

        }
    );


    // ========================================================
    // RECEIVE DATA
    // ========================================================

    tcpClient.on(
        "data",
        async (data) => {

            // Add received TCP data to buffer
            receivedBuffer +=
                data.toString(
                    "utf8"
                );


            // Split using newline
            const messages =
                receivedBuffer.split(
                    "\n"
                );


            // Keep incomplete message
            receivedBuffer =
                messages.pop();


            // Process complete messages
            for (
                const message of messages
            ) {

                await processTcpMessage(
                    message
                );
            }

        }
    );


    // ========================================================
    // TCP ERROR
    // ========================================================

    tcpClient.on(
        "error",
        (error) => {

            console.error(
                `[TCP ERROR] ${error.message}`
            );
        }
    );


    // ========================================================
    // TCP CLOSE
    // ========================================================

    tcpClient.on(
        "close",
        () => {

            console.log(
                "[TCP] Disconnected from main server"
            );

            tcpClient = null;

            receivedBuffer = "";

            scheduleTcpReconnect();
        }
    );

}


// ============================================================
// TCP AUTO RECONNECT
// ============================================================

function scheduleTcpReconnect() {

    // Prevent multiple reconnect timers
    if (tcpReconnectTimer) {

        return;
    }


    console.log(
        `[TCP] Reconnecting in ` +
        `${TCP_RECONNECT_DELAY / 1000} seconds...`
    );


    tcpReconnectTimer =
        setTimeout(
            () => {

                tcpReconnectTimer = null;

                connectToMainServer();

            },
            TCP_RECONNECT_DELAY
        );
}


// ============================================================
// SERIAL AUTO RECONNECT
// ============================================================

function startSerialReconnectCheck() {

    // Completely disabled in TEST MODE
    if (TEST_MODE) {

        console.log(
            "[TEST MODE] Serial auto reconnect disabled."
        );

        return;
    }


    setInterval(
        async () => {

            if (
                !serialPort ||
                !serialPort.isOpen
            ) {

                console.log(
                    "[SERIAL] Relay disconnected. Trying to reconnect..."
                );

                await connectSerialRelay();
            }

        },
        SERIAL_RECONNECT_DELAY
    );
}


// ============================================================
// START APPLICATION
// ============================================================

async function startApplication() {

    console.log("");
    console.log("================================================");
    console.log(
        "BUZZER TCP CLIENT STARTED"
    );
    console.log("================================================");

    console.log(
        `Main Server IP   : ${SERVER_IP}`
    );

    console.log(
        `Main Server Port : ${SERVER_PORT}`
    );

    console.log(
        `Test Mode        : ${TEST_MODE ? "ON" : "OFF"}`
    );


    if (TEST_MODE) {

        console.log(
            "Serial Relay     : DISABLED FOR TESTING"
        );

    } else {

        console.log(
            `Serial Port      : ${SERIAL_PORT}`
        );

        console.log(
            `Baud Rate        : ${BAUD_RATE}`
        );
    }


    console.log(
        `Excel File       : ${EXCEL_FILE_PATH}`
    );

    console.log(
        `Excel Sheet      : ${SHEET_NAME}`
    );

    console.log(
        `Excel Line Cell  : ${LINE_CELL}`
    );

    console.log(
        `Buzzer Duration  : ${BUZZER_DURATION / 1000} seconds`
    );

    console.log("================================================");


    // ========================================================
    // SERIAL CONNECTION
    // ========================================================

    if (TEST_MODE) {

        console.log(
            "[TEST MODE] COM port connection disabled."
        );

        console.log(
            "[TEST MODE] Ready for TCP + Excel comparison."
        );

    } else {

        const serialConnected =
            await connectSerialRelay();


        if (serialConnected) {

            try {

                console.log(
                    "[STARTUP] Sending RELAY OFF command..."
                );

                await sendRelayCommand(
                    RELAY_OFF_COMMAND,
                    "RELAY OFF (STARTUP)"
                );

            } catch (error) {

                console.error(
                    `[STARTUP ERROR] ${error.message}`
                );
            }

        } else {

            console.log(
                "[STARTUP] Serial relay not connected."
            );
        }


        // Start serial reconnect only in real mode
        startSerialReconnectCheck();
    }


    // ========================================================
    // CONNECT TO MAIN TCP SERVER
    // ========================================================

    connectToMainServer();
}


// ============================================================
// SAFE SHUTDOWN
// ============================================================

async function shutdown(
    signal
) {

    console.log("");

    console.log(
        `[SYSTEM] ${signal} received`
    );

    console.log(
        "[SYSTEM] Shutting down buzzer client..."
    );


    // Stop timer
    if (buzzerTimer) {

        clearTimeout(
            buzzerTimer
        );

        buzzerTimer = null;
    }


    // Turn relay OFF only in real mode
    if (
        !TEST_MODE &&
        serialPort &&
        serialPort.isOpen
    ) {

        try {

            await sendRelayCommand(
                RELAY_OFF_COMMAND,
                "RELAY OFF (SHUTDOWN)"
            );

        } catch (error) {

            console.error(
                `[SHUTDOWN ERROR] ${error.message}`
            );
        }
    }


    // Close TCP connection
    if (
        tcpClient &&
        !tcpClient.destroyed
    ) {

        tcpClient.destroy();
    }


    // Close serial connection
    if (
        !TEST_MODE &&
        serialPort &&
        serialPort.isOpen
    ) {

        await new Promise(
            (resolve) => {

                serialPort.close(
                    () => resolve()
                );
            }
        );
    }


    console.log(
        "[SYSTEM] Client stopped."
    );

    process.exit(0);
}


// ============================================================
// SHUTDOWN EVENTS
// ============================================================

process.on(
    "SIGINT",
    () => shutdown("CTRL+C / SIGINT")
);

process.on(
    "SIGTERM",
    () => shutdown("SIGTERM")
);


// ============================================================
// START CLIENT
// ============================================================

startApplication();
