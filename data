const { exec } = require("child_process");
const express = require("express");
const app = express();
const http = require("http").Server(app);
const io = require("socket.io")(http);
const path = require("path");


// ============================================================
// SERVE STATIC FILES
// ============================================================

app.use(express.static(__dirname));


// ============================================================
// HTML ROUTES
// ============================================================

app.get("/", function (req, res) {

    res.sendFile(
        path.join(__dirname, "Altrestart.html")
    );

});


app.get("/ocv", function (req, res) {

    res.sendFile(
        path.join(__dirname, "ocv.html")
    );

});


app.get("/NPDService", function (req, res) {

    res.sendFile(
        path.join(__dirname, "NPDrestart.html")
    );

});


app.get("/LineService", function (req, res) {

    res.sendFile(
        path.join(__dirname, "Linerestart.html")
    );

});


// ============================================================
// SOCKET.IO CONNECTION
// ============================================================

io.on("connection", function (socket) {

    console.log(
        "Client connected:",
        socket.id
    );


    // ========================================================
    // EXECUTE PM2 COMMAND
    // ========================================================

    socket.on(
        "executeBat",
        function (command, callback) {

            console.log(
                "========================================"
            );

            console.log(
                "Command received:"
            );

            console.log(
                command
            );

            console.log(
                "========================================"
            );


            // =================================================
            // EXECUTE COMMAND
            // =================================================

            exec(
                command,
                function (error, stdout, stderr) {


                    // =========================================
                    // ERROR
                    // =========================================

                    if (error) {

                        console.error(
                            "Command execution error:"
                        );

                        console.error(
                            error.message
                        );


                        console.error(
                            "STDERR:"
                        );

                        console.error(
                            stderr
                        );


                        // Send response to browser
                        if (callback) {

                            callback({

                                success: false,

                                error:
                                    stderr ||
                                    error.message

                            });

                        }

                        return;
                    }


                    // =========================================
                    // SUCCESS
                    // =========================================

                    console.log(
                        "Command executed successfully."
                    );


                    console.log(
                        "STDOUT:"
                    );

                    console.log(
                        stdout
                    );


                    if (stderr) {

                        console.log(
                            "STDERR:"
                        );

                        console.log(
                            stderr
                        );

                    }


                    // =========================================
                    // SEND SUCCESS RESPONSE
                    // =========================================

                    if (callback) {

                        callback({

                            success: true,

                            stdout: stdout,

                            stderr: stderr

                        });

                    }

                }
            );

        }
    );


    // ========================================================
    // CLIENT DISCONNECTED
    // ========================================================

    socket.on("disconnect", function () {

        console.log(
            "Client disconnected:",
            socket.id
        );

    });

});


// ============================================================
// START SERVER
// ============================================================

http.listen(
    3998,
    "0.0.0.0",
    function () {

        console.log(
            "========================================"
        );

        console.log(
            "IR Screwing Service Restart Server"
        );

        console.log(
            "Server running on port 3998"
        );

        console.log(
            "========================================"
        );

    }
);
