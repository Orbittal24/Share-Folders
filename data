
function filterSql(filters) {
    const statusCondition =
        filters.mode === "status"
            ? `
                AND LOWER(
                    LTRIM(
                        RTRIM(
                            CONVERT(VARCHAR(30), [pack_status])
                        )
                    )
                ) = @status
            `
            : "";

    return `
        WHERE [current_dateTime] < DATEADD(
                DAY,
                1,
                @startDate
          )
          ${statusCondition}
    `;
}
