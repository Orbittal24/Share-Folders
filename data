<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <title>Station Status</title>

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    >


    <style>

        body {
            background: #f4f6f9;
            font-family: Arial;
        }


        .card {

            background: #fff;

            max-width: 1000px;

            margin: 40px auto;

            padding: 30px;

            border-radius: 10px;

            box-shadow:
                0 6px 18px rgba(0, 0, 0, .15);

        }


        h2 {

            color: #2e7d32;

            margin-bottom: 25px;

        }


        .row {

            display: flex;

            gap: 24px;

            flex-wrap: wrap;

        }


        .group {

            display: flex;

            flex-direction: column;

        }


        .group.station {

            flex: 3;

            min-width: 250px;

        }


        .group.line {

            flex: 1;

            max-width: 120px;

        }


        .group.barcode {

            flex: 2;

            min-width: 220px;

        }


        label {

            font-size: 14px;

            margin-bottom: 6px;

            font-weight: bold;

        }


        input,
        select {

            width: 95%;

            height: 45px;

            font-size: 16px;

            padding: 6px 10px;

            border-radius: 6px;

            border: 1px solid #ccc;

        }


        #barcode {

            font-size: 18px;

            letter-spacing: 1px;

        }


        .button-row {

            text-align: center;

            margin-top: 30px;

        }


        button {

            height: 45px;

            width: 160px;

            font-size: 16px;

            font-weight: bold;

            background: #28a745;

            border: none;

            color: white;

            border-radius: 6px;

            cursor: pointer;

        }


        button:hover {

            background: #218838;

        }


        .popup-overlay {

            display: none;

            position: fixed;

            inset: 0;

            background:
                rgba(0, 0, 0, .4);

            justify-content: center;

            align-items: center;

        }


        .popup {

            background: #fff;

            padding: 25px 30px;

            border-radius: 8px;

            text-align: center;

            min-width: 300px;

        }

    </style>

</head>


<body>


    <!-- MAIN CARD -->

    <div class="card">

        <h2>
            New MIS Station Status OK
        </h2>


        <div class="row">


            <!-- STATION -->

            <div class="group station">

                <label>
                    Station Name :
                </label>


                <input
                    list="stations"
                    id="stationName"
                    placeholder="Search Station"
                >


                <datalist id="stations"></datalist>

            </div>


            <!-- LINE -->

            <div class="group line">

                <label>
                    Line :
                </label>


                <select id="line">

                    <option value="1">
                        1
                    </option>

                </select>

            </div>


            <!-- BARCODE -->

            <div class="group barcode">

                <label>
                    Barcode :
                </label>


                <input
                    type="text"
                    id="barcode"
                    placeholder="Scan Barcode"
                    autocomplete="off"
                    inputmode="none"
                    autofocus
                >

            </div>


        </div>


        <!-- SUBMIT BUTTON -->

        <div class="button-row">

            <button onclick="submitData()">
                Submit
            </button>

        </div>

    </div>



    <!-- PASSWORD POPUP -->

    <div
        class="popup-overlay"
        id="passwordPopup"
    >

        <div class="popup">

            <h3>
                Enter Password
            </h3>


            <input
                type="password"
                id="passwordInput"
                placeholder="Enter Password"
                autocomplete="off"
            >


            <br>
            <br>


            <button onclick="verifyPassword()">
                OK
            </button>

        </div>

    </div>



    <!-- RESULT POPUP -->

    <div
        class="popup-overlay"
        id="resultPopup"
    >

        <div class="popup">

            <h3 id="popupMessage"></h3>


            <button onclick="closePopup()">
                OK
            </button>

        </div>

    </div>



    <script>


        /********************************************************
         * GLOBAL VARIABLES
         ********************************************************/

        let stationMap = {};

        let tempData = {};


        /********************************************************
         * LOAD STATIONS
         ********************************************************/

        fetch('/api/stations')

            .then(res => res.json())

            .then(data => {

                const list =
                    document.getElementById(
                        'stations'
                    );


                data.forEach(r => {

                    stationMap[
                        r.Station_Name
                    ] =
                        r.Station_ID;


                    const opt =
                        document.createElement(
                            'option'
                        );


                    opt.value =
                        r.Station_Name;


                    list.appendChild(
                        opt
                    );

                });

            })

            .catch(err => {

                console.error(
                    "Station loading error:",
                    err
                );

            });



        /********************************************************
         * SUBMIT DATA
         *
         * EXISTING FLOW REMAINS SAME
         ********************************************************/

        function submitData() {


            const stationName =
                document
                    .getElementById(
                        'stationName'
                    )
                    .value
                    .trim();


            const stationId =
                stationMap[
                    stationName
                ];


            const line =
                document
                    .getElementById(
                        'line'
                    )
                    .value;


            const barcode =
                document
                    .getElementById(
                        'barcode'
                    )
                    .value
                    .trim();


            /****************************************************
             * VALIDATE STATION AND BARCODE
             ****************************************************/

            if (!stationId || !barcode) {

                showResultPopup(
                    "Select valid station and scan barcode"
                );

                return;

            }


            /****************************************************
             * STORE TEMP DATA
             ****************************************************/

            tempData = {

                stationId,
                line,
                barcode

            };


            /****************************************************
             * SHOW PASSWORD POPUP
             ****************************************************/

            document
                .getElementById(
                    'passwordPopup'
                )
                .style.display = "flex";


            /****************************************************
             * FOCUS PASSWORD FIELD
             ****************************************************/

            setTimeout(() => {

                document
                    .getElementById(
                        'passwordInput'
                    )
                    .focus();

            }, 100);

        }



        /********************************************************
         * VERIFY PASSWORD
         *
         * PASSWORD IS NOW CHECKED FROM DATABASE
         ********************************************************/

        function verifyPassword() {


            const pwd =
                document
                    .getElementById(
                        'passwordInput'
                    )
                    .value
                    .trim();


            /****************************************************
             * CHECK EMPTY PASSWORD
             ****************************************************/

            if (!pwd) {

                alert(
                    "Please enter password"
                );

                return;

            }


            /****************************************************
             * SEND PASSWORD TO NODE.JS
             ****************************************************/

            fetch(
                '/api/verify-password',
                {

                    method: 'POST',

                    headers: {
                        'Content-Type':
                            'application/json'
                    },

                    body: JSON.stringify({

                        password: pwd

                    })

                }
            )


            /****************************************************
             * PROCESS PASSWORD RESPONSE
             ****************************************************/

            .then(async res => {

                const data =
                    await res.json();


                if (!res.ok) {

                    throw new Error(
                        data.message ||
                        "Invalid Password"
                    );

                }


                return data;

            })


            /****************************************************
             * PASSWORD VALID
             ****************************************************/

            .then(authData => {


                /************************************************
                 * USERNAME COMES FROM DATABASE
                 ************************************************/

                const username =
                    authData.username;


                console.log(
                    "Authenticated Username:",
                    username
                );


                /************************************************
                 * CLOSE PASSWORD POPUP
                 ************************************************/

                document
                    .getElementById(
                        'passwordPopup'
                    )
                    .style.display = "none";


                /************************************************
                 * EXISTING SCAN API
                 ************************************************/

                fetch(
                    '/api/scan',
                    {

                        method: 'POST',

                        headers: {

                            'Content-Type':
                                'application/json'

                        },

                        body: JSON.stringify({

                            ...tempData,

                            username:
                                username

                        })

                    }
                )


                /************************************************
                 * PROCESS SCAN RESPONSE
                 ************************************************/

                .then(async res => {

                    const resp =
                        await res.json();


                    if (!res.ok) {

                        throw new Error(
                            resp.message ||
                            "Scan failed"
                        );

                    }


                    return resp;

                })


                .then(resp => {


                    /********************************************
                     * EXISTING RESPONSE LOGIC
                     ********************************************/

                    const apiMsg =

                        resp
                            .externalApiResponse
                            ?.message ||

                        resp
                            .externalApiResponse
                            ?.msg ||

                        resp.message;


                    if (
                        apiMsg ===
                        "Station created/updated successfully."
                    ) {

                        showResultPopup(
                            "Station status updated"
                        );

                    } else {

                        showResultPopup(
                            apiMsg ||
                            "Unknown response"
                        );

                    }

                })


                /************************************************
                 * SCAN ERROR
                 ************************************************/

                .catch(err => {

                    console.error(
                        "Scan error:",
                        err
                    );


                    showResultPopup(
                        err.message ||
                        "Scan failed"
                    );

                });

            })


            /****************************************************
             * INVALID PASSWORD / DATABASE ERROR
             ****************************************************/

            .catch(err => {

                console.error(
                    "Password verification error:",
                    err
                );


                alert(
                    err.message ||
                    "Invalid Password"
                );


                /************************************************
                 * CLEAR PASSWORD
                 ************************************************/

                document
                    .getElementById(
                        'passwordInput'
                    )
                    .value = "";


                document
                    .getElementById(
                        'passwordInput'
                    )
                    .focus();

            });

        }



        /********************************************************
         * RESULT POPUP
         ********************************************************/

        function showResultPopup(msg) {

            document
                .getElementById(
                    'popupMessage'
                )
                .innerText = msg;


            document
                .getElementById(
                    'resultPopup'
                )
                .style.display = "flex";

        }



        /********************************************************
         * CLOSE RESULT POPUP
         ********************************************************/

        function closePopup() {

            document
                .getElementById(
                    'resultPopup'
                )
                .style.display = "none";


            location.reload();

        }


    </script>


</body>

</html>
