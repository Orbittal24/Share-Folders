<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Restart OCV Services</title>


    <!-- =====================================================
         ALL CSS IN THIS FILE
         ===================================================== -->

    <style>

        /* ====================================================
           GLOBAL
           ==================================================== */

        * {
            box-sizing: border-box;
        }


        html,
        body {

            width: 100%;

            margin: 0;

            padding: 0;

            font-family:
                Arial,
                Helvetica,
                sans-serif;

            background: #ffffff;

        }


        /* ====================================================
           PAGE TITLE
           ==================================================== */

        .page-title {

            width: calc(100% - 56px);

            margin: 25px 28px 18px 28px;

            height: 35px;

            display: flex;

            align-items: center;

        }


        .page-title h3 {

            margin: 0;

            padding: 0;

            font-size: 18px;

            font-weight: 500;

            color: #111827;

        }


        /* ====================================================
           MAIN CONTROL ROW

           12 COLUMN GRID

           LABEL    = 4
           DROPDOWN = 4
           START    = 2
           STOP     = 2

           TOTAL    = 12
           ==================================================== */

        .service-control {

            width: calc(100% - 56px);

            margin: 0 28px;

            padding: 12px 10px;

            min-height: 62px;

            display: grid;

            grid-template-columns:
                4fr
                4fr
                2fr
                2fr;

            column-gap: 10px;

            align-items: center;

            background: #f8f9fa;

            border: 1px solid #e1e4e8;

            border-radius: 3px;

        }


        /* ====================================================
           LABEL
           
           4 COLUMNS
           ==================================================== */

        .service-label {

            width: 100%;

            margin: 0;

            padding: 0 10px;

            display: flex;

            align-items: center;

            font-size: 13px;

            font-weight: 500;

            color: #333333;

        }


        /* ====================================================
           DROPDOWN
           
           4 COLUMNS
           ==================================================== */

        #dropdown {

            width: 100%;

            height: 40px;

            margin: 0;

            padding: 5px 10px;

            border: 1px solid #bfc5cc;

            border-radius: 4px;

            background-color: #ffffff;

            color: #555555;

            font-size: 12px;

            font-weight: 400;

            outline: none;

            cursor: pointer;

        }


        #dropdown:focus {

            border-color: #80bdff;

            outline: none;

            box-shadow:
                0 0 0 2px
                rgba(0, 123, 255, 0.12);

        }


        /* ====================================================
           DROPDOWN OPTIONS
           ==================================================== */

        #dropdown option {

            font-size: 12px;

            padding: 5px;

        }


        /* ====================================================
           BUTTONS
           
           START = 2 COLUMNS
           STOP  = 2 COLUMNS
           ==================================================== */

        #startButton,
        #stopButton {

            width: 100%;

            height: 40px;

            margin: 0;

            padding: 0 15px;

            display: flex;

            align-items: center;

            justify-content: center;

            border: none;

            border-radius: 4px;

            font-size: 14px;

            font-weight: 600;

            cursor: pointer;

            user-select: none;

            transition:
                background-color 0.15s ease,
                transform 0.05s ease;

        }


        /* ====================================================
           START
           ==================================================== */

        #startButton {

            background-color: #28a745;

            color: #ffffff;

        }


        #startButton:hover {

            background-color: #218838;

        }


        #startButton:active {

            background-color: #1e7e34;

            transform: translateY(1px);

        }


        /* ====================================================
           STOP
           ==================================================== */

        #stopButton {

            background-color: #dc3545;

            color: #ffffff;

        }


        #stopButton:hover {

            background-color: #c82333;

        }


        #stopButton:active {

            background-color: #bd2130;

            transform: translateY(1px);

        }


        /* ====================================================
           KEEP ONE ROW ON NORMAL DESKTOP
           ==================================================== */

        @media (max-width: 700px) {

            .service-control {

                column-gap: 5px;

                padding: 8px;

            }


            .service-label {

                padding: 0 4px;

                font-size: 10px;

            }


            #dropdown {

                font-size: 10px;

                height: 36px;

            }


            #startButton,
            #stopButton {

                height: 36px;

                font-size: 11px;

                padding: 0 5px;

            }

        }

    </style>


    <!-- =====================================================
         SWEET ALERT
         ===================================================== -->

    <script src="./style/sweetalert.js"></script>

</head>


<body>


    <!-- =====================================================
         PAGE TITLE
         ===================================================== -->

    <div class="page-title">

        <h3>
            IR Screwing Service Restart
        </h3>

    </div>



    <!-- =====================================================
         12 COLUMN SERVICE ROW

         4 = LABEL
         4 = DROPDOWN
         2 = START
         2 = STOP
         ===================================================== -->

    <div class="service-control">


        <!-- =================================================
             COLUMN 1-4
             LABEL
             ================================================= -->

        <div class="service-label">

            Choose an option:

        </div>



        <!-- =================================================
             COLUMN 5-8
             DROPDOWN
             ================================================= -->

        <div>

            <select id="dropdown">

                <option value="">
                    Select Service Name
                </option>


                <option value="ocv_cell_data_mirror_ocv_universal_line_1_2">
                    ocv_cell_data_mirror_ocv_universal_line_1_2
                </option>


                <option value="ocv_cell_data_mirror_ocv_universal_line_3_4">
                    ocv_cell_data_mirror_ocv_universal_line_3_4
                </option>


                <option value="ocv_cell_data_mirror_ocv_universal_line_5_6">
                    ocv_cell_data_mirror_ocv_universal_line_5_6
                </option>


                <option value="ocv_cell_data_mirror_ocv_universal_line_7_8">
                    ocv_cell_data_mirror_ocv_universal_line_7_8
                </option>


                <option value="ocv_cell_data_mirror_ocv_universal_line_A">
                    ocv_cell_data_mirror_ocv_universal_line_A
                </option>


                <option value="ocv_cell_data_mirror_ocv_universal_XNG">
                    ocv_cell_data_mirror_ocv_universal_XNG
                </option>


                <option value="ocv_cell_data_mirror_ocv_universal_bajaj_2w">
                    ocv_cell_data_mirror_ocv_universal_bajaj_2w
                </option>


            </select>

        </div>



        <!-- =================================================
             COLUMN 9-10
             START BUTTON
             ================================================= -->

        <div>

            <button
                id="startButton"
                type="button">

                Start

            </button>

        </div>



        <!-- =================================================
             COLUMN 11-12
             STOP BUTTON
             ================================================= -->

        <div>

            <button
                id="stopButton"
                type="button">

                Stop

            </button>

        </div>


    </div>



    <!-- =====================================================
         SOCKET.IO
         ===================================================== -->

    <script src="./style/socket_io.js"></script>



    <!-- =====================================================
         JAVASCRIPT
         ===================================================== -->

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {


                // =================================================
                // ELEMENTS
                // =================================================

                const dropdown =
                    document.getElementById(
                        "dropdown"
                    );


                const startButton =
                    document.getElementById(
                        "startButton"
                    );


                const stopButton =
                    document.getElementById(
                        "stopButton"
                    );


                // =================================================
                // SOCKET.IO
                // =================================================

                const socket = io();


                // =================================================
                // START SERVICE
                // =================================================

                startButton.addEventListener(
                    "click",
                    function () {


                        const selectedValue =
                            dropdown.value;


                        // -----------------------------------------
                        // CHECK SERVICE
                        // -----------------------------------------

                        if (selectedValue === "") {

                            Swal.fire({

                                title:
                                    "Select Service",

                                text:
                                    "Please select a service name first.",

                                icon:
                                    "warning"

                            });

                            return;

                        }


                        console.log(
                            "Selected Service:",
                            selectedValue
                        );


                        // -----------------------------------------
                        // PASSCODE
                        // -----------------------------------------

                        Swal.fire({

                            title:
                                "Enter Passcode!",

                            html:
                                '<input ' +
                                'id="password" ' +
                                'type="password" ' +
                                'class="swal2-input" ' +
                                'placeholder="Enter Passcode">',

                            showCancelButton:
                                true,

                            confirmButtonText:
                                "Start",

                            cancelButtonText:
                                "Cancel",

                            allowOutsideClick:
                                false

                        }).then(
                            function (result) {


                                if (!result.isConfirmed) {

                                    return;

                                }


                                const password =
                                    document.getElementById(
                                        "password"
                                    ).value;


                                // ---------------------------------
                                // EMPTY PASSWORD
                                // ---------------------------------

                                if (password === "") {

                                    Swal.fire({

                                        title:
                                            "Password Required",

                                        text:
                                            "Please enter the passcode.",

                                        icon:
                                            "warning"

                                    });

                                    return;

                                }


                                // ---------------------------------
                                // PASSWORD CHECK
                                // ---------------------------------

                                if (password !== "service") {

                                    Swal.fire({

                                        title:
                                            "Invalid Passcode",

                                        text:
                                            "Please enter the correct passcode.",

                                        icon:
                                            "error"

                                    });

                                    return;

                                }


                                // ---------------------------------
                                // PM2 START COMMAND
                                // ---------------------------------

                                const cmdname =
                                    `pm2 start ${selectedValue} --interpreter=pythonw`;


                                console.log(
                                    "START COMMAND:",
                                    cmdname
                                );


                                // ---------------------------------
                                // SEND COMMAND
                                // ---------------------------------

                                socket.emit(

                                    "executeBat",

                                    cmdname,

                                    function (response) {


                                        console.log(
                                            "Server Response:",
                                            response
                                        );


                                        if (
                                            response &&
                                            response.success
                                        ) {

                                            Swal.fire({

                                                title:
                                                    "PM2 Service Started",

                                                text:
                                                    `${selectedValue} has been started successfully.`,

                                                icon:
                                                    "success"

                                            });

                                        }

                                        else {

                                            Swal.fire({

                                                title:
                                                    "Failed to Start Service",

                                                text:
                                                    response?.error ||
                                                    "Unable to start PM2 service.",

                                                icon:
                                                    "error"

                                            });

                                        }

                                    }

                                );

                            }

                        );

                    }

                );



                // =================================================
                // STOP SERVICE
                // =================================================

                stopButton.addEventListener(

                    "click",

                    function () {


                        const selectedValue =
                            dropdown.value;


                        // -----------------------------------------
                        // CHECK SERVICE
                        // -----------------------------------------

                        if (selectedValue === "") {

                            Swal.fire({

                                title:
                                    "Select Service",

                                text:
                                    "Please select a service name first.",

                                icon:
                                    "warning"

                            });

                            return;

                        }


                        console.log(
                            "Selected Service:",
                            selectedValue
                        );


                        // -----------------------------------------
                        // PASSCODE
                        // -----------------------------------------

                        Swal.fire({

                            title:
                                "Enter Passcode!",

                            html:
                                '<input ' +
                                'id="password" ' +
                                'type="password" ' +
                                'class="swal2-input" ' +
                                'placeholder="Enter Passcode">',

                            showCancelButton:
                                true,

                            confirmButtonText:
                                "Stop",

                            cancelButtonText:
                                "Cancel",

                            allowOutsideClick:
                                false

                        }).then(

                            function (result) {


                                if (!result.isConfirmed) {

                                    return;

                                }


                                const password =
                                    document.getElementById(
                                        "password"
                                    ).value;


                                // ---------------------------------
                                // EMPTY PASSWORD
                                // ---------------------------------

                                if (password === "") {

                                    Swal.fire({

                                        title:
                                            "Password Required",

                                        text:
                                            "Please enter the passcode.",

                                        icon:
                                            "warning"

                                    });

                                    return;

                                }


                                // ---------------------------------
                                // PASSWORD CHECK
                                // ---------------------------------

                                if (password !== "service") {

                                    Swal.fire({

                                        title:
                                            "Invalid Passcode",

                                        text:
                                            "Please enter the correct passcode.",

                                        icon:
                                            "error"

                                    });

                                    return;

                                }


                                // ---------------------------------
                                // PM2 STOP COMMAND
                                // ---------------------------------

                                const cmdname =
                                    `pm2 stop ${selectedValue}`;


                                console.log(
                                    "STOP COMMAND:",
                                    cmdname
                                );


                                // ---------------------------------
                                // SEND COMMAND
                                // ---------------------------------

                                socket.emit(

                                    "executeBat",

                                    cmdname,

                                    function (response) {


                                        console.log(
                                            "Server Response:",
                                            response
                                        );


                                        if (
                                            response &&
                                            response.success
                                        ) {

                                            Swal.fire({

                                                title:
                                                    "PM2 Service Stopped",

                                                text:
                                                    `${selectedValue} has been stopped successfully.`,

                                                icon:
                                                    "success"

                                            });

                                        }

                                        else {

                                            Swal.fire({

                                                title:
                                                    "Failed to Stop Service",

                                                text:
                                                    response?.error ||
                                                    "Unable to stop PM2 service.",

                                                icon:
                                                    "error"

                                            });

                                        }

                                    }

                                );

                            }

                        );

                    }

                );



                // =================================================
                // SOCKET CONNECT
                // =================================================

                socket.on(
                    "connect",
                    function () {

                        console.log(
                            "Connected to server."
                        );

                        console.log(
                            "Socket ID:",
                            socket.id
                        );

                    }
                );



                // =================================================
                // SOCKET DISCONNECT
                // =================================================

                socket.on(
                    "disconnect",
                    function () {

                        console.log(
                            "Disconnected from server."
                        );

                    }
                );


            }

        );

    </script>


</body>

</html>
