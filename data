function getTables(tableName) {
    const match = /^running_production_count_line([1-9]|1[0-9]|20)$/.exec(String(tableName || ""));
    if (!match) throw new Error("Please select a valid production count table (Line 1-20).");
    const line = Number(match[1]);
    return {
        line,
        live: `[running_production_count_line${line}]`,
        backup: `[running_production_count_line${line}_backup]`,
        label: `Line ${line}`
    };
}

async function connectDatabase() {
    if (pool && pool.connected) return pool;
    if (poolPromise) return poolPromise;
    pool = new sql.ConnectionPool(sqlConfig);
    pool.on("error", err => console.error("SQL connection pool error:", err.message));
    poolPromise = pool.connect().then(p => {
        console.log("SQL Server connected. Database:", sqlConfig.database);
        return p;
    }).catch(err => {
        pool = null;
        poolPromise = null;
        throw err;
    });
    return poolPromise;
}

async function connectMasterPackDatabase() {
    if (masterPackPool && masterPackPool.connected) return masterPackPool;
    if (masterPackPoolPromise) return masterPackPoolPromise;

    masterPackPool = new sql.ConnectionPool(masterPackSqlConfig);
    masterPackPool.on("error", err => {
        console.error("Master pack SQL pool error:", err.message);
    });

    masterPackPoolPromise = masterPackPool.connect()
        .then(db => {
            console.log(
                "Connected to master pack database:",
                masterPackSqlConfig.database
            );
            return db;
        })
        .catch(err => {
            masterPackPool = null;
            masterPackPoolPromise = null;
            throw err;
        });

    return masterPackPoolPromise;
}

function validateSelection(data) {
    const packNo = String(data?.packNo ?? "").trim();
    if (!/^\d{6}$/.test(packNo)) throw new Error("Pack Number must contain exactly 6 digits.");
    const packIdText = String(data?.packId ?? "").trim();
    if (!/^\d+$/.test(packIdText)) throw new Error("Please select a valid Pack Name.");
    const packId = Number(packIdText);
    if (!Number.isSafeInteger(packId)) throw new Error("Selected Pack_ID is invalid.");
    const tables = getTables(data?.tableName);
    return { packNo, packId, ...tables, tableName: data.tableName };
}

async function getPackList() {
    const db = await connectDatabase();
    // Query as supplied: taco_treceability is the schema name in the connected database.
    const result = await db.request().query(`
        SELECT Pack_ID, Pack_Name
        FROM taco_treceability.master_pack
        ORDER BY Pack_Name;
    `);
    return result.recordset;
}

async function scanRecords(filters) {
    const db = await connectDatabase();
    const request = db.request();
    request.input("packNo", sql.VarChar(6), filters.packNo);
    request.input("packId", sql.Int, filters.packId);
    const result = await request.query(`
        SELECT COUNT_BIG(*) AS total
        FROM ${filters.backup}
        WHERE CONVERT(VARCHAR(50), [pack_no]) = @packNo
          AND [pack_id] = @packId;
    `);
    return result.recordset[0].total.toString();
}

// One backup row is moved per transaction. The backup row is deleted only after
// the live-table insert is verified, and both operations commit/rollback together.
async function shiftOneRecord(db, filters, srNo) {
    const transaction = new sql.Transaction(db);
    await transaction.begin(sql.ISOLATION_LEVEL.READ_COMMITTED);
    try {
        const insertRequest = new sql.Request(transaction);
        insertRequest.input("srNo", sql.Int, srNo);
        insertRequest.input("packNo", sql.VarChar(6), filters.packNo);
        insertRequest.input("packId", sql.Int, filters.packId);
        const insertResult = await insertRequest.query(`
            INSERT INTO ${filters.live} (${COLUMN_LIST})
            SELECT ${COLUMN_LIST}
            FROM ${filters.backup} WITH (UPDLOCK, ROWLOCK)
            WHERE [sr_no] = @srNo
              AND CONVERT(VARCHAR(50), [pack_no]) = @packNo
              AND [pack_id] = @packId;
        `);
        const inserted = insertResult.rowsAffected.reduce((a, b) => a + b, 0);
        if (inserted !== 1) throw new Error(`Expected 1 live-table insert for backup sr_no ${srNo}; got ${inserted}.`);

        const deleteRequest = new sql.Request(transaction);
        deleteRequest.input("srNo", sql.Int, srNo);
        deleteRequest.input("packNo", sql.VarChar(6), filters.packNo);
        deleteRequest.input("packId", sql.Int, filters.packId);
        const deleteResult = await deleteRequest.query(`
            DELETE FROM ${filters.backup}
            WHERE [sr_no] = @srNo
              AND CONVERT(VARCHAR(50), [pack_no]) = @packNo
              AND [pack_id] = @packId;
        `);
        const deleted = deleteResult.rowsAffected.reduce((a, b) => a + b, 0);
        if (deleted !== 1) throw new Error(`Expected 1 backup-table delete for sr_no ${srNo}; got ${deleted}.`);
        await transaction.commit();
        return true;
    } catch (error) {
        try { await transaction.rollback(); } catch (rollbackError) {
            console.error(`Rollback failed for sr_no ${srNo}:`, rollbackError.message);
        }
        throw error;
    }
}

async function shiftRecords(filters, socket) {
    if (shiftRunning) throw new Error("Another shift operation is running. Please wait.");
    shiftRunning = true;
    let shifted = 0;
    let failed = 0;
    let failedSrNo = null;
    let lastError = null;
    let total = 0;
    try {
        const db = await connectDatabase();
        const select = db.request();
        select.input("packNo", sql.VarChar(6), filters.packNo);
        select.input("packId", sql.Int, filters.packId);
        const selected = await select.query(`
            SELECT [sr_no]
            FROM ${filters.backup}
            WHERE CONVERT(VARCHAR(50), [pack_no]) = @packNo
              AND [pack_id] = @packId
            ORDER BY [sr_no] ASC;
        `);
        const ids = selected.recordset.map(r => r.sr_no);
        total = ids.length;
        socket.emit("shift-started", {
            total, source: filters.backup, target: filters.live,
            packNo: filters.packNo, packId: filters.packId, line: filters.label,
            message: "Shift started. Each backup record will be removed only after its live-table insert is verified."
        });
        for (const srNo of ids) {
            try {
                await shiftOneRecord(db, filters, srNo);
                shifted++;
            } catch (error) {
                failed++;
                failedSrNo = srNo;
                lastError = error.message;
                socket.emit("shift-progress", { total, shifted, failed, currentSrNo: srNo, error: lastError });
                break;
            }
            socket.emit("shift-progress", { total, shifted, failed, currentSrNo: srNo, error: null });
        }
        const response = {
            total, shifted, failed, failedSrNo, lastError,
            source: filters.backup, target: filters.live,
            message: failed
                ? "Shift stopped at the failed record. The failed backup record was retained."
                : "Shift completed successfully."
        };
        socket.emit("shift-complete", response);
        return response;
    } finally {
        shiftRunning = false;
    }
}

const server = http.createServer((req, res) => {
    let pathname;
    try { pathname = new URL(req.url, "http://localhost").pathname; }
    catch { res.writeHead(400); return res.end("Invalid request"); }
    if (pathname !== "/" && pathname !== "/production_count_ui_newMIS.html") {
        res.writeHead(404); return res.end("Not found");
    }
    fs.readFile(HTML_FILE, (error, content) => {
        if (error) {
            console.error("HTML file error:", error.message);
            res.writeHead(500); return res.end("Unable to load production_count_ui_newMIS.html");
        }
        res.writeHead(200, { "Content-Type": "text/html; charset=utf-8", "Cache-Control": "no-store" });
        res.end(content);
    });
});
const io = new Server(server, { maxHttpBufferSize: 1e6 });
io.on("connection", socket => {
    console.log("Frontend connected:", socket.id);
    socket.emit("connection-status", { connected: true, message: "Connected to backup server." });

    socket.on("get-pack-list", async (_data, acknowledge) => {
        try {
            const packs = await getPackList();
            if (typeof acknowledge === "function") acknowledge({ success: true, packs });
        } catch (error) {
            console.error("Pack list error:", error.message);
            if (typeof acknowledge === "function") acknowledge({ success: false, message: error.message });
        }
    });

    socket.on("scan-records", async (data, acknowledge) => {
        try {
            const filters = validateSelection(data);
            const total = await scanRecords(filters);
            const response = { success: true, total, source: filters.backup, target: filters.live, packNo: filters.packNo, packId: filters.packId, line: filters.label };
            socket.emit("scan-result", response);
            if (typeof acknowledge === "function") acknowledge(response);
        } catch (error) {
            console.error("Scan error:", error.message);
            const response = { success: false, message: error.message };
            socket.emit("operation-error", response);
            if (typeof acknowledge === "function") acknowledge(response);
        }
    });

    socket.on("shift-records", async (data, acknowledge) => {
        try {
            const filters = validateSelection(data);
            const result = await shiftRecords(filters, socket);
            if (typeof acknowledge === "function") acknowledge({ success: true, ...result });
        } catch (error) {
            console.error("Shift error:", error.message);
            const response = { success: false, message: error.message };
            socket.emit("operation-error", response);
            if (typeof acknowledge === "function") acknowledge(response);
        }
    });
    socket.on("disconnect", reason => console.log("Frontend disconnected:", socket.id, reason));
});
