// ===========================================================================
// MES CELL DATA - DASHBOARD SERVER
//
// Read-only web view of cells_history, so operators and AMC can check whether
// a cell reached the system without touching the database.
//
// Matches the one-row-per-QR schema: each cell appears once, with first_read_at
// (when the machine first reported it), read_at (most recent report),
// read_count and change_count.
//
// Uses ONLY Node built-ins -- nothing to install on an offline line PC.
// Runs as a SEPARATE process from mesCellDataService.js; WAL mode allows a
// reader alongside the writer.
//
// Start:  "C:\Software_Tools\new_OCV\node-v24.21.0-win-x64\node.exe" dashboard.js
// Open:   http://localhost:8090
//
// dashboard.html must sit in the same folder as this file.
// ===========================================================================
"use strict";

const http = require("http");
const fs = require("fs");
const path = require("path");
const { DatabaseSync } = require("node:sqlite");

// ===========================================================================
// CONFIG
// ===========================================================================
const DB_FILE = "C:\\ProgramData\\Orbittal\\MESCellData\\cells.db";
const PORT = 8090;

// "127.0.0.1" = this PC only (most secure).
// "0.0.0.0"   = reachable from other PCs on the plant network.
const HOST = "0.0.0.0";

const LINE_NAME = "TACO Line";
const MAX_PAGE_SIZE = 500;
const DEFAULT_PAGE_SIZE = 100;

// ===========================================================================
// DATABASE (read-only usage -- this server only ever runs SELECT)
//
// Opened read-write rather than readOnly, because a read-only handle cannot
// recover a WAL file if the service was not shut down cleanly. This process
// issues no INSERT, UPDATE or DELETE anywhere.
// ===========================================================================
if (!fs.existsSync(DB_FILE)) {
    console.error(`\n  Database not found:\n  ${DB_FILE}\n`);
    console.error("  Start mesCellDataService.js first so the database is created.\n");
    process.exit(1);
}

const db = new DatabaseSync(DB_FILE);
const HTML_PATH = path.join(__dirname, "dashboard.html");

// ===========================================================================
// HELPERS
// ===========================================================================

/**
 * Timestamps are stored as UTC ISO strings, but the operator types a LOCAL
 * date. Parsing "2026-09-26T00:00:00" without a Z makes JavaScript treat it
 * as local time, and toISOString() then gives the correct UTC boundary.
 * Without this, an IST user would see results shifted by 5.5 hours.
 */
function localDateToUtcStart(dateStr) {
    const d = new Date(`${dateStr}T00:00:00`);
    return isNaN(d.getTime()) ? null : d.toISOString();
}

function localDateToUtcEnd(dateStr) {
    const d = new Date(`${dateStr}T23:59:59.999`);
    return isNaN(d.getTime()) ? null : d.toISOString();
}

function sendJson(res, status, obj) {
    const body = JSON.stringify(obj);
    res.writeHead(status, {
        "Content-Type": "application/json; charset=utf-8",
        "Cache-Control": "no-store",
        "Content-Length": Buffer.byteLength(body),
    });
    res.end(body);
}

// ===========================================================================
// QUERY
// ===========================================================================
function searchCells(params) {
    const where = [];
    const args = [];

    // Filter on FIRST read, not last. read_at moves every time the PLC
    // republishes the same array, so filtering on it would hide a cell from
    // the day it was actually processed.
    if (params.from) {
        const t = localDateToUtcStart(params.from);
        if (t) { where.push("h.first_read_at >= ?"); args.push(t); }
    }
    if (params.to) {
        const t = localDateToUtcEnd(params.to);
        if (t) { where.push("h.first_read_at <= ?"); args.push(t); }
    }
    if (params.qr) {
        // Contains-match so a partial code works. The table is bounded by the
        // retention period and holds one row per cell, so a scan stays cheap.
        where.push("h.cell_qrcode LIKE ?");
        args.push("%" + params.qr + "%");
    }
    if (params.status === "sent") {
        where.push("h.sent_at IS NOT NULL");
    } else if (params.status === "notsent") {
        where.push("h.sent_at IS NULL");
    }

    const whereSql = where.length ? "WHERE " + where.join(" AND ") : "";

    const total = Number(
        db.prepare(`SELECT COUNT(*) AS n FROM cells_history h ${whereSql}`).get(...args).n
    );

    const summary = db.prepare(`
        SELECT
            SUM(CASE WHEN h.sent_at IS NOT NULL THEN 1 ELSE 0 END) AS sent,
            SUM(CASE WHEN h.sent_at IS NULL     THEN 1 ELSE 0 END) AS notsent
        FROM cells_history h ${whereSql}
    `).get(...args);

    const pageSize = Math.min(Math.max(1, params.pageSize || DEFAULT_PAGE_SIZE), MAX_PAGE_SIZE);
    const page = Math.max(1, params.page || 1);
    const offset = (page - 1) * pageSize;

    const rows = db.prepare(`
        SELECT h.id, h.cell_qrcode, h.voltage_val, h.ir_val, h.material,
               h.src_node, h.first_read_at, h.read_at, h.read_count,
               h.change_count, h.sent_at,
               q.id AS queue_id, q.attempts, q.last_error
        FROM cells_history h
        LEFT JOIN cells_queue q ON q.history_id = h.id
        ${whereSql}
        ORDER BY h.id DESC
        LIMIT ? OFFSET ?
    `).all(...args, pageSize, offset);

    return {
        total: total,
        page: page,
        pageSize: pageSize,
        pages: Math.max(1, Math.ceil(total / pageSize)),
        sent: Number(summary.sent || 0),
        notSent: Number(summary.notsent || 0),
        rows: rows.map((r) => ({
            id: r.id,
            qr: r.cell_qrcode,
            voltage: r.voltage_val,
            ir: r.ir_val,
            material: r.material,
            node: r.src_node,
            firstReadAt: r.first_read_at,
            readAt: r.read_at,
            readCount: r.read_count,
            changeCount: r.change_count,
            sentAt: r.sent_at,
            inQueue: r.queue_id != null,
            attempts: r.attempts || 0,
            lastError: r.last_error || null,
        })),
    };
}

function overview() {
    const hist = Number(db.prepare(`SELECT COUNT(*) AS n FROM cells_history`).get().n);
    const sent = Number(db.prepare(`SELECT COUNT(*) AS n FROM cells_history WHERE sent_at IS NOT NULL`).get().n);
    const queued = Number(db.prepare(`SELECT COUNT(*) AS n FROM cells_queue`).get().n);
    const changed = Number(db.prepare(`SELECT COUNT(*) AS n FROM cells_history WHERE change_count > 0`).get().n);
    const ng = Number(db.prepare(`SELECT COUNT(*) AS n FROM cells_history WHERE cell_qrcode IN ('', 'NG')`).get().n);
    const oldest = db.prepare(`SELECT MIN(first_read_at) AS t FROM cells_history`).get().t;
    const newest = db.prepare(`SELECT MAX(first_read_at) AS t FROM cells_history`).get().t;

    let sizeMb = null;
    try { sizeMb = +(fs.statSync(DB_FILE).size / 1048576).toFixed(1); } catch (_) {}

    return {
        line: LINE_NAME,
        total: hist,
        sent: sent,
        notSent: hist - sent,
        queued: queued,
        changed: changed,
        ng: ng,
        oldest: oldest,
        newest: newest,
        sizeMb: sizeMb,
    };
}

// ===========================================================================
// SERVER
// ===========================================================================
const server = http.createServer((req, res) => {
    let url;
    try {
        url = new URL(req.url, `http://${req.headers.host || "localhost"}`);
    } catch (err) {
        sendJson(res, 400, { error: "bad request" });
        return;
    }

    try {
        if (url.pathname === "/" || url.pathname === "/index.html") {
            const html = fs.readFileSync(HTML_PATH, "utf8");
            res.writeHead(200, {
                "Content-Type": "text/html; charset=utf-8",
                "Cache-Control": "no-store",
            });
            res.end(html);
            return;
        }

        if (url.pathname === "/api/overview") {
            sendJson(res, 200, overview());
            return;
        }

        if (url.pathname === "/api/search") {
            const q = url.searchParams;
            sendJson(res, 200, searchCells({
                from: q.get("from") || null,
                to: q.get("to") || null,
                qr: (q.get("qr") || "").trim() || null,
                status: q.get("status") || null,
                page: parseInt(q.get("page") || "1", 10),
                pageSize: parseInt(q.get("pageSize") || String(DEFAULT_PAGE_SIZE), 10),
            }));
            return;
        }

        res.writeHead(404, { "Content-Type": "text/plain" });
        res.end("Not found");
    } catch (err) {
        console.error("[dashboard]", err);
        sendJson(res, 500, { error: err.message });
    }
});

server.listen(PORT, HOST, () => {
    console.log(`\n  MES Cell Data dashboard - ${LINE_NAME}`);
    console.log(`  Database : ${DB_FILE}`);
    console.log(`  Open     : http://localhost:${PORT}`);
    if (HOST === "0.0.0.0") {
        console.log(`  Also reachable from other PCs on this network on port ${PORT}`);
    }
    console.log(`\n  Press Ctrl+C to stop.\n`);
});

const shutdown = () => {
    console.log("\n  stopping dashboard");
    server.close();
    try { db.close(); } catch (_) {}
    process.exit(0);
};
process.on("SIGINT", shutdown);
process.on("SIGTERM", shutdown);

process.on("uncaughtException", (err) => {
    console.error("FATAL:", err);
    process.exit(1);
});
