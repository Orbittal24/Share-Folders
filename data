const net = require("net");
const fs = require("fs");
const path = require("path");
const os = require("os");
const XLSX = require("xlsx");
const { SerialPort } = require("serialport");


// ============================================================
// TCP SERVER CONFIGURATION
// ============================================================

const HOST = "10.9.4.28";
const PORT = 7287;


// ============================================================
// SERIAL PORT CONFIGURATION
// ============================================================

const SERIAL_PORT = "COM4";
const SERIAL_BAUD_RATE = 9600;


// ============================================================
// EXCEL CONFIGURATION
// ============================================================

// Expected file:
// C:\Users\<WindowsUser>\Desktop\buzzer_line.xlsx
//
// Sheet:
// Sheet1
//
// Line number:
// A1

const EXCEL_FILE_NAME = "buzzer_line.xlsx";

const EXCEL_FILE_PATH = path.join(
    os.homedir(),
    "Desktop",
    EXCEL_FILE_NAME
);

const EXCEL_SHEET_NAME = "Sheet1";
const EXCEL_LINE_CELL = "A1";


// ============================================================
// BUZZER CONFIGURATION
// ============================================================

// Buzzer ON:
// A0 01 01 A2

const RELAY_ON_COMMAND = Buffer.from([
    0xA0,
    0x01,
    0x01,
    0xA2
]);


// Buzzer OFF:
// A0 01 00 A1

const RELAY_OFF_COMMAND = Buffer.from([
    0xA0,
    0x01,
    0x00,
    0xA1
]);


// Buzzer duration = 10 seconds

const BUZZER_DURATION_MS = 10000;


// ============================================================
// GLOBAL VARIABLES
// ============================================================

let client = null;

let reconnectTimer = null;

let buzzerTimer = null;

let buzzerRunning = false;


// ============================================================
// SERIAL PORT
// ============================================================

const serialPort = new SerialPort({
    path: SERIAL_PORT,
    baudRate: SERIAL_BAUD_RATE,
    autoOpen: false
});


// ============================================================
// HEX DISPLAY HELPER
// ============================================================

function bufferToHex(buffer) {

    return buffer
        .toString("hex")
        .match(/.{1,2}/g)
        .join(" ")
        .toUpperCase();
}


// ============================================================
// OPEN SERIAL PORT
// ============================================================

function openSerialPort() {

    if (serialPort.isOpen) {

        console.log(
            `✅ Serial port already open: ${SERIAL_PORT}`
        );

        return;
    }

    serialPort.open((error) => {

        if (error) {

            console.log("");
            console.log("==========================================");
            console.log("❌ SERIAL PORT OPEN ERROR");
            console.log("==========================================");
            console.log(
                `Port  : ${SERIAL_PORT}`
            );
            console.log(
                `Error : ${error.message}`
            );
            console.log("==========================================");
            console.log("");

            return;
        }

        console.log("");
        console.log("==========================================");
        console.log("✅ SERIAL PORT OPENED");
        console.log("==========================================");
        console.log(
            `Port : ${SERIAL_PORT}`
        );
        console.log(
            `Baud : ${SERIAL_BAUD_RATE}`
        );
        console.log("==========================================");
        console.log("");
    });
}


// ============================================================
// SERIAL ERROR
// ============================================================

serialPort.on("error", (error) => {

    console.log("");
    console.log("❌ SERIAL ERROR");
    console.log("------------------------------------------");
    console.log(
        error.message
    );
    console.log("");
});


// ============================================================
// READ LINE NUMBER FROM EXCEL
// ============================================================

function getConfiguredLineFromExcel() {

    try {

        // ----------------------------------------------------
        // Check Excel file
        // ----------------------------------------------------

        if (!fs.existsSync(EXCEL_FILE_PATH)) {

            console.log("");
            console.log("==========================================");
            console.log("❌ EXCEL FILE NOT FOUND");
            console.log("==========================================");
            console.log(
                `File : ${EXCEL_FILE_PATH}`
            );
            console.log("==========================================");
            console.log("");

            return null;
        }


        // ----------------------------------------------------
        // Read workbook
        // ----------------------------------------------------

        const workbook = XLSX.readFile(
            EXCEL_FILE_PATH
        );


        // ----------------------------------------------------
        // Check Sheet1
        // ----------------------------------------------------

        if (
            !workbook.Sheets[
                EXCEL_SHEET_NAME
            ]
        ) {

            console.log("");
            console.log("==========================================");
            console.log("❌ EXCEL SHEET NOT FOUND");
            console.log("==========================================");
            console.log(
                `Sheet : ${EXCEL_SHEET_NAME}`
            );
            console.log("==========================================");
            console.log("");

            return null;
        }


        const worksheet =
            workbook.Sheets[
                EXCEL_SHEET_NAME
            ];


        // ----------------------------------------------------
        // Read A1
        // ----------------------------------------------------

        const excelCell =
            worksheet[
                EXCEL_LINE_CELL
            ];


        if (
            !excelCell ||
            excelCell.v === undefined ||
            excelCell.v === null
        ) {

            console.log("");
            console.log("==========================================");
            console.log("❌ EXCEL LINE NUMBER NOT FOUND");
            console.log("==========================================");
            console.log(
                `Sheet : ${EXCEL_SHEET_NAME}`
            );
            console.log(
                `Cell  : ${EXCEL_LINE_CELL}`
            );
            console.log("==========================================");
            console.log("");

            return null;
        }


        // ----------------------------------------------------
        // Convert Excel value to string
        // ----------------------------------------------------

        const configuredLine =
            String(
                excelCell.v
            ).trim();


        if (!configuredLine) {

            console.log(
                "❌ Excel line number is empty."
            );

            return null;
        }


        return configuredLine;

    } catch (error) {

        console.log("");
        console.log("==========================================");
        console.log("❌ EXCEL READ ERROR");
        console.log("==========================================");
        console.log(
            `Error : ${error.message}`
        );
        console.log("==========================================");
        console.log("");

        return null;
    }
}


// ============================================================
// SEND RELAY COMMAND
// ============================================================

function sendRelayCommand(
    command,
    commandName
) {

    // --------------------------------------------------------
    // Check serial port
    // --------------------------------------------------------

    if (!serialPort.isOpen) {

        console.log("");
        console.log("==========================================");
        console.log(
            `❌ RELAY ${commandName} FAILED`
        );
        console.log("==========================================");
        console.log(
            `Serial port ${SERIAL_PORT} is not open.`
        );
        console.log("==========================================");
        console.log("");

        return false;
    }


    // --------------------------------------------------------
    // Send command
    // --------------------------------------------------------

    serialPort.write(
        command,
        (error) => {

            if (error) {

                console.log("");
                console.log("==========================================");
                console.log(
                    `❌ RELAY ${commandName} ERROR`
                );
                console.log("==========================================");
                console.log(
                    `Error : ${error.message}`
                );
                console.log("==========================================");
                console.log("");

                return;
            }


            console.log("");
            console.log(
                `📤 RELAY ${commandName} COMMAND SENT`
            );
            console.log(
                `HEX : ${bufferToHex(command)}`
            );
            console.log("");
        }
    );


    return true;
}


// ============================================================
// START BUZZER
// ============================================================

function startBuzzer(
    lineNo,
    cellQr
) {

    // --------------------------------------------------------
    // Prevent overlapping buzzer cycles
    // --------------------------------------------------------

    if (buzzerRunning) {

        console.log("");
        console.log("==========================================");
        console.log("⚠️ BUZZER ALREADY RUNNING");
        console.log("==========================================");
        console.log(
            "New buzzer event ignored while current "
            + "10-second cycle is active."
        );
        console.log("==========================================");
        console.log("");

        return;
    }


    // --------------------------------------------------------
    // Set buzzer state
    // --------------------------------------------------------

    buzzerRunning = true;


    console.log("");
    console.log("==========================================");
    console.log("🔔 BUZZER START");
    console.log("==========================================");
    console.log(
        `Line     : ${lineNo}`
    );
    console.log(
        `CellQR   : ${cellQr}`
    );
    console.log(
        "Duration : 10 seconds"
    );
    console.log("==========================================");
    console.log("");


    // --------------------------------------------------------
    // RELAY ON
    // --------------------------------------------------------

    const relayOnSent =
        sendRelayCommand(
            RELAY_ON_COMMAND,
            "ON"
        );


    // --------------------------------------------------------
    // If relay ON could not be sent
    // --------------------------------------------------------

    if (!relayOnSent) {

        buzzerRunning = false;

        return;
    }


    // --------------------------------------------------------
    // Clear old timer if somehow present
    // --------------------------------------------------------

    if (buzzerTimer) {

        clearTimeout(
            buzzerTimer
        );

        buzzerTimer = null;
    }


    // --------------------------------------------------------
    // AUTO OFF AFTER 10 SECONDS
    // --------------------------------------------------------

    buzzerTimer = setTimeout(
        () => {

            console.log("");
            console.log("==========================================");
            console.log("⏱️ 10 SECONDS COMPLETED");
            console.log("==========================================");
            console.log(
                "Sending relay OFF command..."
            );
            console.log("==========================================");
            console.log("");


            // ------------------------------------------------
            // RELAY OFF
            // ------------------------------------------------

            sendRelayCommand(
                RELAY_OFF_COMMAND,
                "OFF"
            );


            // ------------------------------------------------
            // Reset state
            // ------------------------------------------------

            buzzerRunning = false;

            buzzerTimer = null;


            console.log("");
            console.log("==========================================");
            console.log("🔕 BUZZER AUTO STOPPED");
            console.log("==========================================");
            console.log(
                "Relay OFF after 10 seconds"
            );
            console.log("==========================================");
            console.log("");

        },
        BUZZER_DURATION_MS
    );
}


// ============================================================
// PROCESS BUZZER EVENT
// ============================================================

function processBuzzerEvent(
    receivedLine,
    cellQr
) {

    // --------------------------------------------------------
    // Read configured line from Excel
    // --------------------------------------------------------

    const configuredLine =
        getConfiguredLineFromExcel();


    // --------------------------------------------------------
    // Excel unavailable
    // --------------------------------------------------------

    if (configuredLine === null) {

        console.log("");
        console.log(
            "⚠️ BUZZER EVENT CANNOT BE PROCESSED"
        );
        console.log(
            "Excel line number could not be read."
        );
        console.log("");

        return;
    }


    // --------------------------------------------------------
    // Display comparison
    // --------------------------------------------------------

    console.log("");
    console.log("==========================================");
    console.log("🔍 LINE COMPARISON");
    console.log("==========================================");
    console.log(
        `Received Line : ${receivedLine}`
    );
    console.log(
        `Excel Line    : ${configuredLine}`
    );
    console.log("==========================================");
    console.log("");


    // --------------------------------------------------------
    // Compare received line with Excel line
    // --------------------------------------------------------

    if (
        String(receivedLine).trim() ===
        String(configuredLine).trim()
    ) {

        console.log("");
        console.log("==========================================");
        console.log("✅ LINE MATCHED");
        console.log("==========================================");
        console.log(
            `Line ${receivedLine} belongs to this client.`
        );
        console.log("==========================================");
        console.log("");


        // ----------------------------------------------------
        // Start buzzer
        // ----------------------------------------------------

        startBuzzer(
            receivedLine,
            cellQr
        );

    } else {

        console.log("");
        console.log("==========================================");
        console.log("❌ LINE NOT MATCHED");
        console.log("==========================================");
        console.log(
            `Received  : ${receivedLine}`
        );
        console.log(
            `Configured: ${configuredLine}`
        );
        console.log(
            "🚫 Buzzer will NOT start."
        );
        console.log("==========================================");
        console.log("");
    }
}


// ============================================================
// CONNECT TO TCP SERVER
// ============================================================

function connectToServer() {

    console.log("");
    console.log("==========================================");
    console.log("🔔 BUZZER TCP CLIENT");
    console.log("==========================================");
    console.log(
        `Server : ${HOST}`
    );
    console.log(
        `Port   : ${PORT}`
    );
    console.log("==========================================");
    console.log("");


    // --------------------------------------------------------
    // Create TCP socket
    // --------------------------------------------------------

    client = new net.Socket();


    // --------------------------------------------------------
    // Keep connection alive
    // --------------------------------------------------------

    client.setKeepAlive(
        true,
        10000
    );


    // --------------------------------------------------------
    // Connect to server
    // --------------------------------------------------------

    client.connect(
        PORT,
        HOST,
        () => {

            console.log("");
            console.log("==========================================");
            console.log(
                "✅ CONNECTED TO BUZZER TCP SERVER"
            );
            console.log("==========================================");
            console.log(
                `Server : ${HOST}:${PORT}`
            );
            console.log(
                "Status : Listening for broadcasts"
            );
            console.log("==========================================");
            console.log("");
        }
    );


    // ========================================================
    // RECEIVE TCP DATA
    // ========================================================

    client.on(
        "data",
        (data) => {

            // ------------------------------------------------
            // TCP data may contain multiple messages
            // ------------------------------------------------

            const messages =
                data
                    .toString("utf-8")
                    .split("\n");


            // ------------------------------------------------
            // Process each message
            // ------------------------------------------------

            for (
                const message of messages
            ) {

                const trimmedMessage =
                    message.trim();


                // Ignore empty messages
                if (!trimmedMessage) {

                    continue;
                }


                console.log("");
                console.log("==========================================");
                console.log(
                    "📥 BUZZER BROADCAST RECEIVED"
                );
                console.log("==========================================");
                console.log(
                    `Raw : ${trimmedMessage}`
                );
                console.log("==========================================");


                // =================================================
                // PARSE JSON
                // =================================================

                try {

                    const payload =
                        JSON.parse(
                            trimmedMessage
                        );


                    // ------------------------------------------------
                    // Get line number
                    // ------------------------------------------------

                    const lineNo =
                        String(
                            payload.line_no || ""
                        ).trim();


                    // ------------------------------------------------
                    // Get cell QR
                    // ------------------------------------------------

                    const cellQr =
                        String(
                            payload.cellqr || ""
                        ).trim();


                    // ------------------------------------------------
                    // Validate line number
                    // ------------------------------------------------

                    if (!lineNo) {

                        console.log(
                            "⚠️ line_no missing."
                        );

                        continue;
                    }


                    console.log(
                        `📡 Line   : ${lineNo}`
                    );

                    console.log(
                        `📦 CellQR : ${cellQr}`
                    );


                    // =================================================
                    // COMPARE LINE WITH EXCEL
                    // =================================================

                    processBuzzerEvent(
                        lineNo,
                        cellQr
                    );


                } catch (error) {

                    console.log("");
                    console.log(
                        "=========================================="
                    );
                    console.log(
                        "⚠️ INVALID JSON RECEIVED"
                    );
                    console.log(
                        "=========================================="
                    );
                    console.log(
                        `Data : ${trimmedMessage}`
                    );
                    console.log(
                        `Error: ${error.message}`
                    );
                    console.log(
                        "=========================================="
                    );
                    console.log("");
                }
            }
        }
    );


    // ========================================================
    // TCP CONNECTION CLOSED
    // ========================================================

    client.on(
        "close",
        () => {

            console.log("");
            console.log("==========================================");
            console.log(
                "❌ TCP CONNECTION CLOSED"
            );
            console.log("==========================================");
            console.log("");

            scheduleReconnect();
        }
    );


    // ========================================================
    // TCP ERROR
    // ========================================================

    client.on(
        "error",
        (err) => {

            console.log("");
            console.log("==========================================");
            console.log("❌ TCP ERROR");
            console.log("==========================================");
            console.log(
                err.message
            );
            console.log("==========================================");
            console.log("");
        }
    );
}


// ============================================================
// RECONNECT
// ============================================================

function scheduleReconnect() {

    // --------------------------------------------------------
    // Prevent duplicate reconnect timers
    // --------------------------------------------------------

    if (reconnectTimer) {

        return;
    }


    console.log(
        "🔄 Reconnecting in 3 seconds..."
    );


    reconnectTimer =
        setTimeout(
            () => {

                reconnectTimer = null;

                connectToServer();

            },
            3000
        );
}


