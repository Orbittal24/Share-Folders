USE SQLMonitoringDB;
GO

SELECT
    DB_NAME() AS CurrentDatabase,
    'SQLQueryExecutionLogs' AS TableName,
    COUNT(*) AS TotalRecords,
    MAX(CaptureTimestamp) AS LatestRecord
FROM dbo.SQLQueryExecutionLogs

UNION ALL

SELECT
    DB_NAME(),
    'SQLBlockingExecutionLogs',
    COUNT(*),
    MAX(CaptureTimestamp)
FROM dbo.SQLBlockingExecutionLogs;
