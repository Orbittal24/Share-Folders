def process_record(src_conn, dst_conn):

    src_cursor = src_conn.cursor()

    dst_cursor = dst_conn.cursor()

    row = None


    # -----------------------------------
    # STATUS FLAGS
    # -----------------------------------

    sql_success = False

    redis_success = False


    try:

        # -----------------------------------
        # FETCH TOP 1 FROM NEW TABLE
        # -----------------------------------

        src_cursor.execute("""
            SELECT TOP 1 *
            FROM taco_treceability.ocv_machine_data_xng_mirrior
            ORDER BY sr_no DESC
        """)

        row = src_cursor.fetchone()


        if not row:

            print(
                "No new records..."
            )

            return


        qr = row.cell_qrcode


        print(
            "\n================ NEW RECORD ================"
        )

        print(
            "QR CODE:",
            qr
        )


        # -----------------------------------
        # QR VALIDATION
        # -----------------------------------

        if not qr or len(qr) < 16:

            print(
                "ERROR: QR too short, skipping"
            )

            return


        # -----------------------------------
        # EXTRACT PLANT CODE & BATCH CODE
        # -----------------------------------

        code12_13 = qr[12:14]


        # -----------------------------------
        # DYNAMIC LOGIC FOR DATE CODE
        # -----------------------------------

        if code12_13 == 'BV':

            dateCode = qr[8:11]

        else:

            dateCode = qr[14:17]


        print(
            "Plant code:",
            code12_13
        )

        print(
            "Batch code:",
            dateCode
        )


        # -----------------------------------
        # DATE MAPPING
        # -----------------------------------

        yearValue = yearMap.get(
            dateCode[0]
        )

        monthValue = monthMap.get(
            dateCode[1]
        )

        dayValue = dayMap.get(
            dateCode[2]
        )


        if not yearValue or not monthValue or not dayValue:

            print(
                "ERROR: Mapping failed! Skipping QR:",
                qr
            )

            return


        year = 2000 + yearValue

        month = f"{monthValue:02d}"

        day = f"{dayValue:02d}"


        tableName = (
            f"ocvcell_inventory_data_{year}_{month}_{day}"
        )


        print(
            "Target Table:",
            tableName
        )


        # -----------------------------------
        # CREATE TABLE IF NOT EXISTS
        # -----------------------------------

        dst_cursor.execute(
            f"""
            IF NOT EXISTS (
                SELECT 1
                FROM INFORMATION_SCHEMA.TABLES
                WHERE TABLE_NAME='{tableName}'
            )
            BEGIN

                CREATE TABLE {tableName} (
                    sr_no INT IDENTITY(1,1) PRIMARY KEY,
                    cellqr NVARCHAR(50),
                    voltage NVARCHAR(50),
                    ir NVARCHAR(50),
                    class_grade NVARCHAR(30),
                    capacity NVARCHAR(50),
                    thickness NVARCHAR(50),
                    k_value NVARCHAR(50),
                    negative_voltage NVARCHAR(50),
                    cell_status NVARCHAR(20),
                    ocv_mc_no NVARCHAR(40),
                    first_para_time DATETIME,
                    last_para_time DATETIME,
                    laser_status VARCHAR(50),
                    batch VARCHAR(100),
                    plant_code VARCHAR(50)
                );

            END
            """
        )


        dst_conn.commit()


        # -----------------------------------
        # CHECK IF EXISTS
        # -----------------------------------

        dst_cursor.execute(
            f"""
            SELECT *
            FROM {tableName}
            WHERE cellqr = ?
            """,
            qr
        )


        exists = dst_cursor.fetchone()


        # -----------------------------------
        # PREPARE REDIS DATA
        # -----------------------------------

        row_dict = {

            "cellqr": safe(qr),

            "voltage": safe(
                row.voltage
            ),

            "ir": safe(
                row.ir
            ),

            "class_grade": safe(
                row.cell_class
            ),

            "capacity": safe(
                row.cell_capacity
            ),

            "thickness": safe(
                row.cell_thikness
            ),

            "k_value": safe(
                row.kvalue
            ),

            "negative_voltage": safe(
                row.cell_nigative_voltage
            ),

            "cell_status": "OK",

            "ocv_mc_no": safe(
                row.used_on_line
            ),

            "first_para_time": safe(
                row.today_date
            ),

            "last_para_time": safe(
                row.updated_time
            ),

            "laser_status": safe(
                row.laser_status
            ),

            "batch": safe(
                dateCode
            ),

            "plant_code": safe(
                code12_13
            )
        }


        # =================================================
        # SQL PROCESS
        # =================================================

        try:

            # -----------------------------------
            # SQL INSERT
            # -----------------------------------

            if not exists:

                print(
                    "SQL: New record - INSERT"
                )


                dst_cursor.execute(
                    f"""
                    INSERT INTO {tableName}
                    (
                        cellqr,
                        voltage,
                        ir,
                        class_grade,
                        capacity,
                        thickness,
                        k_value,
                        negative_voltage,
                        cell_status,
                        ocv_mc_no,
                        first_para_time,
                        last_para_time,
                        laser_status,
                        batch,
                        plant_code
                    )
                    VALUES
                    (
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        'OK',
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        ?
                    )
                    """,
                    (
                        qr,
                        row.voltage,
                        row.ir,
                        row.cell_class,
                        row.cell_capacity,
                        row.cell_thikness,
                        row.kvalue,
                        row.cell_nigative_voltage,
                        row.used_on_line,
                        row.today_date,
                        row.updated_time,
                        row.laser_status,
                        dateCode,
                        code12_13
                    )
                )


                dst_conn.commit()


                print(
                    "INSERTED :",
                    qr
                )


            # -----------------------------------
            # SQL UPDATE
            # -----------------------------------

            else:

                print(
                    "SQL: Existing record - UPDATE"
                )


                dst_cursor.execute(
                    f"""
                    UPDATE {tableName}

                    SET
                        voltage = ?,
                        ir = ?,
                        class_grade = ?,
                        capacity = ?,
                        thickness = ?,
                        k_value = ?,
                        negative_voltage = ?,
                        ocv_mc_no = ?,
                        last_para_time = ?,
                        laser_status = ?,
                        batch = ?,
                        plant_code = ?

                    WHERE cellqr = ?
                    """,
                    (
                        row.voltage,
                        row.ir,
                        row.cell_class,
                        row.cell_capacity,
                        row.cell_thikness,
                        row.kvalue,
                        row.cell_nigative_voltage,
                        row.used_on_line,
                        row.updated_time,
                        row.laser_status,
                        dateCode,
                        code12_13,
                        qr
                    )
                )


                dst_conn.commit()


                print(
                    "SQL UPDATED :",
                    qr
                )


            # -----------------------------------
            # SQL SUCCESS
            # -----------------------------------

            sql_success = True


            print(
                "SQL SUCCESS :",
                qr
            )


        except Exception as sql_error:

            # -----------------------------------
            # SQL FAILED
            # -----------------------------------

            sql_success = False


            print(
                "SQL FAILED :",
                sql_error
            )


            try:

                dst_conn.rollback()

            except Exception as rollback_error:

                print(
                    "SQL ROLLBACK FAILED :",
                    rollback_error
                )


            # IMPORTANT:
            #
            # DO NOT RETURN HERE.
            #
            # Redis must still be attempted.


        # =================================================
        # REDIS PROCESS
        # =================================================

        try:

            # -----------------------------------
            # REDIS INSERT / UPDATE
            # -----------------------------------

            r.set(
                f"cell:{qr}",
                json.dumps(row_dict)
            )


            redis_success = True


            print(
                "REDIS SUCCESS : Stored cell:",
                qr
            )


        except Exception as redis_error:

            # -----------------------------------
            # REDIS FAILED
            # -----------------------------------

            redis_success = False


            print(
                "REDIS FAILED :",
                redis_error
            )


        # =================================================
        # FINAL RESULT HANDLING
        # =================================================


        # -----------------------------------
        # CASE 1
        # SQL SUCCESS + REDIS SUCCESS
        # -----------------------------------

        if sql_success and redis_success:

            print(
                "SQL SUCCESS + REDIS SUCCESS :",
                qr
            )

            print(
                "NORMAL FLOW - DELETE SOURCE"
            )


            try:

                src_cursor.execute(
                    """
                    DELETE FROM taco_treceability.ocv_machine_data_xng_mirrior
                    WHERE cell_qrcode = ?
                    """,
                    qr
                )


                src_conn.commit()


                print(
                    "DELETED SOURCE :",
                    qr
                )


            except Exception as delete_error:

                print(
                    "DELETE SOURCE FAILED :",
                    delete_error
                )

                try:
                    src_conn.rollback()
                except Exception as rollback_error:
                    print(
                        "DELETE ROLLBACK FAILED :",
                        rollback_error
                    )


            return


        # -----------------------------------
        # CASE 2
        # SQL FAILED + REDIS SUCCESS
        # -----------------------------------

        if not sql_success and redis_success:

            print(
                "SQL FAILED + REDIS SUCCESS :",
                qr
            )

            print(
                "SQL DATA WILL BE MOVED TO REJECTION"
            )


            handle_failure(
                src_conn,
                row,
                "SQL INSERT/UPDATE FAILED, REDIS SUCCESS"
            )


            return


        # -----------------------------------
        # CASE 3
        # SQL SUCCESS + REDIS FAILED
        # -----------------------------------

        if sql_success and not redis_success:

            print(
                "SQL SUCCESS + REDIS FAILED :",
                qr
            )

            print(
                "REDIS FAILED DATA WILL BE MOVED TO REJECTION"
            )


            handle_failure(
                src_conn,
                row,
                "SQL SUCCESS, REDIS INSERT/UPDATE FAILED"
            )


            return


        # -----------------------------------
        # CASE 4
        # SQL FAILED + REDIS FAILED
        # -----------------------------------

        if not sql_success and not redis_success:

            print(
                "SQL FAILED + REDIS FAILED :",
                qr
            )

            print(
                "BOTH FAILED - ATTEMPTING REJECTION"
            )


            handle_failure(
                src_conn,
                row,
                "SQL FAILED + REDIS FAILED"
            )


            return


    # =================================================
    # OUTER PROCESS ERROR
    # =================================================

    except Exception as e:

        print(
            "ERROR:",
            e
        )


        # -----------------------------------
        # IF RECORD WAS ALREADY FETCHED
        # -----------------------------------
        #
        # Do not simply lose it.
        # Attempt rejection insertion.
        # Mirror is deleted only if rejection
        # acknowledgement succeeds.
        # -----------------------------------

        if row:

            try:

                handle_failure(
                    src_conn,
                    row,
                    "UNEXPECTED PROCESS ERROR"
                )

            except Exception as failure_error:

                print(
                    "FAILURE HANDLER ERROR :",
                    failure_error
                )


        return


# -----------------------------------
# CONTINUOUS LOOP
# -----------------------------------

def start():

    src_conn = connect_db(
        sqlConfig1
    )

    dst_conn = connect_db(
        sqlConfig2
    )


    print(
        "SYSTEM STARTED"
    )


    while True:

        try:

            process_record(
                src_conn,
                dst_conn
            )


        except Exception as e:

            print(
                "ERROR:",
                e
            )


            # -----------------------------------
            # RECONNECT SOURCE AND DESTINATION DB
            # -----------------------------------

            try:

                src_conn = connect_db(
                    sqlConfig1
                )

                dst_conn = connect_db(
                    sqlConfig2
                )

                print(
                    "DB RECONNECTED"
                )


            except Exception as reconnect_error:

                print(
                    "DB RECONNECT FAILED :",
                    reconnect_error
                )


        # -----------------------------------
        # EXISTING LOOP DELAY
        # -----------------------------------

        time.sleep(1)


# -----------------------------------
# START
# -----------------------------------

start()
