// ============================================================
// PROCESS PACK
// ============================================================

app.post(
    "/api/process-pack",
    async (req, res) => {

        try {

            const {
                packNo,
                packId
            } = req.body;


            // ------------------------------------------------
            // VALIDATION
            // ------------------------------------------------

            if (!packNo) {

                return res.status(400).json({

                    success: false,

                    message:
                        "Pack No is required."

                });

            }


            if (!/^\d{6}$/.test(String(packNo))) {

                return res.status(400).json({

                    success: false,

                    message:
                        "Pack No must contain exactly 6 digits."

                });

            }


            if (!packId) {

                return res.status(400).json({

                    success: false,

                    message:
                        "Pack ID is required."

                });

            }


            // ------------------------------------------------
            // STEP 1
            // Pack_duplicate_checker
            // ------------------------------------------------

            const cellPool =
                await getCellScanningPool();


            const duplicateResult =
                await cellPool
                    .request()

                    .input(
                        "PackNo",
                        sql.VarChar,
                        String(packNo)
                    )

                    .input(
                        "PackID",
                        sql.VarChar,
                        String(packId)
                    )

                    .query(`

                        SELECT
                            Line_Id,
                            pack_creation_Date

                        FROM Pack_duplicate_checker

                        WHERE Pack_No = @PackNo

                        AND Pack_ID = @PackID

                    `);


            if (
                duplicateResult.recordset.length === 0
            ) {

                return res.status(404).json({

                    success: false,

                    message:
                        "No record found in Pack_duplicate_checker for the given Pack No and Pack ID."

                });

            }


            // ------------------------------------------------
            // TAKE ALL MATCHING RECORDS
            // ------------------------------------------------

            const duplicateRecords =
                duplicateResult.recordset;


            // ------------------------------------------------
            // USE FIRST RECORD
            // ------------------------------------------------

            const duplicateRecord =
                duplicateRecords[0];


            const lineId =
                duplicateRecord.Line_Id;


            // ------------------------------------------------
            // EXTRACT YYYY_MM_DD
            // ------------------------------------------------

            const rawCreationDate =
                duplicateRecord.pack_creation_Date;


            let packCreationDate;


            if (rawCreationDate instanceof Date) {

                const year =
                    rawCreationDate
                        .getFullYear();

                const month =
                    String(
                        rawCreationDate.getMonth() + 1
                    ).padStart(2, "0");

                const day =
                    String(
                        rawCreationDate.getDate()
                    ).padStart(2, "0");


                packCreationDate =
                    `${year}_${month}_${day}`;

            } else {

                const dateString =
                    String(rawCreationDate);


                const match =
                    dateString.match(
                        /(\d{4})[-_](\d{2})[-_](\d{2})/
                    );


                if (!match) {

                    throw new Error(
                        "Unable to extract pack_creation_Date."
                    );

                }


                packCreationDate =
                    `${match[1]}_${match[2]}_${match[3]}`;

            }


            console.log(
                "Pack Creation Date:",
                packCreationDate
            );


            // ------------------------------------------------
            // STEP 2
            // GET LINE NO
            // ------------------------------------------------

            const masterPool =
                await getMasterPool();


            const lineResult =
                await masterPool

                    .request()

                    .input(
                        "LineId",
                        sql.VarChar,
                        String(lineId)
                    )

                    .query(`

                        SELECT
                            line_no

                        FROM taco_treceability.master_line

                        WHERE Srno = @LineId

                    `);


            if (
                lineResult.recordset.length === 0
            ) {

                return res.status(404).json({

                    success: false,

                    message:
                        `No line found for Line_Id ${lineId}.`

                });

            }


            const lineNo =
                lineResult.recordset[0].line_no;


            console.log(
                "Line ID:",
                lineId
            );


            console.log(
                "Line No:",
                lineNo
            );


            // ------------------------------------------------
            // STEP 3
            // FIND HISTORY TABLES
            // ------------------------------------------------

            const historyPool =
                await getCompletedHistoryPool();


            const tableResult =
                await historyPool

                    .request()

                    .input(
                        "CreationDate",
                        sql.VarChar,
                        packCreationDate
                    )

                    .query(`

                        SELECT
                            TABLE_NAME

                        FROM INFORMATION_SCHEMA.TABLES

                        WHERE TABLE_TYPE = 'BASE TABLE'

                        AND TABLE_NAME LIKE
                            'pack_history_' +
                            @CreationDate +
                            '_%'

                    `);


            let historyTables =
                tableResult.recordset
                    .map(row => row.TABLE_NAME);


            // ------------------------------------------------
            // SAFETY CHECK TABLE NAME
            // ------------------------------------------------

            historyTables =
                historyTables.filter(
                    tableName => {

                        const parts =
                            tableName.split("_");


                        /*
                            pack_history_2026_03_14_2026_03_15

                            position:
                            0 = pack
                            1 = history
                            2 = 2026
                            3 = 03
                            4 = 14
                            5 = 2026
                            6 = 03
                            7 = 15
                        */

                        if (parts.length < 8) {

                            return false;

                        }


                        const dateAtPosition2 =
                            `${parts[2]}_${parts[3]}_${parts[4]}`;


                        return (
                            dateAtPosition2 ===
                            packCreationDate
                        );

                    }
                );


            console.log(
                "History Tables:",
                historyTables
            );


            if (historyTables.length === 0) {

                return res.status(404).json({

                    success: false,

                    message:
                        `No pack history table found for ${packCreationDate}.`

                });

            }


            // ------------------------------------------------
            // STEP 4
            // SEARCH ALL HISTORY TABLES
            // ------------------------------------------------

            const allRecords = [];


            for (
                const tableName of historyTables
            ) {

                /*
                    Table names cannot be SQL parameters,
                    therefore validate them before inserting
                    into the SQL statement.
                */

                if (
                    !/^pack_history_\d{4}_\d{2}_\d{2}_\d{4}_\d{2}_\d{2}$/
                        .test(tableName)
                ) {

                    console.log(
                        "Skipping invalid table:",
                        tableName
                    );

                    continue;

                }


                const query = `

                    SELECT
                        sr_no,
                        pack_name,
                        pack_id,
                        line_id,
                        pack_no,
                        module_barcode,
                        module_number,
                        module_name,
                        cellqr,
                        module_status,
                        cellqr_status,
                        cell_ir,
                        cell_voltage,
                        cell_kvalue,
                        cell_negativeVolatge,
                        cell_class_grade,
                        cell_capacity,
                        cell_thickness,
                        cell_laserStatus,
                        cell_count,
                        cell_batch,
                        cell_plantCode,
                        ocv_scanned_time,
                        ocv_mc_no,
                        current_dateTime,
                        updated_dateTime

                    FROM
                        [${tableName}]

                    WHERE
                        pack_id = @PackID

                    AND
                        pack_no = @PackNo

                    ORDER BY
                        sr_no

                `;


                const result =
                    await historyPool

                        .request()

                        .input(
                            "PackID",
                            sql.VarChar,
                            String(packId)
                        )

                        .input(
                            "PackNo",
                            sql.VarChar,
                            String(packNo)
                        )

                        .query(query);


                for (
                    const row of result.recordset
                ) {

                    const moduleBarcode =
                        row.module_barcode == null
                            ? ""
                            : String(row.module_barcode);


                    // --------------------------------------------
                    // REPLACE ONLY "None"
                    // --------------------------------------------

                    const modifiedBarcode =
                        moduleBarcode.replace(
                            /None/g,
                            String(lineNo)
                        );


                    allRecords.push({

                        tableName,

                        srNo:
                            row.sr_no,

                        moduleBarcode,

                        modifiedBarcode,

                        moduleNumber:
                            row.module_number,

                        moduleName:
                            row.module_name,

                        lineId:
                            row.line_id

                    });

                }

            }


            // ------------------------------------------------
            // RESPONSE
            // ------------------------------------------------

            const replacedCount =
                allRecords.filter(
                    record =>
                        record.moduleBarcode !==
                        record.modifiedBarcode
                ).length;


            res.json({

                success: true,

                message:
                    allRecords.length > 0

                        ? `${allRecords.length} module barcode record(s) found. ${replacedCount} barcode(s) contained "None".`

                        : "No matching module barcode records found.",

                packNo,

                packId,

                lineId,

                lineNo,

                packCreationDate,

                historyTables,

                records:
                    allRecords

            });


        } catch (error) {

            console.error(
                "Process Pack Error:",
                error
            );


            res.status(500).json({

                success: false,

                message:
                    "Error while processing pack.",

                error:
                    error.message

            });

        }

    }
);


