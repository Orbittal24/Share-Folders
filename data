// ============================================================
// GET XNG OCV REJECTION DATA
// ============================================================

app.get("/api/get_ocv_reject_data", async (req, res) => {

    try {

        const result = await dbConn.request().query(`

            SELECT

                sr_no,
                cell_qrcode,
                voltage,
                ir,
                today_date,
                updated_time,
                machine_location,
                shift,
                used_on_line,
                kvalue,
                grade,
                cell_capacity,
                cell_class,
                cell_thikness,
                cell_nigative_voltage,
                laser_status

            FROM taco_treceability.ocv_machine_data_xng_mirrior_rejection

            WHERE cell_qrcode LIKE '03%'

            ORDER BY sr_no

        `);


        res.json({

            success: true,

            totalCount: result.recordset.length,

            data: result.recordset

        });


    } catch (err) {

        console.log("GET DATA ERROR :", err);


        res.json({

            success: false,

            message: err.message

        });

    }

});


// ============================================================
// SOCKET.IO
// ============================================================

io.on("connection", (socket) => {

    console.log(
        "Client Connected :",
        socket.id
    );


    // ========================================================
    // SHIFT REJECTION DATA TO XNG MIRROR
    // ========================================================

    socket.on("shift_to_mirror", async () => {

        try {

            // ------------------------------------------------
            // GET ALL REJECTION RECORDS
            // ------------------------------------------------

            const result = await dbConn.request().query(`

                SELECT

                    sr_no

                FROM taco_treceability.ocv_machine_data_xng_mirrior_rejection

                WHERE cell_qrcode LIKE '03%'

                ORDER BY sr_no

            `);


            const rows = result.recordset;


            // ------------------------------------------------
            // NO RECORDS
            // ------------------------------------------------

            if (rows.length === 0) {

                socket.emit("shift_completed", {

                    success: true,

                    total: 0

                });

                return;

            }


            let shiftedCount = 0;


            // =================================================
            // PROCESS EACH RECORD
            // =================================================

            for (const row of rows) {

                try {

                    // ------------------------------------------------
                    // INSERT INTO XNG MIRROR
                    // ------------------------------------------------

                    const insertResult =
                        await dbConn.request().query(`

                            INSERT INTO taco_treceability.ocv_machine_data_xng_mirrior

                            (

                                cell_qrcode,
                                voltage,
                                ir,
                                today_date,
                                updated_time,
                                machine_location,
                                shift,
                                used_on_line,
                                kvalue,
                                grade,
                                cell_capacity,
                                cell_class,
                                cell_thikness,
                                cell_nigative_voltage,
                                laser_status

                            )

                            SELECT

                                cell_qrcode,
                                voltage,
                                ir,
                                today_date,
                                updated_time,
                                machine_location,
                                shift,
                                used_on_line,
                                kvalue,
                                grade,
                                cell_capacity,
                                cell_class,
                                cell_thikness,
                                cell_nigative_voltage,
                                laser_status

                            FROM taco_treceability.ocv_machine_data_xng_mirrior_rejection

                            WHERE

                                sr_no = ${row.sr_no}

                                AND cell_qrcode LIKE '03%'

                        `);


                    // ------------------------------------------------
                    // IF INSERT SUCCESSFUL
                    // ------------------------------------------------

                    if (
                        insertResult.rowsAffected[0] > 0
                    ) {

                        // ------------------------------------------------
                        // DELETE INSERTED RECORD
                        // ------------------------------------------------

                        const deleteResult =
                            await dbConn.request().query(`

                                DELETE

                                FROM taco_treceability.ocv_machine_data_xng_mirrior_rejection

                                WHERE

                                    sr_no = ${row.sr_no}

                                    AND cell_qrcode LIKE '03%'

                            `);


                        // ------------------------------------------------
                        // IF DELETE SUCCESSFUL
                        // ------------------------------------------------

                        if (
                            deleteResult.rowsAffected[0] > 0
                        ) {

                            shiftedCount++;


                            // ------------------------------------------------
                            // SEND PROGRESS TO FRONTEND
                            // ------------------------------------------------

                            socket.emit(
                                "shift_progress",
                                {

                                    shifted: shiftedCount,

                                    total: rows.length

                                }
                            );


                            console.log(
                                `Shifted XNG Record SR NO : ${row.sr_no}`
                            );

                        }

                    }

                } catch (err) {

                    console.log(
                        `Error shifting XNG SR NO ${row.sr_no} :`,
                        err.message
                    );

                }

            }


            // =================================================
            // SHIFT COMPLETED
            // =================================================

            socket.emit(
                "shift_completed",
                {

                    success: true,

                    total: shiftedCount

                }
            );


        } catch (err) {

            console.log(
                "XNG Shift Error :",
                err
            );


            socket.emit(
                "shift_completed",
                {

                    success: false

                }
            );

        }

    });


    // ========================================================
    // DISCONNECT
    // ========================================================

    socket.on("disconnect", () => {

        console.log(
            "Client Disconnected :",
            socket.id
        );

    });

});


