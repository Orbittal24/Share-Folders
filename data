```javascript
const {
    OPCUAClient,
    AttributeIds,
    TimestampsToReturn
} = require("node-opcua");

const endpointUrl = "opc.tcp://192.168.250.1:4840";

// OPC UA tags
const nodes = [
    "MES_CellData1",
    "MES_CellData2",
    "MES_CellData3",
    "MES_CellData4",
    "MES_CellData5",
    "MES_CellData6",
    "MES_CellData7",
    "MES_CellData8"
];

async function main() {

    try {

        // Create OPC UA client
        const client = OPCUAClient.create({
            endpoint_must_exist: false,
            connectionStrategy: {
                maxRetry: 5,
                initialDelay: 2000,
                maxDelay: 10000
            }
        });

        client.on("backoff", () => {
            console.log("Retrying OPC UA connection...");
        });

        // Connect
        console.log("Connecting to OPC UA server...");
        await client.connect(endpointUrl);

        console.log("Connected to OPC UA server");

        // Create session
        const session = await client.createSession();

        console.log("OPC UA session created");

        // Create subscription
        const subscription = await session.createSubscription2({
            requestedPublishingInterval: 1000,
            requestedLifetimeCount: 100,
            requestedMaxKeepAliveCount: 10,
            maxNotificationsPerPublish: 100,
            publishingEnabled: true,
            priority: 10
        });

        subscription.on("started", () => {
            console.log(
                "Subscription started. ID =",
                subscription.subscriptionId
            );
        });

        subscription.on("keepalive", () => {
            console.log("OPC UA KeepAlive");
        });

        subscription.on("terminated", () => {
            console.log("Subscription terminated");
        });

        // Monitoring parameters
        const parameters = {
            samplingInterval: 100,
            discardOldest: true,
            queueSize: 100
        };

        // Monitor all tags
        for (let i = 0; i < nodes.length; i++) {

            const nodeId = `ns=4;s=${nodes[i]}`;

            const itemToMonitor = {
                nodeId: nodeId,
                attributeId: AttributeIds.Value
            };

            const monitoredItem = await subscription.monitor(
                itemToMonitor,
                parameters,
                TimestampsToReturn.Both
            );

            console.log(`Monitoring: ${nodes[i]}`);

            monitoredItem.on("changed", (dataValue) => {

                const value = dataValue.value.value;

                console.log("\n=================================");
                console.log(`TAG: ${nodes[i]}`);
                console.log("VALUE:", value);
                console.log("TYPE:", typeof value);
                console.log("TIME:", new Date());
                console.log("=================================");
            });
        }

        console.log("\nAll tags are being monitored...\n");

        // Graceful shutdown
        process.on("SIGINT", async () => {

            console.log("\nShutting down OPC UA client...");

            await subscription.terminate();
            await session.close();
            await client.disconnect();

            console.log("Disconnected");
            process.exit(0);
        });

    } catch (err) {

        console.error("OPC UA Error:", err);

    }
}

main();
