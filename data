const net = require("net");
const { SerialPort } = require("serialport");
const XLSX = require("xlsx");
const fs = require("fs");
const path = require("path");
const os = require("os");


// ============================================================
// CELL SCANNING BUZZER - TCP CLIENT
// ============================================================
// Flow:
//
// Python TCP Server
//        |
//        | {"line_no":"3"}
//        v
// This Node.js client
//        |
//        v
// Read Excel Sheet1!A1
//        |
//        v
// Compare received line with Excel line
//        |
//        +---- NOT MATCHED ---> Buzzer OFF
//        |
//        +---- MATCHED -------> Buzzer ON
//                              |
//                              v
//                           10 seconds
//                              |
//                              v
//                           Buzzer OFF
//
// This client stays connected to the Python TCP server.
// ============================================================



// ============================================================
// MAIN SERVER TCP CONFIGURATION
// ============================================================

const SERVER_IP = "10.9.4.28";
const SERVER_PORT = 5391;


// ============================================================
// SERIAL RELAY CONFIGURATION
// ============================================================

const SERIAL_PORT = "COM4";

const BAUD_RATE = 9600;

const DATA_BITS = 8;
const STOP_BITS = 1;
const PARITY = "none";


// ============================================================
// TEMPORARY TEST MODE
// ============================================================
//
// true  = COM4 is NOT required.
//         Relay commands are only simulated.
//
// false = Real COM4 relay is required.
//
// ============================================================

const SIMULATE_SERIAL = true;


// ============================================================
// EXCEL CONFIGURATION
// ============================================================

const EXCEL_FILE_NAME = "buzzer_line.xlsx";

const EXCEL_FILE_PATH = path.join(
    os.homedir(),
    "Desktop",
    EXCEL_FILE_NAME
);

const SHEET_NAME = "Sheet1";

// Line number is stored in A1
const LINE_CELL = "A1";


// ============================================================
// BUZZER CONFIGURATION
// ============================================================

const BUZZER_DURATION = 10000;


// ============================================================
// RECONNECT CONFIGURATION
// ============================================================

const TCP_RECONNECT_DELAY = 3000;

const SERIAL_RECONNECT_DELAY = 3000;


// ============================================================
// RELAY COMMANDS
// ============================================================

// RELAY ON
// A0 01 01 A2

const RELAY_ON_COMMAND = Buffer.from([
    0xA0,
    0x01,
    0x01,
    0xA2
]);


// RELAY OFF
// A0 01 00 A1

const RELAY_OFF_COMMAND = Buffer.from([
    0xA0,
    0x01,
    0x00,
    0xA1
]);


// ============================================================
// APPLICATION STATE
// ============================================================

let serialPort = null;

let isSerialConnecting = false;

let isBuzzerRunning = false;

let buzzerTimer = null;

let tcpClient = null;

let tcpReconnectTimer = null;

let receivedBuffer = "";


// ============================================================
// READ LINE NUMBER FROM EXCEL
// ============================================================

function readLocalExcelLine() {

    // --------------------------------------------------------
    // Check file
    // --------------------------------------------------------

    if (!fs.existsSync(EXCEL_FILE_PATH)) {

        throw new Error(
            `Excel file not found: ${EXCEL_FILE_PATH}`
        );
    }


    // --------------------------------------------------------
    // Read workbook
    // --------------------------------------------------------

    const workbook = XLSX.readFile(
        EXCEL_FILE_PATH
    );


    // --------------------------------------------------------
    // Check sheet
    // --------------------------------------------------------

    if (
        !workbook.SheetNames.includes(
            SHEET_NAME
        )
    ) {

        throw new Error(
            `Excel sheet "${SHEET_NAME}" not found`
        );
    }


    // --------------------------------------------------------
    // Get worksheet
    // --------------------------------------------------------

    const worksheet =
        workbook.Sheets[SHEET_NAME];


    // --------------------------------------------------------
    // Read A1
    // --------------------------------------------------------

    const cell =
        worksheet[LINE_CELL];


    // --------------------------------------------------------
    // Validate A1
    // --------------------------------------------------------

    if (
        !cell ||
        cell.v === undefined ||
        cell.v === null ||
        String(cell.v).trim() === ""
    ) {

        throw new Error(
            `Excel cell ${LINE_CELL} is empty`
        );
    }


    // --------------------------------------------------------
    // Return line
    // --------------------------------------------------------

    return String(
        cell.v
    ).trim();
}


// ============================================================
// CONNECT SERIAL RELAY
// ============================================================

async function connectSerialRelay() {

    // --------------------------------------------------------
    // Already connected
    // --------------------------------------------------------

    if (
        serialPort &&
        serialPort.isOpen
    ) {

        return true;
    }


    // --------------------------------------------------------
    // Already connecting
    // --------------------------------------------------------

    if (isSerialConnecting) {

        return false;
    }


    isSerialConnecting = true;


    console.log(
        `[SERIAL] Connecting to ${SERIAL_PORT}...`
    );


    return new Promise((resolve) => {

        serialPort = new SerialPort({

            path: SERIAL_PORT,

            baudRate: BAUD_RATE,

            dataBits: DATA_BITS,

            stopBits: STOP_BITS,

            parity: PARITY,

            autoOpen: false
        });


        // ----------------------------------------------------
        // SERIAL DATA
        // ----------------------------------------------------

        serialPort.on(
            "data",
            (data) => {

                console.log(
                    `[SERIAL RESPONSE] ${
                        data.toString("hex")
                    }`.toUpperCase()
                );

            }
        );


        // ----------------------------------------------------
        // SERIAL ERROR
        // ----------------------------------------------------

        serialPort.on(
            "error",
            (error) => {

                console.error(
                    `[SERIAL ERROR] ${error.message}`
                );

            }
        );


        // ----------------------------------------------------
        // SERIAL CLOSE
        // ----------------------------------------------------

        serialPort.on(
            "close",
            () => {

                console.log(
                    "[SERIAL] Relay COM port closed"
                );

                isSerialConnecting = false;

            }
        );


        // ----------------------------------------------------
        // OPEN SERIAL
        // ----------------------------------------------------

        serialPort.open(
            (error) => {

                isSerialConnecting = false;


                if (error) {

                    console.error(
                        `[SERIAL ERROR] ${error.message}`
                    );

                    resolve(false);

                    return;
                }


                console.log(
                    `[SERIAL] Connected successfully to ${SERIAL_PORT}`
                );


                resolve(true);

            }
        );

    });
}


// ============================================================
// ENSURE SERIAL CONNECTION
// ============================================================

async function ensureSerialConnected() {

    if (
        serialPort &&
        serialPort.isOpen
    ) {

        return true;
    }


    return await connectSerialRelay();
}


// ============================================================
// SEND RELAY COMMAND
// ============================================================

async function sendRelayCommand(
    command,
    commandName
) {

    // ========================================================
    // SIMULATION MODE
    // ========================================================

    if (SIMULATE_SERIAL) {

        console.log("");

        console.log(
            `[SIMULATION] ${commandName}`
        );

        console.log(
            `[SIMULATION] Command: ${
                command
                    .toString("hex")
                    .toUpperCase()
            }`
        );

        console.log(
            "[SIMULATION] COM4 not required."
        );

        return;
    }


    // ========================================================
    // REAL SERIAL MODE
    // ========================================================

    const connected =
        await ensureSerialConnected();


    if (!connected) {

        throw new Error(
            `Relay not connected on ${SERIAL_PORT}`
        );
    }


    return new Promise(
        (resolve, reject) => {

            console.log(
                `[SERIAL] Sending ${commandName}`
            );


            console.log(
                `[SERIAL] Command: ${
                    command
                        .toString("hex")
                        .toUpperCase()
                }`
            );


            serialPort.write(
                command,
                (writeError) => {

                    if (writeError) {

                        reject(writeError);

                        return;
                    }


                    serialPort.drain(
                        (drainError) => {

                            if (drainError) {

                                reject(
                                    drainError
                                );

                                return;
                            }


                            console.log(
                                `[SERIAL] ${commandName} command sent successfully`
                            );


                            resolve();

                        }
                    );

                }
            );

        }
    );
}


// ============================================================
// START BUZZER
// ============================================================

async function startBuzzer(
    lineNo
) {

    // --------------------------------------------------------
    // Already running
    // --------------------------------------------------------

    if (isBuzzerRunning) {

        console.log(
            `[BUZZER] Already running. Line ${lineNo} ignored.`
        );

        return;
    }


    isBuzzerRunning = true;


    console.log("");

    console.log(
        "================================================"
    );

    console.log(
        `[BUZZER] STARTING FOR LINE: ${lineNo}`
    );

    console.log(
        "================================================"
    );


    try {

        // ----------------------------------------------------
        // RELAY ON
        // ----------------------------------------------------

        await sendRelayCommand(
            RELAY_ON_COMMAND,
            "RELAY ON"
        );


        console.log(
            `[BUZZER] ON for ${
                BUZZER_DURATION / 1000
            } seconds`
        );


        // ----------------------------------------------------
        // Clear old timer
        // ----------------------------------------------------

        if (buzzerTimer) {

            clearTimeout(
                buzzerTimer
            );

            buzzerTimer = null;
        }


        // ----------------------------------------------------
        // Stop after 10 seconds
        // ----------------------------------------------------

        buzzerTimer = setTimeout(
            async () => {

                await stopBuzzer();

            },
            BUZZER_DURATION
        );


    } catch (error) {

        console.error(
            `[BUZZER ON ERROR] ${error.message}`
        );

        isBuzzerRunning = false;
    }
}


// ============================================================
// STOP BUZZER
// ============================================================

async function stopBuzzer() {

    if (buzzerTimer) {

        clearTimeout(
            buzzerTimer
        );

        buzzerTimer = null;
    }


    console.log("");

    console.log(
        "================================================"
    );

    console.log(
        "[BUZZER] 10 SECONDS COMPLETED"
    );

    console.log(
        "[BUZZER] TURNING OFF..."
    );

    console.log(
        "================================================"
    );


    try {

        await sendRelayCommand(
            RELAY_OFF_COMMAND,
            "RELAY OFF"
        );


        console.log(
            "[BUZZER] OFF SUCCESSFULLY"
        );


    } catch (error) {

        console.error(
            `[BUZZER OFF ERROR] ${error.message}`
        );

    } finally {

        isBuzzerRunning = false;
    }
}


// ============================================================
// PROCESS BROADCAST LINE
// ============================================================

async function processBroadcast(
    receivedLineNo
) {

    console.log("");

    console.log(
        "################################################"
    );

    console.log(
        `[TCP] RECEIVED BROADCAST LINE NO: ${receivedLineNo}`
    );

    console.log(
        "################################################"
    );


    try {

        // ----------------------------------------------------
        // Read Excel A1
        // ----------------------------------------------------

        const excelLine =
            readLocalExcelLine();


        console.log(
            `[EXCEL] File: ${EXCEL_FILE_PATH}`
        );


        console.log(
            `[EXCEL] Sheet: ${SHEET_NAME}`
        );


        console.log(
            `[EXCEL] Cell ${LINE_CELL}: ${excelLine}`
        );


        // ----------------------------------------------------
        // Convert both to strings
        // ----------------------------------------------------

        const serverLine =
            String(
                receivedLineNo
            ).trim();


        const localLine =
            String(
                excelLine
            ).trim();


        // ----------------------------------------------------
        // COMPARE
        // ----------------------------------------------------

        console.log("");

        console.log(
            "[CLIENT] Comparing lines..."
        );


        console.log(
            `[CLIENT] Broadcasted Line: ${serverLine}`
        );


        console.log(
            `[CLIENT] Excel Line      : ${localLine}`
        );


        // ----------------------------------------------------
        // NOT MATCHED
        // ----------------------------------------------------

        if (
            serverLine !==
            localLine
        ) {

            console.log("");

            console.log(
                "[CLIENT] LINE NOT MATCHED"
            );


            console.log(
                "[CLIENT] BUZZER WILL REMAIN OFF"
            );

            console.log("");

            return;
        }


        // ----------------------------------------------------
        // MATCHED
        // ----------------------------------------------------

        console.log("");

        console.log(
            "[CLIENT] LINE MATCHED SUCCESSFULLY"
        );


        console.log(
            `[CLIENT] Broadcasted Line: ${serverLine}`
        );


        console.log(
            `[CLIENT] Excel Line      : ${localLine}`
        );


        console.log(
            "[CLIENT] STARTING BUZZER..."
        );


        await startBuzzer(
            serverLine
        );


    } catch (error) {

        console.error("");

        console.error(
            `[CLIENT EXCEL ERROR] ${error.message}`
        );


        console.error(
            "[CLIENT] BUZZER WILL NOT START"
        );

        console.error("");
    }
}


// ============================================================
// PROCESS TCP MESSAGE
// ============================================================
//
// Expected:
//
// {"line_no":"3"}
//
// followed by:
//
// \n
//
// ============================================================

async function processTcpMessage(
    message
) {

    const trimmedMessage =
        message.trim();


    if (!trimmedMessage) {

        return;
    }


    try {

        console.log(
            `[TCP] Raw Message: ${trimmedMessage}`
        );


        // ----------------------------------------------------
        // Parse JSON
        // ----------------------------------------------------

        const parsed =
            JSON.parse(
                trimmedMessage
            );


        // ----------------------------------------------------
        // IMPORTANT
        //
        // Python backend sends:
        //
        // {"line_no": 1}
        //
        // Therefore use parsed.line_no
        // ----------------------------------------------------

        const lineNo =
            parsed.line_no;


        if (
            lineNo === undefined ||
            lineNo === null ||
            String(lineNo).trim() === ""
        ) {

            console.error(
                "[TCP ERROR] line_no missing"
            );

            return;
        }


        // ----------------------------------------------------
        // Process line
        // ----------------------------------------------------

        await processBroadcast(
            lineNo
        );


    } catch (error) {

        console.error(
            `[TCP MESSAGE ERROR] ${error.message}`
        );


        console.error(
            `[TCP MESSAGE] Invalid message: ${trimmedMessage}`
        );
    }
}


// ============================================================
// CONNECT TO MAIN TCP SERVER
// ============================================================

function connectToMainServer() {

    if (
        tcpClient &&
        !tcpClient.destroyed
    ) {

        return;
    }


    console.log("");

    console.log(
        "================================================"
    );

    console.log(
        "[TCP] CONNECTING TO MAIN SERVER"
    );

    console.log(
        "================================================"
    );

    console.log(
        `Server : ${SERVER_IP}:${SERVER_PORT}`
    );

    console.log(
        "================================================"
    );


    tcpClient =
        new net.Socket();


    // ========================================================
    // TCP CONNECT
    // ========================================================

    tcpClient.connect(
        SERVER_PORT,
        SERVER_IP,
        () => {

            console.log("");

            console.log(
                "================================================"
            );

            console.log(
                "✅ TCP CONNECTED TO MAIN SERVER"
            );

            console.log(
                "================================================"
            );

            console.log(
                `${SERVER_IP}:${SERVER_PORT}`
            );

            console.log(
                "================================================"
            );

            console.log("");


            // ====================================================
            // CELL SCANNING BUZZER - CLIENT REGISTRATION
            // ====================================================
            //
            // Tell the Python TCP server that this connection
            // belongs to a buzzer client.
            //
            // The server can use this for logging/identification.
            //
            // IMPORTANT:
            // The newline is required because the Python server
            // uses newline-delimited TCP messages.
            // ====================================================

            const registrationMessage =
                JSON.stringify({
                    client_type: "buzzer",
                    client_name: os.hostname()
                }) + "\n";


            try {

                tcpClient.write(
                    registrationMessage
                );


                console.log(
                    `[TCP] Registration sent: ${registrationMessage.trim()}`
                );


            } catch (error) {

                console.error(
                    `[TCP REGISTRATION ERROR] ${error.message}`
                );
            }


            // ====================================================
            // END CELL SCANNING BUZZER - CLIENT REGISTRATION
            // ====================================================

        }
    );


    // ========================================================
    // RECEIVE SERVER BROADCAST
    // ========================================================

    tcpClient.on(
        "data",
        async (data) => {

            receivedBuffer +=
                data.toString("utf8");


            console.log(
                `[TCP] Data received: ${data.toString("utf8").trim()}`
            );


            // ------------------------------------------------
            // Split messages by newline
            // ------------------------------------------------

            const messages =
                receivedBuffer.split("\n");


            // ------------------------------------------------
            // Keep incomplete message
            // ------------------------------------------------

            receivedBuffer =
                messages.pop();


            // ------------------------------------------------
            // Process complete messages
            // ------------------------------------------------

            for (
                const message of messages
            ) {

                if (
                    message.trim()
                ) {

                    await processTcpMessage(
                        message
                    );
                }

            }

        }
    );


    // ========================================================
    // TCP ERROR
    // ========================================================

    tcpClient.on(
        "error",
        (error) => {

            console.error("");

            console.error(
                `[TCP ERROR] ${error.message}`
            );

            console.error("");

        }
    );


    // ========================================================
    // TCP CLOSE
    // ========================================================

    tcpClient.on(
        "close",
        () => {

            console.log("");

            console.log(
                "[TCP] Disconnected from main server"
            );

            console.log("");

            tcpClient = null;

            receivedBuffer = "";


            scheduleTcpReconnect();

        }
    );
}


// ============================================================
// TCP RECONNECT
// ============================================================

function scheduleTcpReconnect() {

    if (tcpReconnectTimer) {

        return;
    }


    console.log(
        `[TCP] Reconnecting in ${
            TCP_RECONNECT_DELAY / 1000
        } seconds...`
    );


    tcpReconnectTimer =
        setTimeout(
            () => {

                tcpReconnectTimer = null;

                connectToMainServer();

            },
            TCP_RECONNECT_DELAY
        );
}


// ============================================================
// SERIAL RECONNECT
// ============================================================

function startSerialReconnectCheck() {

    setInterval(
        async () => {

            if (
                !serialPort ||
                !serialPort.isOpen
            ) {

                console.log(
                    "[SERIAL] Relay disconnected. Trying to reconnect..."
                );


                await connectSerialRelay();
            }

        },
        SERIAL_RECONNECT_DELAY
    );
}


// ============================================================
// APPLICATION START
// ============================================================

async function startApplication() {

    console.log("");

    console.log(
        "================================================"
    );

    console.log(
        "BUZZER TCP CLIENT STARTED"
    );

    console.log(
        "================================================"
    );


    console.log(
        `Main Server IP : ${SERVER_IP}`
    );


    console.log(
        `Main Server Port : ${SERVER_PORT}`
    );


    console.log(
        `Serial Port : ${SERIAL_PORT}`
    );


    console.log(
        `Excel File : ${EXCEL_FILE_PATH}`
    );


    console.log(
        `Excel Sheet : ${SHEET_NAME}`
    );


    console.log(
        `Excel Line Cell : ${LINE_CELL}`
    );


    console.log(
        `Buzzer Duration : ${
            BUZZER_DURATION / 1000
        } seconds`
    );


    console.log(
        `Serial Simulation : ${
            SIMULATE_SERIAL
                ? "ENABLED"
                : "DISABLED"
        }`
    );


    console.log(
        "================================================"
    );


    // ========================================================
    // SERIAL
    // ========================================================

    if (SIMULATE_SERIAL) {

        console.log(
            "[TEST MODE] Serial relay simulation enabled."
        );


        console.log(
            "[TEST MODE] COM4 is NOT required."
        );


        console.log(
            "[TEST MODE] Relay commands will be simulated."
        );

    } else {

        // ----------------------------------------------------
        // Real serial connection
        // ----------------------------------------------------

        const serialConnected =
            await connectSerialRelay();


        if (serialConnected) {

            try {

                console.log(
                    "[STARTUP] Turning buzzer OFF..."
                );


                await sendRelayCommand(
                    RELAY_OFF_COMMAND,
                    "RELAY OFF (STARTUP)"
                );


            } catch (error) {

                console.error(
                    `[STARTUP ERROR] ${error.message}`
                );
            }


        } else {

            console.log(
                "[STARTUP] Serial relay not connected. " +
                "TCP will continue running."
            );
        }


        // ----------------------------------------------------
        // Serial reconnect
        // ----------------------------------------------------

        startSerialReconnectCheck();
    }


    // ========================================================
    // TCP CONNECTION
    // ========================================================

    connectToMainServer();
}


// ============================================================
// SAFE SHUTDOWN
// ============================================================

async function shutdown(
    signal
) {

    console.log("");

    console.log(
        `[SYSTEM] ${signal} received`
    );


    console.log(
        "[SYSTEM] Shutting down..."
    );


    // --------------------------------------------------------
    // Clear buzzer timer
    // --------------------------------------------------------

    if (buzzerTimer) {

        clearTimeout(
            buzzerTimer
        );

        buzzerTimer = null;
    }


    // --------------------------------------------------------
    // Turn relay OFF
    // --------------------------------------------------------

    try {

        if (SIMULATE_SERIAL) {

            console.log(
                "[TEST MODE] Simulating RELAY OFF during shutdown."
            );


            await sendRelayCommand(
                RELAY_OFF_COMMAND,
                "RELAY OFF (SHUTDOWN)"
            );

        } else if (
            serialPort &&
            serialPort.isOpen
        ) {

            await sendRelayCommand(
                RELAY_OFF_COMMAND,
                "RELAY OFF (SHUTDOWN)"
            );
        }


    } catch (error) {

        console.error(
            `[SHUTDOWN ERROR] ${error.message}`
        );
    }


    // --------------------------------------------------------
    // Close TCP
    // --------------------------------------------------------

    if (
        tcpClient &&
        !tcpClient.destroyed
    ) {

        tcpClient.destroy();
    }


    // --------------------------------------------------------
    // Close serial
    // --------------------------------------------------------

    if (
        serialPort &&
        serialPort.isOpen
    ) {

        await new Promise(
            (resolve) => {

                serialPort.close(
                    () => resolve()
                );

            }
        );
    }


    console.log(
        "[SYSTEM] Client stopped."
    );


    process.exit(0);
}


// ============================================================
// SHUTDOWN EVENTS
// ============================================================

process.on(
    "SIGINT",
    () => shutdown("SIGINT")
);


process.on(
    "SIGTERM",
    () => shutdown("SIGTERM")
);


// ============================================================
// START CLIENT
// ============================================================

startApplication();
