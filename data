const net = require("net");
const { SerialPort } = require("serialport");
const XLSX = require("xlsx");
const fs = require("fs");
const path = require("path");
const os = require("os");


// ============================================================
// MAIN SERVER TCP CONFIGURATION
// ============================================================

// Main FastAPI server IP
const SERVER_IP = "192.168.0.76";

// TCP Buzzer Server Port
const SERVER_PORT = 5000;


// ============================================================
// SERIAL RELAY CONFIGURATION
// ============================================================

// Change this according to the COM port on this client PC
const SERIAL_PORT = "COM4";

// Change if your relay uses a different baud rate
const BAUD_RATE = 9600;

const DATA_BITS = 8;
const STOP_BITS = 1;
const PARITY = "none";


// ============================================================
// EXCEL CONFIGURATION
// ============================================================
//
// File location:
// C:\Users\<USERNAME>\Desktop\buzzer_line.xlsx
//
// Excel format:
//
//   A
//  ---
//   1
//
// There is NO column name.
// There is NO heading.
// Only one line number is stored in cell A1.
//

const EXCEL_FILE_NAME = "buzzer_line.xlsx";

const EXCEL_FILE_PATH = path.join(
    os.homedir(),
    "Desktop",
    EXCEL_FILE_NAME
);

const SHEET_NAME = "Sheet1";

const LINE_CELL = "A1";


// ============================================================
// BUZZER CONFIGURATION
// ============================================================

// Buzzer automatically turns OFF after 10 seconds
const BUZZER_DURATION = 10000;


// ============================================================
// RECONNECT CONFIGURATION
// ============================================================

const TCP_RECONNECT_DELAY = 3000;

const SERIAL_RECONNECT_DELAY = 3000;


// ============================================================
// RELAY COMMANDS
// ============================================================

// RELAY ON
// A0 01 01 A2
const RELAY_ON_COMMAND = Buffer.from([
    0xA0,
    0x01,
    0x01,
    0xA2
]);


// RELAY OFF
// A0 01 00 A1
const RELAY_OFF_COMMAND = Buffer.from([
    0xA0,
    0x01,
    0x00,
    0xA1
]);


// ============================================================
// APPLICATION STATE
// ============================================================

let serialPort = null;

let isSerialConnecting = false;

let isBuzzerRunning = false;

let buzzerTimer = null;

let tcpClient = null;

let tcpReconnectTimer = null;

let receivedBuffer = "";


// ============================================================
// READ LINE NUMBER FROM LOCAL EXCEL
// ============================================================
//
// Reads only:
// A1
//
// Example:
//
// A1 = 1
//
// Returns:
// "1"
//

function readLocalExcelLine() {

    // Check Excel file exists
    if (!fs.existsSync(EXCEL_FILE_PATH)) {

        throw new Error(
            `Excel file not found: ${EXCEL_FILE_PATH}`
        );
    }


    // Open Excel file
    const workbook = XLSX.readFile(
        EXCEL_FILE_PATH
    );


    // Check Sheet1 exists
    if (!workbook.SheetNames.includes(SHEET_NAME)) {

        throw new Error(
            `Excel sheet "${SHEET_NAME}" not found`
        );
    }


    // Get worksheet
    const worksheet =
        workbook.Sheets[SHEET_NAME];


    // Get A1 cell
    const cell =
        worksheet[LINE_CELL];


    // Check A1 has a value
    if (
        !cell ||
        cell.v === undefined ||
        cell.v === null ||
        String(cell.v).trim() === ""
    ) {

        throw new Error(
            `Excel cell ${LINE_CELL} is empty`
        );
    }


    // Return line number as string
    return String(
        cell.v
    ).trim();
}


// ============================================================
// CONNECT SERIAL RELAY
// ============================================================

async function connectSerialRelay() {

    // Already connected
    if (
        serialPort &&
        serialPort.isOpen
    ) {

        return true;
    }


    // Connection already in progress
    if (isSerialConnecting) {

        return false;
    }


    isSerialConnecting = true;


    console.log(
        `[SERIAL] Connecting to ${SERIAL_PORT}...`
    );


    return new Promise((resolve) => {

        serialPort = new SerialPort({
            path: SERIAL_PORT,
            baudRate: BAUD_RATE,
            dataBits: DATA_BITS,
            stopBits: STOP_BITS,
            parity: PARITY,
            autoOpen: false,
        });


        // Serial data response
        serialPort.on(
            "data",
            (data) => {

                console.log(
                    `[SERIAL RESPONSE] ` +
                    data.toString("hex").toUpperCase()
                );

            }
        );


        // Serial error
        serialPort.on(
            "error",
            (error) => {

                console.error(
                    `[SERIAL ERROR] ${error.message}`
                );

            }
        );


        // Serial closed
        serialPort.on(
            "close",
            () => {

                console.log(
                    "[SERIAL] Relay COM port closed"
                );

                isSerialConnecting = false;

            }
        );


        // Open serial port
        serialPort.open(
            (error) => {

                isSerialConnecting = false;


                if (error) {

                    console.error(
                        `[SERIAL ERROR] ${error.message}`
                    );

                    resolve(false);

                    return;
                }


                console.log(
                    `[SERIAL] Connected successfully to ${SERIAL_PORT}`
                );

                resolve(true);

            }
        );

    });
}


// ============================================================
// ENSURE SERIAL RELAY IS CONNECTED
// ============================================================

async function ensureSerialConnected() {

    if (
        serialPort &&
        serialPort.isOpen
    ) {

        return true;
    }


    return await connectSerialRelay();
}


// ============================================================
// SEND SERIAL COMMAND
// ============================================================

async function sendRelayCommand(
    command,
    commandName
) {

    const connected =
        await ensureSerialConnected();


    if (!connected) {

        throw new Error(
            `Relay not connected on ${SERIAL_PORT}`
        );
    }


    return new Promise(
        (resolve, reject) => {

            console.log(
                `[SERIAL] Sending ${commandName}`
            );

            console.log(
                `[SERIAL] Command: ` +
                command
                    .toString("hex")
                    .toUpperCase()
            );


            serialPort.write(
                command,
                (writeError) => {

                    if (writeError) {

                        reject(writeError);

                        return;
                    }


                    serialPort.drain(
                        (drainError) => {

                            if (drainError) {

                                reject(drainError);

                                return;
                            }


                            console.log(
                                `[SERIAL] ${commandName} command sent successfully`
                            );

                            resolve();

                        }
                    );

                }
            );

        }
    );
}


// ============================================================
// START BUZZER
// ============================================================

async function startBuzzer(lineNo) {

    // Do not restart while buzzer is already ON
    if (isBuzzerRunning) {

        console.log(
            `[BUZZER] Already running. ` +
            `New trigger for Line ${lineNo} ignored.`
        );

        return;
    }


    isBuzzerRunning = true;


    console.log("");
    console.log("================================================");
    console.log(
        `[BUZZER] STARTING FOR LINE: ${lineNo}`
    );
    console.log("================================================");


    try {

        // Send ON command
        await sendRelayCommand(
            RELAY_ON_COMMAND,
            "RELAY ON"
        );


        console.log(
            `[BUZZER] ON for ${BUZZER_DURATION / 1000} seconds`
        );


        // Clear old timer if any
        if (buzzerTimer) {

            clearTimeout(
                buzzerTimer
            );

            buzzerTimer = null;
        }


        // Automatically stop after 10 seconds
        buzzerTimer = setTimeout(
            async () => {

                await stopBuzzer();

            },
            BUZZER_DURATION
        );

    } catch (error) {

        console.error(
            `[BUZZER ON ERROR] ${error.message}`
        );

        isBuzzerRunning = false;
    }
}


// ============================================================
// STOP BUZZER
// ============================================================

async function stopBuzzer() {

    // Clear timer
    if (buzzerTimer) {

        clearTimeout(
            buzzerTimer
        );

        buzzerTimer = null;
    }


    console.log("");
    console.log("================================================");
    console.log(
        "[BUZZER] 10 SECONDS COMPLETED"
    );
    console.log(
        "[BUZZER] TURNING OFF..."
    );
    console.log("================================================");


    try {

        // Send OFF command
        await sendRelayCommand(
            RELAY_OFF_COMMAND,
            "RELAY OFF"
        );


        console.log(
            "[BUZZER] OFF SUCCESSFULLY"
        );

    } catch (error) {

        console.error(
            `[BUZZER OFF ERROR] ${error.message}`
        );

    } finally {

        isBuzzerRunning = false;
    }
}


// ============================================================
// PROCESS RECEIVED LINE NUMBER
// ============================================================

async function processBroadcast(
    receivedLineNo
) {

    console.log("");
    console.log("################################################");
    console.log(
        `[TCP] RECEIVED BROADCAST LINE NO: ${receivedLineNo}`
    );
    console.log("################################################");


    try {

        // Read local Excel A1
        const excelLine =
            readLocalExcelLine();


        console.log(
            `[EXCEL] File: ${EXCEL_FILE_PATH}`
        );

        console.log(
            `[EXCEL] Cell ${LINE_CELL}: ${excelLine}`
        );


        // ====================================================
        // COMPARE SERVER LINE WITH EXCEL LINE
        // ====================================================

        const serverLine =
            String(
                receivedLineNo
            ).trim();

        const localLine =
            String(
                excelLine
            ).trim();


        // ====================================================
        // LINE DOES NOT MATCH
        // ====================================================

        if (serverLine !== localLine) {

            console.log("");
            console.log(
                "[CLIENT] LINE NOT MATCHED"
            );

            console.log(
                `[CLIENT] Broadcasted Line: ${serverLine}`
            );

            console.log(
                `[CLIENT] Excel Line      : ${localLine}`
            );

            console.log(
                "[CLIENT] BUZZER WILL REMAIN OFF"
            );

            console.log("");

            return;
        }


        // ====================================================
        // LINE MATCHED
        // ====================================================

        console.log("");
        console.log(
            "[CLIENT] LINE MATCHED SUCCESSFULLY"
        );

        console.log(
            `[CLIENT] Broadcasted Line: ${serverLine}`
        );

        console.log(
            `[CLIENT] Excel Line      : ${localLine}`
        );

        console.log(
            "[CLIENT] STARTING BUZZER..."
        );


        // Start local buzzer
        await startBuzzer(
            receivedLineNo
        );

    } catch (error) {

        console.error("");
        console.error(
            `[CLIENT EXCEL ERROR] ${error.message}`
        );
        console.error(
            "[CLIENT] BUZZER WILL NOT START"
        );
        console.error("");
    }
}


// ============================================================
// PROCESS TCP MESSAGE
// ============================================================
//
// Expected server message:
//
// {"line_no": 1}\n
//
// Server MUST send a newline at the end:
//
// message = json.dumps({
//     "line_no": line_no
// }) + "\\n"
//

async function processTcpMessage(
    message
) {

    const trimmedMessage =
        message.trim();


    // Ignore empty message
    if (!trimmedMessage) {

        return;
    }


    try {

        console.log(
            `[TCP] Raw Message: ${trimmedMessage}`
        );


        // Parse JSON
        const parsed =
            JSON.parse(
                trimmedMessage
            );


        // IMPORTANT:
        // Python server must send:
        // {"line_no": 1}
        const lineNo =
            parsed.line_no;


        // Check line_no exists
        if (
            lineNo === undefined ||
            lineNo === null ||
            String(lineNo).trim() === ""
        ) {

            console.error(
                "[TCP ERROR] line_no missing from server message"
            );

            return;
        }


        // Process received line
        await processBroadcast(
            lineNo
        );

    } catch (error) {

        console.error(
            `[TCP MESSAGE ERROR] ${error.message}`
        );

        console.error(
            `[TCP MESSAGE] Invalid message: ${trimmedMessage}`
        );
    }
}


// ============================================================
// CONNECT TO MAIN TCP SERVER
// ============================================================

function connectToMainServer() {

    // Prevent duplicate connection
    if (
        tcpClient &&
        !tcpClient.destroyed
    ) {

        return;
    }


    console.log("");
    console.log("================================================");
    console.log(
        `[TCP] CONNECTING TO MAIN SERVER`
    );
    console.log(
        `[TCP] Server: ${SERVER_IP}:${SERVER_PORT}`
    );
    console.log("================================================");


    tcpClient =
        new net.Socket();


    // Connect
    tcpClient.connect(
        SERVER_PORT,
        SERVER_IP,
        () => {

            console.log("");
            console.log("================================================");
            console.log(
                "[TCP] CONNECTED TO MAIN SERVER"
            );
            console.log(
                `[TCP] ${SERVER_IP}:${SERVER_PORT}`
            );
            console.log("================================================");

        }
    );


    // ========================================================
    // RECEIVE DATA FROM MAIN SERVER
    // ========================================================

    tcpClient.on(
        "data",
        async (data) => {

            // Add new data to buffer
            receivedBuffer +=
                data.toString(
                    "utf8"
                );


            // Messages are separated by newline
            const messages =
                receivedBuffer.split(
                    "\n"
                );


            // Keep incomplete last message
            receivedBuffer =
                messages.pop();


            // Process all complete messages
            for (
                const message of messages
            ) {

                await processTcpMessage(
                    message
                );

            }

        }
    );


    // ========================================================
    // TCP ERROR
    // ========================================================

    tcpClient.on(
        "error",
        (error) => {

            console.error(
                `[TCP ERROR] ${error.message}`
            );

        }
    );


    // ========================================================
    // TCP CONNECTION CLOSED
    // ========================================================

    tcpClient.on(
        "close",
        () => {

            console.log(
                "[TCP] Disconnected from main server"
            );

            tcpClient = null;

            receivedBuffer = "";

            scheduleTcpReconnect();

        }
    );

}


// ============================================================
// TCP AUTO RECONNECT
// ============================================================

function scheduleTcpReconnect() {

    // Prevent multiple reconnect timers
    if (tcpReconnectTimer) {

        return;
    }


    console.log(
        `[TCP] Reconnecting in ${TCP_RECONNECT_DELAY / 1000} seconds...`
    );


    tcpReconnectTimer =
        setTimeout(
            () => {

                tcpReconnectTimer = null;

                connectToMainServer();

            },
            TCP_RECONNECT_DELAY
        );
}


// ============================================================
// SERIAL AUTO RECONNECT
// ============================================================

function startSerialReconnectCheck() {

    setInterval(
        async () => {

            if (
                !serialPort ||
                !serialPort.isOpen
            ) {

                console.log(
                    "[SERIAL] Relay disconnected. Trying to reconnect..."
                );

                await connectSerialRelay();
            }

        },
        SERIAL_RECONNECT_DELAY
    );
}


// ============================================================
// APPLICATION START
// ============================================================

async function startApplication() {

    console.log("");
    console.log("================================================");
    console.log(
        "BUZZER TCP CLIENT STARTED"
    );
    console.log("================================================");

    console.log(
        `Main Server IP : ${SERVER_IP}`
    );

    console.log(
        `Main Server Port : ${SERVER_PORT}`
    );

    console.log(
        `Serial Port : ${SERIAL_PORT}`
    );

    console.log(
        `Baud Rate : ${BAUD_RATE}`
    );

    console.log(
        `Excel File : ${EXCEL_FILE_PATH}`
    );

    console.log(
        `Excel Sheet : ${SHEET_NAME}`
    );

    console.log(
        `Excel Line Cell : ${LINE_CELL}`
    );

    console.log(
        `Buzzer Duration : ${BUZZER_DURATION / 1000} seconds`
    );

    console.log("================================================");


    // ========================================================
    // CONNECT SERIAL RELAY
    // ========================================================

    const serialConnected =
        await connectSerialRelay();


    if (serialConnected) {

        // Safety:
        // Make sure buzzer is OFF when program starts.
        try {

            console.log(
                "[STARTUP] Sending RELAY OFF command..."
            );

            await sendRelayCommand(
                RELAY_OFF_COMMAND,
                "RELAY OFF (STARTUP)"
            );

        } catch (error) {

            console.error(
                `[STARTUP ERROR] ${error.message}`
            );
        }

    } else {

        console.log(
            "[STARTUP] Serial relay not connected. Auto reconnect enabled."
        );
    }


    // ========================================================
    // START SERIAL AUTO RECONNECT
    // ========================================================

    startSerialReconnectCheck();


    // ========================================================
    // CONNECT TO MAIN TCP SERVER
    // ========================================================

    connectToMainServer();
}


// ============================================================
// SAFE SHUTDOWN
// ============================================================

async function shutdown(
    signal
) {

    console.log("");
    console.log(
        `[SYSTEM] ${signal} received`
    );

    console.log(
        "[SYSTEM] Shutting down buzzer client..."
    );


    // Stop buzzer
    if (buzzerTimer) {

        clearTimeout(
            buzzerTimer
        );

        buzzerTimer = null;
    }


    // Turn relay OFF before closing
    try {

        if (
            serialPort &&
            serialPort.isOpen
        ) {

            await sendRelayCommand(
                RELAY_OFF_COMMAND,
                "RELAY OFF (SHUTDOWN)"
            );
        }

    } catch (error) {

        console.error(
            `[SHUTDOWN ERROR] ${error.message}`
        );
    }


    // Close TCP
    if (
        tcpClient &&
        !tcpClient.destroyed
    ) {

        tcpClient.destroy();
    }


    // Close serial port
    if (
        serialPort &&
        serialPort.isOpen
    ) {

        await new Promise(
            (resolve) => {

                serialPort.close(
                    () => resolve()
                );

            }
        );
    }


    console.log(
        "[SYSTEM] Client stopped."
    );

    process.exit(0);
}


// ============================================================
// SHUTDOWN EVENTS
// ============================================================

process.on(
    "SIGINT",
    () => shutdown("CTRL+C / SIGINT")
);

process.on(
    "SIGTERM",
    () => shutdown("SIGTERM")
);


// ============================================================
// START CLIENT
// ============================================================

startApplication();
