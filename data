// ============================================================
// PROCESS PACK
// ============================================================

app.post(
    "/api/process-pack",
    async (req, res) => {

        try {

            const {
                packNo,
                packId
            } = req.body;


            // ====================================================
            // VALIDATE PACK NO
            // ====================================================

            if (!packNo) {

                return res.status(400).json({

                    success: false,

                    message:
                        "Pack No is required."

                });

            }


            if (
                !/^\d{6}$/.test(
                    String(packNo)
                )
            ) {

                return res.status(400).json({

                    success: false,

                    message:
                        "Pack No must contain exactly 6 digits."

                });

            }


            // ====================================================
            // VALIDATE PACK ID
            // ====================================================

            if (!packId) {

                return res.status(400).json({

                    success: false,

                    message:
                        "Pack ID is required."

                });

            }


            console.log("");
            console.log(
                "============================================"
            );

            console.log(
                "PROCESSING PACK"
            );

            console.log(
                "Pack No :",
                packNo
            );

            console.log(
                "Pack ID :",
                packId
            );

            console.log(
                "============================================"
            );


            // ====================================================
            // STEP 1
            // GET LINE_ID + PACK CREATION DATE
            // ====================================================

            const cellPool =
                await getCellScanningPool();


            const duplicateResult =
                await cellPool
                    .request()

                    .input(
                        "PackNo",
                        sql.VarChar,
                        String(packNo)
                    )

                    .input(
                        "PackID",
                        sql.VarChar,
                        String(packId)
                    )

                    .query(`

                        SELECT
                            Line_Id,
                            pack_creation_Date

                        FROM Pack_duplicate_checker

                        WHERE Pack_No = @PackNo

                        AND Pack_ID = @PackID

                    `);


            if (
                duplicateResult.recordset.length === 0
            ) {

                return res.status(404).json({

                    success: false,

                    message:
                        "No record found in Pack_duplicate_checker for the given Pack No and Pack ID."

                });

            }


            // ====================================================
            // TAKE FIRST MATCHING RECORD
            // ====================================================

            const duplicateRecord =
                duplicateResult.recordset[0];


            const lineId =
                duplicateRecord.Line_Id;


            // ====================================================
            // STEP 2
            // EXTRACT PACK CREATION DATE
            // ====================================================

            const rawCreationDate =
                duplicateRecord.pack_creation_Date;


            let packCreationDate;


            if (
                rawCreationDate instanceof Date
            ) {

                const year =
                    rawCreationDate
                        .getFullYear();


                const month =
                    String(
                        rawCreationDate.getMonth() + 1
                    ).padStart(2, "0");


                const day =
                    String(
                        rawCreationDate.getDate()
                    ).padStart(2, "0");


                packCreationDate =
                    `${year}_${month}_${day}`;

            } else {

                const dateString =
                    String(
                        rawCreationDate
                    );


                const match =
                    dateString.match(
                        /(\d{4})[-_](\d{2})[-_](\d{2})/
                    );


                if (!match) {

                    throw new Error(
                        "Unable to extract pack_creation_Date."
                    );

                }


                packCreationDate =
                    `${match[1]}_${match[2]}_${match[3]}`;

            }


            console.log(
                "Line ID:",
                lineId
            );


            console.log(
                "Pack Creation Date:",
                packCreationDate
            );


            // ====================================================
            // STEP 3
            // GET LINE NO FROM MASTER_LINE
            // ====================================================

            const masterPool =
                await getMasterPool();


            const lineResult =
                await masterPool
                    .request()

                    .input(
                        "LineId",
                        sql.VarChar,
                        String(lineId)
                    )

                    .query(`

                        SELECT
                            line_no

                        FROM taco_treceability.master_line

                        WHERE Srno = @LineId

                    `);


            if (
                lineResult.recordset.length === 0
            ) {

                return res.status(404).json({

                    success: false,

                    message:
                        `No line found for Line_Id ${lineId}.`

                });

            }


            const lineNo =
                lineResult.recordset[0].line_no;


            const finalLineNo =
                lineNo == null
                    ? ""
                    : String(lineNo).trim();


            if (!finalLineNo) {

                return res.status(404).json({

                    success: false,

                    message:
                        `Line No is empty for Line_Id ${lineId}.`

                });

            }


            console.log(
                "Line No:",
                finalLineNo
            );


            // ====================================================
            // STEP 4
            // FIND HISTORY TABLES
            // ====================================================

            const historyPool =
                await getCompletedHistoryPool();


            const tableResult =
                await historyPool
                    .request()

                    .input(
                        "CreationDate",
                        sql.VarChar,
                        packCreationDate
                    )

                    .query(`

                        SELECT
                            TABLE_NAME

                        FROM INFORMATION_SCHEMA.TABLES

                        WHERE TABLE_TYPE = 'BASE TABLE'

                        AND TABLE_NAME LIKE
                            'pack_history_' +
                            @CreationDate +
                            '_%'

                    `);


            let historyTables =
                tableResult.recordset
                    .map(
                        row => row.TABLE_NAME
                    );


            // ====================================================
            // VALIDATE HISTORY TABLE NAMES
            // ====================================================

            historyTables =
                historyTables.filter(
                    tableName => {

                        const parts =
                            tableName.split("_");


                        if (
                            parts.length < 8
                        ) {

                            return false;

                        }


                        const dateAtPosition2 =
                            `${parts[2]}_${parts[3]}_${parts[4]}`;


                        return (
                            dateAtPosition2 ===
                            packCreationDate
                        );

                    }
                );


            console.log(
                "History Tables:"
            );


            historyTables.forEach(
                tableName => {

                    console.log(
                        tableName
                    );

                }
            );


            if (
                historyTables.length === 0
            ) {

                return res.status(404).json({

                    success: false,

                    message:
                        `No pack history table found for ${packCreationDate}.`

                });

            }


            // ====================================================
            // STEP 5
            // SEARCH ALL HISTORY TABLES
            // ====================================================

            const allRecords = [];


            for (
                const tableName of historyTables
            ) {

                // ------------------------------------------------
                // Validate table name
                // ------------------------------------------------

                if (
                    !/^pack_history_\d{4}_\d{2}_\d{2}_\d{4}_\d{2}_\d{2}$/
                        .test(tableName)
                ) {

                    console.log(
                        "Skipping invalid table:",
                        tableName
                    );

                    continue;

                }


                // =================================================
                // YOUR SHORT QUERY
                // =================================================

                const query = `

                    SELECT
                        pack_name,
                        pack_id,
                        line_id,
                        pack_no,
                        module_barcode

                    FROM [${tableName}]

                    WHERE line_id = @LineID

                    AND pack_no = @PackNo

                    ORDER BY sr_no

                `;


                console.log("");
                console.log(
                    "Searching Table:",
                    tableName
                );


                console.log(
                    "Line ID:",
                    lineId
                );


                console.log(
                    "Pack No:",
                    packNo
                );


                // =================================================
                // EXECUTE QUERY
                // =================================================

                const result =
                    await historyPool
                        .request()

                        .input(
                            "LineID",
                            sql.VarChar,
                            String(lineId)
                        )

                        .input(
                            "PackNo",
                            sql.VarChar,
                            String(packNo)
                        )

                        .query(query);


                console.log(
                    "Records Found:",
                    result.recordset.length
                );


                // =================================================
                // PROCESS RECORDS
                // =================================================

                for (
                    const row of result.recordset
                ) {

                    // ---------------------------------------------
                    // ORIGINAL MODULE BARCODE
                    // ---------------------------------------------

                    const moduleBarcode =
                        row.module_barcode == null
                            ? ""
                            : String(
                                row.module_barcode
                            ).trim();


                    // ---------------------------------------------
                    // REPLACE NONE WITH LINE NO
                    // ---------------------------------------------

                    const modifiedBarcode =
                        moduleBarcode.replaceAll(
                            "None",
                            finalLineNo
                        );


                    // ---------------------------------------------
                    // DEBUG
                    // ---------------------------------------------

                    console.log(
                        "--------------------------------------------"
                    );

                    console.log(
                        "Table:",
                        tableName
                    );

                    console.log(
                        "Line ID:",
                        lineId
                    );

                    console.log(
                        "Line No:",
                        finalLineNo
                    );

                    console.log(
                        "Pack No:",
                        packNo
                    );

                    console.log(
                        "Original Barcode:",
                        moduleBarcode
                    );

                    console.log(
                        "Modified Barcode:",
                        modifiedBarcode
                    );

                    console.log(
                        "--------------------------------------------"
                    );


                    // ---------------------------------------------
                    // STORE RESULT
                    // ---------------------------------------------

                    allRecords.push({

                        tableName,

                        packName:
                            row.pack_name,

                        packId:
                            row.pack_id,

                        lineId:
                            row.line_id,

                        packNo:
                            row.pack_no,

                        moduleBarcode,

                        modifiedBarcode

                    });

                }

            }


            // ====================================================
            // COUNT REPLACED RECORDS
            // ====================================================

            const replacedCount =
                allRecords.filter(
                    record =>
                        record.moduleBarcode !==
                        record.modifiedBarcode
                ).length;


            // ====================================================
            // FINAL RESPONSE
            // ====================================================

            console.log("");
            console.log(
                "============================================"
            );

            console.log(
                "Total Records:",
                allRecords.length
            );

            console.log(
                "None Replaced:",
                replacedCount
            );

            console.log(
                "============================================"
            );


            res.json({

                success: true,

                message:
                    allRecords.length > 0

                        ? `${allRecords.length} module barcode record(s) found. ${replacedCount} barcode(s) contained "None".`

                        : "No matching module barcode records found.",

                packNo,

                packId,

                lineId,

                lineNo:
                    finalLineNo,

                packCreationDate,

                historyTables,

                records:
                    allRecords

            });


        } catch (error) {

            console.error("");
            console.error(
                "============================================"
            );

            console.error(
                "PROCESS PACK ERROR"
            );

            console.error(
                error
            );

            console.error(
                "============================================"
            );


            res.status(500).json({

                success: false,

                message:
                    "Error while processing pack.",

                error:
                    error.message

            });

        }

    }
);


