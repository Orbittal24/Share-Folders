# ============================================================
# ENSURE TABLE
# ============================================================

def ensure_table(dst_cursor, tableName):

    dst_cursor.execute(f"""
    IF NOT EXISTS (
        SELECT 1
        FROM INFORMATION_SCHEMA.TABLES
        WHERE TABLE_NAME = '{tableName}'
    )
    BEGIN

        CREATE TABLE {tableName} (
            sr_no INT IDENTITY(1,1) PRIMARY KEY,
            cellqr NVARCHAR(50),
            voltage NVARCHAR(50),
            ir NVARCHAR(50),
            class_grade NVARCHAR(30),
            capacity NVARCHAR(50),
            thickness NVARCHAR(50),
            k_value NVARCHAR(50),
            negative_voltage NVARCHAR(50),
            cell_status NVARCHAR(20),
            ocv_mc_no NVARCHAR(40),
            first_para_time DATETIME,
            last_para_time DATETIME,
            laser_status VARCHAR(50),
            batch VARCHAR(100),
            plant_code VARCHAR(50)
        )

    END
    """)


# ============================================================
# MOVE TO REJECTION
# ============================================================

def move_to_rejection(src_conn, row):

    cursor = None

    try:

        cursor = src_conn.cursor()

        print(
            "INSERTING INTO REJECTION :",
            row.cell_qrcode
        )

        cursor.execute("""
        INSERT INTO taco_treceability.ocv_machine_data_mirror_rejection
        (
            cell_qrcode,
            voltage,
            ir,
            today_date,
            updated_time,
            machine_location,
            shift,
            used_on_line,
            kvalue,
            grade,
            cell_capacity,
            cell_class
        )
        VALUES (?,?,?,?,?,?,?,?,?,?,?,?)
        """,
        (
            row.cell_qrcode,
            row.voltage,
            row.ir,
            row.today_date,
            row.updated_time,
            row.machine_location,
            row.shift,
            row.used_on_line,
            row.kvalue,
            row.grade,
            row.cell_capacity,
            row.cell_class
        ))

        # ====================================================
        # ACKNOWLEDGEMENT
        # ====================================================
        #
        # Commit means rejection insertion succeeded.
        # Only after this succeeds will mirror be deleted.
        #

        src_conn.commit()

        print(
            "REJECTION ACKNOWLEDGED :",
            row.cell_qrcode
        )

        return True

    except Exception as e:

        print(
            "REJECTION INSERT FAILED :",
            e
        )

        try:

            src_conn.rollback()

        except Exception as rollback_error:

            print(
                "REJECTION ROLLBACK FAILED :",
                rollback_error
            )

        return False

    finally:

        try:

            if cursor:
                cursor.close()

        except Exception:
            pass


# ============================================================
# HANDLE FAILURE
# ============================================================

def handle_failure(src_conn, row):

    qr = safe(
        row.cell_qrcode
    )

    print(
        "FAILURE HANDLER STARTED :",
        qr
    )

    # ========================================================
    # INSERT INTO REJECTION
    # ========================================================

    rejection_success = move_to_rejection(
        src_conn,
        row
    )

    # ========================================================
    # ONLY DELETE AFTER ACKNOWLEDGEMENT
    # ========================================================

    if rejection_success:

        cursor = None

        try:

            cursor = src_conn.cursor()

            cursor.execute("""
            DELETE FROM taco_treceability.ocv_machine_data_mirror
            WHERE cell_qrcode=?
            """, qr)

            src_conn.commit()

            print(
                "SOURCE DELETED AFTER REJECTION ACK :",
                qr
            )

            return True

        except Exception as delete_error:

            print(
                "DELETE AFTER REJECTION FAILED :",
                delete_error
            )

            try:

                src_conn.rollback()

            except Exception as rollback_error:

                print(
                    "DELETE ROLLBACK FAILED :",
                    rollback_error
                )

            return False

        finally:

            try:

                if cursor:
                    cursor.close()

            except Exception:
                pass

    else:

        print(
            "REJECTION NOT ACKNOWLEDGED - SOURCE KEPT :",
            qr
        )

        return False


