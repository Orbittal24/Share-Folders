<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <title>Update Password</title>

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    >


    <style>

        * {
            box-sizing: border-box;
        }


        body {

            margin: 0;

            background: #f4f6f9;

            font-family: Arial, sans-serif;

        }


        .card {

            background: #ffffff;

            width: 500px;

            max-width: 90%;

            margin: 80px auto;

            padding: 35px;

            border-radius: 12px;

            box-shadow:
                0 6px 20px rgba(0, 0, 0, 0.15);

        }


        h2 {

            text-align: center;

            color: #2e7d32;

            margin-top: 0;

            margin-bottom: 30px;

        }


        .group {

            display: flex;

            flex-direction: column;

            margin-bottom: 22px;

        }


        label {

            font-size: 15px;

            font-weight: bold;

            margin-bottom: 8px;

        }


        select,
        input {

            width: 100%;

            height: 45px;

            padding: 8px 12px;

            font-size: 16px;

            border: 1px solid #ccc;

            border-radius: 6px;

            outline: none;

        }


        select:focus,
        input:focus {

            border-color: #28a745;

        }


        .button-row {

            text-align: center;

            margin-top: 30px;

        }


        button {

            width: 180px;

            height: 45px;

            border: none;

            border-radius: 6px;

            background: #28a745;

            color: #ffffff;

            font-size: 16px;

            font-weight: bold;

            cursor: pointer;

        }


        button:hover {

            background: #218838;

        }


        button:disabled {

            background: #999;

            cursor: not-allowed;

        }


        .message {

            display: none;

            margin-top: 20px;

            padding: 12px;

            border-radius: 6px;

            text-align: center;

            font-weight: bold;

        }


        .success {

            background: #d4edda;

            color: #155724;

        }


        .error {

            background: #f8d7da;

            color: #721c24;

        }


        .loading {

            text-align: center;

            color: #666;

            margin-top: 10px;

        }

    </style>

</head>


<body>


    <!-- =====================================================
         MAIN CARD
         ===================================================== -->

    <div class="card">


        <h2>
            Update User Password
        </h2>


        <!-- =================================================
             USERNAME
             ================================================= -->

        <div class="group">

            <label for="username">

                Select Name :

            </label>


            <select id="username">

                <option value="">

                    Loading users...

                </option>

            </select>

        </div>


        <!-- =================================================
             NEW PASSWORD
             ================================================= -->

        <div class="group">

            <label for="newPassword">

                New Password :

            </label>


            <input
                type="password"
                id="newPassword"
                placeholder="Enter New Password"
                autocomplete="new-password"
            >

        </div>


        <!-- =================================================
             CONFIRM PASSWORD
             ================================================= -->

        <div class="group">

            <label for="confirmPassword">

                Confirm New Password :

            </label>


            <input
                type="password"
                id="confirmPassword"
                placeholder="Re-enter New Password"
                autocomplete="new-password"
            >

        </div>


        <!-- =================================================
             SUBMIT
             ================================================= -->

        <div class="button-row">

            <button
                id="submitButton"
                onclick="updatePassword()"
            >

                Update Password

            </button>

        </div>


        <!-- =================================================
             MESSAGE
             ================================================= -->

        <div
            id="message"
            class="message"
        ></div>


        <div
            id="loading"
            class="loading"
        ></div>


    </div>



    <script>


        /********************************************************
         * LOAD USERS
         ********************************************************/

        loadUsers();


        function loadUsers() {


            const usernameSelect =
                document.getElementById(
                    "username"
                );


            const loading =
                document.getElementById(
                    "loading"
                );


            loading.innerText =
                "Loading users...";


            fetch(
                "/api/password-users"
            )

            .then(
                async response => {

                    const data =
                        await response.json();


                    if (!response.ok) {

                        throw new Error(
                            data.message ||
                            "Failed to load users"
                        );

                    }


                    return data;

                }
            )

            .then(
                data => {


                    usernameSelect.innerHTML =
                        "";


                    /****************************************
                     * DEFAULT OPTION
                     ****************************************/

                    const defaultOption =
                        document.createElement(
                            "option"
                        );


                    defaultOption.value =
                        "";


                    defaultOption.textContent =
                        "Select Name";


                    usernameSelect.appendChild(
                        defaultOption
                    );


                    /****************************************
                     * ADD USERS
                     ****************************************/

                    data.data.forEach(
                        user => {

                            const option =
                                document.createElement(
                                    "option"
                                );


                            option.value =
                                user.username;


                            option.textContent =
                                user.username;


                            usernameSelect
                                .appendChild(
                                    option
                                );

                        }
                    );


                    loading.innerText =
                        "";

                }
            )

            .catch(
                error => {

                    console.error(
                        "Load users error:",
                        error
                    );


                    usernameSelect.innerHTML =
                        `
                        <option value="">
                            Failed to load users
                        </option>
                        `;


                    loading.innerText =
                        "";


                    showMessage(
                        error.message ||
                        "Failed to load users",
                        false
                    );

                }
            );

        }



        /********************************************************
         * UPDATE PASSWORD
         ********************************************************/

        function updatePassword() {


            const username =
                document
                    .getElementById(
                        "username"
                    )
                    .value;


            const newPassword =
                document
                    .getElementById(
                        "newPassword"
                    )
                    .value
                    .trim();


            const confirmPassword =
                document
                    .getElementById(
                        "confirmPassword"
                    )
                    .value
                    .trim();


            const submitButton =
                document
                    .getElementById(
                        "submitButton"
                    );


            /****************************************************
             * VALIDATE USERNAME
             ****************************************************/

            if (!username) {

                showMessage(
                    "Please select a name",
                    false
                );

                return;

            }


            /****************************************************
             * VALIDATE NEW PASSWORD
             ****************************************************/

            if (!newPassword) {

                showMessage(
                    "Please enter new password",
                    false
                );

                return;

            }


            /****************************************************
             * VALIDATE CONFIRM PASSWORD
             ****************************************************/

            if (!confirmPassword) {

                showMessage(
                    "Please confirm new password",
                    false
                );

                return;

            }


            /****************************************************
             * CHECK PASSWORD MATCH
             ****************************************************/

            if (
                newPassword !==
                confirmPassword
            ) {

                showMessage(
                    "New password and confirm password do not match",
                    false
                );

                return;

            }


            /****************************************************
             * DISABLE BUTTON
             ****************************************************/

            submitButton.disabled =
                true;


            submitButton.innerText =
                "Updating...";


            /****************************************************
             * CLEAR OLD MESSAGE
             ****************************************************/

            hideMessage();


            /****************************************************
             * SEND UPDATE REQUEST
             ****************************************************/

            fetch(
                "/api/update-password",
                {

                    method: "POST",

                    headers: {

                        "Content-Type":
                            "application/json"

                    },

                    body:
                        JSON.stringify({

                            username:
                                username,

                            newPassword:
                                newPassword

                        })

                }
            )

            .then(
                async response => {

                    const data =
                        await response.json();


                    if (!response.ok) {

                        throw new Error(
                            data.message ||
                            "Password update failed"
                        );

                    }


                    return data;

                }
            )

            .then(
                data => {


                    /****************************************
                     * SUCCESS
                     ****************************************/

                    showMessage(
                        "Password updated successfully for " +
                        data.username,
                        true
                    );


                    /****************************************
                     * CLEAR PASSWORD FIELDS
                     ****************************************/

                    document
                        .getElementById(
                            "newPassword"
                        )
                        .value =
                        "";


                    document
                        .getElementById(
                            "confirmPassword"
                        )
                        .value =
                        "";


                    /****************************************
                     * SHOW UPDATED TIME
                     ****************************************/

                    if (
                        data.today_date
                    ) {

                        const timeText =
                            new Date(
                                data.today_date
                            ).toLocaleString();


                        showMessage(
                            "Password updated successfully for " +
                            data.username +
                            "\nUpdated on: " +
                            timeText,
                            true
                        );

                    }

                }
            )

            .catch(
                error => {

                    console.error(
                        "Password update error:",
                        error
                    );


                    showMessage(
                        error.message ||
                        "Password update failed",
                        false
                    );

                }
            )

            .finally(
                () => {

                    /****************************************
                     * ENABLE BUTTON
                     ****************************************/

                    submitButton.disabled =
                        false;


                    submitButton.innerText =
                        "Update Password";

                }
            );

        }



        /********************************************************
         * SHOW MESSAGE
         ********************************************************/

        function showMessage(
            message,
            success
        ) {


            const messageBox =
                document.getElementById(
                    "message"
                );


            messageBox.innerText =
                message;


            messageBox.style.whiteSpace =
                "pre-line";


            messageBox.className =
                "message " +
                (
                    success
                        ? "success"
                        : "error"
                );


            messageBox.style.display =
                "block";

        }



        /********************************************************
         * HIDE MESSAGE
         ********************************************************/

        function hideMessage() {

            const messageBox =
                document.getElementById(
                    "message"
                );


            messageBox.style.display =
                "none";

        }

    </script>


</body>

</html>
