
const net = require("net");

// ============================================================
// TCP SERVER CONFIGURATION
// ============================================================

const HOST = "0.0.0.0";
const PORT = 7287;

// ============================================================
// CONNECTED TCP CLIENTS
// ============================================================

const connectedClients = new Set();

// ============================================================
// SERVER
// ============================================================

const server = net.createServer((socket) => {
    const clientAddress =
        `${socket.remoteAddress}:${socket.remotePort}`;

    console.log("");
    console.log("==========================================");
    console.log("NEW TCP CONNECTION");
    console.log("==========================================");
    console.log(`Client : ${clientAddress}`);
    console.log(`Clients connected : ${connectedClients.size + 1}`);
    console.log("==========================================");

    connectedClients.add(socket);

    // Prevent idle connections from being closed automatically.
    socket.setKeepAlive(true, 10000);
    socket.setNoDelay(true);

    // Preserve incomplete messages between TCP data events.
    let receiveBuffer = "";

    // ========================================================
    // RECEIVE DATA
    // ========================================================

    socket.on("data", (data) => {
        receiveBuffer += data.toString("utf8");

        // Process only complete newline-terminated messages.
        let newlineIndex;

        while ((newlineIndex = receiveBuffer.indexOf("\n")) !== -1) {
            const message = receiveBuffer
                .slice(0, newlineIndex)
                .trim();

            receiveBuffer = receiveBuffer.slice(newlineIndex + 1);

            if (!message) {
                continue;
            }

            processMessage(socket, message);
        }

        // Avoid unlimited memory use for malformed input.
        if (receiveBuffer.length > 1024 * 1024) {
            console.log("ERROR: Incoming message exceeded 1 MB.");
            socket.destroy();
        }
    });

    // ========================================================
    // CLIENT DISCONNECTED
    // ========================================================

    socket.on("close", () => {
        connectedClients.delete(socket);

        console.log("");
        console.log("==========================================");
        console.log("TCP CLIENT DISCONNECTED");
        console.log("==========================================");
        console.log(`Client : ${clientAddress}`);
        console.log(`Remaining clients : ${connectedClients.size}`);
        console.log("==========================================");
    });

    // ========================================================
    // CLIENT ERROR
    // ========================================================

    socket.on("error", (error) => {
        console.log("");
        console.log("TCP CLIENT ERROR");
        console.log(`Client : ${clientAddress}`);
        console.log(`Error  : ${error.message}`);
        console.log("");
    });
});

// ============================================================
// PROCESS MESSAGE AND BROADCAST
// ============================================================

function processMessage(sender, rawMessage) {
    let payload;

    try {
        payload = JSON.parse(rawMessage);
    } catch (error) {
        sendAcknowledgement(sender, {
            status: "error",
            message: "Invalid JSON"
        });

        console.log("Invalid JSON received:", rawMessage);
        return;
    }

    const lineNo = String(payload.line_no ?? "").trim();
    const cellQr = String(payload.cellqr ?? "").trim();

    if (!lineNo) {
        sendAcknowledgement(sender, {
            status: "error",
            message: "line_no is required"
        });

        console.log("Rejected message: line_no is missing.");
        return;
    }

    // Keep the existing buzzer-client message format.
    const broadcastMessage = JSON.stringify({
        line_no: lineNo,
        cellqr: cellQr
    }) + "\n";

    console.log("");
    console.log("==========================================");
    console.log("BUZZER EVENT RECEIVED");
    console.log("==========================================");
    console.log(`Line   : ${lineNo}`);
    console.log(`CellQR : ${cellQr}`);
    console.log(`Clients currently connected: ${connectedClients.size}`);
    console.log("==========================================");

    let successCount = 0;
    let failureCount = 0;

    // ========================================================
    // BROADCAST TO ALL CONNECTED CLIENTS
    // ========================================================

    for (const client of connectedClients) {
        // Do not send the broadcast back to the sending socket.
        // The sender receives an acknowledgement instead.
        if (client === sender) {
            continue;
        }

        if (client.destroyed || !client.writable) {
            connectedClients.delete(client);
            continue;
        }

        try {
            client.write(broadcastMessage, (error) => {
                if (error) {
                    console.log(
                        `Broadcast write error: ${error.message}`
                    );
                }
            });

            successCount++;
        } catch (error) {
            failureCount++;

            console.log(
                `Broadcast failed: ${error.message}`
            );
        }
    }

    console.log("");
    console.log("==========================================");
    console.log("BUZZER BROADCAST COMPLETED");
    console.log("==========================================");
    console.log(`Line             : ${lineNo}`);
    console.log(`CellQR           : ${cellQr}`);
    console.log(`Clients sent to  : ${successCount}`);
    console.log(`Write failures   : ${failureCount}`);
    console.log("==========================================");
    console.log("");

    // Acknowledge the FastAPI sender.
    sendAcknowledgement(sender, {
        status: "success",
        line_no: lineNo,
        cellqr: cellQr,
        clients_sent: successCount,
        message: "Broadcast completed"
    });
}

// ============================================================
// SEND ACKNOWLEDGEMENT TO SENDER
// ============================================================

function sendAcknowledgement(socket, response) {
    if (socket.destroyed || !socket.writable) {
        return;
    }

    socket.write(JSON.stringify(response) + "\n");
}

// ============================================================
// SERVER ERROR
// ============================================================

server.on("error", (error) => {
    console.log("");
    console.log("==========================================");
    console.log("TCP SERVER ERROR");
    console.log("==========================================");
    console.log(`Error : ${error.message}`);
    console.log("==========================================");

    if (error.code === "EADDRINUSE") {
        console.log(`Port ${PORT} is already in use.`);
    }

    if (error.code === "EADDRNOTAVAIL") {
        console.log(`Check whether the server IP is available.`);
    }
});

// ============================================================
// START SERVER
// ============================================================

server.listen(PORT, HOST, () => {
    console.log("");
    console.log("================================================");
    console.log("BUZZER TCP SERVER STARTED");
    console.log("================================================");
    console.log(`Bind address : ${HOST}`);
    console.log(`Port         : ${PORT}`);
    console.log(`Client IP    : 10.9.4.28:${PORT}`);
    console.log("Status       : Listening for connections");
    console.log("Mode         : Multiple TCP clients");
    console.log("================================================");
    console.log("");
});

// ============================================================
// GRACEFUL SHUTDOWN
// ============================================================

function shutdown() {
    console.log("\nStopping buzzer TCP server...");

    for (const client of connectedClients) {
        client.destroy();
    }

    connectedClients.clear();

    server.close(() => {
        console.log("Buzzer TCP server stopped.");
        process.exit(0);
    });
}

process.on("SIGINT", shutdown);
process.on("SIGTERM", shutdown);
