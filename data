import csv
import json
import time
from datetime import datetime
import redis

r = redis.StrictRedis(
    host="localhost",
    port=6379,
    password="Gotion@123Strong!",
    db=31,
    decode_responses=True
)

TARGET_PREFIX = "2026-09-20"    # "2026-01" = all of Jan 2026, "2026-01-15" = one day
SCAN_COUNT = 5000

DRY_RUN = False                  # True = only list, False = actually delete
PRINT_EACH = True                # print every cellqr to console


print("Redis version:", r.info("server")["redis_version"])

mode = "dryrun" if DRY_RUN else "deleted"

csv_file = (
    f"cells_{TARGET_PREFIX}_{mode}_"
    f"{datetime.now():%Y%m%d_%H%M%S}.csv"
)

cursor = 0
scanned = 0
matched = 0
skipped = 0
csv_rows = 0

# ---------------------------------------------------------
# First pass:
# We need to discover ALL fields present in matching Redis
# records so that the CSV contains every Redis field.
# ---------------------------------------------------------

print("\nScanning Redis and collecting complete records...\n")

all_records = []

while True:

    cursor, keys = r.scan(
        cursor=cursor,
        match="cell:*",
        count=SCAN_COUNT
    )

    if keys:

        values = r.mget(keys)

        for key, raw in zip(keys, values):

            scanned += 1

            if not raw:
                continue

            try:
                data = json.loads(raw)

            except (json.JSONDecodeError, TypeError):
                skipped += 1
                continue

            if not isinstance(data, dict):
                skipped += 1
                continue

            fpt = str(
                data.get("first_para_time") or ""
            ).strip()

            if fpt.startswith(TARGET_PREFIX):

                # -------------------------------------------------
                # Store COMPLETE Redis record
                # -------------------------------------------------

                record = {
                    "redis_key": key,
                    **data
                }

                all_records.append(record)

                if PRINT_EACH:

                    cellqr = data.get("cellqr", "")

                    print(
                        f"  {'[DRY RUN]' if DRY_RUN else '[DELETE]'} "
                        f"{cellqr} "
                        f"first_para_time={fpt}"
                    )

    if cursor == 0:
        break

    time.sleep(0.05)


# ---------------------------------------------------------
# Nothing matched
# ---------------------------------------------------------

if not all_records:

    print("\nNo matching Redis records found.")
    print(f"Total cell keys scanned: {scanned}")
    print(f"Non-JSON keys skipped  : {skipped}")
    exit(0)


# ---------------------------------------------------------
# Build complete CSV header
#
# Different Redis records may contain different fields.
# Therefore collect the UNION of every field.
# ---------------------------------------------------------

csv_fields = []

csv_fields.append("redis_key")

for record in all_records:

    for field in record.keys():

        if field not in csv_fields:
            csv_fields.append(field)


# ---------------------------------------------------------
# Write COMPLETE Redis records to CSV
# ---------------------------------------------------------

print("\nWriting complete Redis records to CSV...")

with open(
    csv_file,
    "w",
    newline="",
    encoding="utf-8-sig"
) as f:

    writer = csv.DictWriter(
        f,
        fieldnames=csv_fields,
        extrasaction="ignore"
    )

    writer.writeheader()

    for record in all_records:

        # -------------------------------------------------
        # Convert nested values to JSON strings so that
        # nothing is lost in the CSV.
        # -------------------------------------------------

        csv_record = {}

        for field in csv_fields:

            value = record.get(field, "")

            if isinstance(value, (dict, list)):
                value = json.dumps(
                    value,
                    ensure_ascii=False
                )

            elif value is None:
                value = ""

            csv_record[field] = value

        writer.writerow(csv_record)

        csv_rows += 1

    # Make sure everything is physically written
    f.flush()


# ---------------------------------------------------------
# CSV successfully saved.
#
# ONLY AFTER CSV IS COMPLETELY WRITTEN,
# perform Redis deletion.
# ---------------------------------------------------------

print("\nCSV successfully created.")
print(f"CSV rows written : {csv_rows}")
print(f"CSV columns      : {len(csv_fields)}")
print(f"CSV file         : {csv_file}")


# ---------------------------------------------------------
# DELETE REDIS RECORDS
# ---------------------------------------------------------

if not DRY_RUN:

    print("\nDeleting matching Redis records...")

    delete_keys = [
        record["redis_key"]
        for record in all_records
    ]

    # Delete in batches to avoid a huge DEL command
    DELETE_BATCH_SIZE = 1000

    for i in range(
        0,
        len(delete_keys),
        DELETE_BATCH_SIZE
    ):

        batch = delete_keys[
            i:i + DELETE_BATCH_SIZE
        ]

        deleted_now = r.delete(*batch)

        matched += deleted_now

        print(
            f"Deleted {deleted_now} keys "
            f"({min(i + DELETE_BATCH_SIZE, len(delete_keys))}"
            f"/{len(delete_keys)})"
        )

else:

    matched = len(all_records)


# ---------------------------------------------------------
# FINAL SUMMARY
# ---------------------------------------------------------

print("\n========================================")
print("Completed.")
print("========================================")

print(
    f"Mode                   : "
    f"{'DRY RUN (nothing deleted)' if DRY_RUN else 'DELETED'}"
)

print(
    f"Target                 : "
    f"first_para_time starting with {TARGET_PREFIX}"
)

print(
    f"Total cell keys scanned: {scanned}"
)

print(
    f"Total matching records : {len(all_records)}"
)

print(
    f"Total CSV rows saved   : {csv_rows}"
)

print(
    f"Total {'would delete' if DRY_RUN else 'deleted'} "
    f"         : {matched}"
)

print(
    f"Non-JSON keys skipped  : {skipped}"
)

print(
    f"CSV columns saved      : {len(csv_fields)}"
)

print(
    f"Cell data saved to     : {csv_file}"
)

print("========================================")
