const net = require("net");

const HOST = "10.9.4.28";
const PORT = 7280;

let client = null;
let reconnectTimer = null;


// ============================================================
// CONNECT TO TCP SERVER
// ============================================================

function connectToServer() {

    console.log("");
    console.log("==========================================");
    console.log("🔔 BUZZER TCP CLIENT");
    console.log("==========================================");
    console.log(`Server : ${HOST}`);
    console.log(`Port   : ${PORT}`);
    console.log("==========================================");

    client = new net.Socket();

    client.setKeepAlive(true, 10000);

    client.connect(
        PORT,
        HOST,
        () => {

            console.log("");
            console.log("==========================================");
            console.log("✅ CONNECTED TO BUZZER TCP SERVER");
            console.log("==========================================");
            console.log(
                `Server : ${HOST}:${PORT}`
            );
            console.log("Status : Listening for broadcasts");
            console.log("==========================================");
        }
    );


    // ========================================================
    // RECEIVE BROADCAST
    // ========================================================

    client.on("data", (data) => {

        const messages = data
            .toString("utf-8")
            .split("\n");

        for (const message of messages) {

            const trimmedMessage =
                message.trim();

            if (!trimmedMessage) {
                continue;
            }

            console.log("");
            console.log("📥 BUZZER BROADCAST RECEIVED");
            console.log("------------------------------------------");
            console.log(
                `Raw : ${trimmedMessage}`
            );

            try {

                const payload = JSON.parse(
                    trimmedMessage
                );

                const lineNo = String(
                    payload.line_no || ""
                ).trim();

                const cellQr = String(
                    payload.cellqr || ""
                ).trim();

                console.log(
                    `📡 Line   : ${lineNo}`
                );

                console.log(
                    `📦 CellQR : ${cellQr}`
                );

                // =================================================
                // YOUR LOCAL BUZZER LOGIC GOES HERE
                // =================================================

                console.log(
                    "🔔 BUZZER EVENT RECEIVED"
                );

            } catch (error) {

                console.log(
                    "⚠️ Invalid JSON received:",
                    trimmedMessage
                );

            }
        }
    });


    // ========================================================
    // CONNECTION CLOSED
    // ========================================================

    client.on("close", () => {

        console.log("");
        console.log(
            "❌ TCP CONNECTION CLOSED"
        );

        scheduleReconnect();
    });


    // ========================================================
    // ERROR
    // ========================================================

    client.on("error", (err) => {

        console.log("");
        console.log(
            "❌ TCP ERROR:"
        );

        console.log(
            err.message
        );

    });
}


// ============================================================
// RECONNECT
// ============================================================

function scheduleReconnect() {

    if (reconnectTimer) {
        return;
    }

    console.log(
        "🔄 Reconnecting in 3 seconds..."
    );

    reconnectTimer = setTimeout(
        () => {

            reconnectTimer = null;

            connectToServer();

        },
        3000
    );
}


// ============================================================
// START
// ============================================================

connectToServer();
