Get-Process python* | Sort-Object CPU -Descending | Select-Object -First 5 Id, CPU, WorkingSet |
ForEach-Object {
  $cmd = (Get-CimInstance Win32_Process -Filter "ProcessId=$($_.Id)").CommandLine
  $port = (Get-NetTCPConnection -OwningProcess $_.Id -State Listen -ErrorAction SilentlyContinue).LocalPort
  [PSCustomObject]@{PID=$_.Id; CPUsec=[math]::Round($_.CPU); Port=$port; Cmd=$cmd}
} | Format-List
