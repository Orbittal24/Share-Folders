
@echo off
setlocal

title TACO BUZZER WINDOWS SERVICE

echo ==========================================
echo       TACO BUZZER SERVICE INSTALLER
echo ==========================================

set "APP_DIR=C:\Project\buzzer_client_ready"
set "SCRIPT=%APP_DIR%\buzzer_client_live_2_relay.js"
set "NODE=C:\Program Files\nodejs\node.exe"
set "NSSM=%APP_DIR%\nssm.exe"
set "SERVICE=TACO_Buzzer_Client"

REM Check Administrator permission
net session >nul 2>&1
if %errorlevel% neq 0 (
    echo ERROR: Please run this BAT file as Administrator.
    pause
    exit /b 1
)

REM Check required files
if not exist "%NODE%" (
    echo ERROR: Node.js not found: %NODE%
    pause
    exit /b 1
)

if not exist "%SCRIPT%" (
    echo ERROR: JavaScript file not found.
    pause
    exit /b 1
)

if not exist "%NSSM%" (
    echo ERROR: nssm.exe not found.
    pause
    exit /b 1
)

if not exist "%APP_DIR%\logs" mkdir "%APP_DIR%\logs"

REM Check whether service already exists
sc query "%SERVICE%" >nul 2>&1

if %errorlevel% neq 0 (

    echo Installing Windows Service...

    "%NSSM%" install "%SERVICE%" "%NODE%"

    if errorlevel 1 (
        echo ERROR: Service installation failed.
        pause
        exit /b 1
    )

    "%NSSM%" set "%SERVICE%" AppParameters "\"%SCRIPT%\""
    "%NSSM%" set "%SERVICE%" AppDirectory "%APP_DIR%"

    REM Configure automatic restart
    "%NSSM%" set "%SERVICE%" AppExit Default Restart
    "%NSSM%" set "%SERVICE%" AppRestartDelay 5000

    REM Configure log files
    "%NSSM%" set "%SERVICE%" AppStdout "%APP_DIR%\logs\service_output.log"
    "%NSSM%" set "%SERVICE%" AppStderr "%APP_DIR%\logs\service_error.log"

    "%NSSM%" set "%SERVICE%" AppRotateFiles 1
    "%NSSM%" set "%SERVICE%" AppRotateOnline 1
    "%NSSM%" set "%SERVICE%" AppRotateBytes 10485760

    echo Service installed successfully.

) else (
    echo Service already exists.
)

REM Start service
echo.
echo Starting TACO BUZZER Service...

net start "%SERVICE%"

if errorlevel 1 (
    echo.
    echo ERROR: Unable to start service.
    echo Check service_error.log
    pause
    exit /b 1
)

echo.
echo ==========================================
echo  TACO BUZZER SERVICE STARTED SUCCESSFULLY
echo ==========================================

echo.
echo Service Name: %SERVICE%
echo Script: %SCRIPT%

pause
///////////////////////////////////////////


@echo off

title TACO BUZZER SERVICE STOP

net session >nul 2>&1
if %errorlevel% neq 0 (
    echo Please run as Administrator.
    pause
    exit /b 1
)

net stop TACO_Buzzer_Client

echo.
echo TACO BUZZER SERVICE STOPPED.
pause
