
const sql = require("mssql");

// SQL Server connection configuration
const sqlConfig = {
    user: "user_mis",
    password: "YOUR_SQL_PASSWORD", // Enter your actual SQL password
    server: "10.9.4.29",
    port: 1433,
    database: "SQLMonitoringDB",

    options: {
        encrypt: false,
        trustServerCertificate: true
    },

    pool: {
        max: 5,
        min: 0,
        idleTimeoutMillis: 30000
    },

    connectionTimeout: 15000,
    requestTimeout: 60000
};

// Captures cached query statistics from all accessible databases.
// Statistics are cumulative for each cached query plan.
const captureSQL = `
;WITH QueryStats AS
(
    SELECT
        qs.sql_handle,
        qs.plan_handle,
        qs.statement_start_offset,
        qs.statement_end_offset,
        qs.execution_count,
        qs.total_worker_time,
        qs.total_elapsed_time,
        qs.total_logical_reads,
        qs.total_physical_reads,
        qs.total_logical_writes,
        qs.last_execution_time,
        st.dbid,
        st.text AS batch_text,
        pa.database_id AS plan_database_id
    FROM sys.dm_exec_query_stats AS qs

    CROSS APPLY sys.dm_exec_sql_text(qs.sql_handle) AS st

    OUTER APPLY
    (
        SELECT TOP (1)
            TRY_CONVERT(INT, p.value) AS database_id
        FROM sys.dm_exec_plan_attributes(qs.plan_handle) AS p
        WHERE p.attribute = 'dbid'
    ) AS pa

    WHERE qs.last_execution_time >=
          DATEADD(MINUTE, -1, GETDATE())
)
INSERT INTO SQLMonitoringDB.dbo.SQLQueryExecutionLogs
(
    CaptureTimestamp,
    DatabaseName,
    QueryText,
    LastExecutionTime,
    ExecutionCount,
    TotalCPUMs,
    TotalElapsedMs,
    LogicalReads,
    PhysicalReads,
    LogicalWrites
)
SELECT
    SYSDATETIME(),

    COALESCE(
        DB_NAME(q.dbid),
        DB_NAME(q.plan_database_id)
    ),

    CASE
        WHEN q.batch_text IS NULL THEN NULL
        WHEN q.statement_start_offset < 0
            THEN q.batch_text
        ELSE SUBSTRING
        (
            q.batch_text,
            (q.statement_start_offset / 2) + 1,
            (
                CASE
                    WHEN q.statement_end_offset = -1
                        THEN DATALENGTH(q.batch_text)
                    ELSE q.statement_end_offset
                END
                - q.statement_start_offset
            ) / 2 + 1
        )
    END,

    q.last_execution_time,
    q.execution_count,
    q.total_worker_time / 1000,
    q.total_elapsed_time / 1000,
    q.total_logical_reads,
    q.total_physical_reads,
    q.total_logical_writes

FROM QueryStats AS q;
`;

let pool = null;
let isRunning = false;

async function captureQueryLogs() {
    if (isRunning) {
        console.log("Previous capture is still running. Skipping this cycle.");
        return;
    }

    isRunning = true;

    try {
        if (!pool || !pool.connected) {
            if (pool) {
                await pool.close().catch(() => {});
            }

            pool = await new sql.ConnectionPool(sqlConfig).connect();
        }

        const result = await pool.request().query(captureSQL);

        const rowsInserted = (result.rowsAffected || [])
            .reduce((total, count) => total + count, 0);

        console.log(
            new Date().toISOString(),
            "| Capture successful | Rows inserted:",
            rowsInserted
        );
    } catch (error) {
        console.error(
            new Date().toISOString(),
            "| SQL logging failed:",
            error.message
        );
    } finally {
        isRunning = false;
    }
}

async function startLogger() {
    console.log("SQL Query Logger started.");
    console.log("Target server: 10.9.4.29:1433");
    console.log("Logging database: SQLMonitoringDB");
    console.log("Capture interval: 60 seconds");

    // Capture immediately at startup.
    await captureQueryLogs();

    // Repeat every minute.
    setInterval(captureQueryLogs, 60 * 1000);
}

startLogger();

// Gracefully close the connection pool when stopped.
async function shutdown() {
    console.log("Stopping SQL Query Logger...");

    if (pool) {
        await pool.close().catch(() => {});
    }

    process.exit(0);
}

process.on("SIGINT", shutdown);
process.on("SIGTERM", shutdown);



