<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Pack Module Barcode Checker
    </title>


    <style>

        * {
            box-sizing: border-box;
        }


        body {

            margin: 0;

            padding: 0;

            font-family: Arial, sans-serif;

            background: #f4f6f9;

            color: #222;

        }


        .container {

            width: 95%;

            max-width: 1200px;

            margin: 30px auto;

            background: white;

            padding: 25px;

            border-radius: 10px;

            box-shadow:
                0 3px 15px rgba(
                    0,
                    0,
                    0,
                    0.1
                );

        }


        h1 {

            margin-top: 0;

            text-align: center;

            color: #1f4e78;

        }


        .form-row {

            display: flex;

            gap: 20px;

            align-items: flex-start;

            margin-top: 25px;

        }


        .form-group {

            flex: 1;

            position: relative;

        }


        label {

            display: block;

            font-weight: bold;

            margin-bottom: 8px;

        }


        input,
        button {

            width: 100%;

            height: 42px;

            padding: 8px 12px;

            font-size: 15px;

            border-radius: 5px;

            border: 1px solid #bbb;

        }


        input:focus {

            outline: none;

            border-color: #1f4e78;

        }


        .error {

            color: #d60000;

            font-size: 13px;

            margin-top: 5px;

            min-height: 18px;

        }


        .button-container {

            width: 120px;

            margin-top: 25px;

        }


        button {

            border: none;

            background: #1f4e78;

            color: white;

            font-weight: bold;

            cursor: pointer;

        }


        button:hover {

            background: #163b5c;

        }


        button:disabled {

            background: #999;

            cursor: not-allowed;

        }


        /* ========================================================
           SEARCHABLE PACK NAME
           ======================================================== */

        .pack-search-container {

            position: relative;

        }


        .pack-dropdown {

            position: absolute;

            top: 47px;

            left: 0;

            right: 0;

            background: white;

            border: 1px solid #bbb;

            border-radius: 5px;

            max-height: 250px;

            overflow-y: auto;

            z-index: 1000;

            display: none;

            box-shadow:
                0 4px 10px rgba(
                    0,
                    0,
                    0,
                    0.15
                );

        }


        .pack-dropdown-item {

            padding: 10px 12px;

            cursor: pointer;

            font-size: 14px;

            border-bottom: 1px solid #eee;

        }


        .pack-dropdown-item:last-child {

            border-bottom: none;

        }


        .pack-dropdown-item:hover {

            background: #eaf2f8;

        }


        .pack-dropdown-no-data {

            padding: 10px 12px;

            color: #777;

            font-size: 14px;

        }


        .message {

            margin-top: 20px;

            padding: 12px;

            border-radius: 5px;

            display: none;

        }


        .success {

            background: #dff5e1;

            color: #146c2e;

            border: 1px solid #9ad5a5;

        }


        .failure {

            background: #ffe0e0;

            color: #a00000;

            border: 1px solid #e0a0a0;

        }


        .info {

            background: #e5f1ff;

            color: #13558a;

            border: 1px solid #9cc7ee;

        }


        .results {

            margin-top: 30px;

        }


        .results-header {

            display: flex;

            justify-content: space-between;

            align-items: center;

            margin-bottom: 10px;

        }


        .results-header h2 {

            margin: 0;

            color: #1f4e78;

        }


        .table-container {

            overflow-x: auto;

            border: 1px solid #ddd;

        }


        table {

            width: 100%;

            border-collapse: collapse;

            min-width: 700px;

        }


        th,
        td {

            padding: 10px;

            border: 1px solid #ddd;

            text-align: left;

        }


        th {

            background: #1f4e78;

            color: white;

        }


        tr:nth-child(even) {

            background: #f7f7f7;

        }


        .changed {

            color: #008000;

            font-weight: bold;

        }


        .no-data {

            text-align: center;

            padding: 20px;

            color: #777;

        }


        .loading {

            display: none;

            text-align: center;

            margin-top: 15px;

            font-weight: bold;

            color: #1f4e78;

        }


        .pack-info {

            display: flex;

            gap: 20px;

            margin-top: 20px;

            padding: 15px;

            background: #f1f5f9;

            border-radius: 6px;

        }


        .pack-info div {

            flex: 1;

        }


        .pack-info span {

            font-weight: bold;

            color: #1f4e78;

        }


        @media (max-width: 700px) {

            .form-row {

                flex-direction: column;

            }


            .button-container {

                width: 100%;

                margin-top: 0;

            }


            .pack-info {

                flex-direction: column;

                gap: 8px;

            }

        }

    </style>

</head>


<body>


<div class="container">


    <h1>
        Pack Module Barcode Checker
    </h1>


    <!-- ========================================================
         INPUT SECTION
         ======================================================== -->

    <div class="form-row">


        <!-- ====================================================
             PACK NO
             ==================================================== -->

        <div class="form-group">

            <label for="packNo">

                Pack No
                <span style="color:red">*</span>

            </label>


            <input
                type="text"
                id="packNo"
                maxlength="6"
                inputmode="numeric"
                placeholder="Enter 6 digit Pack No"
                autocomplete="off"
            >


            <div
                id="packNoError"
                class="error"
            ></div>

        </div>


        <!-- ====================================================
             PACK NAME SEARCH
             ==================================================== -->

        <div class="form-group">

            <label for="packName">

                Pack Name
                <span style="color:red">*</span>

            </label>


            <div class="pack-search-container">


                <input
                    type="text"
                    id="packName"
                    placeholder="Type to search Pack Name"
                    autocomplete="off"
                >


                <div
                    id="packDropdown"
                    class="pack-dropdown"
                ></div>


            </div>


            <div
                id="packNameError"
                class="error"
            ></div>

        </div>


        <!-- ====================================================
             OK BUTTON
             ==================================================== -->

        <div class="button-container">

            <button
                id="okButton"
                onclick="processPack()"
            >
                OK
            </button>

        </div>


    </div>


    <!-- ========================================================
         LOADING
         ======================================================== -->

    <div
        id="loading"
        class="loading"
    >

        Processing... Please wait.

    </div>


    <!-- ========================================================
         MESSAGE
         ======================================================== -->

    <div
        id="message"
        class="message"
    ></div>


    <!-- ========================================================
         PACK INFORMATION
         ======================================================== -->

    <div
        id="packInfo"
        class="pack-info"
        style="display:none;"
    >


        <div>

            Pack ID:

            <span id="displayPackId"></span>

        </div>


        <div>

            Line ID:

            <span id="displayLineId"></span>

        </div>


        <div>

            Line No:

            <span id="displayLineNo"></span>

        </div>


        <div>

            Pack Creation Date:

            <span id="displayCreationDate"></span>

        </div>


    </div>


    <!-- ========================================================
         PACK HISTORY RESULTS
         ======================================================== -->

    <div class="results">

        <div class="results-header">
            <h2>Pack History Results</h2>
        </div>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>History Table</th>
                        <th>Pack Name</th>
                        <th>Pack ID</th>
                        <th>Line ID</th>
                        <th>Pack No</th>
                        <th>Module Barcode</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody id="historyResultsBody">
                    <tr>
                        <td colspan="8" class="no-data">No data available</td>
                    </tr>
                </tbody>
            </table>
        </div>

    </div>


    <!-- ========================================================
         MODULE REGISTER RESULTS
         ======================================================== -->

    <div class="results">

        <div class="results-header">
            <h2>Module Register Results</h2>
        </div>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Module Register Table</th>
                        <th>Pack Name</th>
                        <th>Pack ID</th>
                        <th>Line ID</th>
                        <th>Pack No</th>
                        <th>Module Barcode</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody id="moduleRegisterResultsBody">
                    <tr>
                        <td colspan="8" class="no-data">No data available</td>
                    </tr>
                </tbody>
            </table>
        </div>

    </div>



<script>


    // ============================================================
    // API BASE
    // ============================================================

    const API_BASE = "";


    // ============================================================
    // PACK DATA
    // ============================================================

    let packData = [];


    // Currently selected Pack
    let selectedPack = null;



    // ============================================================
    // LOAD PACK NAMES
    // ============================================================

    async function loadPackNames() {

        const dropdown =
            document.getElementById(
                "packDropdown"
            );


        try {

            const response =
                await fetch(
                    `${API_BASE}/api/pack-names`
                );


            const result =
                await response.json();


            if (!response.ok) {

                throw new Error(
                    result.message ||
                    "Failed to load Pack Names"
                );

            }


            packData =
                result.data || [];


            console.log(
                "Total Pack Names Loaded:",
                packData.length
            );


        } catch (error) {

            console.error(
                "Pack Name Error:",
                error
            );


            showMessage(
                "Failed to load Pack Names. Please check backend/database connection.",
                "failure"
            );

        }

    }



    // ============================================================
    // PACK NAME INPUT
    // ============================================================

    const packNameInput =
        document.getElementById(
            "packName"
        );


    const packDropdown =
        document.getElementById(
            "packDropdown"
        );


    packNameInput.addEventListener(
        "input",
        function () {

            const searchText =
                this.value
                    .trim()
                    .toLowerCase();


            // Reset selected pack
            selectedPack = null;


            document.getElementById(
                "packNameError"
            ).textContent = "";


            // If nothing typed
            if (!searchText) {

                packDropdown.style.display =
                    "none";

                return;

            }


            // ====================================================
            // FILTER PACK NAMES
            // ====================================================

            const filteredPacks =
                packData.filter(
                    pack => {

                        const packName =
                            String(
                                pack.Pack_Name || ""
                            ).toLowerCase();


                        return packName.includes(
                            searchText
                        );

                    }
                );


            // ====================================================
            // CLEAR DROPDOWN
            // ====================================================

            packDropdown.innerHTML = "";


            // ====================================================
            // NO RESULTS
            // ====================================================

            if (
                filteredPacks.length === 0
            ) {

                const noData =
                    document.createElement(
                        "div"
                    );


                noData.className =
                    "pack-dropdown-no-data";


                noData.textContent =
                    "No Pack Name found";


                packDropdown.appendChild(
                    noData
                );


                packDropdown.style.display =
                    "block";


                return;

            }


            // ====================================================
            // SHOW RESULTS
            // ====================================================

            filteredPacks.forEach(
                pack => {

                    const item =
                        document.createElement(
                            "div"
                        );


                    item.className =
                        "pack-dropdown-item";


                    item.textContent =
                        pack.Pack_Name;


                    // Store complete pack object
                    item.dataset.packId =
                        pack.Pack_ID;


                    item.addEventListener(
                        "click",
                        function () {

                            // ------------------------------------
                            // SET PACK NAME
                            // ------------------------------------

                            packNameInput.value =
                                pack.Pack_Name;


                            // ------------------------------------
                            // STORE SELECTED PACK
                            // ------------------------------------

                            selectedPack =
                                pack;


                            // ------------------------------------
                            // CLOSE DROPDOWN
                            // ------------------------------------

                            packDropdown.style.display =
                                "none";


                            // ------------------------------------
                            // REMOVE ERROR
                            // ------------------------------------

                            document.getElementById(
                                "packNameError"
                            ).textContent = "";


                            console.log(
                                "Selected Pack:",
                                pack
                            );


                            console.log(
                                "Selected Pack ID:",
                                pack.Pack_ID
                            );

                        }
                    );


                    packDropdown.appendChild(
                        item
                    );

                }
            );


            packDropdown.style.display =
                "block";

        }
    );



    // ============================================================
    // SHOW DROPDOWN WHEN INPUT IS CLICKED
    // ============================================================

    packNameInput.addEventListener(
        "focus",
        function () {

            const searchText =
                this.value
                    .trim()
                    .toLowerCase();


            if (!searchText) {

                return;

            }


            const filteredPacks =
                packData.filter(
                    pack => {

                        const packName =
                            String(
                                pack.Pack_Name || ""
                            ).toLowerCase();


                        return packName.includes(
                            searchText
                        );

                    }
                );


            if (
                filteredPacks.length === 0
            ) {

                return;

            }


            packDropdown.innerHTML = "";


            filteredPacks.forEach(
                pack => {

                    const item =
                        document.createElement(
                            "div"
                        );


                    item.className =
                        "pack-dropdown-item";


                    item.textContent =
                        pack.Pack_Name;


                    item.addEventListener(
                        "click",
                        function () {

                            packNameInput.value =
                                pack.Pack_Name;


                            selectedPack =
                                pack;


                            packDropdown.style.display =
                                "none";


                            document.getElementById(
                                "packNameError"
                            ).textContent = "";

                        }
                    );


                    packDropdown.appendChild(
                        item
                    );

                }
            );


            packDropdown.style.display =
                "block";

        }
    );



    // ============================================================
    // CLOSE DROPDOWN WHEN CLICKING OUTSIDE
    // ============================================================

    document.addEventListener(
        "click",
        function (event) {

            const container =
                document.querySelector(
                    ".pack-search-container"
                );


            if (
                !container.contains(
                    event.target
                )
            ) {

                packDropdown.style.display =
                    "none";

            }

        }
    );



    // ============================================================
    // PACK NUMBER VALIDATION
    // ============================================================

    document
        .getElementById("packNo")
        .addEventListener(
            "input",
            function () {

                // Only numbers
                this.value =
                    this.value.replace(
                        /\D/g,
                        ""
                    );


                const error =
                    document.getElementById(
                        "packNoError"
                    );


                if (
                    this.value.length === 0
                ) {

                    error.textContent =
                        "";

                }

                else if (
                    this.value.length < 6
                ) {

                    error.textContent =
                        "Pack No must contain exactly 6 digits.";

                }

                else {

                    error.textContent =
                        "";

                }

            }
        );



    // ============================================================
    // PROCESS PACK
    // ============================================================

    async function processPack() {


        // ========================================================
        // GET PACK NO
        // ========================================================

        const packNo =
            document
                .getElementById(
                    "packNo"
                )
                .value
                .trim();


        // ========================================================
        // GET PACK NAME
        // ========================================================

        const packName =
            document
                .getElementById(
                    "packName"
                )
                .value
                .trim();


        // ========================================================
        // FIND SELECTED PACK
        //
        // If user typed the complete exact Pack Name but did not
        // click the dropdown item, we still find it here.
        // ========================================================

        if (!selectedPack) {

            selectedPack =
                packData.find(
                    pack => {

                        return String(
                            pack.Pack_Name || ""
                        )
                        .trim()
                        .toLowerCase()
                        ===
                        packName
                            .toLowerCase();

                    }
                ) || null;

        }


        // ========================================================
        // GET PACK ID
        // ========================================================

        const packId =
            selectedPack
                ? selectedPack.Pack_ID
                : "";


        // ========================================================
        // VALIDATION
        // ========================================================

        let valid = true;


        // --------------------------------------------------------
        // PACK NO VALIDATION
        // --------------------------------------------------------

        if (
            !/^\d{6}$/.test(
                packNo
            )
        ) {

            document.getElementById(
                "packNoError"
            ).textContent =
                "Pack No must contain exactly 6 digits.";


            valid = false;

        }

        else {

            document.getElementById(
                "packNoError"
            ).textContent =
                "";

        }


        // --------------------------------------------------------
        // PACK NAME VALIDATION
        // --------------------------------------------------------

        if (!packName) {

            document.getElementById(
                "packNameError"
            ).textContent =
                "Please enter a Pack Name.";


            valid = false;

        }

        else if (!selectedPack) {

            document.getElementById(
                "packNameError"
            ).textContent =
                "Please select a valid Pack Name from the list.";


            valid = false;

        }

        else {

            document.getElementById(
                "packNameError"
            ).textContent =
                "";

        }


        if (!valid) {

            return;

        }


        // ========================================================
        // UI
        // ========================================================

        const button =
            document.getElementById(
                "okButton"
            );


        const loading =
            document.getElementById(
                "loading"
            );


        button.disabled =
            true;


        loading.style.display =
            "block";


        hideMessage();


        document.getElementById(
            "packInfo"
        ).style.display =
            "none";


        document.getElementById(
            "historyResultsBody"
        ).innerHTML = `

            <tr>

                <td
                    colspan="8"
                    class="no-data"
                >

                    Processing...

                </td>

            </tr>

        `;

        document.getElementById(
            "moduleRegisterResultsBody"
        ).innerHTML = `
            <tr>
                <td colspan="8" class="no-data">Processing...</td>
            </tr>
        `;


        try {


            // ====================================================
            // SEND DATA TO BACKEND
            // ====================================================

            const response =
                await fetch(
                    `${API_BASE}/api/process-pack`,
                    {

                        method:
                            "POST",

                        headers: {

                            "Content-Type":
                                "application/json"

                        },

                        body:
                            JSON.stringify({

                                packNo:
                                    packNo,

                                packId:
                                    packId,

                                packName:
                                    packName

                            })

                    }
                );


            const result =
                await response.json();


            if (!response.ok) {

                throw new Error(
                    result.message ||
                    "Processing failed."
                );

            }


            // ====================================================
            // SHOW PACK INFORMATION
            // ====================================================

            document.getElementById(
                "displayPackId"
            ).textContent =
                result.packId || "";


            document.getElementById(
                "displayLineId"
            ).textContent =
                result.lineId || "";


            document.getElementById(
                "displayLineNo"
            ).textContent =
                result.lineNo || "";


            document.getElementById(
                "displayCreationDate"
            ).textContent =
                result.packCreationDate || "";


            document.getElementById(
                "packInfo"
            ).style.display =
                "flex";


            // ====================================================
            // SHOW RESULTS
            // ====================================================

            displayHistoryResults(
                result.historyRecords || []
            );

            displayModuleRegisterResults(
                result.moduleRegisterRecords || []
            );


            showMessage(
                result.message ||
                "Processing completed successfully.",
                "success"
            );


        }

        catch (error) {


            console.error(
                error
            );


            document.getElementById(
                "historyResultsBody"
            ).innerHTML = `

                <tr>

                    <td
                        colspan="8"
                        class="no-data"
                    >

                        No data available

                    </td>

                </tr>

            `;


            document.getElementById(
                "moduleRegisterResultsBody"
            ).innerHTML = `
                <tr>
                    <td colspan="8" class="no-data">No data available</td>
                </tr>
            `;


            showMessage(
                error.message ||
                "Something went wrong.",
                "failure"
            );


        }

        finally {


            button.disabled =
                false;


            loading.style.display =
                "none";

        }

    }



    // ============================================================
    // DISPLAY PACK HISTORY RESULTS
    // ============================================================

    function displayHistoryResults(records) {

        displayResultsInTable(
            "historyResultsBody",
            records,
            "No Pack History module barcode records found."
        );

    }


    // ============================================================
    // DISPLAY MODULE REGISTER RESULTS
    // ============================================================

    function displayModuleRegisterResults(records) {

        displayResultsInTable(
            "moduleRegisterResultsBody",
            records,
            "No Module Register module barcode records found."
        );

    }


    // ============================================================
    // COMMON RESULT TABLE RENDERER
    // ============================================================

    function displayResultsInTable(
        elementId,
        records,
        noDataMessage
    ) {

        const tbody =
            document.getElementById(elementId);

        if (!records || records.length === 0) {

            tbody.innerHTML = `
                <tr>
                    <td colspan="8" class="no-data">
                        ${escapeHtml(noDataMessage)}
                    </td>
                </tr>
            `;

            return;
        }

        tbody.innerHTML = "";

        records.forEach((record, index) => {

            const row = document.createElement("tr");

            row.innerHTML = `
                <td>${index + 1}</td>
                <td>${escapeHtml(record.tableName || "")}</td>
                <td>${escapeHtml(record.packName || "")}</td>
                <td>${escapeHtml(record.packId || "")}</td>
                <td>${escapeHtml(record.lineId || "")}</td>
                <td>${escapeHtml(record.packNo || "")}</td>
                <td class="changed">${escapeHtml(record.moduleBarcode || "")}</td>
                <td>${escapeHtml(record.status || "Updated")}</td>
            `;

            tbody.appendChild(row);

        });

    }



    // ============================================================
    // SHOW MESSAGE
    // ============================================================

    function showMessage(
        message,
        type
    ) {


        const element =
            document.getElementById(
                "message"
            );


        element.textContent =
            message;


        element.className =
            `message ${type}`;


        element.style.display =
            "block";

    }



    // ============================================================
    // HIDE MESSAGE
    // ============================================================

    function hideMessage() {


        const element =
            document.getElementById(
                "message"
            );


        element.style.display =
            "none";

    }



    // ============================================================
    // HTML ESCAPE
    // ============================================================

    function escapeHtml(
        value
    ) {

        return String(value)

            .replace(
                /&/g,
                "&amp;"
            )

            .replace(
                /</g,
                "&lt;"
            )

            .replace(
                />/g,
                "&gt;"
            )

            .replace(
                /"/g,
                "&quot;"
            )

            .replace(
                /'/g,
                "&#039;"
            );

    }



    // ============================================================
    // INITIAL LOAD
    // ============================================================

    loadPackNames();


</script>


</body>

</html>
