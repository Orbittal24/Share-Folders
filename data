                safe(row.today_date),
                safe(row.updated_time),
                safe(row.laser_status),
                safe(dateCode),
                safe(code12_13),
                safe(tableName),
                1 if sql_success else 0,
                1 if redis_success else 0,
                safe(sql_error),
                safe(redis_error),
                rejection_reason
            )
        )


        # --------------------------------------------------------
        # GET THE INSERTED REJECTION ID
        # --------------------------------------------------------

        cursor.execute(
            "SELECT CAST(SCOPE_IDENTITY() AS INT)"
        )

        rejection_id_row = cursor.fetchone()

        if not rejection_id_row:

            raise Exception(
                "Could not get rejection record ID"
            )

        rejection_id = rejection_id_row[0]


        # --------------------------------------------------------
        # COMMIT REJECTION INSERT
        # --------------------------------------------------------

        dst_conn.commit()

        print("REJECTION INSERTED :", qr)
        print("REJECTION ID       :", rejection_id)
        print("REJECTION REASON   :", rejection_reason)


        # --------------------------------------------------------
        # ACKNOWLEDGEMENT
        # --------------------------------------------------------

        cursor.execute(
            f"""
            UPDATE {REJECTION_TABLE}
            SET acknowledgement = 1
            WHERE sr_no = ?
            """,
            rejection_id
        )

        dst_conn.commit()

        print("REJECTION ACKNOWLEDGED :", qr)

        return True


