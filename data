const axios = require("axios");

socket.on("get_station_status", async function (barcode) {
    try {
        const response = await axios.get(
            `https://mismainapp.tataautocomp.com:3241/fetch_nomenclature/${barcode}`
        );

        const result = response.data;

        let status = "NOT OK";
        let FinalQRCode;

        if (Array.isArray(result) && result.length > 0) {
            status = "OK";
            FinalQRCode = result[0].Pack_No;
        }

        console.log("API Result:", result);

        socket.emit("set_station_status", status, barcode, FinalQRCode);

    } catch (err) {
        console.error("API Error:", err.message);

        socket.emit("set_station_status", "NOT OK", barcode, undefined);
    }
});
