USE taco_treceability;
GO

SET NOCOUNT ON;

INSERT INTO dbo.ocv_machine_data_mirror
(
    sr_no,
    cell_qrcode,
    voltage,
    ir,
    today_date,
    updated_time,
    machine_location,
    shift,
    used_on_line,
    kvalue,
    grade,
    cell_capacity,
    cell_class
)
SELECT
    sr_no,
    cell_qrcode,
    voltage,
    ir,
    today_date,
    updated_time,
    machine_location,
    shift,
    used_on_line,
    kvalue,
    grade,
    cell_capacity,
    cell_class
FROM dbo.ocv_machine_data WITH (NOLOCK)
WHERE machine_location = 'line7_line8'
  AND today_date >= '2026-11-14'
  AND today_date < '2026-11-15';

PRINT 'Data copied successfully';
GO
