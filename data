
"use strict";

const sql = require("mssql");

// ======================================================
// SQL SERVER CONFIGURATION
// ======================================================

const sqlConfig = {
    user: "user_mis",
    password: "YOUR_SQL_PASSWORD",
    server: "10.9.4.29",
    database: "SQLMonitoringDB",

    options: {
        instanceName: "PROD_SQL_2026",
        encrypt: false,
        trustServerCertificate: true
    },

    pool: {
        max: 5,
        min: 0,
        idleTimeoutMillis: 30000
    },

    connectionTimeout: 15000,
    requestTimeout: 60000
};

const QUERY_INTERVAL_MS = 60 * 1000;
const BLOCKING_INTERVAL_MS = 10 * 1000;

let pool = null;
let isStopping = false;
let queryCaptureRunning = false;
let blockingCaptureRunning = false;
let queryTimer = null;
let blockingTimer = null;

// ======================================================
// 1. TOP 10 SQL QUERIES BY CUMULATIVE CPU
// ======================================================

const captureSQL = `
;WITH RecentQueries AS
(
    SELECT
        qs.sql_handle,
        qs.plan_handle,
        qs.statement_start_offset,
        qs.statement_end_offset,
        qs.execution_count,
        qs.total_worker_time / 1000 AS total_cpu_ms,
        qs.total_elapsed_time / 1000 AS total_elapsed_ms,
        qs.total_logical_reads AS logical_reads,
        qs.total_physical_reads AS physical_reads,
        qs.total_logical_writes AS logical_writes,
        qs.last_execution_time,
        st.dbid,
        st.text AS query_text,
        pa.database_id AS plan_database_id

    FROM sys.dm_exec_query_stats AS qs

    CROSS APPLY sys.dm_exec_sql_text(qs.sql_handle) AS st

    OUTER APPLY
    (
        SELECT TOP (1)
            TRY_CONVERT(INT, p.value) AS database_id
        FROM sys.dm_exec_plan_attributes(qs.plan_handle) AS p
        WHERE p.attribute = 'dbid'
    ) AS pa

    WHERE qs.last_execution_time >=
          DATEADD(MINUTE, -1, GETDATE())
)
INSERT INTO SQLMonitoringDB.dbo.SQLQueryExecutionLogs
(
    CaptureTimestamp,
    DatabaseName,
    QueryText,
    LastExecutionTime,
    ExecutionCount,
    TotalCPUMs,
    TotalElapsedMs,
    LogicalReads,
    PhysicalReads,
    LogicalWrites
)
SELECT TOP (10)
    SYSDATETIME(),

    COALESCE(
        DB_NAME(q.dbid),
        DB_NAME(q.plan_database_id)
    ),

    CASE
        WHEN q.query_text IS NULL THEN NULL

        WHEN q.statement_start_offset < 0
            THEN q.query_text

        ELSE SUBSTRING
        (
            q.query_text,
            (q.statement_start_offset / 2) + 1,

            (
                CASE
                    WHEN q.statement_end_offset = -1
                        THEN DATALENGTH(q.query_text)
                    ELSE q.statement_end_offset
                END
                - q.statement_start_offset
            ) / 2
        )
    END,

    q.last_execution_time,
    q.execution_count,
    q.total_cpu_ms,
    q.total_elapsed_ms,
    q.logical_reads,
    q.physical_reads,
    q.logical_writes

FROM RecentQueries AS q
ORDER BY q.total_cpu_ms DESC;
`;

// ======================================================
// 2. BLOCKING SESSION CAPTURE
// ======================================================

const blockingCaptureSQL = `
INSERT INTO SQLMonitoringDB.dbo.SQLBlockingExecutionLogs
(
    CaptureTimestamp,
    BlockedSessionID,
    BlockedDatabaseName,
    WaitType,
    WaitTimeMs,
    BlockedQueryText,
    BlockingSessionID,
    BlockingHostProcessID,
    BlockingStatus,
    BlockingOpenTransactionCount,
    BlockingLastRequestEndTime,
    BlockingQueryText
)
SELECT
    SYSDATETIME(),

    r.session_id,
    DB_NAME(r.database_id),
    r.wait_type,
    r.wait_time,
    blockedSQL.text,

    r.blocking_session_id,
    blocker.host_process_id,
    blocker.status,
    blocker.open_transaction_count,
    blocker.last_request_end_time,
    blockerSQL.text

FROM sys.dm_exec_requests AS r

CROSS APPLY sys.dm_exec_sql_text(r.sql_handle) AS blockedSQL

LEFT JOIN sys.dm_exec_sessions AS blocker
    ON blocker.session_id = r.blocking_session_id

LEFT JOIN sys.dm_exec_connections AS blockerConnection
    ON blockerConnection.session_id = r.blocking_session_id

OUTER APPLY sys.dm_exec_sql_text(
    blockerConnection.most_recent_sql_handle
) AS blockerSQL

WHERE r.blocking_session_id <> 0;
`;

// ======================================================
// 3. SQL CONNECTION
// ======================================================

async function getConnection() {
    if (isStopping) {
        throw new Error("Logger is stopping.");
    }

    if (pool && pool.connected) {
        return pool;
    }

    if (pool) {
        await pool.close().catch(() => {});
        pool = null;
    }

    console.log(
        new Date().toISOString(),
        "| Connecting to SQL Server PROD_SQL_2026..."
    );

    const newPool = new sql.ConnectionPool(sqlConfig);

    newPool.on("error", (err) => {
        console.error(
            new Date().toISOString(),
            "| SQL connection pool error:",
            err.message
        );
    });

    pool = await newPool.connect();

    console.log("SQL Server connection established.");

    return pool;
}

// ======================================================
// 4. CAPTURE TOP 10 QUERY LOGS
// ======================================================

async function captureQueryLogs() {
    if (queryCaptureRunning || isStopping) {
        return;
    }

    queryCaptureRunning = true;

    try {
        const connection = await getConnection();

        const result = await connection.request().query(captureSQL);

        const inserted = (result.rowsAffected || [])
            .reduce((sum, count) => sum + count, 0);

        console.log(
            new Date().toISOString(),
            "| Top 10 query capture successful | Rows inserted:",
            inserted
        );
    } catch (err) {
        console.error(
            new Date().toISOString(),
            "| Query capture failed:",
            err.message
        );

        await resetConnection();
    } finally {
        queryCaptureRunning = false;
    }
}

// ======================================================
// 5. CAPTURE BLOCKING LOGS
// ======================================================

async function captureBlockingLogs() {
    if (blockingCaptureRunning || isStopping) {
        return;
    }

    blockingCaptureRunning = true;

    try {
        const connection = await getConnection();

        const result = await connection.request()
            .query(blockingCaptureSQL);

        const inserted = (result.rowsAffected || [])
            .reduce((sum, count) => sum + count, 0);

        console.log(
            new Date().toISOString(),
            "| Blocking capture successful | Rows inserted:",
            inserted
        );
    } catch (err) {
        console.error(
            new Date().toISOString(),
            "| Blocking capture failed:",
            err.message
        );

        await resetConnection();
    } finally {
        blockingCaptureRunning = false;
    }
}

// ======================================================
// 6. RESET CONNECTION AFTER ERRORS
// ======================================================

async function resetConnection() {
    if (pool) {
        const oldPool = pool;
        pool = null;
        await oldPool.close().catch(() => {});
    }
}

// ======================================================
// 7. START BOTH MONITORS
// ======================================================

async function startLogger() {
    console.log("================================================");
    console.log("SQL QUERY AND BLOCKING LOGGER STARTED");
    console.log("Server          : 10.9.4.29");
    console.log("Instance        : PROD_SQL_2026");
    console.log("Logging DB      : SQLMonitoringDB");
    console.log("Top query limit : 10");
    console.log("Query interval  : 60 seconds");
    console.log("Blocking interval: 10 seconds");
    console.log("================================================");

    // Run both captures immediately.
    await Promise.all([
        captureQueryLogs(),
        captureBlockingLogs()
    ]);

    if (isStopping) {
        return;
    }

    queryTimer = setInterval(() => {
        captureQueryLogs();
    }, QUERY_INTERVAL_MS);

    blockingTimer = setInterval(() => {
        captureBlockingLogs();
    }, BLOCKING_INTERVAL_MS);

    console.log("Both monitors are running. Press Ctrl+C to stop.");
}

// ======================================================
// 8. GRACEFUL SHUTDOWN
// ======================================================

async function shutdown() {
    if (isStopping) {
        return;
    }

    isStopping = true;

    console.log("\nStopping SQL monitors...");

    if (queryTimer) {
        clearInterval(queryTimer);
        queryTimer = null;
    }

    if (blockingTimer) {
        clearInterval(blockingTimer);
        blockingTimer = null;
    }

    // Wait for both captures to finish before closing the pool.
    while (queryCaptureRunning || blockingCaptureRunning) {
        await new Promise(resolve => setTimeout(resolve, 200));
    }

    await resetConnection();

    console.log("SQL monitors stopped.");
}

process.once("SIGINT", shutdown);
process.once("SIGTERM", shutdown);

// ======================================================
// 9. EXECUTE
// ======================================================

startLogger().catch(err => {
    console.error("Logger startup failed:", err.message);
    process.exitCode = 1;
});
