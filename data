<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Production Count Backup - New MIS</title>
<script src="/socket.io/socket.io.js"></script>
<style>
*{box-sizing:border-box}body{margin:0;padding:25px;font-family:Arial,Helvetica,sans-serif;background:#f1f5f9;color:#1e293b}.container{max-width:1100px;margin:auto}h1{font-size:28px;margin-bottom:8px}h2{font-size:19px;margin-top:0;color:#b91c1c}.subtitle{color:#64748b;margin-bottom:24px}.card{background:#fff;border-radius:12px;padding:23px;margin-bottom:20px;box-shadow:0 3px 12px rgba(15,23,42,.07)}.fields{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;margin:20px 0}label{display:block;margin-bottom:8px;font-weight:600}input,select{width:100%;padding:12px;border:1px solid #cbd5e1;border-radius:7px;font-size:15px;background:#fff}input:focus,select:focus{outline:2px solid #93c5fd;border-color:#2563eb}.buttons{display:flex;flex-wrap:wrap;gap:12px}button{border:0;padding:12px 21px;border-radius:7px;font-weight:700;font-size:14px;cursor:pointer}button:disabled{opacity:.5;cursor:not-allowed}.scan-btn{background:#2563eb;color:white}.shift-btn{background:#15803d;color:white}.metric-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-top:18px}.metric{border:1px solid #e2e8f0;background:#f8fafc;border-radius:9px;padding:18px}.metric span{display:block;color:#64748b;font-size:13px;margin-bottom:10px}.metric strong{display:block;font-size:25px;overflow-wrap:anywhere}.connection{display:inline-block;padding:8px 12px;border-radius:20px;background:#fee2e2;color:#991b1b;font-size:13px;margin-bottom:20px}.connection.online{background:#dcfce7;color:#166534}.status{margin-top:16px;padding:14px;border-radius:7px;background:#eff6ff;color:#1d4ed8;white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.5}.status.error{background:#fef2f2;color:#b91c1c}.status.success{background:#f0fdf4;color:#166534}.progress-track{width:100%;height:15px;margin:22px 0 10px;background:#e2e8f0;border-radius:20px;overflow:hidden}.progress-bar{height:100%;width:0;background:#16a34a;transition:width .2s}#progressText{color:#475569;font-size:14px}.hint{font-size:13px;color:#64748b;line-height:1.6;margin-top:20px}.small{font-size:12px;color:#64748b;margin-top:6px}@media(max-width:750px){body{padding:12px}.card{padding:16px}.fields,.metric-grid{grid-template-columns:1fr}}
</style></head>
<body><div class="container">
<h1>Production Count Backup - New MIS</h1><div class="subtitle">Move selected pack records from a line backup table back to its live production table.</div>
<div id="connection" class="connection">Connecting to server...</div>
<section class="card"><h2>Pack-wise Shift</h2>
<div class="fields">
 <div><label for="packNo">Pack Number (6 digits)</label><input id="packNo" type="text" inputmode="numeric" maxlength="6" pattern="[0-9]{6}" placeholder="Enter 6-digit pack number" autocomplete="off"/><div class="small">Example: 123456</div></div>
 <div><label for="packSearch">Search Pack Name</label><input id="packSearch" type="text" placeholder="Type to search pack name" autocomplete="off"/><label for="packSelect" style="margin-top:10px">Select Pack Name</label><select id="packSelect"><option value="">Loading pack names...</option></select></div>
 <div><label for="tableName">Select Line</label><select id="tableName"></select><div class="small">The selected line determines both backup and live tables.</div></div>
</div>
<div class="buttons"><button id="scanBtn" class="scan-btn" onclick="scanRecords()">Scan</button><button id="shiftBtn" class="shift-btn" onclick="startShift()">Shift to Live Table</button></div>
</section>
<section class="card"><h2>Shift Progress</h2><div class="metric-grid">
<div class="metric"><span>Records Found</span><strong id="totalCount">—</strong></div><div class="metric"><span>Successfully Shifted</span><strong id="shiftedCount">0</strong></div><div class="metric"><span>Failed Records</span><strong id="failedCount">0</strong></div></div>
<div class="progress-track"><div id="progressBar" class="progress-bar"></div></div><div id="progressText">No shift operation started.</div>
<div id="statusMessage" class="status">Enter a six-digit pack number, select a pack name and line, then click Scan.</div>
<p class="hint">Scan only counts matching records in the selected line's backup table. Shift processes records sequentially. Each record is inserted into the live table and verified before its backup copy is deleted. Both operations are in one SQL transaction. If an operation fails, that record is rolled back, remains in the backup table, and the shift stops.</p>
</section></div>
<script>
const socket=io();let connected=false,shiftInProgress=false,scanned=null,operationTimeout=null;const $=id=>document.getElementById(id);
for(let line=1;line<=20;line++){const name=`running_production_count_line${line}`;const option=document.createElement('option');option.value=name;option.textContent=`Line ${line}`;$('tableName').appendChild(option)}
function setMessage(message,type=''){const el=$('statusMessage');el.textContent=message;el.className='status'+(type?' '+type:'')}
function updateButtons(){const busy=!connected||shiftInProgress;$('scanBtn').disabled=busy;$('shiftBtn').disabled=busy||!scanned||Number(scanned.total)===0}
function currentSelection(){return{packNo:$('packNo').value.trim(),packId:$('packSelect').value,tableName:$('tableName').value}}
function validateSelection(s){if(!/^\d{6}$/.test(s.packNo)){setMessage('Pack Number must contain exactly 6 digits.','error');return false}if(!s.packId){setMessage('Please select a Pack Name.','error');return false}if(!s.tableName){setMessage('Please select a Line.','error');return false}return true}
function resetMetrics(){ $('totalCount').textContent='—';$('shiftedCount').textContent='0';$('failedCount').textContent='0';$('progressBar').style.width='0%';$('progressText').textContent='Waiting...'}
function startTimeout(){clearTimeout(operationTimeout);operationTimeout=setTimeout(()=>{setMessage('No response received from the server. Check backend/database status before retrying.','error');if(shiftInProgress){shiftInProgress=false;updateButtons()}},120000)}
function loadPacks(){socket.emit('get-pack-list',{},response=>{if(!response||!response.success){$('packSelect').innerHTML='<option value="">Unable to load pack names</option>';setMessage(response?.message||'Could not load pack names.','error');return}const select=$('packSelect');select.innerHTML='<option value="">Select Pack Name</option>';for(const pack of response.packs){const option=document.createElement('option');option.value=String(pack.Pack_ID);option.textContent=String(pack.Pack_Name??'');option.dataset.search=(String(pack.Pack_Name??'')+' '+String(pack.Pack_ID??'')).toLowerCase();select.appendChild(option)}filterPacks()})}
function filterPacks(){const term=$('packSearch').value.trim().toLowerCase();const select=$('packSelect');let selectedStillVisible=false;for(const option of select.options){if(!option.value){option.hidden=false;continue}option.hidden=!option.dataset.search.includes(term);if(option.selected&&!option.hidden)selectedStillVisible=true}if(select.selectedOptions[0]?.hidden||!selectedStillVisible)select.value='';invalidateScan()}
$('packSearch').addEventListener('input',filterPacks);
function invalidateScan(){scanned=null;updateButtons()}
function scanRecords(){if(!connected||shiftInProgress)return;const selection=currentSelection();if(!validateSelection(selection))return;scanned=null;resetMetrics();updateButtons();setMessage(`Scanning backup records for Pack Number ${selection.packNo}...`);startTimeout();socket.emit('scan-records',selection,response=>{clearTimeout(operationTimeout);if(!response||!response.success){setMessage(response?.message||'Scan failed.','error');return}scanned={...selection,total:response.total};$('totalCount').textContent=response.total;setMessage(`Scan completed successfully.\nPack Number: ${selection.packNo}\nPack ID: ${selection.packId}\nSource: ${response.source}\nDestination: ${response.target}\nMatching records: ${response.total}`,Number(response.total)>0?'success':'');updateButtons()})}
function startShift(){if(!connected||shiftInProgress)return;const selection=currentSelection();if(!validateSelection(selection))return;if(!scanned||scanned.packNo!==selection.packNo||scanned.packId!==selection.packId||scanned.tableName!==selection.tableName){setMessage('Please scan again after confirming the exact same Pack Number, Pack Name and Line.','error');return}if(Number(scanned.total)===0){setMessage('No matching backup records are available to shift.','error');return}const lineNo=selection.tableName.replace('running_production_count_line','');const backup=`${selection.tableName}_backup`;const live=selection.tableName;const packName=$('packSelect').selectedOptions[0].textContent;if(!confirm(`Shift ${scanned.total} records?\n\nPack Number: ${selection.packNo}\nPack Name: ${packName}\nPack ID: ${selection.packId}\nSource: ${backup}\nDestination: ${live}\n\nEach backup row will be deleted only after its live-table insert is verified. Continue?`))return;shiftInProgress=true;resetMetrics();$('totalCount').textContent=scanned.total;updateButtons();setMessage(`Starting shift for Line ${lineNo}...`);startTimeout();socket.emit('shift-records',selection,response=>{clearTimeout(operationTimeout);if(!response||!response.success){shiftInProgress=false;updateButtons();setMessage(response?.message||'Could not start shift.','error')}})}
$('packNo').addEventListener('input',e=>{e.target.value=e.target.value.replace(/\D/g,'').slice(0,6);invalidateScan()});$('packSelect').addEventListener('change',invalidateScan);$('tableName').addEventListener('change',invalidateScan);
socket.on('connect',()=>{connected=true;$('connection').textContent='Connected to backup server';$('connection').className='connection online';updateButtons();loadPacks()});socket.on('disconnect',()=>{connected=false;scanned=null;clearTimeout(operationTimeout);$('connection').textContent='Disconnected — reconnecting...';$('connection').className='connection';if(shiftInProgress)setMessage('Browser connection lost during shift. Some records may already have committed. Reconnect and scan the backup table before retrying.','error');updateButtons()});socket.on('connect_error',err=>{connected=false;$('connection').textContent='Connection error';$('connection').className='connection';console.error('Socket connection error:',err.message);updateButtons()});socket.on('connection-status',data=>{if(data.connected){connected=true;$('connection').textContent=data.message;$('connection').className='connection online';updateButtons()}});
socket.on('shift-started',data=>{$('totalCount').textContent=data.total;$('progressText').textContent=`Starting shift: ${data.total} records selected.`;setMessage(`${data.message}\nSource: ${data.source}\nDestination: ${data.target}`)});
socket.on('shift-progress',data=>{$('totalCount').textContent=data.total;$('shiftedCount').textContent=data.shifted;$('failedCount').textContent=data.failed;const percent=data.total?Math.min(100,Math.round(data.shifted/data.total*100)):0;$('progressBar').style.width=percent+'%';$('progressText').textContent=`${data.shifted} of ${data.total} records committed (${percent}%)`;if(data.error)setMessage(`Shift stopped at backup sr_no ${data.currentSrNo}.\n${data.error}\nThe failed backup record was retained.`,'error')});
socket.on('shift-complete',data=>{clearTimeout(operationTimeout);shiftInProgress=false;scanned=null;$('totalCount').textContent=data.total;$('shiftedCount').textContent=data.shifted;$('failedCount').textContent=data.failed;const percent=data.total?Math.min(100,Math.round(data.shifted/data.total*100)):0;$('progressBar').style.width=percent+'%';$('progressText').textContent=`${data.shifted} of ${data.total} records committed (${percent}%)`;let message=`${data.message}\n\nSource: ${data.source}\nDestination: ${data.target}\nSelected records: ${data.total}\nSuccessfully shifted: ${data.shifted}\nFailed records: ${data.failed}`;if(data.failedSrNo!==null&&data.failedSrNo!==undefined)message+=`\nFailed sr_no: ${data.failedSrNo}`;if(data.lastError)message+=`\nError: ${data.lastError}`;setMessage(message,data.failed?'error':'success');updateButtons()});socket.on('operation-error',response=>{clearTimeout(operationTimeout);if(shiftInProgress){shiftInProgress=false;scanned=null;updateButtons()}setMessage(response?.message||'An operation failed.','error')});
</script></body></html>
