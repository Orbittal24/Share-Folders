def IR_Packstatus(
    pack_id: int,
    pack_no: str,
    station_id: int,
    process_id: int,
    pack_creation_date,
    module_id: Optional[int] = None
):

    conn = None
    cursor = None

    try:

        # ----------------------------------------------------------
        # CONNECTION
        # ----------------------------------------------------------

        conn = create_sql_connection()

        if conn is None:

            return {
                "success": False,
                "message": "Unable to connect to SQL Server."
            }

        cursor = conn.cursor()

        # ----------------------------------------------------------
        # STEP 0: GET STATION_ID FROM PROCESS MASTER
        # ----------------------------------------------------------

        cursor.execute("""
            SELECT TOP (1) Station_ID
            FROM [master_taco_treceability_IR].[taco_treceability].[Process_Master]
            WHERE Process_ID = ?
        """, (process_id,))

        process_result = cursor.fetchone()

        if not process_result:

            return {
                "success": False,
                "message": "Process not found."
            }

        # Override station_id

        station_id = process_result[0]

        print(f"Fetched Station_ID: {station_id}")

        # ----------------------------------------------------------
        # STEP 1: GET STATION DETAILS
        # ----------------------------------------------------------

        cursor.execute("""
            SELECT Station_ID, Station_Name, category
            FROM taco_treceability_master.taco_treceability.master_station
            WHERE Station_ID = ?
        """, (station_id,))

        station = cursor.fetchone()

        if not station:

            return {
                "success": False,
                "message": "Station not found."
            }

        column_name = station[1]

        station_name = column_name.replace(" ", "_")

        print(f"Station Name: {station_name}")

        # ----------------------------------------------------------
        # STEP 2: CHECK PACK TYPE
        # ----------------------------------------------------------

        cursor.execute("""
            SELECT module_group_id
            FROM taco_treceability_master.taco_treceability.master_module
            WHERE Pack_ID = ?
        """, (pack_id,))

        modules = cursor.fetchall()

        if not modules:

            return {
                "success": False,
                "message": "No modules found for this pack."
            }

        # If ANY module has module_group_id NOT NULL → NPD

        is_npd_pack = any(
            row[0] is not None
            for row in modules
        )

        print("Is NPD Pack:", is_npd_pack)

        # ----------------------------------------------------------
        # STEP 3: BUILD DYNAMIC TABLE NAME
        # ----------------------------------------------------------

        try:

            if isinstance(pack_creation_date, datetime):

                creation_date = pack_creation_date

            else:

                creation_date = datetime.fromisoformat(
                    str(pack_creation_date)
                )

        except Exception:

            return {
                "success": False,
                "message": "Invalid pack_creation_date format."
            }

        if is_npd_pack:

            # NPD

            table_suffix = creation_date.strftime(
                "%d-%m-%Y"
            )

            table_name = (
                f"[taco_treceability_station_status].[dbo]."
                f"[set_status_{table_suffix}]"
            )

            condition = """
                pack_id = ?
                AND pack_no = ?
                AND module_id = ?
            """

            params = (
                pack_id,
                pack_no,
                module_id
            )

        else:

            # NORMAL

            table_suffix = creation_date.strftime(
                "%m-%Y"
            )

            table_name = (
                f"[taco_treceability_station_status].[dbo]."
                f"[pack_status_{table_suffix}]"
            )

            condition = """
                pack_id = ?
                AND pack_no = ?
            """

            params = (
                pack_id,
                pack_no
            )

        print("Dynamic Table:", table_name)

        # ----------------------------------------------------------
        # STEP 4: FETCH CURRENT STATUS
        # ----------------------------------------------------------

        select_query = f"""
            SELECT [{station_name}]
            FROM {table_name}
            WHERE {condition}
        """

        cursor.execute(
            select_query,
            params
        )

        current_row = cursor.fetchone()

        if not current_row:

            return {
                "success": False,
                "message": "Pack record not found in status table."
            }

        current_status = current_row[0]

        if not current_status:

            return {
                "success": False,
                "message": "Current status is empty."
            }

        # Already completed

        if current_status.startswith("OK|"):

            return {
                "success": True,
                "message": "Station already completed.",
                "data": {
                    "pack_id": pack_id,
                    "pack_no": pack_no,
                    "station_name": station_name,
                    "status": current_status
                }
            }

        # ----------------------------------------------------------
        # STEP 5: REMOVE PROCESS ID
        # ----------------------------------------------------------

        timestamp = datetime.now().strftime(
            "%Y-%m-%d %H.%M.%S"
        )

        try:

            status_main, process_part, last_part = (
                current_status.split(":", 2)
            )

        except ValueError:

            return {
                "success": False,
                "message": "Current status format is invalid."
            }

        if process_part and process_part != "NA":

            process_list = [
                p.strip()
                for p in process_part.split(",")
                if p.strip()
            ]

            # Remove current process ID

            process_list = [
                p for p in process_list
                if p != str(process_id)
            ]

            # All completed

            if len(process_list) == 0:

                updated_status = (
                    f"OK|{timestamp}:NA:{last_part}"
                )

            else:

                new_process_part = ",".join(
                    process_list
                )

                updated_status = (
                    f"NOT OK:{new_process_part}:{last_part}"
                )

        else:

            updated_status = (
                f"OK|{timestamp}:NA:{last_part}"
            )

        print(
            "Updated Status:",
            updated_status
        )

        # ----------------------------------------------------------
        # STEP 7: UPDATE TABLE
        # ----------------------------------------------------------

        update_query = f"""
            UPDATE {table_name}
            SET [{station_name}] = ?
            WHERE {condition}
        """

        update_params = (
            updated_status,
            *params
        )

        cursor.execute(
            update_query,
            update_params
        )

        conn.commit()

        print(
            "Pack status updated successfully"
        )

        # ----------------------------------------------------------
        # SUCCESS RESPONSE
        # ----------------------------------------------------------

        return {
            "success": True,
            "message": "Pack status updated successfully.",
            "data": {
                "pack_id": pack_id,
                "pack_no": pack_no,
                "station_name": station_name,
                "updated_status": updated_status,
                "table": table_name
            }
        }

    except Exception as e:

        try:

            if conn:
                conn.rollback()

        except Exception:
            pass

        if "Invalid object name" in str(e):

            return {
                "success": False,
                "message": f"Table {table_name} does not exist."
            }

        return {
            "success": False,
            "message": str(e)
        }

    finally:

        try:

            if cursor:
                cursor.close()

        except Exception:
            pass

        try:

            if conn:
                conn.close()

        except Exception:
            pass


