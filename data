USE master;
GO

IF DB_ID('SQLMonitoringDB') IS NULL
BEGIN
    CREATE DATABASE SQLMonitoringDB;
END;
GO

USE SQLMonitoringDB;
GO

CREATE TABLE dbo.SQLQueryExecutionLogs
(
    LogID BIGINT IDENTITY(1,1) PRIMARY KEY,
    CaptureTimestamp DATETIME2(3) NOT NULL,
    DatabaseName SYSNAME NULL,
    QueryText NVARCHAR(MAX) NULL,
    LastExecutionTime DATETIME NULL,
    ExecutionCount BIGINT NULL,
    TotalCPUMs BIGINT NULL,
    TotalElapsedMs BIGINT NULL,
    LogicalReads BIGINT NULL,
    PhysicalReads BIGINT NULL,
    LogicalWrites BIGINT NULL
);

CREATE INDEX IX_SQLQueryExecutionLogs_CaptureTimestamp
ON dbo.SQLQueryExecutionLogs(CaptureTimestamp);

CREATE INDEX IX_SQLQueryExecutionLogs_DatabaseName
ON dbo.SQLQueryExecutionLogs(DatabaseName);
GO
