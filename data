def get_formatted_timestamp():

    utc = datetime.utcnow()

    ist = pytz.timezone(
        'Asia/Kolkata'
    )

    return (
        utc
        .replace(tzinfo=pytz.utc)
        .astimezone(ist)
        .strftime('%Y-%m-%d %H:%M:%S')
    )


