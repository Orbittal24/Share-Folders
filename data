
"use strict";

const sql = require("mssql");

// ======================================================
// SQL SERVER CONFIGURATION
// ======================================================

const sqlConfig = {
    user: "user_mis",
    password: "YOUR_SQL_PASSWORD", // Replace with actual password
    server: "10.9.4.29",
    port: 1433,
    database: "SQLMonitoringDB",

    options: {
        encrypt: false,
        trustServerCertificate: true
    },

    pool: {
        max: 3,
        min: 0,
        idleTimeoutMillis: 30000
    },

    connectionTimeout: 15000,
    requestTimeout: 60000
};

const CAPTURE_INTERVAL_MS = 60 * 1000;

let pool = null;
let isRunning = false;
let isStopping = false;
let timer = null;

// ======================================================
// SQL QUERY: CAPTURE CACHED STATISTICS ACROSS DATABASES
// ======================================================

const captureSQL = `
;WITH QueryStats AS
(
    SELECT
        qs.sql_handle,
        qs.plan_handle,
        qs.statement_start_offset,
        qs.statement_end_offset,
        qs.execution_count,
        qs.total_worker_time,
        qs.total_elapsed_time,
        qs.total_logical_reads,
        qs.total_physical_reads,
        qs.total_logical_writes,
        qs.last_execution_time,
        st.dbid,
        st.text AS batch_text,
        pa.database_id AS plan_database_id

    FROM sys.dm_exec_query_stats AS qs

    CROSS APPLY sys.dm_exec_sql_text(qs.sql_handle) AS st

    OUTER APPLY
    (
        SELECT TOP (1)
            TRY_CONVERT(INT, p.value) AS database_id
        FROM sys.dm_exec_plan_attributes(qs.plan_handle) AS p
        WHERE p.attribute = 'dbid'
    ) AS pa

    WHERE qs.last_execution_time >=
          DATEADD(MINUTE, -1, GETDATE())
)
INSERT INTO SQLMonitoringDB.dbo.SQLQueryExecutionLogs
(
    CaptureTimestamp,
    DatabaseName,
    QueryText,
    LastExecutionTime,
    ExecutionCount,
    TotalCPUMs,
    TotalElapsedMs,
    LogicalReads,
    PhysicalReads,
    LogicalWrites
)
SELECT
    SYSDATETIME(),

    COALESCE(
        DB_NAME(q.dbid),
        DB_NAME(q.plan_database_id)
    ),

    CASE
        WHEN q.batch_text IS NULL THEN NULL

        WHEN q.statement_start_offset < 0
            THEN q.batch_text

        ELSE SUBSTRING
        (
            q.batch_text,

            (q.statement_start_offset / 2) + 1,

            (
                CASE
                    WHEN q.statement_end_offset = -1
                        THEN DATALENGTH(q.batch_text)
                    ELSE q.statement_end_offset
                END
                - q.statement_start_offset
            ) / 2
        )
    END,

    q.last_execution_time,
    q.execution_count,
    q.total_worker_time / 1000,
    q.total_elapsed_time / 1000,
    q.total_logical_reads,
    q.total_physical_reads,
    q.total_logical_writes

FROM QueryStats AS q;
`;

// ======================================================
// GET OR CREATE SQL CONNECTION POOL
// ======================================================

async function getConnectionPool() {
    if (pool && pool.connected) {
        return pool;
    }

    if (pool) {
        await pool.close().catch(() => {});
        pool = null;
    }

    console.log("Connecting to SQL Server...");

    const newPool = new sql.ConnectionPool(sqlConfig);

    newPool.on("error", (error) => {
        console.error(
            new Date().toISOString(),
            "| SQL connection pool error:",
            error.message
        );
    });

    pool = await newPool.connect();

    console.log("SQL Server connection established.");

    return pool;
}

// ======================================================
// CAPTURE QUERY LOGS
// ======================================================

async function captureQueryLogs() {
    if (isRunning || isStopping) {
        return;
    }

    isRunning = true;

    const captureStartedAt = new Date().toISOString();

    try {
        console.log(
            captureStartedAt,
            "| Starting query statistics capture..."
        );

        const connection = await getConnectionPool();

        const result = await connection.request().query(captureSQL);

        const rowsInserted = (result.rowsAffected || [])
            .reduce((total, count) => total + count, 0);

        console.log(
            new Date().toISOString(),
            "| Capture successful | Rows inserted:",
            rowsInserted
        );

    } catch (error) {
        console.error(
            new Date().toISOString(),
            "| Capture failed:",
            error.message
        );

        // Force a new connection attempt during the next cycle.
        if (pool) {
            await pool.close().catch(() => {});
            pool = null;
        }

    } finally {
        isRunning = false;
    }
}

// ======================================================
// START LOGGER
// ======================================================

async function startLogger() {
    console.log("==================================================");
    console.log("SQL CPU / QUERY CONSUMPTION LOGGER STARTED");
    console.log("Server       : 10.9.4.29:1433");
    console.log("Log database : SQLMonitoringDB");
    console.log("Log table    : dbo.SQLQueryExecutionLogs");
    console.log("Interval     : 60 seconds");
    console.log("==================================================");

    // Capture immediately, then repeat every minute.
    await captureQueryLogs();

    if (!isStopping) {
        timer = setInterval(() => {
            captureQueryLogs().catch((error) => {
                console.error("Unexpected capture error:", error.message);
            });
        }, CAPTURE_INTERVAL_MS);

        console.log("Logger is running. Press Ctrl+C to stop.");
    }
}

// ======================================================
// GRACEFUL SHUTDOWN
// ======================================================

async function shutdown() {
    if (isStopping) {
        return;
    }

    isStopping = true;

    console.log("\nStopping SQL query logger...");

    if (timer) {
        clearInterval(timer);
        timer = null;
    }

    // Wait for an active capture to finish.
    while (isRunning) {
        await new Promise((resolve) => setTimeout(resolve, 200));
    }

    if (pool) {
        await pool.close().catch(() => {});
        pool = null;
    }

    console.log("SQL query logger stopped.");
    process.exitCode = 0;
}

process.once("SIGINT", shutdown);
process.once("SIGTERM", shutdown);

// ======================================================
// EXECUTE LOGGER
// ======================================================

startLogger().catch((error) => {
    console.error("Logger startup failed:", error.message);
    process.exitCode = 1;
});
