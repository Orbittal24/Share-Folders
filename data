import json
import os
import time
import redis

r = redis.StrictRedis(
    host="localhost",
    port=6379,
    password=os.getenv("REDIS_PASSWORD"),  # don't hardcode the password
    db=31,
    decode_responses=True
)

TARGET_DATE = "2026-09-20"   # delete cells whose first_para_time is on this date
SCAN_COUNT = 5000
DRY_RUN = True               # run once as True, check counts, then set False

cursor = 0
scanned = matched = skipped = 0

while True:
    cursor, keys = r.scan(cursor=cursor, match="cell:*", count=SCAN_COUNT)

    if keys:
        values = r.mget(keys)   # one round trip for the whole batch
        to_delete = []

        for key, raw in zip(keys, values):
            scanned += 1
            if not raw:
                continue            # expired between SCAN and MGET
            try:
                data = json.loads(raw)
            except (json.JSONDecodeError, TypeError):
                skipped += 1        # not JSON, leave it alone
                continue

            fpt = str(data.get("first_para_time") or "")
            if fpt.startswith(TARGET_DATE):
                to_delete.append(key)

        if to_delete:
            if not DRY_RUN:
                r.unlink(*to_delete)
            matched += len(to_delete)

        print(f"scanned={scanned}  {'would delete' if DRY_RUN else 'deleted'}={matched}  skipped={skipped}")

    if cursor == 0:
        break

    time.sleep(0.05)

print("\nCompleted.")
print(f"Total scanned: {scanned}")
print(f"Total {'matching (dry run)' if DRY_RUN else 'deleted'}: {matched}")
