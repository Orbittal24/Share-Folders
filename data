<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Restart IR Screwing Services</title>

    <!-- Your CSS -->
    <link href="./style/style.css" rel="stylesheet">

    <!-- SweetAlert -->
    <script src="./style/sweetalert.js"></script>
</head>

<body>

    <!-- Page Heading -->
    <div class="py-3 d-flex flex-row align-items-center m-5">
        <h3>IR Screwing Service Restart</h3>
    </div>


    <!-- Service Control Card -->
    <div class="card-header py-3 d-flex flex-row align-items-center m-5 bg-light">

        <label for="dropdown" class="mr-2">
            Choose an option:
        </label>

        <select id="dropdown" class="custom-select mr-2">

            <option value="ocv_cell_data_mirror_ocv_universal_line_1_2">
                ocv_cell_data_mirror_ocv_universal_line_1_2
            </option>

            <option value="ocv_cell_data_mirror_ocv_universal_line_3_4">
                ocv_cell_data_mirror_ocv_universal_line_3_4
            </option>

            <option value="ocv_cell_data_mirror_ocv_universal_line_5_6">
                ocv_cell_data_mirror_ocv_universal_line_5_6
            </option>

            <option value="ocv_cell_data_mirror_ocv_universal_line_7_8">
                ocv_cell_data_mirror_ocv_universal_line_7_8
            </option>

            <option value="ocv_cell_data_mirror_ocv_universal_line_A">
                ocv_cell_data_mirror_ocv_universal_line_A
            </option>

            <option value="ocv_cell_data_mirror_ocv_universal_XNG">
                ocv_cell_data_mirror_ocv_universal_XNG
            </option>

            <option value="ocv_cell_data_mirror_ocv_universal_bajaj_2w">
                ocv_cell_data_mirror_ocv_universal_bajaj_2w
            </option>

        </select>


        <!-- Start Button -->
        <a id="startButton"
           class="ml-auto btn btn-success btn-sm"
           href="#">
            Start
        </a>


        <!-- Stop Button -->
        <a id="stopButton"
           class="ml-2 btn btn-danger btn-sm"
           href="#">
            Stop
        </a>

    </div>


    <!-- Socket.IO -->
    <script src="./style/socket_io.js"></script>


    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const dropdown = document.getElementById("dropdown");
            const startButton = document.getElementById("startButton");
            const stopButton = document.getElementById("stopButton");


            // =========================================================
            // CONNECT TO SOCKET.IO SERVER
            // =========================================================

            const socket = io();


            // =========================================================
            // START SERVICE
            // =========================================================

            startButton.addEventListener("click", function (event) {

                event.preventDefault();

                const selectedValue = dropdown.value;

                console.log("Selected Service:", selectedValue);


                Swal.fire({

                    title: "Enter Passcode!",

                    html:
                        '<input id="password" ' +
                        'type="password" ' +
                        'class="swal2-input" ' +
                        'placeholder="Enter Passcode">',

                    showCancelButton: true,

                    confirmButtonText: "Start",

                    cancelButtonText: "Cancel"

                }).then((result) => {


                    // User clicked Cancel
                    if (!result.isConfirmed) {
                        return;
                    }


                    const password =
                        document.getElementById("password").value;


                    // =================================================
                    // CHECK PASSWORD
                    // =================================================

                    if (password === "") {

                        Swal.fire({
                            title: "Password Required",
                            text: "Please enter the passcode.",
                            icon: "warning"
                        });

                        return;
                    }


                    if (password !== "service") {

                        Swal.fire({
                            title: "Invalid Passcode",
                            text: "Please enter the correct passcode.",
                            icon: "error"
                        });

                        return;
                    }


                    // =================================================
                    // PM2 START COMMAND
                    // =================================================

                    const cmdname =
                        `pm2 start ${selectedValue} --interpreter=pythonw`;


                    console.log(
                        "START COMMAND:",
                        cmdname
                    );


                    // =================================================
                    // SEND COMMAND TO BACKEND
                    // =================================================

                    socket.emit(
                        "executeBat",
                        cmdname,
                        function (response) {

                            console.log(
                                "Server Response:",
                                response
                            );


                            if (response.success) {

                                Swal.fire({
                                    title: "PM2 Service Started",
                                    text:
                                        `${selectedValue} has been started successfully.`,
                                    icon: "success"
                                });

                            } else {

                                Swal.fire({
                                    title: "Failed to Start Service",
                                    text:
                                        response.error ||
                                        "Unable to start PM2 service.",
                                    icon: "error"
                                });

                            }

                        }
                    );

                });

            });


            // =========================================================
            // STOP SERVICE
            // =========================================================

            stopButton.addEventListener("click", function (event) {

                event.preventDefault();

                const selectedValue = dropdown.value;

                console.log("Selected Service:", selectedValue);


                Swal.fire({

                    title: "Enter Passcode!",

                    html:
                        '<input id="password" ' +
                        'type="password" ' +
                        'class="swal2-input" ' +
                        'placeholder="Enter Passcode">',

                    showCancelButton: true,

                    confirmButtonText: "Stop",

                    cancelButtonText: "Cancel"

                }).then((result) => {


                    // User clicked Cancel
                    if (!result.isConfirmed) {
                        return;
                    }


                    const password =
                        document.getElementById("password").value;


                    // =================================================
                    // CHECK PASSWORD
                    // =================================================

                    if (password === "") {

                        Swal.fire({
                            title: "Password Required",
                            text: "Please enter the passcode.",
                            icon: "warning"
                        });

                        return;
                    }


                    if (password !== "service") {

                        Swal.fire({
                            title: "Invalid Passcode",
                            text: "Please enter the correct passcode.",
                            icon: "error"
                        });

                        return;
                    }


                    // =================================================
                    // PM2 STOP COMMAND
                    // =================================================

                    const cmdname =
                        `pm2 stop ${selectedValue}`;


                    console.log(
                        "STOP COMMAND:",
                        cmdname
                    );


                    // =================================================
                    // SEND COMMAND TO BACKEND
                    // =================================================

                    socket.emit(
                        "executeBat",
                        cmdname,
                        function (response) {

                            console.log(
                                "Server Response:",
                                response
                            );


                            if (response.success) {

                                Swal.fire({
                                    title: "PM2 Service Stopped",
                                    text:
                                        `${selectedValue} has been stopped successfully.`,
                                    icon: "success"
                                });

                            } else {

                                Swal.fire({
                                    title: "Failed to Stop Service",
                                    text:
                                        response.error ||
                                        "Unable to stop PM2 service.",
                                    icon: "error"
                                });

                            }

                        }
                    );

                });

            });


            // =========================================================
            // SOCKET CONNECTION STATUS
            // =========================================================

            socket.on("connect", function () {

                console.log(
                    "Connected to server. Socket ID:",
                    socket.id
                );

            });


            socket.on("disconnect", function () {

                console.log(
                    "Disconnected from server."
                );

            });

        });

    </script>


</body>

</html>
