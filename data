# ------------------------------------------------------------------
# SQL CONNECTION HELPER
# ------------------------------------------------------------------

def create_sql_connection():

    max_retries = 3

    for attempt in range(1, max_retries + 1):

        try:

            print(
                f"[SQL] Connecting to SQL Server "
                f"(attempt {attempt}/{max_retries})..."
            )

            conn = pyodbc.connect(SQL_CONN_STR)

            print("[SQL] Connection established successfully.")

            return conn

        except pyodbc.Error as e:

            print(
                f"[SQL CONNECTION ERROR] "
                f"Attempt {attempt}/{max_retries}: {e}"
            )

            if attempt < max_retries:

                print(
                    "[SQL] Retrying SQL connection in 3 seconds..."
                )

                time.sleep(3)

            else:

                print(
                    "[SQL] All SQL connection attempts failed."
                )

        except Exception as e:

            print(
                f"[SQL CONNECTION ERROR] Unexpected error: {e}"
            )

            if attempt < max_retries:
                time.sleep(3)

    return None


# ------------------------------------------------------------------
# SQL CONNECTION VALIDATION
# ------------------------------------------------------------------

def is_sql_connection_alive(conn):

    if conn is None:
        return False

    try:

        cursor = conn.cursor()

        cursor.execute("SELECT 1")

        cursor.fetchone()

        cursor.close()

        return True

    except Exception as e:

        print(
            f"[SQL] Existing connection is not usable: {e}"
        )

        return False


# ------------------------------------------------------------------
# CLOSE SQL CONNECTION SAFELY
# ------------------------------------------------------------------

def close_sql_connection(conn):

    try:

        if conn:
            conn.close()

    except Exception:
        pass


