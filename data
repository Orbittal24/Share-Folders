
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Production Count Backup</title>

    <script src="/socket.io/socket.io.js"></script>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 25px;
            font-family: Arial, Helvetica, sans-serif;
            background: #f1f5f9;
            color: #1e293b;
        }

        .container {
            max-width: 1050px;
            margin: auto;
        }

        h1 {
            font-size: 28px;
            margin-bottom: 8px;
        }

        h2 {
            font-size: 19px;
            margin-top: 0;
        }

        .subtitle {
            color: #64748b;
            margin-bottom: 24px;
        }

        .card {
            background: #fff;
            border-radius: 12px;
            padding: 23px;
            margin-bottom: 20px;
            box-shadow: 0 3px 12px rgba(15, 23, 42, .07);
        }

        .fields {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 18px;
            margin: 20px 0;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
        }

        input,
        select {
            width: 100%;
            padding: 12px;
            border: 1px solid #cbd5e1;
            border-radius: 7px;
            font-size: 15px;
            background: #fff;
        }

        .buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
        }

        button {
            border: 0;
            padding: 12px 21px;
            border-radius: 7px;
            font-weight: 700;
            font-size: 14px;
            cursor: pointer;
        }

        button:disabled {
            opacity: .5;
            cursor: not-allowed;
        }

        .scan-btn {
            background: #2563eb;
            color: white;
        }

        .backup-btn {
            background: #15803d;
            color: white;
        }

        .metric-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 14px;
            margin-top: 18px;
        }

        .metric {
            border: 1px solid #e2e8f0;
            background: #f8fafc;
            border-radius: 9px;
            padding: 18px;
        }

        .metric span {
            display: block;
            color: #64748b;
            font-size: 13px;
            margin-bottom: 10px;
        }

        .metric strong {
            display: block;
            font-size: 25px;
            overflow-wrap: anywhere;
        }

        .connection {
            display: inline-block;
            padding: 8px 12px;
            border-radius: 20px;
            background: #fee2e2;
            color: #991b1b;
            font-size: 13px;
            margin-bottom: 20px;
        }

        .connection.online {
            background: #dcfce7;
            color: #166534;
        }

        .status {
            margin-top: 16px;
            padding: 14px;
            border-radius: 7px;
            background: #eff6ff;
            color: #1d4ed8;
            white-space: pre-wrap;
            overflow-wrap: anywhere;
            line-height: 1.5;
        }

        .status.error {
            background: #fef2f2;
            color: #b91c1c;
        }

        .status.success {
            background: #f0fdf4;
            color: #166534;
        }

        .progress-track {
            width: 100%;
            height: 15px;
            margin: 22px 0 10px;
            background: #e2e8f0;
            border-radius: 20px;
            overflow: hidden;
        }

        .progress-bar {
            height: 100%;
            width: 0;
            background: #16a34a;
            transition: width .2s;
        }

        #progressText {
            color: #475569;
            font-size: 14px;
        }

        .hint {
            font-size: 13px;
            color: #64748b;
            line-height: 1.6;
            margin-top: 20px;
        }

        @media (max-width: 650px) {
            body {
                padding: 12px;
            }

            .card {
                padding: 16px;
            }

            .fields,
            .metric-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>
<div class="container">

    <h1>Production Count Backup</h1>

    <div class="subtitle">
        Date-wise and battery-status-wise record transfer
    </div>

    <div id="connection" class="connection">
        Connecting to server...
    </div>

    <!-- CONDITION 1 -->
    <section class="card">
        <h2>Condition 1 — Date-wise Backup</h2>

        <div class="fields">
            <div>
                <label for="dateOnly">Select Date</label>
                <input type="date" id="dateOnly" required>
            </div>
        </div>

        <div class="buttons">
            <button
                id="scanDateBtn"
                class="scan-btn"
                onclick="scan('date')">
                Scan
            </button>

            <button
                id="backupDateBtn"
                class="backup-btn"
                onclick="startBackup('date')">
                Shift to Backup
            </button>
        </div>
    </section>

    <!-- CONDITION 2 -->
    <section class="card">
        <h2>Condition 2 — Date and Status Backup</h2>

        <div class="fields">
            <div>
                <label for="statusDate">Select Date</label>
                <input type="date" id="statusDate" required>
            </div>

            <div>
                <label for="batteryStatus">Battery Status</label>
                <select id="batteryStatus">
                    <option value="running">Running</option>
                    <option value="pause">Pause</option>
                </select>
            </div>
        </div>

        <div class="buttons">
            <button
                id="scanStatusBtn"
                class="scan-btn"
                onclick="scan('status')">
                Scan
            </button>

            <button
                id="backupStatusBtn"
                class="backup-btn"
                onclick="startBackup('status')">
                Shift to Backup
            </button>
        </div>
    </section>

    <!-- PROGRESS -->
    <section class="card">
        <h2>Backup Progress</h2>

        <div class="metric-grid">
            <div class="metric">
                <span>Records Found</span>
                <strong id="totalCount">—</strong>
            </div>

            <div class="metric">
                <span>Successfully Shifted</span>
                <strong id="shiftedCount">0</strong>
            </div>

            <div class="metric">
                <span>Failed Records</span>
                <strong id="failedCount">0</strong>
            </div>
        </div>

        <div class="progress-track">
            <div id="progressBar" class="progress-bar"></div>
        </div>

        <div id="progressText">
            No backup operation started.
        </div>

        <div id="statusMessage" class="status">
            Select a date and click Scan.
        </div>

        <p class="hint">
            Scan only counts records; it does not modify either table.
            Backup processes records sequentially. Each successful
            transaction inserts one record into production_count_1
            and deletes its original from production_count.
            If a transaction fails, it is rolled back and processing
            stops at that record.
        </p>
    </section>

</div>

<script>
    const socket = io();

    let connected = false;
    let backupInProgress = false;
    let scanned = null;

    let pendingOperation = null;
    let operationTimeout = null;

    const $ = id => document.getElementById(id);

    // -------------------------------------------------
    // UI HELPERS
    // -------------------------------------------------

    function setMessage(message, type = "") {
        const el = $("statusMessage");

        el.textContent = message;
        el.className = "status" + (type ? " " + type : "");
    }

    function setConnection(isOnline, message) {
        connected = isOnline;

        $("connection").textContent = message;

        $("connection").className =
            "connection" + (isOnline ? " online" : "");

        updateButtons();
    }

    function updateButtons() {
        const busy = !connected || backupInProgress;

        [
            "scanDateBtn",
            "backupDateBtn",
            "scanStatusBtn",
            "backupStatusBtn"
        ].forEach(id => {
            $(id).disabled = busy;
        });
    }

    function getFilters(mode) {
        if (mode === "date") {
            return {
                mode: "date",
                date: $("dateOnly").value
            };
        }

        return {
            mode: "status",
            date: $("statusDate").value,
            status: $("batteryStatus").value
        };
    }

    function validFilters(filters) {
        if (!filters.date) {
            setMessage("Please select a date.", "error");
            return false;
        }

        if (
            filters.mode === "status" &&
            !["running", "pause"].includes(filters.status)
        ) {
            setMessage(
                "Please select Running or Pause.",
                "error"
            );
            return false;
        }

        return true;
    }

    function resetMetrics() {
        $("totalCount").textContent = "—";
        $("shiftedCount").textContent = "0";
        $("failedCount").textContent = "0";
        $("progressBar").style.width = "0%";
        $("progressText").textContent = "Waiting...";
    }

    function clearOperationTimeout() {
        if (operationTimeout) {
            clearTimeout(operationTimeout);
            operationTimeout = null;
        }
    }

    function startOperationTimeout() {
        clearOperationTimeout();

        operationTimeout = setTimeout(() => {
            pendingOperation = null;

            setMessage(
                "No response received from the server. " +
                "Check the backend and database before retrying.",
                "error"
            );
        }, 30000);
    }

    function getPercent(done, total) {
        if (!total || total <= 0) return 0;

        return Math.min(
            100,
            Math.round((done / total) * 100)
        );
    }

    // -------------------------------------------------
    // SCAN
    // -------------------------------------------------

    function scan(mode) {
        if (!connected || backupInProgress) return;

        const filters = getFilters(mode);

        if (!validFilters(filters)) return;

        scanned = null;
        pendingOperation = "scan";

        resetMetrics();
        setMessage("Scanning production_count...");

        startOperationTimeout();

        socket.emit("scan-records", filters, response => {
            clearOperationTimeout();
            pendingOperation = null;

            if (!response || !response.success) {
                setMessage(
                    response?.message || "Scan failed.",
                    "error"
                );
                return;
            }

            scanned = {
                mode: filters.mode,
                date: filters.date,
                status: filters.status || null,
                total: response.total
            };

            $("totalCount").textContent = response.total;

            setMessage(
                `Scan completed successfully.\n` +
                `Matching records: ${response.total}`,
                "success"
            );
        });
    }

    // -------------------------------------------------
    // START BACKUP
    // -------------------------------------------------

    function startBackup(mode) {
        if (!connected || backupInProgress) return;

        const filters = getFilters(mode);

        if (!validFilters(filters)) return;

        // Require a scan for the exact same selection.
        if (
            !scanned ||
            scanned.mode !== filters.mode ||
            scanned.date !== filters.date ||
            scanned.status !== (filters.status || null)
        ) {
            setMessage(
                "Please scan the selected date and status again " +
                "before starting the backup.",
                "error"
            );
            return;
        }

        if (Number(scanned.total) === 0) {
            setMessage(
                "No matching records are available to shift.",
                "error"
            );
            return;
        }

        const confirmed = window.confirm(
            `Are you sure you want to shift ${scanned.total} records?\n\n` +
            `Source: production_count\n` +
            `Destination: production_count_1\n` +
            `Date: ${filters.date}\n` +
            (
                filters.mode === "status"
                    ? `Battery status: ${filters.status}\n`
                    : ""
            ) +
            "\nThe original is deleted only after a successful " +
            "transaction commit."
        );

        if (!confirmed) return;

        backupInProgress = true;
        pendingOperation = "backup";

        updateButtons();
        resetMetrics();

        $("totalCount").textContent = scanned.total;

        setMessage("Starting backup...");

        startOperationTimeout();

        socket.emit("shift-backup", filters, response => {
            clearOperationTimeout();

            if (!response || !response.success) {
                backupInProgress = false;
                pendingOperation = null;
                updateButtons();

                setMessage(
                    response?.message || "Could not start backup.",
                    "error"
                );
            }
        });
    }

    // -------------------------------------------------
    // SOCKET CONNECTION EVENTS
    // -------------------------------------------------

    socket.on("connect", () => {
        setConnection(true, "Connected to backup server");
    });

    socket.on("disconnect", () => {
        setConnection(false, "Disconnected — reconnecting...");

        clearOperationTimeout();

        pendingOperation = null;
        scanned = null;

        if (backupInProgress) {
            setMessage(
                "Browser connection lost during backup. " +
                "Some records may already have committed. " +
                "Check the server and scan the source again " +
                "before retrying.",
                "error"
            );
        }
    });

    socket.on("connect_error", error => {
        setConnection(false, "Connection error");

        console.error("Socket connection error:", error.message);
    });

    socket.on("connection-status", data => {
        if (data.connected) {
            setConnection(true, data.message);
        }
    });

    // -------------------------------------------------
    // SCAN RESULTS
    // -------------------------------------------------

    socket.on("scan-result", response => {
        if (response.success) {
            $("totalCount").textContent = response.total;
        }
    });

    // -------------------------------------------------
    // BACKUP PROGRESS
    // -------------------------------------------------

    socket.on("backup-started", data => {
        clearOperationTimeout();

        $("totalCount").textContent = data.total;

        $("progressText").textContent =
            `Starting backup: ${data.total} records selected.`;

        setMessage(data.message || "Backup started.");
    });

    socket.on("backup-progress", data => {
        $("totalCount").textContent = data.total;
        $("shiftedCount").textContent = data.shifted;
        $("failedCount").textContent = data.failed;

        const percent = getPercent(
            data.shifted,
            data.total
        );

        $("progressBar").style.width = percent + "%";

        $("progressText").textContent =
            `${data.shifted} of ${data.total} records committed (${percent}%)`;

        if (data.error) {
            setMessage(
                `Backup stopped at sr_no ${data.currentSrNo}.\n` +
                `${data.error}\n` +
                "The failed record was not removed from the source.",
                "error"
            );
        }
    });

    // -------------------------------------------------
    // BACKUP COMPLETION
    // -------------------------------------------------

    socket.on("backup-complete", data => {
        clearOperationTimeout();

        backupInProgress = false;
        pendingOperation = null;

        updateButtons();

        $("totalCount").textContent = data.total;
        $("shiftedCount").textContent = data.shifted;
        $("failedCount").textContent = data.failed;

        const percent = getPercent(
            data.shifted,
            data.total
        );

        $("progressBar").style.width = percent + "%";

        $("progressText").textContent =
            `${data.shifted} of ${data.total} records committed (${percent}%)`;

        let message =
            `${data.message}\n\n` +
            `Selected records: ${data.total}\n` +
            `Successfully shifted: ${data.shifted}\n` +
            `Failed records: ${data.failed}`;

        if (data.failedSrNo !== null &&
            data.failedSrNo !== undefined) {
            message += `\nFailed sr_no: ${data.failedSrNo}`;
        }

        if (data.lastError) {
            message += `\nError: ${data.lastError}`;
        }

        setMessage(
            message,
            data.failed > 0 ? "error" : "success"
        );

        // A new scan is required before another backup.
        scanned = null;
    });

    // -------------------------------------------------
    // GENERAL SERVER ERRORS
    // -------------------------------------------------

    socket.on("operation-error", response => {
        clearOperationTimeout();

        if (pendingOperation === "backup") {
            backupInProgress = false;
            pendingOperation = null;
            updateButtons();
        }

        setMessage(
            response.message || "An operation failed.",
            "error"
        );
    });

    // -------------------------------------------------
    // INVALIDATE OLD SCANS WHEN FILTERS CHANGE
    // -------------------------------------------------

    [
        "dateOnly",
        "statusDate",
        "batteryStatus"
    ].forEach(id => {
        $(id).addEventListener("change", () => {
            if (!backupInProgress) {
                scanned = null;
            }
        });
    });
</script>
</body>
</html>
