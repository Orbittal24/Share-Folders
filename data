def delete_source_record(src_conn, qr):

    src_cursor = src_conn.cursor()

    try:

        src_cursor.execute(
            """
            DELETE FROM taco_treceability.ocv_machine_data_xng_mirrior
            WHERE cell_qrcode = ?
            """,
            qr
        )

        src_conn.commit()

        print("DELETED SOURCE :", qr)

        return True


    except Exception as e:

        print("SOURCE DELETE FAILED :", qr)
        print("ERROR :", e)

        try:
            src_conn.rollback()
        except Exception:
            pass

        return False


# ============================================================
# PROCESS ONE RECORD
# ============================================================

def process_record(src_conn, dst_conn):

    src_cursor = src_conn.cursor()
    dst_cursor = dst_conn.cursor()


    # ============================================================
    # FETCH TOP 1 FROM NEW TABLE
    # ============================================================

    src_cursor.execute(
        """
        SELECT TOP 1 *
        FROM taco_treceability.ocv_machine_data_xng_mirrior
        ORDER BY sr_no DESC
        """
    )

    row = src_cursor.fetchone()


    if not row:

        print("No new records...")

        return


    qr = row.cell_qrcode


    print("\n================ NEW RECORD ================")
    print("QR CODE:", qr)


    # ============================================================
    # QR VALIDATION
    # ============================================================

    if not qr or len(qr) < 16:

        print("ERROR: QR too short, skipping")

        return


    # ============================================================
    # EXTRACT PLANT CODE & BATCH CODE
    # ============================================================

    code12_13 = qr[12:14]


    # Dynamic logic for dateCode
    if code12_13 == "BV":

        dateCode = qr[8:11]

    else:

        dateCode = qr[14:17]


    print("Plant code:", code12_13)
    print("Batch code:", dateCode)


    # ============================================================
    # DATE MAPPING
    # ============================================================

    yearValue = yearMap.get(dateCode[0])
    monthValue = monthMap.get(dateCode[1])
    dayValue = dayMap.get(dateCode[2])


    if not yearValue or not monthValue or not dayValue:

        print(
            "ERROR: Mapping failed! Skipping QR:",
            qr
        )

        return


    year = 2000 + yearValue

    month = f"{monthValue:02d}"

    day = f"{dayValue:02d}"


    tableName = (
        f"ocvcell_inventory_data_"
        f"{year}_{month}_{day}"
    )


    print("Target Table:", tableName)


    # ============================================================
    # CREATE TABLE IF NOT EXISTS
    # ============================================================

    try:

        dst_cursor.execute(
            f"""
            IF NOT EXISTS
            (
                SELECT 1
                FROM INFORMATION_SCHEMA.TABLES
                WHERE TABLE_NAME = '{tableName}'
            )
            BEGIN

                CREATE TABLE {tableName}
                (
                    sr_no INT IDENTITY(1,1) PRIMARY KEY,

                    cellqr NVARCHAR(50),
                    voltage NVARCHAR(50),
                    ir NVARCHAR(50),
                    class_grade NVARCHAR(30),
                    capacity NVARCHAR(50),
                    thickness NVARCHAR(50),
                    k_value NVARCHAR(50),
                    negative_voltage NVARCHAR(50),
                    cell_status NVARCHAR(20),
                    ocv_mc_no NVARCHAR(40),
                    first_para_time DATETIME,
                    last_para_time DATETIME,
                    laser_status VARCHAR(50),
                    batch VARCHAR(100),
                    plant_code VARCHAR(50)
                );

            END
            """
        )

        dst_conn.commit()


    except Exception as e:

        print("SQL TABLE CREATION ERROR :", e)

        try:
            dst_conn.rollback()
        except Exception:
            pass


    # ============================================================
    # CHECK IF EXISTS
    # ============================================================

    exists = None


    try:

        dst_cursor.execute(
            f"""
            SELECT *
            FROM {tableName}
            WHERE cellqr = ?
            """,
            qr
        )

        exists = dst_cursor.fetchone()


    except Exception as e:

        print(
            "SQL EXISTENCE CHECK FAILED :",
            e
        )

        try:
            dst_conn.rollback()
        except Exception:
            pass

        exists = None


    # ============================================================
    # PREPARE ROW DICT FOR REDIS
    # ============================================================

    row_dict = {

        "cellqr": safe(qr),

        "voltage": safe(row.voltage),

        "ir": safe(row.ir),

        "class_grade": safe(row.cell_class),

        "capacity": safe(row.cell_capacity),

        "thickness": safe(row.cell_thikness),

        "k_value": safe(row.kvalue),

        "negative_voltage": safe(
            row.cell_nigative_voltage
        ),

        "cell_status": "OK",

        "ocv_mc_no": safe(
            row.used_on_line
        ),

        "first_para_time": safe(
            row.today_date
        ),

        "last_para_time": safe(
            row.updated_time
        ),

        "laser_status": safe(
            row.laser_status
        ),

        "batch": safe(dateCode),

        "plant_code": safe(code12_13)

    }


    # ============================================================
    # STATUS VARIABLES
    # ============================================================

    sql_success = False
    redis_success = False

    sql_error = None
    redis_error = None


    # ============================================================
    # SQL OPERATION
    # ============================================================

    if not exists:

        # ========================================================
        # SQL INSERT
        # ========================================================

        try:

            print("TRYING SQL INSERT :", qr)


            dst_cursor.execute(
                f"""
                INSERT INTO {tableName}
                (
                    cellqr,
                    voltage,
                    ir,
                    class_grade,
                    capacity,
                    thickness,
                    k_value,
                    negative_voltage,
                    cell_status,
                    ocv_mc_no,
                    first_para_time,
                    last_para_time,
                    laser_status,
                    batch,
                    plant_code
                )
                VALUES
                (
                    ?,
                    ?,
                    ?,
                    ?,
                    ?,
                    ?,
                    ?,
                    ?,
                    'OK',
                    ?,
                    ?,
                    ?,
                    ?,
                    ?,
                    ?
                )
                """,
                (
                    qr,
                    row.voltage,
                    row.ir,
                    row.cell_class,
                    row.cell_capacity,
                    row.cell_thikness,
                    row.kvalue,
                    row.cell_nigative_voltage,
                    row.used_on_line,
                    row.today_date,
                    row.updated_time,
                    row.laser_status,
                    dateCode,
                    code12_13
                )
            )


            dst_conn.commit()


            sql_success = True


            print(
                "SQL INSERT SUCCESS :",
                qr
            )


        except Exception as e:

            sql_success = False

            sql_error = str(e)


            print(
                "SQL INSERT FAILED :",
                qr
            )

            print(
                "SQL ERROR :",
                e
            )


            try:
                dst_conn.rollback()
            except Exception:
                pass


    else:

        # ========================================================
        # EXISTING RECORD
        # ========================================================

        print("Already exists :", qr)


        # ========================================================
        # SQL UPDATE
        # ========================================================

        try:

            print(
                "TRYING SQL UPDATE :",
                qr
            )


            dst_cursor.execute(
                f"""
                UPDATE {tableName}
                SET
                    voltage = ?,
                    ir = ?,
                    class_grade = ?,
                    capacity = ?,
                    thickness = ?,
                    k_value = ?,
                    negative_voltage = ?,
                    ocv_mc_no = ?,
                    last_para_time = ?,
                    laser_status = ?,
                    batch = ?,
                    plant_code = ?
                WHERE cellqr = ?
                """,
                (
                    row.voltage,
                    row.ir,
                    row.cell_class,
                    row.cell_capacity,
                    row.cell_thikness,
                    row.kvalue,
                    row.cell_nigative_voltage,
                    row.used_on_line,
                    row.updated_time,
                    row.laser_status,
                    dateCode,
                    code12_13,
                    qr
                )
            )


            dst_conn.commit()


            sql_success = True


            print(
                "SQL UPDATE SUCCESS :",
                qr
            )


        except Exception as e:

            sql_success = False

            sql_error = str(e)


            print(
                "SQL UPDATE FAILED :",
                qr
            )

            print(
                "SQL ERROR :",
                e
            )


            try:
                dst_conn.rollback()
            except Exception:
                pass


    # ============================================================
    # REDIS OPERATION
    # ============================================================
    #
    # IMPORTANT:
    #
    # Redis is attempted independently.
    #
    # Even if SQL fails, Redis will still be attempted.
    #
    # ============================================================

    try:

        print(
            "TRYING REDIS :",
            qr
        )


        r.set(
            f"cell:{qr}",
            json.dumps(row_dict)
        )


        redis_success = True


        print(
            "REDIS SUCCESS :",
            qr
        )


    except Exception as e:

        redis_success = False

        redis_error = str(e)


        print(
            "REDIS FAILED :",
            qr
        )

        print(
            "REDIS ERROR :",
            e
        )


    # ============================================================
    # FINAL RESULT
    # ============================================================

    print(
        "\n--------------- FINAL RESULT ---------------"
    )

    print(
        "QR CODE       :",
        qr
    )

    print(
        "SQL SUCCESS   :",
        sql_success
    )

    print(
        "REDIS SUCCESS :",
        redis_success
    )


    # ============================================================
    # CASE 1
    #
    # SQL SUCCESS + REDIS SUCCESS
    # ============================================================

    if sql_success and redis_success:

        print(
            "\nCASE 1 : "
            "SQL SUCCESS + REDIS SUCCESS"
        )


        print(
            "SQL and Redis both successful."
        )


        # --------------------------------------------------------
        # DELETE SOURCE
        # --------------------------------------------------------

        delete_source_record(
            src_conn,
            qr
        )


    # ============================================================
    # CASE 2
    #
    # SQL FAILED + REDIS SUCCESS
    # ============================================================

    elif not sql_success and redis_success:

        print(
            "\nCASE 2 : "
            "SQL FAILED + REDIS SUCCESS"
        )


        print(
            "SQL failed."
        )

        print(
            "Redis succeeded."
        )

        print(
            "SQL ERROR :",
            sql_error
        )


        # --------------------------------------------------------
        # INSERT INTO REJECTION TABLE
        # --------------------------------------------------------

        rejection_success = insert_rejection_record(

            dst_conn,

            row,

            qr,

            dateCode,

            code12_13,

            tableName,

            sql_success,

            redis_success,

            sql_error,

            redis_error

        )


        # --------------------------------------------------------
        # DELETE SOURCE AFTER REJECTION ACKNOWLEDGEMENT
        # --------------------------------------------------------

        if rejection_success:

            delete_source_record(
                src_conn,
                qr
            )

        else:

            print(
                "SOURCE NOT DELETED BECAUSE "
                "REJECTION INSERT FAILED :",
                qr
            )


    # ============================================================
    # CASE 3
    #
    # SQL SUCCESS + REDIS FAILED
    # ============================================================

    elif sql_success and not redis_success:

        print(
            "\nCASE 3 : "
            "SQL SUCCESS + REDIS FAILED"
        )


        print(
            "SQL succeeded."
        )

        print(
            "Redis failed."
        )

        print(
            "REDIS ERROR :",
            redis_error
        )


        # --------------------------------------------------------
        # INSERT INTO REJECTION TABLE
        # --------------------------------------------------------

        rejection_success = insert_rejection_record(

            dst_conn,

            row,

            qr,

            dateCode,

            code12_13,

            tableName,

            sql_success,

            redis_success,

            sql_error,

            redis_error

        )


        # --------------------------------------------------------
        # DELETE SOURCE AFTER REJECTION ACKNOWLEDGEMENT
        # --------------------------------------------------------

        if rejection_success:

            delete_source_record(
                src_conn,
                qr
            )

        else:

            print(
                "SOURCE NOT DELETED BECAUSE "
                "REJECTION INSERT FAILED :",
                qr
            )


    # ============================================================
    # CASE 4
    #
    # SQL FAILED + REDIS FAILED
    # ============================================================

    elif not sql_success and not redis_success:

        print(
            "\nCASE 4 : "
            "SQL FAILED + REDIS FAILED"
        )


        print(
            "SQL failed."
        )

        print(
            "Redis failed."
        )

        print(
            "SQL ERROR :",
            sql_error
        )

        print(
            "REDIS ERROR :",
            redis_error
        )


        # --------------------------------------------------------
        # BOTH FAILED
        #
        # INSERT INTO REJECTION TABLE
        # --------------------------------------------------------

        rejection_success = insert_rejection_record(

            dst_conn,

            row,

            qr,

            dateCode,

            code12_13,

            tableName,

            sql_success,

            redis_success,

            sql_error,

            redis_error

        )


        # --------------------------------------------------------
        # DELETE SOURCE AFTER REJECTION ACKNOWLEDGEMENT
        # --------------------------------------------------------

        if rejection_success:

            print(
                "REJECTION INSERT SUCCESSFUL."
            )

            print(
                "REJECTION ACKNOWLEDGEMENT SUCCESSFUL."
            )


            delete_source_record(
                src_conn,
                qr
            )


        else:

            print(
                "REJECTION INSERT FAILED."
            )

            print(
                "SOURCE NOT DELETED :",
                qr
            )


    # ============================================================
    # PROCESS COMPLETE
    # ============================================================

    print(
        "---------------------------------------------"
    )

    print(
        "PROCESS COMPLETE :",
        qr
    )

    print(
        "---------------------------------------------\n"
    )


# ============================================================
# CONTINUOUS LOOP
# ============================================================

def start():

    src_conn = connect_db(sqlConfig1)

    dst_conn = connect_db(sqlConfig2)


    print(
        "=============================================="
    )

    print(
        "OCV CELL DATA MIRROR SERVICE STARTED"
    )

    print(
        "=============================================="
    )


    while True:

        try:

            process_record(
                src_conn,
                dst_conn
            )


        except Exception as e:

            print(
                "ERROR:",
                e
            )

            time.sleep(1)


# ============================================================
# START SERVICE
# ============================================================

start()
