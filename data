import csv
import json
import time
from datetime import datetime
import redis

r = redis.StrictRedis(
    host="localhost",
    port=6379,
    password="Gotion@123Strong!",
    db=31,
    decode_responses=True
)

TARGET_PREFIX = "2026-01"    # "2026-01" = all of Jan 2026, "2026-01-15" = one day
SCAN_COUNT = 5000
DRY_RUN = False              # True = only list, False = actually delete
PRINT_EACH = True            # print every cellqr to console (set False if the list is huge)

print("Redis version:", r.info("server")["redis_version"])

mode = "dryrun" if DRY_RUN else "deleted"
csv_file = f"cells_{TARGET_PREFIX}_{mode}_{datetime.now():%Y%m%d_%H%M%S}.csv"

cursor = 0
scanned = matched = skipped = 0

with open(csv_file, "w", newline="", encoding="utf-8") as f:
    writer = csv.writer(f)
    writer.writerow(["redis_key", "cellqr", "first_para_time", "last_para_time", "batch", "plant_code"])

    while True:
        cursor, keys = r.scan(cursor=cursor, match="cell:*", count=SCAN_COUNT)

        if keys:
            to_delete = []

            for key, raw in zip(keys, r.mget(keys)):
                scanned += 1
                if not raw:
                    continue            # expired between SCAN and MGET
                try:
                    data = json.loads(raw)
                except (json.JSONDecodeError, TypeError):
                    skipped += 1        # not JSON, leave it alone
                    continue

                fpt = str(data.get("first_para_time") or "").strip()
                if fpt.startswith(TARGET_PREFIX):
                    to_delete.append(key)
                    cellqr = data.get("cellqr")
                    writer.writerow([key, cellqr, fpt,
                                     data.get("last_para_time"),
                                     data.get("batch"),
                                     data.get("plant_code")])
                    if PRINT_EACH:
                        print(f"  {'[DRY RUN]' if DRY_RUN else '[DELETE]'} {cellqr}  first_para_time={fpt}")

            if to_delete:
                if not DRY_RUN:
                    matched += r.delete(*to_delete)   # DEL works on Redis 3.x (UNLINK needs 4.0+)
                else:
                    matched += len(to_delete)
                f.flush()

            print(f"scanned={scanned}  {'would delete' if DRY_RUN else 'deleted'}={matched}  skipped={skipped}")

        if cursor == 0:
            break

        time.sleep(0.05)

print("\nCompleted.")
print(f"Mode                   : {'DRY RUN (nothing deleted)' if DRY_RUN else 'DELETED'}")
print(f"Target                 : first_para_time starting with {TARGET_PREFIX}")
print(f"Total cell keys scanned: {scanned}")
print(f"Total {'matching' if DRY_RUN else 'deleted'}         : {matched}")
print(f"Non-JSON keys skipped  : {skipped}")
print(f"Cell list saved to     : {csv_file}")
